+# Standalone AAR built via chromium's native dist_aar template. Its classes.jar
+# comes from the same deps chain as afree_demo_apk (so the AAR and the GN APK
+# contain the same Java classes + resources). SDK/androidx/kotlin/guava classes
+# are excluded and must be provided by the AAR consumer (see demo/build.gradle).
+dist_aar("afree_webview_aar") {
+  android_manifest = "sdk/src/main/AndroidManifest.xml"
+
+  _webview_out_dir = get_label_info(
+          "//android_webview:libwebviewchromium($webview_toolchain)",
+          "root_out_dir")
+  _trampoline_out_dir = get_label_info(
+          "//third_party/crashpad/crashpad/handler:crashpad_handler_trampoline",
+          "root_out_dir")
+  native_libraries = [
+    _webview_out_dir + "/libwebviewchromium.so",
+    _trampoline_out_dir + "/libcrashpad_handler_trampoline.so",
+  ]
+
+  deps = [
+    ":afree_api_java",
+    ":afree_glue_java",
+    ":afree_init_java",
+    ":afree_generated_java",
+    ":afree_assets",
+    "//android_webview:libwebviewchromium($webview_toolchain)",
+    "//android_webview:libwebviewchromium__jni_registration($webview_toolchain)",
+    "//third_party/crashpad/crashpad/handler:crashpad_handler_trampoline",
+  ]
+
+  jar_excluded_patterns = [
+    "META-INF/*",
+    "android/*",
+    "androidx/*",
+    "com/google/*",
+    "java/*",
+    "javax/*",
+    "kotlin/*",
+    "kotlinx/*",
+    "org/jspecify/*",
+    "org/jetbrains/*",
+    # kotlinx-coroutines internal classes and intellij annotations bundled by
+    # kotlin-stdlib / jspecify; the consumer provides them via androidx-deps.jar.
+    "_COROUTINE/*",
+    "org/intellij/*",
+    # com/afree/demo/R comes from afree_demo_apk_unsigned__compile_resources;
+    # the Gradle demo generates its own com.afree.demo.R, so drop it to avoid a
+    # duplicate-class error.
+    "com/afree/demo/*",
+  ]
+
+  # Exclude all resources. Chromium's raw resource zips are designed for the GN
+  # AAPT (with overlay merging) and have attr overlaps with androidx that plain
+  # Gradle AAPT2 rejects as "Duplicate resources". The demo is fully
+  # programmatic UI and does not need chromium's res at runtime.
+  resource_excluded_patterns = [ "*" ]
+
+  output = "$root_build_dir/apks/afree_webview.aar"
+}
