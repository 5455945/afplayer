+# ProGuard configuration for the afree WebView AAR.
+#
+# Keep all public API classes in the com.afree.webkit and com.afree.chromium
+# packages, as well as the init class, so they are not obfuscated or removed
+# by consumers' ProGuard/R8 minification.
+
+-keep class org.chromium.content_public.app.** { *; }
+-keep class org.chromium.content.app.** { *; }
+
+# Keep all com.afree.webkit public API classes
+-keep public class com.afree.webkit.** { public *; }
+
+# Keep all com.afree.chromium public API classes
+-keep public class com.afree.chromium.** { public *; }
+
+# Keep the init class entirely (it is referenced by name from Application)
+-keep class com.afree.AfreeWebViewInit { *; }
