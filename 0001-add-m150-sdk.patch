+++ b/android_webview/afree/demo/src/main/java/com/afree/demo/AfreeWebView.java
@@ -0,0 +1,384 @@
+package com.afree.demo;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.util.Log;
+import android.view.MotionEvent;
+import android.view.View;
+import android.widget.FrameLayout;
+
+/**
+ * WebView wrapper that can switch between the afree engine
+ * (com.afree.webkit.WebView) and the system engine (android.webkit.WebView).
+ *
+ * Both engines expose a nearly identical API (com.afree.webkit.* was ported
+ * from AOSP android.webkit.*), so this class abstracts the difference behind a
+ * single interface and bridges WebViewClient/WebChromeClient callbacks through
+ * {@link Listener}.
+ */
+@SuppressWarnings("deprecation")
+public abstract class AfreeWebView extends FrameLayout {
+
+    /** Callbacks that MainActivity needs (URL bar / progress / title / errors). */
+    public interface Listener {
+        void onPageStarted(String url);
+        void onPageFinished(String url);
+        void onProgressChanged(int progress);
+        void onReceivedTitle(String title);
+        void onReceivedError(String description);
+        void onShowCustomView(View view);
+        void onHideCustomView();
+    }
+
+    private Listener mListener;
+
+    protected AfreeWebView(Context context) {
+        super(context);
+    }
+
+    public void setListener(Listener listener) {
+        mListener = listener;
+    }
+
+    protected Listener getListener() {
+        return mListener;
+    }
+
+    private static final String TAG = "AfreeDemo";
+
+    @Override
+    public boolean dispatchHoverEvent(MotionEvent ev) {
+        Log.i(TAG, "WRAP dispatchHover action=" + ev.getActionMasked()
+                + " x=" + (int) ev.getX() + " y=" + (int) ev.getY());
+        return super.dispatchHoverEvent(ev);
+    }
+
+    @Override
+    public boolean dispatchGenericMotionEvent(MotionEvent ev) {
+        Log.i(TAG, "WRAP dispatchGenericMotion action=" + ev.getActionMasked()
+                + " src=0x" + Integer.toHexString(ev.getSource()));
+        return super.dispatchGenericMotionEvent(ev);
+    }
+
+    @Override
+    public boolean onHoverEvent(MotionEvent ev) {
+        Log.i(TAG, "WRAP onHover action=" + ev.getActionMasked()
+                + " x=" + (int) ev.getX() + " y=" + (int) ev.getY());
+        return super.onHoverEvent(ev);
+    }
+
+    // ---- unified API (delegated by each impl) ----
+
+    public abstract void loadUrl(String url);
+
+    public abstract void loadDataWithBaseURL(String baseUrl, String data,
+            String mimeType, String encoding, String historyUrl);
+
+    public abstract void setUserAgentString(String ua);
+
+    public abstract boolean canGoBack();
+
+    public abstract void goBack();
+
+    public abstract void onPause();
+
+    public abstract void onResume();
+
+    public abstract void destroyWebView();
+
+    /** Enables private (incognito-like) browsing: no cache, no cookies, no
+     *  persistent DOM storage. */
+    public abstract void setPrivateMode(boolean enabled);
+
+    /** Expose a Java object to page JavaScript as window.&lt;name&gt;. */
+    public abstract void addJavascriptInterface(Object obj, String name);
+
+    /** Leave HTML5 fullscreen initiated by the page (calls the saved callback). */
+    public abstract void exitHtml5Fullscreen();
+
+    /** @param useAfree true to use com.afree.webkit.WebView, false for android.webkit.WebView */
+    public static AfreeWebView create(Context context, boolean useAfree) {
+        return useAfree ? new AfreeImpl(context) : new SystemImpl(context);
+    }
+
+    // ==================== System engine ====================
+
+    static class SystemImpl extends AfreeWebView {
+        private final android.webkit.WebView mWebView;
+        private android.webkit.WebChromeClient.CustomViewCallback mCustomCallback;
+
+        SystemImpl(Context context) {
+            super(context);
+            mWebView = new android.webkit.WebView(context);
+            configure();
+            addView(mWebView, new FrameLayout.LayoutParams(
+                    FrameLayout.LayoutParams.MATCH_PARENT,
+                    FrameLayout.LayoutParams.MATCH_PARENT));
+        }
+
+        private void configure() {
+            android.webkit.WebSettings s = mWebView.getSettings();
+            s.setJavaScriptEnabled(true);
+            s.setDomStorageEnabled(true);
+            s.setSupportZoom(true);
+            s.setBuiltInZoomControls(true);
+            s.setDisplayZoomControls(false);
+            s.setUseWideViewPort(true);
+            s.setLoadWithOverviewMode(true);
+            s.setCacheMode(android.webkit.WebSettings.LOAD_DEFAULT);
+            s.setMixedContentMode(android.webkit.WebSettings.MIXED_CONTENT_ALWAYS_ALLOW);
+            s.setAllowFileAccess(true);
+            s.setAllowContentAccess(true);
+            s.setMediaPlaybackRequiresUserGesture(false);
+
+            mWebView.setWebViewClient(new android.webkit.WebViewClient() {
+                @Override
+                public boolean shouldOverrideUrlLoading(android.webkit.WebView view,
+                        android.webkit.WebResourceRequest request) {
+                    String scheme = request.getUrl().getScheme();
+                    if (scheme != null
+                            && (scheme.equals("http") || scheme.equals("https"))) {
+                        view.loadUrl(request.getUrl().toString());
+                    }
+                    return true;
+                }
+
+                @Override
+                public void onPageStarted(android.webkit.WebView view, String url,
+                        Bitmap favicon) {
+                    if (getListener() != null) getListener().onPageStarted(url);
+                }
+
+                @Override
+                public void onPageFinished(android.webkit.WebView view, String url) {
+                    if (getListener() != null) getListener().onPageFinished(url);
+                }
+
+                @Override
+                public void onReceivedError(android.webkit.WebView view, int errorCode,
+                        String description, String failingUrl) {
+                    String scheme = android.net.Uri.parse(failingUrl).getScheme();
+                    if (scheme != null
+                            && !(scheme.equals("http") || scheme.equals("https"))) {
+                        if (mWebView.canGoBack()) mWebView.goBack();
+                        return;
+                    }
+                    if (getListener() != null) getListener().onReceivedError(description);
+                }
+            });
+
+            mWebView.setWebChromeClient(new android.webkit.WebChromeClient() {
+                @Override
+                public void onProgressChanged(android.webkit.WebView view, int newProgress) {
+                    if (getListener() != null) getListener().onProgressChanged(newProgress);
+                }
+
+                @Override
+                public void onReceivedTitle(android.webkit.WebView view, String title) {
+                    if (getListener() != null) getListener().onReceivedTitle(title);
+                }
+
+                @Override
+                public void onShowCustomView(View view,
+                        android.webkit.WebChromeClient.CustomViewCallback callback) {
+                    mCustomCallback = callback;
+                    if (getListener() != null) getListener().onShowCustomView(view);
+                }
+
+                @Override
+                public void onShowCustomView(View view, int requestedOrientation,
+                        android.webkit.WebChromeClient.CustomViewCallback callback) {
+                    mCustomCallback = callback;
+                    if (getListener() != null) getListener().onShowCustomView(view);
+                }
+
+                @Override
+                public void onHideCustomView() {
+                    mCustomCallback = null;
+                    if (getListener() != null) getListener().onHideCustomView();
+                }
+            });
+        }
+
+        @Override public void exitHtml5Fullscreen() {
+            if (mCustomCallback != null) {
+                mCustomCallback.onCustomViewHidden();
+                mCustomCallback = null;
+            }
+        }
+
+        @Override public void loadUrl(String url) { mWebView.loadUrl(url); }
+
+        @Override
+        public void loadDataWithBaseURL(String baseUrl, String data, String mimeType,
+                String encoding, String historyUrl) {
+            mWebView.loadDataWithBaseURL(baseUrl, data, mimeType, encoding, historyUrl);
+        }
+
+        @Override public void setUserAgentString(String ua) {
+            mWebView.getSettings().setUserAgentString(ua);
+        }
+
+        @Override public boolean canGoBack() { return mWebView.canGoBack(); }
+        @Override public void goBack() { mWebView.goBack(); }
+        @Override public void onPause() { mWebView.onPause(); }
+        @Override public void onResume() { mWebView.onResume(); }
+        @Override public void destroyWebView() { mWebView.destroy(); }
+
+        @Override public void addJavascriptInterface(Object obj, String name) {
+            mWebView.addJavascriptInterface(obj, name);
+        }
+
+        @Override public void setPrivateMode(boolean enabled) {
+            if (!enabled) return;
+            // per-session data-directory isolation + cleanup is done in
+            // MainActivity.setupPrivateSession(), so we must NOT disable the process-global
+            // CookieManager here (that would also affect non-private WebViews).
+            android.webkit.WebSettings s = mWebView.getSettings();
+            s.setCacheMode(android.webkit.WebSettings.LOAD_NO_CACHE);
+            s.setSaveFormData(false);
+            s.setSavePassword(false);
+        }
+    }
+
+    // ==================== afree engine ====================
+
+    static class AfreeImpl extends AfreeWebView {
+        private final com.afree.webkit.WebView mWebView;
+        private com.afree.webkit.WebChromeClient.CustomViewCallback mCustomCallback;
+
+        AfreeImpl(Context context) {
+            super(context);
+            mWebView = new com.afree.webkit.WebView(context);
+            configure();
+            addView(mWebView, new FrameLayout.LayoutParams(
+                    FrameLayout.LayoutParams.MATCH_PARENT,
+                    FrameLayout.LayoutParams.MATCH_PARENT));
+        }
+
+        private void configure() {
+            com.afree.webkit.WebSettings s = mWebView.getSettings();
+            s.setJavaScriptEnabled(true);
+            s.setDomStorageEnabled(true);
+            s.setSupportZoom(true);
+            s.setBuiltInZoomControls(true);
+            s.setDisplayZoomControls(false);
+            s.setUseWideViewPort(true);
+            s.setLoadWithOverviewMode(true);
+            s.setCacheMode(com.afree.webkit.WebSettings.LOAD_NORMAL);
+            s.setMixedContentMode(com.afree.webkit.WebSettings.MIXED_CONTENT_ALWAYS_ALLOW);
+            s.setAllowFileAccess(true);
+            s.setAllowContentAccess(true);
+            s.setMediaPlaybackRequiresUserGesture(false);
+
+            mWebView.setWebViewClient(new com.afree.webkit.WebViewClient() {
+                @Override
+                public boolean shouldOverrideUrlLoading(com.afree.webkit.WebView view,
+                        com.afree.webkit.WebResourceRequest request) {
+                    String scheme = android.net.Uri.parse(request.getUrl()).getScheme();
+                    if (scheme != null
+                            && (scheme.equals("http") || scheme.equals("https"))) {
+                        view.loadUrl(request.getUrl());
+                    }
+                    return true;
+                }
+
+                @Override
+                public void onPageStarted(com.afree.webkit.WebView view, String url,
+                        Bitmap favicon) {
+                    if (getListener() != null) getListener().onPageStarted(url);
+                }
+
+                @Override
+                public void onPageFinished(com.afree.webkit.WebView view, String url) {
+                    if (getListener() != null) getListener().onPageFinished(url);
+                }
+
+                @Override
+                public void onReceivedError(com.afree.webkit.WebView view, int errorCode,
