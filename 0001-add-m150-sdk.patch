+def tap_bounds(device, b, note):
+    x = (b[0] + b[2]) // 2
+    y = (b[1] + b[3]) // 2
+    adb_shell(device, "input tap %d %d" % (x, y))
+    print("[media]     gesture: tap %s (%d,%d)" % (note, x, y), flush=True)
+    time.sleep(1.3)
+
+
+def uia_tap_controls(device, keys, note, maxn=8, pause=1.0):
+    """Dump UI -> find nodes containing keys -> tap each (up to maxn). Returns tap count."""
+    ui = ui_dump(device)
+    if ui is None:
+        print("[media]     uia dump unavailable, skipping: %s" % note, flush=True)
+        return 0
+    nodes = ui_find(ui, keys)
+    if not nodes:
+        print("[media]     uia: %s not found" % note, flush=True)
+        return 0
+    for b, t, d in nodes[:maxn]:
+        tap_bounds(device, b, "%s [uia %r]" % (note, t or d))
+        time.sleep(pause)
+    return min(len(nodes), maxn)
