+package com.afree.webkit;
+
+/**
+ * Afree SDK fork note.
+ *
+ * Original source: AOSP android.webkit.JsResult (android-16.0.0_r4)
+ * Purpose: JS result
+ */
+
+import android.os.Handler;
+import android.os.Message;
+
+public class JsResult {
+    private final ResultReceiver mReceiver;
+
+    public interface ResultReceiver {
+        void onJsResultComplete(JsResult result);
+    }
+
+    public JsResult(ResultReceiver receiver) {
+        mReceiver = receiver;
+    }
+
+    public void cancel() {
+        mResult = true;
+        wakeUp();
+    }
+
+    public void confirm() {
+        mResult = true;
+        wakeUp();
+    }
+
+    public boolean getResult() { return mResult; }
+
+    private boolean mResult;
+    private boolean mReady;
+
+    private synchronized void wakeUp() {
+        mReady = true;
+        notifyAll();
+    }
+
+    private synchronized void handleDefault() {
+        if (mReady) return;
+        mResult = false;
+        mReady = true;
+        notifyAll();
+    }
+
+    public final void setReady() {
+        wakeUp();
+    }
+
+    final synchronized boolean getReady() {
+        return mReady;
+    }
+}
