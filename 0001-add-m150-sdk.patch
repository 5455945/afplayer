index 0000000000..1d6ea3f2bf
--- /dev/null
+++ b/android_webview/afree/tools/screenshot_analyze.py
@@ -0,0 +1,254 @@
+#!/usr/bin/env python3
+"""
+Vehicle WebView rendering analysis tool.
+
+Purpose: perform pixel-level analysis on adb screenshots (PNG) without depending
+on PIL/ImageMagick (useful for vehicle head-unit debugging and servers), to
+determine whether WebView rendering is normal and whether video is on screen.
+
+How it works:
+  1. PNG parsing: manually parse the PNG file structure using the Python stdlib
+     (struct + zlib), extract IHDR (dimensions) and IDAT (image data), then
+     zlib-decompress to obtain the raw pixels.
+  2. Pixel analysis: perform color statistics and content-region detection on
+     the decompressed RGBA pixels.
+
+Usage:
+  # 1. Capture a screenshot on the vehicle
+  adb -s <device> shell screencap -p /sdcard/s.png
+  adb -s <device> pull /sdcard/s.png ./s.png
+
+  # 2. Analyze
+  python3 screenshot_analyze.py s.png
+  python3 screenshot_analyze.py s.png --rows      # per-row non-black ratio (locate content region)
+  python3 screenshot_analyze.py s.png --skin      # skin-tone detection (video person frame)
+  python3 screenshot_analyze.py s.png --links     # blue-link detection (WebView link list)
+"""
+
+import argparse
+import struct
+import sys
+import zlib
+from collections import Counter
+
+
+def parse_png(path):
+    """Parse a PNG, returning (width, height, bpp, raw_pixels).
+
+    raw_pixels is the DEFILTERED raw data (PNG filter byte already applied);
+    each row is [filter_byte][row_pixels...], with RGBA 4 bytes per pixel (or
+    RGB 3 bytes). Defiltering is required because screencap on the head unit
+    emits Sub/Up/Average/Paeth filters (not just None).
+    """
+    with open(path, "rb") as f:
+        data = f.read()
+
+    # Verify the PNG magic number
+    if data[:8] != b"\x89PNG\r\n\x1a\n":
+        raise ValueError("not a valid PNG file")
+
+    # Parse IHDR (width/height)
+    # PNG structure: [8-byte magic][4-byte length][4-byte type "IHDR"][data][4-byte CRC]
+    width = struct.unpack(">I", data[16:20])[0]
+    height = struct.unpack(">I", data[20:24])[0]
+    bit_depth = data[24]
+    color_type = data[25]
+
+    # Color type: 0=grayscale 2=RGB 3=indexed 4=grayscale+alpha 6=RGBA
+    if color_type == 6:  # RGBA
+        bpp = 4
+    elif color_type == 2:  # RGB
+        bpp = 3
+    elif color_type == 0:  # grayscale
+        bpp = 1
+    else:
+        raise ValueError(f"unsupported color type color_type={color_type}")
+
+    # Extract all IDAT chunks
+    idat = bytearray()
+    i = 8
+    while i < len(data):
+        length = struct.unpack(">I", data[i : i + 4])[0]
+        chunk_type = data[i + 4 : i + 8]
+        if chunk_type == b"IDAT":
+            idat += data[i + 8 : i + 8 + length]
+        i += 12 + length  # 4 length + 4 type + data + 4 CRC
+
+    raw = zlib.decompress(bytes(idat))
+    return width, height, bpp, defilter(raw, width, height, bpp)
+
+
+def paeth_predictor(a, b, c):
+    p = a + b - c
+    pa = abs(p - a)
+    pb = abs(p - b)
+    pc = abs(p - c)
+    if pa <= pb and pa <= pc:
+        return a
+    if pb <= pc:
+        return b
+    return c
+
+
+def defilter(raw, width, height, bpp):
+    """Reverse the PNG scanline filters (None/Sub/Up/Average/Paeth) in-place."""
+    stride = width * bpp + 1
+    out = bytearray(raw)
+    for y in range(height):
+        row_start = y * stride
+        filter_type = raw[row_start]
+        for i in range(1, stride):
+            cur = raw[row_start + i]
+            left = out[row_start + i - bpp] if i - bpp >= 1 else 0
+            up = out[row_start - stride + i] if y > 0 else 0
+            up_left = (
+                out[row_start - stride + i - bpp]
+                if (y > 0 and i - bpp >= 1)
+                else 0
+            )
+            if filter_type == 0:  # None
+                val = cur
+            elif filter_type == 1:  # Sub
+                val = (cur + left) & 0xFF
+            elif filter_type == 2:  # Up
+                val = (cur + up) & 0xFF
+            elif filter_type == 3:  # Average
+                val = (cur + ((left + up) >> 1)) & 0xFF
+            elif filter_type == 4:  # Paeth
+                val = (cur + paeth_predictor(left, up, up_left)) & 0xFF
+            else:
+                val = cur
+            out[row_start + i] = val
+    return out
+
+
+def iter_pixels(width, height, bpp, raw, step_x=1, step_y=1):
+    """Iterate pixels, yielding (x, y, (r, g, b)).
+
+    raw is already defiltered (see parse_png); each row still has a leading
+    filter byte that we skip.
+    """
+    stride = width * bpp + 1  # per row: filter byte + pixels
+    for y in range(0, height, step_y):
+        row_start = y * stride
+        if row_start + 1 >= len(raw):
+            break
+        for x in range(0, width, step_x):
+            off = row_start + 1 + x * bpp
+            if off + bpp - 1 < len(raw):
+                r = raw[off]
+                g = raw[off + 1] if bpp >= 2 else r
+                b = raw[off + 2] if bpp >= 3 else r
+                yield x, y, (r, g, b)
+
+
+def analyze_colors(path, top_n=8):
+    """Compute the color distribution, returning (width, height, color_count, TopN colors)."""
+    w, h, bpp, raw = parse_png(path)
+    colors = Counter()
+    for x, y, c in iter_pixels(w, h, bpp, raw, step_x=2, step_y=2):
+        colors[c] += 1
+    return w, h, len(colors), colors.most_common(top_n), colors
+
+
+def cmd_default(args):
+    w, h, cnt, top, colors = analyze_colors(args.path)
+    total = sum(colors.values())
+    nonblack = sum(n for c, n in colors.items() if max(c) > 40)
+    print(f"size: {w}x{h}")
+    print(f"sampled colors: {cnt}")
+    print(f"non-black ratio: {100 * nonblack / total:.1f}%")
+    print(f"Top {args.top} colors:")
+    for c, n in top:
+        print(f"  RGB{c} x{n}")
+
+
+def cmd_rows(args):
+    """Per-row non-black ratio, used to locate content regions (video frame, link list, etc.)."""
+    w, h, bpp, raw = parse_png(args.path)
+    stride = w * bpp + 1
+    for y in range(0, h, args.step):
+        rs = y * stride
+        if rs + 1 >= len(raw):
+            break
+        nonblack = 0
+        total = 0
+        for x in range(0, w, 4):
+            off = rs + 1 + x * bpp
+            if off + bpp - 1 < len(raw):
+                r = raw[off]
+                g = raw[off + 1] if bpp >= 2 else r
+                b = raw[off + 2] if bpp >= 3 else r
+                total += 1
+                if max(r, g, b) > 40:
+                    nonblack += 1
+        if total > 0 and nonblack / total > args.threshold:
+            print(f"y={y}: non-black {100 * nonblack / total:.1f}%")
+
+
+def cmd_skin(args):
+    """Skin-tone detection: determine whether a video frame contains a person.
+
+    Skin-tone features: R > 100 and R > G > B and (R-B) > 20 (common skin range).
+    """
+    w, h, bpp, raw = parse_png(args.path)
+    skin = 0
+    total = 0
+    for x, y, c in iter_pixels(w, h, bpp, raw, step_x=2, step_y=2):
+        r, g, b = c
+        total += 1
+        if r > 100 and r > g > b and (r - b) > 20:
+            skin += 1
+    print(f"skin pixels: {skin} (sampled {total})")
+    print("result: " + ("person frame detected" if skin > 50 else "no obvious person frame"))
+
+
+def cmd_links(args):
+    """Blue-link detection: WebView page links are usually blue text near RGB(0,0,238)."""
+    w, h, bpp, raw = parse_png(args.path)
+    blues = []
+    for x, y, c in iter_pixels(w, h, bpp, raw, step_x=2, step_y=2):
+        r, g, b = c
+        if b > 200 and r < 50 and g < 50:
+            blues.append((x, y))
+    if not blues:
+        print("no blue links found")
+        return
+    # Cluster by y (merge adjacent rows)
+    ys = sorted(set(p[1] for p in blues))
+    merged = []
+    for y in ys:
+        xs = [p[0] for p in blues if p[1] == y]
+        x1, x2 = min(xs), max(xs)
+        if merged and y - merged[-1][0] <= 20:
+            merged[-1] = (merged[-1][0], min(merged[-1][1], x1), max(merged[-1][2], x2))
+        else:
+            merged.append((y, x1, x2))
+    print(f"blue links: {len(merged)}")
+    for y, x1, x2 in merged:
+        print(f"  y={y}, x={x1}-{x2}, center=({(x1 + x2) // 2}, {y})")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Vehicle WebView rendering analysis tool")
+    parser.add_argument("path", help="PNG screenshot path")
+    parser.add_argument("--rows", action="store_true", help="per-row non-black ratio (locate content region)")
+    parser.add_argument("--skin", action="store_true", help="skin-tone detection (video person frame)")
+    parser.add_argument("--links", action="store_true", help="blue-link detection (WebView link list)")
+    parser.add_argument("--top", type=int, default=8, help="Top N colors (default 8)")
+    parser.add_argument("--step", type=int, default=30, help="row-statistics step (default 30)")
+    parser.add_argument("--threshold", type=float, default=0.01, help="non-black threshold (default 0.01=1%%)")
+    args = parser.parse_args()
+
+    if args.rows:
+        cmd_rows(args)
+    elif args.skin:
+        cmd_skin(args)
+    elif args.links:
+        cmd_links(args)
+    else:
+        cmd_default(args)
+
+
+if __name__ == "__main__":
+    main()
