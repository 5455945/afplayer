@@ -0,0 +1,2037 @@
+#!/usr/bin/env python3
+# =============================================================================
+# media_test.py — afree demo audio/video playback test (standalone case)
+#
+# Defaults: edit DEFAULT_UA / DEFAULT_URLS at the top of this file.
+# Overrides: --ua overrides DEFAULT_UA; an --url that duplicates a default is not tested twice;
+#           extra urls are tested too (union of DEFAULT_URLS + extra urls).
+#
+# Behavior: for each url, launch the demo with the ua, then start playback in a
+#           media-aware way (no random/blind tapping): if the page actually has a
+#           <video>/<audio> element, play it (CDP, user gesture); otherwise click a
+#           visible play control / content tab (discovered by text via CDP/uia).
+#           Then confirm sustained playback for `sustain` seconds (signals keep growing).
+#         - video: ForwardVideoFrame in logcat (renderer video frame on screen)
+#         - audio: AudioTrack/AAudioStream/onMoreData in this app's process,
+#                 or AudioPlaybackConfiguration state:started for this uid in dumpsys audio
+#           If a tap shows the IME (mInputShown=true), send BACK to close it and continue
+#           (while shown, BACK only closes the IME, it does not go back). Started + sustained = PASS.
+#           After started+sustained, run the gesture phase (visualized): play/pause, bar seek ff/rew,
+#           swipe ff/rew, swipe up/down, volume down/up/mute, next/prev, back home, switch tabs
+#           (WebView content has no enumerable controls, so use ratio coordinates; volume/mute via keyevent 24/25/164).
+#
+#         Site profiles (structure-driven, strict PASS/FAIL per action):
+#           bilibili H5 (vehicle-web):
+#             - left nav .bili-nav__tab (搜索/FM/视频/续播/我的); assert .active moves
+#             - 视频 tab -> .bili-video-horizontal card -> .bili-view.play in VIDEO mode
+#               (video.bili-video-player__core videoWidth>0, playing, currentTime advancing)
+#             - .bili-audio-button toggles VIDEO<->AUDIO (audio: .bili-audio-mask flex,
+#               core videoWidth==0, button "视频播放"; video: mask none, videoWidth>0, button "音频播放")
+#             - immersive vs non-immersive is DETECTED (controls 0x0 vs laid out); in
+#               immersive: right=forward/left=rewind, left-half up/down=brightness,
+#               right-half up/down=volume (both directions tried; gesture must be off-center).
+#               The brightness/volume HUD exists only DURING the swipe: poll the DOM while
+#               the finger is down (.bili-toast__text = "亮度: N%" / "音量: N%").
+#             - non-immersive (one tap): click pause/play; seek by DRAGGING the progress bar;
+#               next (.bili-next-button); episode if present
+#             - back to home (history.back, fallback system BACK)
+#           iqiyi /iv (Vue SPA; reacts to DOM click, not input tap):
+#             - top tabs .van-tab__text (推荐/电视剧/电影/...); assert .van-tab--active moves
+#             - .swiper-img-box card -> #/video page; assert <video> present + advancing
+#             - history.back() to home; assert the #/video route is gone
+#           Use --only <substr> to test just one site (e.g. --only bilibili).
+#
+# Usage:
+#   ./media_test.py --device 30.207.82.150:62464
+#   ./media_test.py --device <dev> --ua "..." --url "https://www.bing.com"
+#   ./media_test.py --device <dev> --runtime 20 --taps 8
+#   ./media_test.py --help
+#
+# Can also be invoked by verify_demo.sh (see its --media-test).
+# =============================================================================
+
+# Never emit __pycache__/*.pyc (e.g. for the lazily imported screenshot_analyze).
+import sys as _sys
+_sys.dont_write_bytecode = True
+
+import argparse
+import base64
+import json
+import os
+import random
+import re
+import shutil
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.request
+import xml.etree.ElementTree as ET
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+REPO_ROOT = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "..", ".."))
+
+PKG = "com.afree.demo"
+ACTIVITY = "com.afree.demo/.MainActivity"
+
+# =============================================================================
+# Default config (edit as needed; --ua / --url override or append).
+# =============================================================================
+DEFAULT_UA = (
+    "Mozilla/5.0 (Linux; Android 6.0.99; AS22L Build/YunOSBuildID) "
+    "AppleWebKit/537.36 (KHTML, like Gecko) Domono/3.0.0.0 "
+    "Chrome/150.0.7871.255 Mobile Safari/537.36 Edg/150.0.0.0"
+)
+DEFAULT_URLS = [
+    "https://www.iqiyi.com/iv#/?ver=bm_zj&dodge=true",
+    "https://www.bilibili.com/h5/vehicle-web/v2",
+]
+
+
+def find_adb():
+    a = shutil.which("adb")
+    if a:
+        return a
+    p = os.path.join(REPO_ROOT, "third_party/android_sdk/public/platform-tools/adb")
+    return p if os.path.exists(p) else "adb"
+
+
+ADB = find_adb()
+
+
+def run(argv, timeout=30):
+    try:
+        # NOTE: avoid capture_output= (Python 3.7+); keep Python 3.6 compatibility.
+        r = subprocess.run([ADB] + argv, stdout=subprocess.PIPE,
+                           stderr=subprocess.PIPE, timeout=timeout)
+        return (r.returncode,
+                r.stdout.decode("utf-8", "replace"),
+                r.stderr.decode("utf-8", "replace"))
+    except subprocess.TimeoutExpired:
+        return 124, "", "timeout"
+
+
+def adb_shell(device, cmd, timeout=30):
+    return run(["-s", device, "shell", cmd], timeout)
+
+
+def app_uid(device):
+    rc, out, _ = adb_shell(device, "cmd package list packages -U %s" % PKG)
+    for tok in out.replace("\n", " ").split():
+        if tok.startswith("uid:"):
+            return tok[4:]
+    return ""
+
+
+def screen_size(device):
+    rc, out, _ = adb_shell(device, "wm size")
+    m = re.findall(r"(\d+)x(\d+)", out)
+    if m:
+        w, h = m[-1]
+        return int(w), int(h)
+    return 1920, 720
+
+
+def audio_playing(device, uid):
+    """dumpsys audio: whether this uid has a state:started playback config."""
+    if not uid:
+        return False
+    rc, out, _ = adb_shell(device, "dumpsys audio", timeout=20)
+    needle = "u/pid:%s/" % uid
+    for line in out.splitlines():
+        if ("AudioPlaybackConfiguration" in line and needle in line
+                and "state:started" in line):
+            return True
+    return False
+
+
+def app_pids(device):
+    """pid set of the demo main process + sandboxed render process."""
+    rc, out, _ = adb_shell(device, "ps -A -o PID,NAME", timeout=20)
+    pids = set()
+    for line in out.splitlines():
+        if PKG in line:
+            parts = line.split()
+            if parts and parts[0].isdigit():
+                pids.add(parts[0])
+    return pids
+
+
+MEDIA_VIDEO = ("ForwardVideoFrame",)
+MEDIA_AUDIO = ("AudioTrack", "AAudioStream", "onMoreData", "audio_hw_generic")
+MEDIA_CODEC = ("MediaCodec", "CCodec", "c2.android", "c2.google")
+
+
+def scan_log(log, pids):
+    """Count only log lines belonging to demo processes: returns (video frame lines, audio lines, codec lines)."""
+    v = a = c = 0
+    for line in log.splitlines():
+        parts = line.split(None, 5)
+        if len(parts) < 3:
+            continue
+        if parts[2] not in pids:
+            continue
+        if any(p in line for p in MEDIA_VIDEO):
+            v += 1
+        if any(p in line for p in MEDIA_AUDIO):
+            a += 1
+        if any(p in line for p in MEDIA_CODEC):
+            c += 1
+    return v, a, c
+
+
+def ime_shown(device):
+    """Whether the soft keyboard is shown."""
+    rc, out, _ = adb_shell(device, "dumpsys input_method 2>/dev/null | grep -oE 'mInputShown=[a-z]+' | head -1")
+    return "mInputShown=true" in out
+
+
+def dismiss_ime(device):
+    """When the soft keyboard is shown, press BACK to close it (BACK only closes the IME, it does not go back)."""
+    if ime_shown(device):
+        adb_shell(device, "input keyevent 4")
+        print("[media]     IME shown -> BACK to dismiss", flush=True)
+        time.sleep(1)
+
+
+def has_media(cdp):
+    """True if the page currently has a <video>/<audio> element (CDP)."""
+    if not cdp:
+        return False
+    try:
+        return int(cdp.eval("document.querySelectorAll('video,audio').length") or 0) > 0
+    except Exception:
+        return False
+
+
+def signals(device, uid):
+    """Returns (video frame lines, audio lines, codec lines, whether this uid is playing via dumpsys audio)."""
+    rc, log, _ = run(["-s", device, "logcat", "-d"], timeout=40)
+    pids = app_pids(device)
+    v, a, c = scan_log(log, pids)
+    return v, a, c, audio_playing(device, uid)
+
+
+def set_touch_visual(device, on):
+    """Enable/disable tap visualization: show_touches=1 shows a white circle at the tap point;
+    pointer_location draws a distracting top coordinate bar, so it is always off."""
+    v = "1" if on else "0"
+    adb_shell(device, "settings put system show_touches %s" % v)
+    adb_shell(device, "settings put system pointer_location 0")
+
+
+def fullscreen_state(device):
+    """Count demo fullscreen/handle/toolbar events from logcat (MainActivity AfreeDemo logs)."""
+    rc, log, _ = run(["-s", device, "logcat", "-d"], timeout=40)
+    return (log.count("FULLSCREEN on"), log.count("FULLSCREEN off"),
+            log.count("HANDLE show"), log.count("HANDLE hide"),
+            log.count("TOOLBAR show"), log.count("TOOLBAR hide"))
+
+
+def html5_fullscreen_state(device):
+    """Count HTML5 fullscreen events in logcat (demo AfreeDemo logs)."""
+    rc, log, _ = run(["-s", device, "logcat", "-d"], timeout=40)
+    return log.count("HTML5 FULLSCREEN show"), log.count("HTML5 FULLSCREEN hide")
+
+
+def activity_delta(device, uid, secs):
+    """Clear logcat, wait secs, and return this app progress audio/video activity line count (for play/pause)."""
+    run(["-s", device, "logcat", "-c"])
+    time.sleep(secs)
+    v, a, c, au = signals(device, uid)
+    return v + a
+
+
+def media_volume(device):
+    """Read STREAM_MUSIC streamVolume (to verify the volume keys work)."""
+    rc, out, _ = adb_shell(device, "dumpsys audio", timeout=20)
+    inblk = False
+    for line in out.splitlines():
+        if "- STREAM_MUSIC:" in line:
+            inblk = True
+            continue
+        if inblk:
+            if line.strip().startswith("- STREAM_"):
+                break
+            if "streamVolume:" in line:
+                return line.split("streamVolume:")[1].strip()
+    return ""
+
+
+def detect_progress_bar(device):
+    """Find the progress-bar fill in the bottom area of the screen (a uniform theme-colored bar),
+    returning (y, x1, x2, len). Uniform color filters out the video image (which is noisy).
+    Screenshots use "save PNG on device + pull" to avoid exec-out stalling/mixing in warnings."""
+    remote = "/data/local/tmp/afree_bar.png"
+    rc, _o, _e = adb_shell(device, "screencap -p %s" % remote, timeout=25)
+    fd, local = tempfile.mkstemp(suffix=".png")
+    os.close(fd)
+    run(["-s", device, "pull", remote, local], timeout=30)
+    try:
+        tools = os.path.join(REPO_ROOT, "android_webview", "afree", "tools")
+        if not os.path.isdir(tools):
+            # portable bundle rooted at "afree/" (demo and tools are siblings)
+            tools = os.path.normpath(os.path.join(SCRIPT_DIR, "..", "tools"))
+        if tools not in sys.path:
+            sys.path.insert(0, tools)
+        import screenshot_analyze as sa
+        w, h, bpp, raw = sa.parse_png(local)
+    except Exception as e:
+        print("[media]     screencap parse failed: %s" % e, flush=True)
+        return None
+    finally:
+        try:
+            os.unlink(local)
+        except Exception:
+            pass
+
+    stride = w * bpp + 1
+    best = None
+    for y in range(int(h * 0.78), int(h * 0.90), 2):
+        row = y * stride
+        run_start = None
+        run_len = 0
+        x = 0
+        while x < w:
+            o = row + 1 + x * bpp
+            if o + bpp - 1 < len(raw):
+                r_, g_, b_ = raw[o], raw[o + 1], raw[o + 2]
+                mx, mn = max(r_, g_, b_), min(r_, g_, b_)
+            else:
+                mx = mn = 0
+            if mx - mn > 60 and mx > 90:
+                if run_start is None:
+                    run_start = x
+                run_len += 1
+            else:
+                if run_start is not None and run_len >= 30:
+                    cols = set()
+                    step = max(1, (x - run_start) // 12)
+                    for xx in range(run_start, x, step):
+                        oo = row + 1 + xx * bpp
+                        cols.add((raw[oo], raw[oo + 1], raw[oo + 2]))
+                    if len(cols) <= 3 and (best is None or run_len > best[3]):
+                        best = (y, run_start, x - 2, run_len)
+                run_start = None
+                run_len = 0
+            x += 2
+    return best
+
+
+def _free_tcp_port():
+    """Return a free localhost TCP port (avoids conflicts, e.g. a local Chrome
+    already listening on the fixed 9222 used by `adb forward`)."""
+    s = socket.socket()
+    s.bind(("127.0.0.1", 0))
+    port = s.getsockname()[1]
+    s.close()
+    return port
+
