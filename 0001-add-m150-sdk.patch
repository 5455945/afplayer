+            float startY;
+            @Override public boolean onTouch(View view, MotionEvent e) {
+                switch (e.getActionMasked()) {
+                    case MotionEvent.ACTION_DOWN:
+                        startY = e.getRawY();
+                        return true;
+                    case MotionEvent.ACTION_MOVE:
+                        return true;
+                    case MotionEvent.ACTION_UP:
+                        if (e.getRawY() - startY > dp(40)) {
+                            // Pull-down = hide the whole APK (move to background/home), not navigate back.
+                            if (mCustomView != null) mWebView.exitHtml5Fullscreen();
+                            Log.i(TAG, "DRAG down -> moveTaskToBack (hide APK)");
+                            moveTaskToBack(true);
+                        } else {
+                            revealHandle();
+                        }
+                        return true;
+                }
+                return false;
+            }
+        });
+        return v;
+    }
+
+    private void enterFullscreen() {
+        mFullscreen = true;
+        Log.i(TAG, "FULLSCREEN on");
+        hideToolbarAnimated();
+        revealHandle();
+    }
+
+    private void exitFullscreen() {
+        mFullscreen = false;
+        mHandler.removeCallbacks(mHideHandle);
+        mHandler.removeCallbacks(mHideToolbar);
+        showToolbarAnimated();
+        if (mDragHandle != null) {
+            mDragHandle.setVisibility(View.VISIBLE);
+            mDragHandle.setAlpha(0.25f);
+        }
+        Log.i(TAG, "FULLSCREEN off");
+    }
+
+    /** Page requested HTML5 fullscreen: add the page-provided video View to the
+     *  content area and hide the address bar. */
+    private void enterHtml5Fullscreen(View view) {
+        if (mCustomView != null || view == null) return;
+        mCustomView = view;
+        mContent.addView(view, new FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.MATCH_PARENT,
+                FrameLayout.LayoutParams.MATCH_PARENT));
+        mWebView.setVisibility(View.GONE);
+        enterFullscreen();
+        Log.i(TAG, "HTML5 FULLSCREEN show");
+    }
+
+    private void exitHtml5Fullscreen() {
+        if (mCustomView == null) return;
+        mContent.removeView(mCustomView);
+        mCustomView = null;
+        mWebView.setVisibility(View.VISIBLE);
+        exitFullscreen();
+        Log.i(TAG, "HTML5 FULLSCREEN hide");
+    }
+
+    private void setToolbarHeight(int h) {
+        ViewGroup.LayoutParams lp = mToolbar.getLayoutParams();
+        if (lp == null) return;
+        lp.height = h;
+        mToolbar.setLayoutParams(lp);
+    }
+
+    private int measureToolbar() {
+        int w = (mRoot != null && mRoot.getWidth() > 0) ? mRoot.getWidth()
+                : getResources().getDisplayMetrics().widthPixels;
+        mToolbar.measure(View.MeasureSpec.makeMeasureSpec(w, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+        mToolbarHeight = mToolbar.getMeasuredHeight();
+        return mToolbarHeight;
+    }
+
+    /** Animate the address bar away: animate its height to 0 so the WebView expands to fullscreen. */
+    private void hideToolbarAnimated() {
+        mToolbar.setVisibility(View.VISIBLE);
+        mToolbarHeight = mToolbar.getHeight() > 0 ? mToolbar.getHeight() : measureToolbar();
+        ValueAnimator a = ValueAnimator.ofInt(mToolbar.getHeight(), 0);
+        a.setDuration(250);
+        a.addUpdateListener(an -> setToolbarHeight((int) an.getAnimatedValue()));
+        a.addListener(new AnimatorListenerAdapter() {
+            @Override public void onAnimationEnd(Animator animation) {
+                mToolbar.setVisibility(View.GONE);
+            }
+        });
+        a.start();
+        Log.i(TAG, "TOOLBAR hide");
+    }
+
+    /** Animate the address bar in: animate height from 0 back to the original so the WebView shrinks. */
+    private void showToolbarAnimated() {
+        mToolbar.setVisibility(View.VISIBLE);
+        int target = mToolbarHeight > 0 ? mToolbarHeight : measureToolbar();
+        ValueAnimator a = ValueAnimator.ofInt(mToolbar.getHeight(), target);
+        a.setDuration(250);
+        a.addUpdateListener(an -> setToolbarHeight((int) an.getAnimatedValue()));
+        a.start();
+        Log.i(TAG, "TOOLBAR show");
+    }
+
+    private void revealHandle() {
+        if (mDragHandle == null) return;
+        mDragHandle.setVisibility(View.VISIBLE);
+        mDragHandle.setAlpha(1.0f);
+        Log.i(TAG, "HANDLE show");
+        mHandler.removeCallbacks(mHideHandle);
+        mHandler.postDelayed(mHideHandle, 2000);
+    }
+
+    private void toggleFullscreenChrome() {
+        if (!mFullscreen) {
+            enterFullscreen();
+            return;
+        }
+        if (mToolbar.getVisibility() == View.VISIBLE) {
+            hideToolbarAnimated();
+        } else {
+            showToolbarAnimated();
+            mHandler.removeCallbacks(mHideToolbar);
+            mHandler.postDelayed(mHideToolbar, 2000);
+        }
+    }
+
+    /** (Re)install the <video> play/pause hook into the current page. */
+    private void injectVideoHook() {
+        if (mWebView == null) return;
+        mWebView.loadUrl("javascript:" + VIDEO_HOOK_JS);
+    }
+
+    /** JS bridge: page reports HTML5 media state so we can auto full-screen. */
+    private class VideoBridge {
+        @JavascriptInterface
+        public void onVideoEvent(String event) {
+            runOnUiThread(() -> {
+                if ("playing".equals(event)) {
+                    if (!mFullscreen) enterFullscreen();
+                } else if ("paused".equals(event) || "ended".equals(event)) {
+                    if (mFullscreen) exitFullscreen();
+                }
+            });
+        }
+    }
+
+    private void loadUrlFromBar() {
+        String url = mUrlBar.getText().toString().trim();
+        if (url.isEmpty()) return;
+        if (!url.startsWith("http://") && !url.startsWith("https://")
+                && !url.startsWith("file://")) {
+            url = "https://" + url;
+            mUrlBar.setText(url);
+        }
+        mProgressBar.setVisibility(View.VISIBLE);
+        mWebView.loadUrl(url);
+    }
+
+    // ==================== help / markdown ====================
+
+    private void showHelp() {
+        String mdContent = readMdContent("file:///android_asset/help.md");
+        if (mdContent != null) {
+            mWebView.loadDataWithBaseURL(null, mdToHtml(mdContent),
+                    "text/html", "UTF-8", null);
+            Log.i(TAG, "\n" + mdContent);
+        }
+    }
+
+    private String mdToHtml(String md) {
+        if (mdCss == null) mdCss = readAsset("md.css");
+        if (htmlTemplate == null) htmlTemplate = readAsset("template.html");
+        String body = mdRenderer.render(mdParser.parse(md));
+        String html = htmlTemplate.replace("{{style}}", mdCss).replace("{{body}}", body);
+        Log.i(TAG, "mdToHtml: cssLen=" + mdCss.length() + " tplLen=" + htmlTemplate.length()
+                + " bodyLen=" + body.length() + " htmlLen=" + html.length());
+        return html;
+    }
+
+    private String readMdContent(String url) {
+        InputStream is = null;
+        try {
+            if (url.startsWith("file:///android_asset/")) {
+                String assetPath = url.substring("file:///android_asset/".length());
+                is = getAssets().open(assetPath);
+            } else if (url.startsWith("file://")) {
+                is = new FileInputStream(new File(url.substring("file://".length())));
+            } else {
+                is = new FileInputStream(new File(url));
+            }
+            BufferedReader reader = new BufferedReader(new InputStreamReader(is, "UTF-8"));
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) sb.append(line).append("\n");
+            reader.close();
+            return sb.toString();
+        } catch (Exception e) {
+            return null;
+        } finally {
+            if (is != null) { try { is.close(); } catch (Exception ignored) {} }
+        }
+    }
+
+    private String readAsset(String path) {
+        try (InputStream is = getAssets().open(path)) {
+            BufferedReader r = new BufferedReader(new InputStreamReader(is, "UTF-8"));
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = r.readLine()) != null) sb.append(line).append("\n");
+            return sb.toString();
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    // ==================== media ====================
+
+    private boolean isMediaFile(String url) {
+        String lower = url.toLowerCase();
+        for (String ext : VIDEO_EXTS) if (lower.endsWith(ext)) return true;
+        for (String ext : AUDIO_EXTS) if (lower.endsWith(ext)) return true;
+        return false;
+    }
+
+    private void loadMedia(String url) {
+        String lower = url.toLowerCase();
+        boolean isVideo = false;
+        for (String ext : VIDEO_EXTS) if (lower.endsWith(ext)) { isVideo = true; break; }
+        boolean isLocal = url.startsWith("file://");
+        String player = getIntent().getStringExtra(EXTRA_PLAYER);
+        // Default: play both audio and video in the WebView. Only "-e player
+        // native" uses the Android native player (VideoView/MediaPlayer).
+        boolean useNative = "native".equalsIgnoreCase(player);
+
+        if (isVideo && isLocal && useNative) {
+            playNative(url);
+        } else {
+            playWebView(url, isVideo, isLocal);
+        }
+    }
+
+    private void playNative(String url) {
+        String path = url.substring("file://".length());
+        File srcFile = resolveFile(path);
+        if (srcFile == null) {
+            mWebView.loadDataWithBaseURL(null,
+                    "<h2>File Error</h2><p>" + path + "</p><p>not found</p>",
+                    "text/html", "UTF-8", null);
+            return;
+        }
+        if (!srcFile.canRead()) {
+            File tmp = copyToCache(srcFile);
+            if (tmp == null) {
+                mWebView.loadDataWithBaseURL(null,
+                        "<h2>File Error</h2><p>Cannot read: " + path + "</p>",
+                        "text/html", "UTF-8", null);
+                return;
+            }
+            srcFile = tmp;
+        }
+
+        final File playedFile = srcFile;
+        mVideoView.setVisibility(View.VISIBLE);
+        mWebView.setVisibility(View.GONE);
+        enterFullscreen();
+        mVideoView.setOnErrorListener((mp, what, extra) -> {
+            Log.e(TAG, "Native error: what=" + what + " extra=" + extra);
+            mVideoView.setVisibility(View.GONE);
+            mWebView.setVisibility(View.VISIBLE);
+            mWebView.loadDataWithBaseURL(null,
+                    "<h2>Video Error</h2><p>code: " + what + "</p>",
+                    "text/html", "UTF-8", null);
+            return true;
+        });
+        mVideoView.setOnPreparedListener(mp -> mp.start());
+        MediaController mc = new MediaController(this);
+        mc.setAnchorView(mVideoView);
+        mVideoView.setMediaController(mc);
+        mVideoView.setVideoURI(Uri.fromFile(playedFile));
+        Log.i(TAG, "Playing native: " + playedFile);
+    }
+
+    private void playWebView(String url, boolean isVideo, boolean isLocal) {
+        mVideoView.setVisibility(View.GONE);
+        mWebView.setVisibility(View.VISIBLE);
+
+        String srcUrl;
+        // Assets (file:///android_asset/...) are served directly by the WebView;
+        // only real filesystem paths go through resolveFile().
+        if (isVideo && isLocal && !url.startsWith("file:///android_asset/")) {
+            String path = url.substring("file://".length());
+            File srcFile = resolveFile(path);
+            if (srcFile == null) {
+                mWebView.loadDataWithBaseURL(null,
+                        "<h2>File Error</h2><p>" + path + "</p><p>not found</p>",
+                        "text/html", "UTF-8", null);
+                return;
+            }
+            if (!srcFile.canRead()) {
+                File tmp = copyToCache(srcFile);
+                if (tmp == null) return;
+                srcFile = tmp;
+            }
+            srcUrl = Uri.fromFile(srcFile).toString();
+        } else {
+            srcUrl = url;
+        }
+
+        String html = "<!DOCTYPE html><html><head><meta charset=\"UTF-8\">"
+                + "<style>body{margin:0;background:#000;display:flex;"
+                + "align-items:center;justify-content:center;height:100vh;overflow:hidden;}"
+                + (isVideo ? "video{max-width:100%;max-height:100%;}" : "audio{width:100%;}")
+                + "</style></head><body>"
+                + (isVideo
+                    ? "<video src=\"" + srcUrl + "\" controls autoplay playsinline></video>"
+                    : "<audio src=\"" + srcUrl + "\" controls autoplay></audio>")
+                + "</body></html>";
+        mWebView.loadDataWithBaseURL(null, html, "text/html", "UTF-8", null);
+        if (isVideo) enterFullscreen();
+        Log.i(TAG, "Playing WebView: " + srcUrl);
+    }
+
+    private File resolveFile(String path) {
+        File f = new File(path);
+        if (f.exists() && f.canRead()) return f;
+        String name = new File(path).getName();
+        File[] dirs = {
+            getExternalFilesDir(null),
+            getCacheDir(),
+            new File(getFilesDir().getParentFile(), "files"),
+            Environment.getExternalStorageDirectory(),
+            new File("/storage/emulated/0"),
+            new File("/data/media/0"),
+        };
+        for (File dir : dirs) {
+            if (dir == null) continue;
+            File candidate = new File(dir, name);
+            if (candidate.exists() && candidate.canRead()) return candidate;
+            candidate = new File(new File(dir, "Download"), name);
+            if (candidate.exists() && candidate.canRead()) return candidate;
+        }
+        return null;
+    }
+
+    private File copyToCache(File src) {
+        if (src.canRead()) {
+            try {
+                String name = src.getName();
+                int dot = name.lastIndexOf('.');
+                String ext = dot > 0 ? name.substring(dot) : "";
+                File tmp = File.createTempFile("video_", ext, getCacheDir());
+                FileInputStream fis = new FileInputStream(src);
+                FileOutputStream fos = new FileOutputStream(tmp);
+                byte[] buf = new byte[8192];
+                int len;
+                while ((len = fis.read(buf)) > 0) fos.write(buf, 0, len);
+                fis.close();
+                fos.close();
+                return tmp;
+            } catch (Exception e) {
+                Log.e(TAG, "copyToCache error: " + e.getMessage());
+            }
+        }
+        try {
+            String name = src.getName();
+            int dot = name.lastIndexOf('.');
+            String ext = dot > 0 ? name.substring(dot) : "";
+            File tmp = File.createTempFile("video_", ext, getCacheDir());
+            Process p = Runtime.getRuntime().exec(new String[]{
+                    "cp", src.getAbsolutePath(), tmp.getAbsolutePath()});
+            p.waitFor();
+            if (tmp.exists() && tmp.length() > 0) return tmp;
+        } catch (Exception e) {
+            Log.e(TAG, "shell copy error: " + e.getMessage());
+        }
+        return null;
+    }
+
+    // ==================== lifecycle ====================
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        super.onNewIntent(intent);
+        setIntent(intent);
+        // Reload only when an explicit new URL is provided; otherwise (e.g. brought
+        // back from background) keep the current page and playback position.
+        String url = intent.getStringExtra(EXTRA_URL);
+        if (url != null && !url.isEmpty()) {
+            mHomeUrl = url;
+            mUrlBar.setText(url);
+            loadUrl(url);
+        } else {
+            Log.i(TAG, "onNewIntent: no new url, keeping current page");
+        }
+    }
+
+    @Override
+    public boolean dispatchGenericMotionEvent(MotionEvent ev) {
+        Log.i(TAG, "ACT dispatchGenericMotion action=" + ev.getActionMasked()
+                + " src=0x" + Integer.toHexString(ev.getSource())
+                + " x=" + (int) ev.getX() + " y=" + (int) ev.getY());
+        return super.dispatchGenericMotionEvent(ev);
+    }
+
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent ev) {
+        Log.i(TAG, "ACT dispatchTouch action=" + ev.getActionMasked());
+        return super.dispatchTouchEvent(ev);
+    }
+
+    @Override
+    public void onBackPressed() {
+        if (mCustomView != null) {
+            mWebView.exitHtml5Fullscreen();
+        } else if (mWebView.canGoBack()) {
+            mWebView.goBack();
+        } else {
+            super.onBackPressed();
+        }
+    }
+
+    // ==================== private (incognito-like) session data dir ====================
+
+    private boolean isIncognito() {
+        return "1".equals(getIntent().getStringExtra(EXTRA_PRIVATE))
+                || "1".equals(getIntent().getStringExtra(EXTRA_INCOGNITO));
+    }
+
+    /**
+     * Isolate a private session into its own user-data directory and make sure leftovers
+     * from previous private sessions are removed. Must run before any WebView is created
+     * (and before the afree engine native init), since the directory is chosen once per
+     * process.
+     */
+    private void setupPrivateSession(boolean useAfree) {
+        File dataRoot = new File(getApplicationInfo().dataDir);
+
+        // Always clean up leftovers from earlier private sessions (robust even if the
+        // process was killed before its own cleanup ran).
+        sweepIncognitoDirs(dataRoot);
+
+        if (!isIncognito()) {
+            return;
+        }
+
+        String session = (useAfree ? AFREE_INCOGNITO_SUFFIX : SYSTEM_INCOGNITO_PREFIX)
+                + "_" + System.currentTimeMillis();
+        boolean isolated = false;
+
+        if (useAfree) {
+            com.afree.AfreeWebViewInit.setDataDirectorySuffix(session);
+            isolated = true;
+        } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            try {
+                android.webkit.WebView.setDataDirectorySuffix(session);
+                isolated = true;
+            } catch (Throwable t) {
+                Log.w(TAG, "system WebView.setDataDirectorySuffix failed: " + t);
+            }
+        }
+
+        if (isolated) {
+            mSessionSuffix = session;
+            mSessionDataDir = sessionPaths(dataRoot, session)[0].getAbsolutePath();
+        }
+        Log.i(TAG, "incognito mode: isolated=" + isolated + " suffix=" + session
+                + " sessionDir=" + mSessionDataDir);
+    }
+
+    /**
+     * The per-suffix directories both engines use:
+     * data {@code <dataDir>/app_webview_<suffix>}, cache {@code <dataDir>/cache/webview_<suffix>},
+     * no_backup {@code <dataDir>/no_backup/.webview_<suffix>}.
+     */
+    private static File[] sessionPaths(File dataRoot, String suffix) {
+        return new File[] {
+            new File(dataRoot, "app_webview_" + suffix),
+            new File(dataRoot, "cache/webview_" + suffix),
+            new File(dataRoot, "no_backup/.webview_" + suffix),
+        };
+    }
+
+    /** Remove leftover incognito data/cache dirs from any engine / past session. */
+    private void sweepIncognitoDirs(File dataRoot) {
+        File[] root = dataRoot.listFiles();
+        if (root != null) {
+            for (File f : root) {
+                String n = f.getName();
+                if (n.startsWith("app_webview_") && n.contains("incognito")) {
+                    deleteRecursively(f);
+                }
+            }
+        }
+        deleteMatching(new File(dataRoot, "cache"), "webview_", "incognito");
+        deleteMatching(new File(dataRoot, "no_backup"), ".webview_", "incognito");
+    }
+
+    private static void deleteMatching(File dir, String prefix, String contains) {
+        File[] cs = dir.listFiles();
+        if (cs == null) return;
+        for (File f : cs) {
+            String n = f.getName();
+            if (n.startsWith(prefix) && n.contains(contains)) {
+                deleteRecursively(f);
+            }
+        }
+    }
+
+    private static void deleteRecursively(File f) {
+        if (f == null || !f.exists()) return;
+        if (f.isDirectory()) {
+            File[] cs = f.listFiles();
+            if (cs != null) {
+                for (File c : cs) deleteRecursively(c);
+            }
+        }
+        //noinspection ResultOfMethodCallIgnored
+        f.delete();
+    }
+
+    @Override
+    protected void onPause() {
+        super.onPause();
+        mWebView.onPause();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        mWebView.onResume();
+    }
+
+    @Override
+    protected void onDestroy() {
+        if (mWebView != null) {
+            mWebView.destroyWebView();
+        }
+        super.onDestroy();
+        // Best-effort removal of this private session's data/cache dirs; a next-start sweep
+        // also handles the case where the process is killed before reaching here.
+        if (isFinishing() && mSessionSuffix != null) {
+            try {
+                for (File f : sessionPaths(new File(getApplicationInfo().dataDir), mSessionSuffix)) {
+                    deleteRecursively(f);
+                }
+                Log.i(TAG, "private session dirs removed: suffix=" + mSessionSuffix);
+            } catch (Throwable t) {
+                Log.w(TAG, "failed to remove private session dirs: " + t);
+            }
+            mSessionSuffix = null;
+            mSessionDataDir = null;
+        }
+    }
+}
