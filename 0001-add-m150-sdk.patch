+#!/bin/bash
+# =============================================================================
+# verify_video.sh — afree demo video hardware-decode/on-screen verification script
+#
+# How it works:
+#   Loads the built-in test page audio_zone.html, taps the first video link to start
+#   playback, then counts ForwardVideoFrame lines in logcat (a marker that video
+#   frames were rendered on screen by the renderer); frames > 0 means video
+#   hardware decode/on-screen works.
+#
+# Usage:
+#   ./verify_video.sh <device_serial>
+#   e.g. ./verify_video.sh 30.207.82.150:62482
+#
+# Dependency: none (adb only)
+# =============================================================================
+set -e
+
+SERIAL="${1:?usage: $0 <device_serial>}"
+VIDEO_PAGE="http://47.89.235.173:9090/audio_zone.html"
+
+adb -s "$SERIAL" shell am force-stop com.afree.demo
+adb -s "$SERIAL" logcat -c
+adb -s "$SERIAL" shell am start -n com.afree.demo/.MainActivity \
+    -e url "$VIDEO_PAGE" >/dev/null
+echo "loading $VIDEO_PAGE ..."
+sleep 14
+
+# Tap the first video link (coordinates of the first link in audio_zone.html's H264 list).
+echo "tapping video link ..."
+adb -s "$SERIAL" shell input tap 300 346
+sleep 14
+
+FRAMES=$(timeout 8 adb -s "$SERIAL" logcat -d 2>/dev/null | grep -c "ForwardVideoFrame" || true)
+echo "ForwardVideoFrame count: $FRAMES"
+
+if [ "$FRAMES" -gt 0 ]; then
+  echo "PASS: video hardware decode/on-screen works"
+  exit 0
+else
+  echo "FAIL: no video frames on screen detected"
+  exit 1
+fi
