diff --git a/android_webview/afree/tools/verify_scroll.ps1 b/android_webview/afree/tools/verify_scroll.ps1
new file mode 100644
index 0000000000..ff95c33811
--- /dev/null
+++ b/android_webview/afree/tools/verify_scroll.ps1
@@ -0,0 +1,130 @@
+# =============================================================================
+# verify_scroll.ps1 - Windows (PowerShell) port of verify_scroll.sh
+#
+# How it works:
+#   Generates a long page (200 lines) with a position:fixed report bar at the top,
+#   whose background color is set dynamically by JS based on window.scrollY:
+#       scrollY == 0 -> red (not scrolled)
+#       scrollY > 0  -> green (scrolled)
+#   `input swipe` triggers touch scrolling; a screenshot is then analyzed by
+#   screenshot_analyze.py: green = scroll works, red = scroll broken.
+#
+# Usage (from any directory):
+#   powershell -ExecutionPolicy Bypass -File verify_scroll.ps1 <device_serial>
+#   ./verify_scroll.bat <device_serial>
+#
+# Dependency: screenshot_analyze.py (same directory); adb and python3 in PATH
+# =============================================================================
+$ErrorActionPreference = 'Continue'
+
+$SCRIPT_DIR = Split-Path -Parent $MyInvocation.MyCommand.Path
+$ANALYZER = Join-Path $SCRIPT_DIR 'screenshot_analyze.py'
+
+$Serial = if ($args.Count -ge 1) { [string]$args[0] } else { '' }
+if (-not $Serial) { Write-Host "usage: verify_scroll.ps1 <device_serial>"; exit 2 }
+
+function Get-AdbPath {
+  if ($env:AFREE_ADB -and (Test-Path $env:AFREE_ADB)) { return $env:AFREE_ADB }
+  $c = Get-Command adb -ErrorAction SilentlyContinue
+  if (-not $c) { return $null }
+  if ($c.Source) { return $c.Source }
+  return $c.Path
+}
+
+function Get-PyInfo {
+  if ($env:AFREE_PY -and (Test-Path $env:AFREE_PY)) {
+    $pa = @()
+    if ($env:AFREE_PYARGS) { $pa = @($env:AFREE_PYARGS -split ',') }
+    return @{ exe = $env:AFREE_PY; args = $pa }
+  }
+  foreach ($c in @('python3', 'python')) {
+    $p = Get-Command $c -ErrorAction SilentlyContinue
+    if ($p) {
+      $v = (& $p.Source -c "import sys;print(sys.version_info[0])" 2>$null | Out-String).Trim()
+      if ($v -eq '3') { return @{ exe = $p.Source; args = @() } }
+    }
+  }
+  $p = Get-Command py -ErrorAction SilentlyContinue
+  if ($p) {
+    $v = (& $p.Source -3 -c "import sys;print(sys.version_info[0])" 2>$null | Out-String).Trim()
+    if ($v -eq '3') { return @{ exe = $p.Source; args = @('-3') } }
+  }
+  return $null
+}
+
+$ADB = Get-AdbPath
+if (-not $ADB) { Write-Host 'FAIL: adb not found in PATH'; exit 1 }
+$pyInfo = Get-PyInfo
+if (-not $pyInfo) { Write-Host 'FAIL: python3 not found in PATH'; exit 1 }
+if (-not (Test-Path $ANALYZER)) { Write-Host "FAIL: missing $ANALYZER"; exit 1 }
+
+function Adb([string[]]$AdbArgs) { & $ADB -s $Serial @AdbArgs }
+
+# Generate the scroll test page (report bar + 200 lines of content).
+$tmp = Join-Path $env:TEMP ("scroll_test_" + (Get-Random -Minimum 100000 -Maximum 999999) + ".html")
+$html = @()
+$html += '<!DOCTYPE html><html><head><meta charset=UTF-8><script>'
+$html += "function report(){var d=document.getElementById('r');var y=window.scrollY;"
+$html += "d.textContent='SH='+document.body.scrollHeight+' CH='+window.innerHeight+' scrollY='+y;"
+$html += "d.style.background=(y>0)?'#00ff00':'#ff0000';}"
+$html += 'window.onscroll=report;window.onload=report;'
+$html += '</script></head><body style="margin:0">'
+$html += '<div id="r" style="position:fixed;top:0;left:0;background:red;color:white;font-size:40px;z-index:999">WAIT</div>'
+for ($i = 0; $i -lt 200; $i++) {
+  $html += "<div style='height:60px;font-size:30px'>Line $i</div>"
+}
+$html += '</body></html>'
+Set-Content -LiteralPath $tmp -Value $html -Encoding ASCII
+
+try {
+  Adb @('push', $tmp, '/data/local/tmp/scroll_test.html') | Out-Null
+
+  Adb @('shell', 'am force-stop com.afree.demo') | Out-Null
+  Adb @('shell', "am start -n com.afree.demo/.MainActivity -e url 'file:///data/local/tmp/scroll_test.html'") | Out-Null
+  Start-Sleep -Seconds 5
+
+  $beforeLocal = Join-Path $env:TEMP ("scroll_before_" + (Get-Random) + ".png")
+  $afterLocal = Join-Path $env:TEMP ("scroll_after_" + (Get-Random) + ".png")
+
+  # Screenshot before swipe (should be red).
+  Adb @('shell', 'screencap -p /sdcard/scroll_before.png') | Out-Null
+  Adb @('pull', '/sdcard/scroll_before.png', $beforeLocal) | Out-Null
+
+  # Touch swipe up.
+  Adb @('shell', 'input swipe 900 500 900 100 800') | Out-Null
+  Start-Sleep -Seconds 2
+
+  # Screenshot after swipe (should be green if scrolling worked).
+  Adb @('shell', 'screencap -p /sdcard/scroll_after.png') | Out-Null
+  Adb @('pull', '/sdcard/scroll_after.png', $afterLocal) | Out-Null
+
+  $before = ''
+  $after = ''
+  if (Test-Path $beforeLocal) {
+    $before = (& $pyInfo.exe @($pyInfo.args + @($ANALYZER, $beforeLocal)) 2>$null | Out-String)
+  }
+  if (Test-Path $afterLocal) {
+    $after = (& $pyInfo.exe @($pyInfo.args + @($ANALYZER, $afterLocal)) 2>$null | Out-String)
+  }
+
+  $beforeRGB = ''
+  if ($before -match 'RGB\(255, 0, 0\)|RGB\(0, 255, 0\)') { $beforeRGB = $Matches[0] }
+  $afterRGB = ''
+  if ($after -match 'RGB\(255, 0, 0\)|RGB\(0, 255, 0\)') { $afterRGB = $Matches[0] }
+
+  Write-Host "report bar before swipe: $beforeRGB"
+  Write-Host "report bar after swipe: $afterRGB"
+
+  if ($after -match 'RGB\(0, 255, 0\)') {
+    Write-Host 'PASS: touch scrolling works (scrollY > 0)'
+    exit 0
+  } else {
+    Write-Host 'FAIL: touch scrolling broken (scrollY == 0)'
+    exit 1
+  }
+}
+finally {
+  Remove-Item -LiteralPath $tmp -ErrorAction SilentlyContinue
+  if ($beforeLocal) { Remove-Item -LiteralPath $beforeLocal -ErrorAction SilentlyContinue }
+  if ($afterLocal) { Remove-Item -LiteralPath $afterLocal -ErrorAction SilentlyContinue }
+}
diff --git a/android_webview/afree/tools/verify_scroll.sh b/android_webview/afree/tools/verify_scroll.sh
new file mode 100755
index 0000000000..88100c9e7d
--- /dev/null
+++ b/android_webview/afree/tools/verify_scroll.sh
@@ -0,0 +1,75 @@
+#!/bin/bash
+# =============================================================================
+# verify_scroll.sh — afree demo touch-scroll verification script
+#
+# How it works:
+#   Generates a long page (200 lines) with a position:fixed report bar at the top,
+#   whose background color is set dynamically by JS based on window.scrollY:
+#       scrollY == 0 -> red (not scrolled)
+#       scrollY > 0  -> green (scrolled)
+#   `input swipe` triggers touch scrolling; a screenshot is then analyzed by
+#   screenshot_analyze.py: green = scroll works, red = scroll broken.
+#
+# Usage:
+#   ./verify_scroll.sh <device_serial>
+#   e.g. ./verify_scroll.sh 30.207.82.150:62482
+#
+# Dependency: screenshot_analyze.py (same directory)
+# =============================================================================
+set -e
+
+SERIAL="${1:?usage: $0 <device_serial>}"
+AFREE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ANALYZER="$AFREE_DIR/screenshot_analyze.py"
+
+# Generate the scroll test page (report bar + 200 lines of content).
+TEST_HTML=$(mktemp /tmp/scroll_test.XXXXXX.html)
+{
+  cat <<'EOF'
+<!DOCTYPE html><html><head><meta charset=UTF-8><script>
+function report(){var d=document.getElementById('r');var y=window.scrollY;
+d.textContent='SH='+document.body.scrollHeight+' CH='+window.innerHeight+' scrollY='+y;
+d.style.background=(y>0)?'#00ff00':'#ff0000';}
+window.onscroll=report;window.onload=report;
+</script></head><body style="margin:0">
+<div id="r" style="position:fixed;top:0;left:0;background:red;color:white;font-size:40px;z-index:999">WAIT</div>
+EOF
+  for i in $(seq 0 199); do
+    echo "<div style='height:60px;font-size:30px'>Line $i</div>"
+  done
+  echo "</body></html>"
+} > "$TEST_HTML"
+
+adb -s "$SERIAL" push "$TEST_HTML" /data/local/tmp/scroll_test.html >/dev/null
+rm -f "$TEST_HTML"
+
+adb -s "$SERIAL" shell am force-stop com.afree.demo
+adb -s "$SERIAL" shell am start -n com.afree.demo/.MainActivity \
+    -e url "file:///data/local/tmp/scroll_test.html" >/dev/null
+sleep 5
+
+# Screenshot before swipe (should be red).
+adb -s "$SERIAL" shell screencap -p /sdcard/scroll_before.png
+adb -s "$SERIAL" pull /sdcard/scroll_before.png /tmp/scroll_before.png >/dev/null
+
+# Touch swipe up.
+adb -s "$SERIAL" shell input swipe 900 500 900 100 800
+sleep 2
+
+# Screenshot after swipe (should be green if scrolling worked).
+adb -s "$SERIAL" shell screencap -p /sdcard/scroll_after.png
+adb -s "$SERIAL" pull /sdcard/scroll_after.png /tmp/scroll_after.png >/dev/null
+
+BEFORE=$(python3 "$ANALYZER" /tmp/scroll_before.png | grep -oE "RGB\(255, 0, 0\)|RGB\(0, 255, 0\)" | head -1)
+AFTER=$(python3 "$ANALYZER" /tmp/scroll_after.png | grep -oE "RGB\(255, 0, 0\)|RGB\(0, 255, 0\)" | head -1)
+
+echo "report bar before swipe: $BEFORE"
+echo "report bar after swipe: $AFTER"
+
+if echo "$AFTER" | grep -q "0, 255, 0"; then
+  echo "PASS: touch scrolling works (scrollY > 0)"
+  exit 0
+else
+  echo "FAIL: touch scrolling broken (scrollY == 0)"
+  exit 1
+fi
