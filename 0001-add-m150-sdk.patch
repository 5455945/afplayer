+    print(f"ERROR: no command matching script={script} output={output_match}", file=sys.stderr)
+    sys.exit(1)
+cmd = cmd.replace('$:', ':').replace('$ ', ' ')
+ret = subprocess.call(cmd, shell=True, cwd=output_dir)
+sys.exit(ret)
+PYEOF
+  return "${PIPESTATUS[0]}"
