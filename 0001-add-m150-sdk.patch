+def ui_dump(device, retries=3):
+    """Dump the WebView accessibility tree (HTML semantics + bounds). Often fails during playback, returns None."""
+    remote = "/sdcard/afree_ui.xml"
+    for _ in range(retries):
+        rc, out, err = adb_shell(device, "uiautomator dump %s" % remote, timeout=45)
+        if "dumped" in (out + err):
+            fd, local = tempfile.mkstemp(suffix=".xml")
+            os.close(fd)
+            run(["-s", device, "pull", remote, local], timeout=30)
+            try:
+                root = ET.parse(local).getroot()
+                return root
+            except Exception:
+                pass
+            finally:
+                try:
+                    os.unlink(local)
+                except Exception:
+                    pass
+        time.sleep(1.5)
+    return None
+
+
+def ui_find(root, keys):
+    """Find nodes whose text/content-desc contains any keyword, returns [(bounds,text,desc)]."""
+    if root is None:
+        return []
+    res = []
+    for n in root.iter("node"):
+        t = n.get("text", "") or ""
+        d = n.get("content-desc", "") or ""
+        if any(k in t or k in d for k in keys):
+            m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", n.get("bounds", "") or "")
+            if m:
+                res.append((tuple(map(int, m.groups())), t, d))
+    return res
+
