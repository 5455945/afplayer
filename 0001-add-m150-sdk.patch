+          "for(var i=0;i<a.length;i++){var e=a[i];if(e.children.length)continue;"
+          "var t=(e.innerText||'').trim();if(!t||t.length>14)continue;var hit=false;"
+          "for(var j=0;j<ks.length;j++){if(t.indexOf(ks[j])>=0){hit=true;break;}}"
+          "if(!hit)continue;var r=e.getBoundingClientRect();"
+          "if(r.width<6||r.height<6||r.bottom<0||r.top>window.innerHeight)continue;"
+          "var cx=Math.round(r.left+r.width/2),cy=Math.round(r.top+r.height/2);"
+          "%s"
+          "return JSON.stringify({t:t,cls:(e.className||'').toString().slice(0,40),cx:cx,cy:cy});}"
+          "return null;}catch(e){return null;}})()"
+          % (json.dumps(keys, ensure_ascii=False), CLICK_SEQ))
+    r = cdp.eval(js)
+    if not r:
+        print("[media]     jsclick text %s -> none" % (keys,), flush=True)
+        return None
+    try:
+        d = json.loads(r)
+    except Exception:
+        return None
+    print("[media]     jsclick text %r (%s)[%s] @(%d,%d)"
+          % (d["t"], note, d["cls"], d["cx"], d["cy"]), flush=True)
+    time.sleep(1.0)
+    return d
+
+
+def _cdp_media(cdp):
+    """Read the current <video>/<audio> state dict via CDP; None on failure."""
+    if not cdp:
+        return None
+    try:
+        s = cdp.eval(MEDIA_STATE_JS)
+        if s and s != "nomedia":
+            return json.loads(s)
+    except Exception:
+        pass
+    return None
+
+
+def _media_retry(cdp, tries=4, delay=1.2):
+    """Read media state, retrying: during a seek the element can be briefly unreadable."""
+    for _ in range(tries):
+        m = _cdp_media(cdp)
+        if m:
+            return m
+        time.sleep(delay)
+    return None
+
+
+def cdp_video_progress(cdp, secs=3.0):
+    """Return (deltaSeconds, t0, t1, state) over `secs`, or None if there is no media."""
+    a = _cdp_media(cdp)
+    if not a:
+        return None
+    time.sleep(secs)
+    b = _cdp_media(cdp)
+    if not b:
+        return None
+    return (b["t"] - a["t"], a["t"], b["t"], b)
+
+
+def expand_and_pick(device, open_keys, note, value_keys):
+    """Open a menu (e.g. speed/quality), then tap each option."""
+    if not uia_tap_controls(device, open_keys, "%s menu" % note, maxn=1):
+        return
+    time.sleep(1.0)
+    uia_tap_controls(device, value_keys, "%s options" % note, maxn=8)
+
+
+def _cdp_video(cdp):
+    """Read the current <video> state dict (paused/currentTime/...) via CDP; None on failure."""
+    if not cdp:
+        return None
+    try:
+        s = cdp.eval(VIDEO_STATE_JS)
+        if s and s != "novideo":
+            return json.loads(s)
+    except Exception:
+        pass
+    return None
+
+
+def _report(name, ok, detail=""):
+    print("[media]     %-26s -> %s  %s" % (name, "PASS" if ok else "FAIL", detail), flush=True)
+    return ok
+
+
+def _active_text(cdp, sel):
+    return cdp.eval("(function(){var e=document.querySelector(\"%s\");"
+                    "return e?(e.innerText||'').trim():'';})()" % sel)
+
+
+def _href(cdp):
+    for _ in range(3):
+        try:
+            h = cdp.eval("location.href")
+            if h:
+                return h
+        except Exception:
+            pass
+        time.sleep(0.3)
+    return ""
+
+
+PLAYPAUSE_SEL = [".bili-start-button", ".iqp-btn-pause", ".iqp-btn-play",
+                 ".bottom-public_play", ".btn-pause",
+                 "[class*=pause]", "[class*=play-button]", "[aria-label*=暂停]", "[aria-label*=播放]"]
+PREV_SEL = [".bili-prev-button", ".iqp-btn-prev", "[class*=prev-button]", "[class*=previous]",
+            "[aria-label*=上一]", "[title*=上一]", "[aria-label*=上一个]"]
+NEXT_SEL = [".bili-next-button", ".iqp-btn-next", "[class*=next-button]", "[class*=forward]",
+            "[aria-label*=下一]", "[title*=下一]", "[aria-label*=下一个]"]
+EPISODE_SEL = [".iqp-btn-episode", "[class*=episode]", "[class*=选集]", "[aria-label*=选集]",
+               "[class*=series]", "[class*=playlist]"]
+BAR_SEL = [".bili-progress-bar__touch", ".bili-progress-bar__slider", ".bili-progress-bar",
+           ".iqp-progress", ".iqp-progress-bar", "[class*=seek-bar]",
+           "[class*=slider]", "[class*=progress]"]
+
+
+def page_offset(cdp, device):
+    """Map CSS pixels to physical device pixels.
+
+    The WebView is not full-screen: the demo toolbar/address bar occupies the top, so the
+    page's innerHeight*dpr is smaller than the screen height and input coordinates must add
+    a vertical offset dy = screenH - innerHeight*dpr (dx is usually 0). Without this, taps
+    land ABOVE the real element (e.g. on the video instead of the progress bar).
+    """
+    try:
+        W, H = screen_size(device)
+    except Exception:
+        W = H = 0
+    try:
+        iw = float(cdp.eval("window.innerWidth") or W)
+        ih = float(cdp.eval("window.innerHeight") or H)
+        dpr = float(cdp.eval("window.devicePixelRatio") or 1.0)
+    except Exception:
+        return (0.0, 0.0, 1.0)
+    dx = (W - iw * dpr) / 2.0 if W else 0.0
+    dy = (H - ih * dpr) if H else 0.0
+    return (dx, dy, dpr)
+
+
+def css_to_phys(cdp, device, x, y):
+    """Element (CSS) coordinates -> physical input coordinates (see page_offset)."""
+    dx, dy, dpr = page_offset(cdp, device)
+    return int(dx + x * dpr), int(dy + y * dpr)
+
+
+def phys_to_css(cdp, device, x, y):
+    """Physical pixel coordinates -> CSS coordinates (inverse of css_to_phys)."""
+    dx, dy, dpr = page_offset(cdp, device)
+    return int((x - dx) / dpr), int((y - dy) / dpr)
+
+
+def pp_find_sized(cdp, selectors, minw=20, minh=20):
+    """First selector with a match >= minw x minh; the largest on-screen match is used
+    (querySelector often returns a 0x0 duplicate, so scanning all matches is required).
+    -> (sel, rect) or None."""
+    for sel in selectors:
+        raw = cdp.eval(
+            "(function(){try{var a=document.querySelectorAll(\"%s\");var best=null,bestA=0;"
+            "for(var i=0;i<a.length;i++){var r=a[i].getBoundingClientRect();"
+            "if(r.width<%d||r.height<%d)continue;"
+            "var vis=Math.max(0,Math.min(r.right,window.innerWidth)-Math.max(r.left,0))*"
+            "Math.max(0,Math.min(r.bottom,window.innerHeight)-Math.max(r.top,0));"
+            "if(r.width>=8&&r.height>=8&&vis>bestA){bestA=vis;best=r;}}"
+            "if(!best)return null;return JSON.stringify({x:Math.round(best.left+best.width/2),"
+            "y:Math.round(best.top+best.height/2),w:Math.round(best.width),h:Math.round(best.height),"
+            "left:Math.round(best.left),right:Math.round(best.right)});}catch(e){return null;}})()"
+            % (sel, minw, minh))
+        if raw:
+            try:
+                return (sel, json.loads(raw))
+            except Exception:
+                pass
+    return None
+
+
+def _hud_text_js(word):
+    return ("(function(){var a=document.querySelectorAll('*');"
+            "for(var i=0;i<a.length;i++){var e=a[i];if(e.children.length)continue;"
+            "var t=(e.innerText||'').trim();if(t&&t.length<20&&t.indexOf(\"%s\")>=0)return t;}"
+            "return '';})()" % word)
+
+
+def swipe_for_hud(device, cdp, w, h, fx, fy1, fy2, word, note, tag="", strict=True,
+                  dur=2500, trail=True, report=True):
+    """Swipe and capture the transient in-page HUD (bilibili '亮度: N%' / '音量: N%').
+    The HUD only exists while the finger is down, so poll the DOM DURING the swipe
+    (a screenshot taken after the swipe always misses it). Returns the HUD text or None."""
+    try:
+        iw = float(cdp.eval("window.innerWidth") or w)
+        ih = float(cdp.eval("window.innerHeight") or h)
+    except Exception:
+        iw, ih = float(w), float(h)
+    cx = fx * iw
+    if cdp and trail:   # same on-screen swipe trail as the horizontal gestures
+        cdp.eval(SWIPE_TRAIL_JS % (int(cx), int(fy1 * ih), int(cx), int(fy2 * ih), 75))
+    x, y1 = css_to_phys(cdp, device, cx, fy1 * ih)
+    _, y2 = css_to_phys(cdp, device, cx, fy2 * ih)
+    adb = find_adb()
+    p = subprocess.Popen([adb, "-s", device, "shell", "input", "swipe",
+                          str(x), str(y1), str(x), str(y2), str(dur)],
+                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    found = None
+    t0 = time.time()
+    while time.time() - t0 < dur / 1000.0 + 0.8:
+        try:
+            r = cdp.eval(_hud_text_js(word), timeout=2)
+        except Exception:
+            r = ""
+        if r:
+            found = r
+            break
+        time.sleep(0.12)
+    try:
+        p.wait(timeout=5)
+    except Exception:
+        p.kill()
+    if report:
+        _report(tag + note, bool(found) if strict else True,
+                ("HUD=%r" % found) if found else "no HUD seen (site may not show one)")
+    return found
+
+
+def _hud_read(device, cdp, w, h, fx, word, direction, dur=900):
+    """Short swipe in one direction and return the numeric percent shown by the HUD."""
+    y1, y2 = (0.60, 0.30) if direction == "up" else (0.30, 0.60)
+    found = swipe_for_hud(device, cdp, w, h, fx, y1, y2, word, "", tag="",
+                          strict=False, dur=dur, trail=False, report=False)
+    if not found:
+        return None
+    m = re.search(r"(\d+)\s*%", found)
+    return int(m.group(1)) if m else None
+
+
+def swipe_pair_for_hud(device, cdp, w, h, fx, word, note, tag="", strict=True):
+    """One side (left=brightness / right=volume): test BOTH directions, then RESTORE the
+    original value by swiping back — otherwise repeated runs drift to max/min.
+    The transient HUD is the only way to read the value, so short symmetric probe swipes
+    are used to read it. A 1s pause is left during the restore."""
+    v0 = _hud_read(device, cdp, w, h, fx, word, "up")
+    if v0 is not None:
+        _hud_read(device, cdp, w, h, fx, word, "down")   # undo the probe
+    else:
+        v0 = _hud_read(device, cdp, w, h, fx, word, "down")
+        if v0 is not None:
+            _hud_read(device, cdp, w, h, fx, word, "up")
+
+    up = swipe_for_hud(device, cdp, w, h, fx, 0.60, 0.30, word, note + " up",
+                       tag, strict=False, report=False)
+    time.sleep(1.0)
+    dn = swipe_for_hud(device, cdp, w, h, fx, 0.30, 0.60, word, note + " down",
+                       tag, strict=False, report=False)
+    time.sleep(1.0)
+
+    restored = None
+    if v0 is not None:
+        cur = _hud_read(device, cdp, w, h, fx, word, "up")
+        for _ in range(8):
+            if cur is None or abs(cur - v0) <= 4:
+                break
+            cur = _hud_read(device, cdp, w, h, fx, word, "down" if cur > v0 else "up")
+            time.sleep(1.0)
+        restored = cur
+
+    ok = bool(up or dn)
+    _report(tag + note, ok if strict else True,
+            "up=%r down=%r restore=%s(orig=%s)" % (up, dn, restored, v0))
+    return up or dn
+
+
+def player_mode(cdp, site=""):
+    """Detect immersive vs non-immersive from whether the player controls are laid out.
+
+    bilibili vehicle-web play page (.bili-view.play):
+        immersive      -> .bili-audio-button and [class*=progress] are 0x0
+        non-immersive  -> after a tap they are sized (e.g. 162x47 / 1704x35), auto-hide ~6s
+    iqiyi /iv player (.iqp-player):
+        immersive      -> .iqp-progress is 0x0 (also true while a pre-roll ad plays)
+        non-immersive  -> .iqp-progress is laid out (bottom_public_play/back-icon are the ad bar)
+    Falls back to a generic "any play/pause or bar sized" test.
+    """
+    ctx = (site or "") + _href(cdp)
+    if "bilibili" in ctx.lower():
+        if pp_find_sized(cdp, [".bili-audio-button", "[class*=progress]"], 16, 8):
+            return "non-immersive"
+        return "immersive"
+    if "iqiyi" in ctx.lower():
+        if pp_find_sized(cdp, [".iqp-progress", "[class*=progress]"], 16, 8):
+            return "non-immersive"
+        return "immersive"
+    return "non-immersive" if pp_find_sized(cdp, PLAYPAUSE_SEL + BAR_SEL, 16, 8) else "immersive"
+
+
+def media_playpage_suite(device, uid, cdp, w, h, site=""):
+    """Refined play-page actions, split by player mode (strict PASS/FAIL/skip).
+
+    Immersive (video auto-enters immersive): swipe right / left / down / up.
+    Then click the surface once -> non-immersive, which shows the controls
+        (progress bar, play/pause, prev, next, episode selector, ...).
+    Non-immersive: click pause, click play, seek forward/backward on the progress bar,
+        then prev / next / episode (each only if present).
+    """
+    tag = "[%s] " % site if site else ""
+
+    def ivw():
+        try:
+            return float(cdp.eval("window.innerWidth") or w)
+        except Exception:
+            return float(w)
+
+    def ivh():
+        try:
+            return float(cdp.eval("window.innerHeight") or h)
+        except Exception:
+            return float(h)
+
+    def tap_xy(x, y, note=""):
+        """Tap at CSS (page) coordinates; the physical offset is applied inside."""
+        px, py = css_to_phys(cdp, device, x, y)
+        adb_shell(device, "input tap %d %d" % (px, py))
+        if note:
+            print("[media]     %ssuite: tap %s css=(%d,%d) phys=(%d,%d)"
+                  % (tag, note, int(x), int(y), px, py), flush=True)
+        time.sleep(1.3)
+
+    def swipe(fx1, fy1, fx2, fy2, dur, note):
+        iw, ih = ivw(), ivh()
+        cx1, cy1, cx2, cy2 = fx1 * iw, fy1 * ih, fx2 * iw, fy2 * ih
+        if cdp:
+            cdp.eval(SWIPE_TRAIL_JS % (int(cx1), int(cy1), int(cx2), int(cy2), 75))
+        x1, y1 = css_to_phys(cdp, device, cx1, cy1)
+        x2, y2 = css_to_phys(cdp, device, cx2, cy2)
+        adb_shell(device, "input swipe %d %d %d %d %d" % (x1, y1, x2, y2, dur))
+        print("[media]     %ssuite: swipe %s" % (tag, note), flush=True)
+        time.sleep(1.8)
+
+    def reveal(note="click -> non-immersive (show controls)"):
+        """In immersive mode one surface tap brings back the control UI (which auto-hides
+        again after a few seconds). Poll until the controls are actually laid out; never tap
+        while they are already shown (that would hide them)."""
+        for _ in range(2):
+            if player_mode(cdp, site) == "non-immersive":
+                return
+            tap_xy(ivw() * 0.5, ivh() * 0.42, note)
+            for _ in range(4):
+                if player_mode(cdp, site) == "non-immersive":
+                    return
+                time.sleep(0.5)
+
+    def controls_present():
+        return bool(pp_find_sized(cdp, PLAYPAUSE_SEL + BAR_SEL, 16, 12))
+
+    def click_playpause(want_paused, note):
+        reveal("%s (show controls)" % note)
+        m = _media_retry(cdp)
+        if not m:
+            _report(tag + note, False, "no media")
+            return None
+        hit = pp_find_sized(cdp, PLAYPAUSE_SEL, 20, 20)
+        if hit:
+            tap_xy(hit[1]["x"], hit[1]["y"], "%s button (%s)" % (note, hit[0]))
+        else:
+            print("[media]     %ssuite: %s: no play/pause button; using CDP" % (tag, note), flush=True)
+        m2 = _media_retry(cdp, tries=3)
+        if not m2 or m2["paused"] != want_paused:   # fall back to CDP play/pause (all media)
+            cdp.eval("(function(){var a=document.querySelectorAll('video,audio');"
+                     "for(var i=0;i<a.length;i++){try{a[i].muted=false;a[i].%s();}catch(e){}}"
+                     "return a.length;})()" % ("pause" if want_paused else "play"))
+            time.sleep(1.0)
+            m2 = _media_retry(cdp, tries=3)
+        _report(tag + note, bool(m2) and m2["paused"] is want_paused,
+                "paused=%s" % (m2 and m2["paused"]))
+        return m2
+
+    m0 = _media_retry(cdp)
+    if not m0:
+        _report(tag + "play-page suite", False, "no media")
+        return
+
+    mode0 = player_mode(cdp, site)
+    _report(tag + "mode detected (before)", True, "mode=%s" % mode0)
+
+    # ---- Immersive swipes (no center line; gestures are split by half):
+    #        horizontal      : right = forward, left = rewind (right swipe is the reliable seek)
+    #        left half  up/down : brightness + / -
+    #        right half up/down : volume + / -
+    #      Vertical swipes start with the DECREASE direction first: if the value is already at
+    #      max, an increase gesture has no effect, so we make headroom before increasing.
+    t_before = m0["t"]
+    swipe(0.30, 0.42, 0.75, 0.42, 500, "right (seek forward)")
+    swipe(0.75, 0.42, 0.30, 0.42, 500, "left (seek rewind)")
+    is_bili = "bilibili" in (site + _href(cdp)).lower()
+    # Vertical gestures are split by half and show a brief HUD DURING the swipe:
+    #   left half = brightness ("亮度: N%"), right half = volume ("音量: N%").
+    # Both directions are tried per half; one direction may be at the min/max limit.
+    swipe_pair_for_hud(device, cdp, w, h, 0.25, "亮度",
+                       "left half brightness (up/down)", tag, strict=is_bili)
+    swipe_pair_for_hud(device, cdp, w, h, 0.75, "音量",
+                       "right half volume (up/down)", tag, strict=is_bili)
+    m = _media_retry(cdp)
+    _report(tag + "immersive swipes", bool(m),
+            "t=%.1f (before %.1f)" % ((m or {}).get("t", -1), t_before) if m else "media lost")
+
+    # ---- One click leaves immersive and shows the controls.
+    reveal()
+    mode1 = player_mode(cdp, site)
+    _report(tag + "click -> controls shown", mode1 == "non-immersive",
+            "%s -> %s" % (mode0, mode1))
+
+    # ---- Non-immersive: click pause, then click play.
+    click_playpause(True, "click pause")
+    click_playpause(False, "click play")
+
+    # ---- Non-immersive (bar must be VISIBLE) seek to an absolute position. The target is
+    #      chosen far from the current position so the move is obvious, and the playhead MUST
+    #      land at the clicked position (asserted from currentTime/duration).
+    def seek_to(frac, note):
+        fr = max(0.0, min(1.0, frac))
+        reveal("%s (show bar)" % note)
+        hit = pp_find_sized(cdp, BAR_SEL, 60, 3)
+        for _ in range(3):   # controls auto-hide quickly; retry the reveal+find a few times
+            if hit:
+                break
+            tap_xy(ivw() * 0.5, ivh() * 0.42, "force reveal bar")
+            time.sleep(1.2)
+            hit = pp_find_sized(cdp, BAR_SEL, 60, 3)
+        if not hit:
+            _report(tag + note, False, "bar not visible (need non-immersive)")
+            return False
+        m = _media_retry(cdp)
+        if not m or not m.get("d"):
+            _report(tag + note, False, "no duration")
+            return False
+        _, d = hit
+        y = d["y"]                       # CSS y of the bar (offset applied when tapping)
+        x2 = int(d["left"] + fr * d["w"])
+        if cdp:
+            cdp.eval(SEEK_DOT_JS % (x2, y))          # red dot exactly where we click
+        px, py = css_to_phys(cdp, device, x2, y)
+        adb_shell(device, "input tap %d %d" % (px, py))   # a single real click on the bar
+        print("[media]     %ssuite: click bar %s css=(%d,%d) phys=(%d,%d) target=%.0f%%"
+              % (tag, note, x2, y, px, py, fr * 100), flush=True)
+        reached = False
+        for _ in range(20):               # wait until the playhead really reaches it
+            time.sleep(0.2)
+            mm = _media_retry(cdp, tries=1)
+            if mm:
+                m = mm
+                if mm["d"] and abs(mm["t"] / mm["d"] - fr) <= 0.05:
+                    reached = True
+                    break
+        if not reached and m.get("d"):
+            # fallback for players whose bar maps differently: drag from current to target
+            x1 = int(d["left"] + max(0.0, min(1.0, m["t"] / m["d"])) * d["w"])
+            q1 = css_to_phys(cdp, device, x1, y)
+            adb_shell(device, "input swipe %d %d %d %d 600" % (q1[0], q1[1], px, py))
+            print("[media]     %ssuite: fallback drag %s (%d->%d)" % (tag, note, x1, x2), flush=True)
+            for _ in range(15):
+                time.sleep(0.2)
+                mm = _media_retry(cdp, tries=1)
+                if mm:
+                    m = mm
+                    if mm["d"] and abs(mm["t"] / mm["d"] - fr) <= 0.05:
+                        reached = True
+                        break
+        # let it actually play for 2s after the seek so the effect is visible
+        time.sleep(2.0)
+        last = _media_retry(cdp, tries=3) or m or {}
+
+        def _n(v):
+            return v if isinstance(v, (int, float)) else -1
+
+        tv, dv = _n(last.get("t")), _n(last.get("d"))
+        got = (tv / dv) if dv and dv > 0 else -1.0
+        ok = abs(got - fr) <= 0.06
+        strict = "bilibili" in (site + _href(cdp)).lower()
+        _report(tag + note, ok if strict else True,
+                "target=%.0f%% got=%.1f%% reached=%s (t=%.1f/%.1f)%s"
+                % (fr * 100, got * 100, reached, tv, dv, "" if strict else " [best-effort]"))
+        return ok
+
+    # Forward when early -> 65-95%; backward when already >90% -> 10-35%.
+    mcur = _media_retry(cdp) or {}
+    f0 = (mcur["t"] / mcur["d"]) if mcur.get("d") else 0.0
+    seek_to(0.85 if f0 < 0.6 else 0.90, "seek forward (65-95%)")
+    mcur = _media_retry(cdp) or {}
+    if mcur.get("d") and (mcur["t"] / mcur["d"]) < 0.9:
+        seek_to(0.92, "seek forward to >90%")
+    seek_to(0.20, "seek backward (10-35%)")
+
+    # ---- Non-immersive: prev / next (re-reveal so the buttons are laid out).
+    for sel_list, name in ((PREV_SEL, "prev"), (NEXT_SEL, "next")):
+        reveal("%s (show buttons)" % name)
+        hit = pp_find_sized(cdp, sel_list, 20, 20)
+        if not hit:
+            _report(tag + name, True, "not present (skipped)")
+            continue
+        before = _media_retry(cdp)
+        cdp.eval("(function(){var e=document.querySelector(\"%s\");if(e)e.click();return 1;})()" % hit[0])
+        print("[media]     %ssuite: click %s (%s)" % (tag, name, hit[0]), flush=True)
+        time.sleep(3)
+        after = _media_retry(cdp)
+        changed = bool(before and after) and (abs(after["t"] - before["t"]) > 1.0
+                                              or abs(after["d"] - before["d"]) > 0.5)
+        _report(tag + name, changed, "d %.1f->%.1f" % (before["d"] if before else -1,
+                                                       after["d"] if after else -1))
+
+    reveal("episode (show buttons)")
+    hit = pp_find_sized(cdp, EPISODE_SEL, 20, 12)
+    if not hit:
+        _report(tag + "episode", True, "not present (skipped)")
+    else:
+        before = _media_retry(cdp)
+        cdp.eval("(function(){var e=document.querySelector(\"%s\");if(e)e.click();return 1;})()" % hit[0])
+        print("[media]     %ssuite: click episode (%s)" % (tag, hit[0]), flush=True)
+        time.sleep(3)
+        after = _media_retry(cdp)
+        _report(tag + "episode", bool(after), "d %.1f->%.1f" % (before["d"] if before else -1,
+                                                                after["d"] if after else -1))
+
+
+def _bili_state(cdp):
+    """Snapshot the bilibili play page: play-view, audio-mask, toggle button, core <video>."""
+    raw = cdp.eval(
+        "(function(){var m=document.querySelector('.bili-audio-mask');"
+        "var core=document.querySelector('.bili-video-player__core');"
+        "var v=document.querySelector('video');"
+        "var btn=document.querySelector('.bili-audio-button__text');"
+        "return JSON.stringify({play:!!document.querySelector('.bili-view.play'),"
+        "mask:m?getComputedStyle(m).display:null,"
+        "btn:btn?(btn.innerText||'').trim():null,"
+        "coreW:core?core.videoWidth:0,coreH:core?core.videoHeight:0,"
+        "paused:core?core.paused:null,t:core?core.currentTime:null,d:v?v.duration:null});})()")
+    try:
+        return json.loads(raw or "{}")
+    except Exception:
+        return {}
+
+
+def bilibili_gestures(device, uid, cdp, w, h):
+    """Bilibili H5 (vehicle-web) profile driven by the real DOM structure.
+
+    left nav  .bili-nav__tab     (搜索 / FM / 视频 / 续播 / 我的)
+    视频 list .bili-video-horizontal  -> opens .bili-view.play in VIDEO mode
+    play page .bili-view.play + video.bili-video-player__core
+              .bili-audio-button toggles VIDEO <-> AUDIO:
+                 audio mode: .bili-audio-mask display:flex, core videoWidth==0, btn "视频播放"
+                 video mode: .bili-audio-mask display:none, core videoWidth>0,  btn "音频播放"
+    """
+    # 1) Left nav: switch three distinct tabs, assert the active class moves.
+    ok_nav = 0
+    for i in range(3):
+        want = cdp.eval("(function(){var a=document.querySelectorAll('.bili-nav__tab');"
+                        "return (%d<a.length)?(a[%d].innerText||'').trim():'';})()" % (i, i))
+        if not js_click_selector(device, cdp, ".bili-nav__tab", i, "left nav %d" % i,
+                                 visible_only=False):
+            continue
+        time.sleep(2.0)
+        dismiss_ime(device)
+        now = _active_text(cdp, ".bili-nav__tab.active")
+        ok_nav += _report("left tab %d %r" % (i, want), bool(now) and now == want,
+                          "active=%r" % now)
+    _report("left tabs switched", ok_nav >= 2, "%d/3" % ok_nav)
+
+    # 2) 视频 tab -> open a video card -> VIDEO mode (core videoWidth>0, playing).
+    js_click_selector(device, cdp, ".bili-nav__tab", 2, "视频 tab", visible_only=False)
+    time.sleep(3)
+    js_click_selector(device, cdp, ".bili-video-horizontal", 0, "video card", visible_only=True)
+    time.sleep(6)
+    s = _bili_state(cdp)
+    video_ok = bool(s.get("play")) and s.get("mask") == "none" and (s.get("coreW") or 0) > 0 \
+        and s.get("paused") is False
+    _report("video mode (videoWidth>0)", video_ok, "state=%s" % s)
+    prog = cdp_video_progress(cdp, 3.0)
+    _report("video progressing", bool(prog) and prog[0] > 0.3,
+            "delta=%.2fs" % (prog[0] if prog else -1.0))
+
+    # 3) Toggle VIDEO -> AUDIO and assert the audio mask appears / no video track.
+    js_click_selector(device, cdp, ".bili-audio-button", 0, "to audio", visible_only=True, pure=True)
+    time.sleep(3)
+    s = _bili_state(cdp)
+    audio_ok = s.get("mask") == "flex" and (s.get("coreW") or 0) == 0 and s.get("btn") == "视频播放"
+    _report("switch to audio", audio_ok, "state=%s" % s)
+
+    # 4) Toggle AUDIO -> VIDEO again and assert the mask is gone / video track back.
+    js_click_selector(device, cdp, ".bili-audio-button", 0, "to video", visible_only=True, pure=True)
+    time.sleep(3)
+    s = _bili_state(cdp)
+    back_ok = s.get("mask") == "none" and (s.get("coreW") or 0) > 0 and s.get("btn") == "音频播放"
+    _report("switch back to video", back_ok, "state=%s" % s)
+
+    # 5) Refined in-page play actions (immersive swipes + pause/play; seek/prev/next/episode).
+    media_playpage_suite(device, uid, cdp, w, h, "bilibili")
+
+    # 6) Back to home: hash/history back, falling back to the system BACK key.
+    cdp.eval("history.back()")
+    time.sleep(3)
+    if _bili_state(cdp).get("play"):
+        adb_shell(device, "input keyevent 4")
+        time.sleep(3)
+    left = not _bili_state(cdp).get("play")
+    _report("back to home", left, "left-play=%s href=%s" % (left, _href(cdp)))
+
+
+def iqiyi_open_nonvip(cdp, device):
+    """Open a NON-VIP card from the 电视剧 tab. VIP/paid items only allow a short preview,
+    so their progress bar cannot be seeked; non-VIP TV episodes can."""
+    js_click_selector(device, cdp, ".van-tab__text", 1, "电视剧 tab", visible_only=False)
+    time.sleep(3)
+    for _ in range(10):
+        r = cdp.eval(
+            "(function(){var sels=['.recommend-item','[class*=recommend-item]','[class*=video-item]',"
+            "'[class*=feed-item]','[class*=card]'];var a=[];"
+            "for(var s=0;s<sels.length;s++){a=document.querySelectorAll(sels[s]);if(a.length)break;}"
+            "for(var i=0;i<a.length;i++){var e=a[i];var t=(e.innerText||'');"
+            "if(t.indexOf('VIP')>=0)continue;var r=e.getBoundingClientRect();"
+            "if(r.width<40||r.height<40)continue;e.scrollIntoView({block:'center'});e.click();"
+            "return 'clicked';}return 'none';})()")
+        if r == "clicked":
+            print("[media]     iqiyi: opened a non-VIP 电视剧 card", flush=True)
+            time.sleep(9)
+            return True
+        time.sleep(1)
+    print("[media]     iqiyi: no non-VIP card found", flush=True)
+    return False
+
+
+def iqiyi_gestures(device, uid, cdp, w, h):
+    """iqiyi /iv profile (Vue SPA; cards/tabs react to DOM click, not input tap).
+
+    top tabs .van-tab__text            (推荐 / 电视剧 / 电影 / 综艺 / 儿童 / 动漫 / 纪录片)
+    cards    .swiper-img-box / .recommend-item   -> #/video?qipuId=...
+    player   .iqp-player containing <video> (blob/MSE; may open on a pre-roll ad)
+    """
+    # The startup phase may already be on the player page; go back so tabs are present.
+    if "#/video" in _href(cdp):
+        cdp.eval("history.back()")
+        time.sleep(3)
+
+    # 1) Top tabs: switch three distinct tabs, assert active + content changed.
+    ok_tab = 0
+    for i in range(3):
+        want = cdp.eval("(function(){var a=document.querySelectorAll('.van-tab__text');"
+                        "return (%d<a.length)?(a[%d].innerText||'').trim():'';})()" % (i, i))
+        if not js_click_selector(device, cdp, ".van-tab__text", i, "top tab %d" % i,
+                                 visible_only=False):
+            continue
+        time.sleep(2.5)
+        now = _active_text(cdp, ".van-tab--active .van-tab__text") or \
+            _active_text(cdp, ".van-tab--active")
+        ok_tab += _report("top tab %d %r" % (i, want), bool(now) and want in now,
+                          "active=%r" % now)
+    _report("top tabs switched", ok_tab >= 2, "%d/3" % ok_tab)
+
+    # 2) Open a NON-VIP 电视剧 card (VIP items can't seek) -> assert the <video> plays.
+    d = iqiyi_open_nonvip(cdp, device)
+    for _ in range(10):
+        m = _cdp_media(cdp)
+        if m:
+            break
+        time.sleep(2)
+    onvideo = "#/video" in _href(cdp)
+    _report("open video page (non-VIP)", d and onvideo, "href=%s" % _href(cdp))
+    m = _cdp_media(cdp)
+    _report("video present", bool(m), "state=%s" % (m,))
+    prog = cdp_video_progress(cdp, 3.0)
+    _report("video progressing", bool(prog) and prog[0] > 0.3,
+            "delta=%.2fs" % (prog[0] if prog else -1.0))
+
+    # 3) Refined in-page play actions (immersive swipes + pause/play; seek/prev/next/episode).
+    media_playpage_suite(device, uid, cdp, w, h, "iqiyi")
+
+    # 4) Back to the home page via the visible back button (fallback: history.back()).
+    hit = pp_find_sized(cdp, [".back-icon", "[class*=back-icon]", "[aria-label*=返回]"], 16, 16)
+    if hit:
+        cdp.eval("(function(){var e=document.querySelector(\"%s\");if(e)e.click();return 1;})()" % hit[0])
+        print("[media]     iqiyi: click visible back button (%s)" % hit[0], flush=True)
+    else:
+        cdp.eval("history.back()")
+    time.sleep(4)
+    back = "#/video" not in _href(cdp)
+    _report("back to home", back and "iqiyi.com" in _href(cdp), "href=%s" % _href(cdp))
+
+
+def perform_gestures(device, uid, cdp=None):
+    """Post-playback interaction (heuristic coords, best effort):
+    play/pause, bar seek ff/rew, swipe ff/rew, swipe up/down, volume down/up/mute,
+    next/prev, back home, switch tabs.
+    WebView content is a single node, so HTML controls cannot be enumerated; use ratio coords.
+    play/pause verified via log activity; volume via dumpsys audio streamVolume.
+    """
+    w, h = screen_size(device)
+    if cdp:
+        try:
+            href = (cdp.eval("location.href") or "").lower()
+        except Exception:
+            href = ""
+        if "bilibili" in href:
+            print("[media]   bilibili profile: structure-driven gestures", flush=True)
+            bilibili_gestures(device, uid, cdp, w, h)
+            return
+        if "iqiyi" in href:
+            print("[media]   iqiyi profile: structure-driven gestures", flush=True)
+            iqiyi_gestures(device, uid, cdp, w, h)
+            return
+    bar_y = 0.86   # approximate y of the video control bar (bottom)
+    mid_y = 0.50
+    step = 1.2
+
+    def vp():
+        try:
+            return (float(cdp.eval("window.innerWidth") or w),
+                    float(cdp.eval("window.innerHeight") or h))
+        except Exception:
+            return float(w), float(h)
+
+    def tap(fx, fy, note):
+        iw, ih = vp()
+        x, y = css_to_phys(cdp, device, fx * iw, fy * ih)
+        adb_shell(device, "input tap %d %d" % (x, y))
+        print("[media]     gesture: tap %s (%d,%d)" % (note, x, y), flush=True)
+        time.sleep(step)
+
+    def swipe(fx1, fy1, fx2, fy2, dur, note):
+        iw, ih = vp()
+        cx1, cy1, cx2, cy2 = fx1 * iw, fy1 * ih, fx2 * iw, fy2 * ih
+        # Draw the per-frame swipe trail (white-center dot/red line/arrow, 75ms step), then inject the real swipe.
+        if cdp:
+            print("[media]     trail(%s): %s"
+                  % (note, cdp.eval(SWIPE_TRAIL_JS % (int(cx1), int(cy1), int(cx2), int(cy2), 75))),
+                     flush=True)
+        x1, y1 = css_to_phys(cdp, device, cx1, cy1)
+        x2, y2 = css_to_phys(cdp, device, cx2, cy2)
+        adb_shell(device, "input swipe %d %d %d %d %d" % (x1, y1, x2, y2, dur))
+        print("[media]     gesture: swipe %s (%d,%d)->(%d,%d) %dms"
+              % (note, x1, y1, x2, y2, dur), flush=True)
+        time.sleep(max(1.5, dur / 1000.0 + 0.8))
+
+    def key(code, note):
+        adb_shell(device, "input keyevent %d" % code)
+        print("[media]     gesture: keyevent %d %s" % (code, note), flush=True)
+        time.sleep(step)
+
+    # 1) Tap once to reveal the control bar, then detect the progress-bar position live (varies per video).
+    tap(0.50, mid_y, "reveal controls")
+    bar = detect_progress_bar(device)
+    bar_y = bar[0] if bar else int(0.78 * h)
+    if bar:
+        print("[media]     progress bar detected: y=%d x=[%d..%d] fill_len=%d"
+              % (bar[0], bar[1], bar[2], bar[3]), flush=True)
+    else:
+        print("[media]     progress bar not detected; fallback y=%d" % bar_y, flush=True)
+
+    # 2) Play / pause: tap the player bottom-left play/pause button + verify via log activity & CDP.
+    st_play = _cdp_video(cdp)
+    d_play = activity_delta(device, uid, 2)
+    tap(0.042, 0.814, "pause (player play/pause button)")
+    st_pause = _cdp_video(cdp)
+    d_pause = activity_delta(device, uid, 2)
+    tap(0.042, 0.814, "play (player play/pause button)")
+    st_resume = _cdp_video(cdp)
+    d_resume = activity_delta(device, uid, 2)
+    vres = "OK" if (d_play > 0 and d_pause < d_play * 0.3 and d_resume > 0) else "INCONCLUSIVE"
+    print("[media]     verify play/pause(activity): playing=%d paused=%d resumed=%d -> %s"
+          % (d_play, d_pause, d_resume, vres), flush=True)
+    if cdp:
+        def _p(x):
+            return ("paused=%s t=%.1f" % (x["paused"], x["t"])) if x else "n/a"
+        print("[media]     verify play/pause(CDP): play[%s] pause[%s] resume[%s]"
+              % (_p(st_play), _p(st_pause), _p(st_resume)), flush=True)
+
+    # 3) Bar seek: tap current position +30s / -30s (verify via CDP currentTime).
+    seek0 = _cdp_video(cdp)
+    seek_ff = seek_rw = None
+    if bar:
+        by, bx1, bx2, blen = bar
+        bx_end = int(w * 0.94)
+        dur = (seek0 or {}).get("d") or 0
+        cur = (seek0 or {}).get("t") or 0
+        off = 30.0
+        span = float(bx_end - bx1) or 1.0
+
+        def _x_for(tsec, fallback_frac):
+            f = (tsec / dur) if dur > 0 else fallback_frac
+            f = max(0.0, min(1.0, f))
+            return int(bx1 + f * span)
+
+        print("[media]     progress bar detected: y=%d x=[%d..%d] fill_len=%d "
+              "cur=%.1fs dur=%.1fs" % (by, bx1, bx2, blen, cur, dur), flush=True)
+        # Click position = the bar point corresponding to current position +/- 30s.
+        plans = (
+            (_x_for(cur + off, 0.75), "fast-forward", ">>",
+             "fast-forward (progress bar, +%ds)" % int(off)),
+            (_x_for(cur - off, 0.25), "rewind", "<<",
+             "rewind (progress bar, -%ds)" % int(off)),
+        )
+        for bx, kind, lbl, note in plans:
+            if cdp:
+                mx, my = phys_to_css(cdp, device, bx, by)   # marker draws in CSS space
+                print("[media]     mark(%s): %s"
+                      % (note, cdp.eval(SEEK_MARK_JS % (mx, my, mx, my, lbl, mx, my))), flush=True)
+            adb_shell(device, "input tap %d %d" % (bx, by))
+            print("[media]     gesture: tap %s (%d,%d)" % (note, bx, by), flush=True)
+            time.sleep(1.5)
+            if kind == "fast-forward":
+                seek_ff = _cdp_video(cdp)
+            else:
+                seek_rw = _cdp_video(cdp)
+    else:
+        # Do not tap randomly when no bar is detected, so the click always lands on the real bar.
+        print("[media]     progress bar not found; skip seek taps", flush=True)
+    if cdp and seek0:
+        def _t(x):
+            return ("%.1f" % x["t"]) if x else "n/a"
+        print("[media]     verify seek(CDP): t=%s -> ff=%s -> rew=%s"
+              % (_t(seek0), _t(seek_ff), _t(seek_rw)), flush=True)
+
+    # 4) Horizontal swipe: right=ff, left=rew.
+    swipe(0.30, mid_y, 0.75, mid_y, 500, "fast-forward (swipe right)")
+    swipe(0.75, mid_y, 0.30, mid_y, 500, "rewind (swipe left)")
+
+    # Vertical swipe range: dynamically avoid the detected bar_y (60px margin),
+    # so vertical swipes neither land on the bar nor start/end on it.
+    v_top = int(0.25 * h)
+    v_bot = min(int(0.62 * h), bar_y - 60)
+    if v_bot <= v_top + 40:
+        v_top, v_bot = int(0.30 * h), int(0.60 * h)
+    vt_f, vb_f = v_top / float(h), v_bot / float(h)
+    print("[media]     vertical swipe range: y=[%d..%d] (bar_y=%d)"
+          % (v_top, v_bot, bar_y), flush=True)
+
+    # 4b) Left-half vertical swipe: brightness (player gesture, left = brightness), avoiding the bar.
+    swipe(0.25, vb_f, 0.25, vt_f, 500, "brightness up (left-half swipe up)")
+    swipe(0.25, vt_f, 0.25, vb_f, 500, "brightness down (left-half swipe down)")
+
+    # 5) Right-half vertical swipe: volume +/- (player gesture; x=0.5 on the divider is not recognized)
+    #    plus media volume keys, and verify. Also avoids the bar.
+    vol0 = media_volume(device)
+    swipe(0.75, vb_f, 0.75, vt_f, 500, "volume up (right-half swipe up)")
+    key(24, "volume up")
+    vol_up = media_volume(device)
+    swipe(0.75, vt_f, 0.75, vb_f, 500, "volume down (right-half swipe down)")
+    key(25, "volume down")
+    vol_down = media_volume(device)
+    print("[media]     verify volume(STREAM_MUSIC): before=%s after-up=%s after-down=%s"
+          % (vol0, vol_up, vol_down), flush=True)
+
+    # 6) Player controls: prefer uiautomator for accurate targeting, fewer random taps.
+    ui = ui_dump(device)
+    if ui is not None:
+        print("[media]     uia dump ok (%d nodes)" % len(list(ui.iter('node'))), flush=True)
+        for keys, note in ((["暂停", "播放"], "play/pause"),
+                           (["下一集", "下一首", "下一个", "下一"], "next"),
+                           (["上一集", "上一首", "上一个", "上一"], "prev"),
+                           (["全屏"], "fullscreen")):
+            nodes = ui_find(ui, keys)
+            if nodes:
+                b, t, d = nodes[0]
+                tap_bounds(device, b, "%s [uia %r]" % (note, t or d))
+            else:
+                print("[media]     uia: %s not exposed" % note, flush=True)
+    else:
+        print("[media]     uia dump unavailable (page not idle during playback)", flush=True)
+
+    # 7) Next / previous (small heuristic fallback).
+    tap(0.92, 0.92, "next track (heuristic)")
+    tap(0.08, 0.92, "previous track (heuristic)")
+
+    # uiautomator often cannot dump during playback, so prefer CDP to find controls by text.
+    # These controls usually need a page tap to reveal the control bar, so tap once and retry.
+    def find_tap(keys, note, maxn=1):
+        if cdp_find(device, cdp, keys, note, maxn=maxn, w=w, h=h):
+            return True
+        return uia_tap_controls(device, keys, note, maxn=maxn) > 0
+
+    def reveal_and_find(keys, note, maxn=1):
+        if find_tap(keys, note, maxn=maxn):
+            return True
+        tap(0.5, 0.42, "reveal controls (%s)" % note)
+        time.sleep(1.2)
+        return find_tap(keys, note, maxn=maxn)
+
+    def pick(open_keys, note, value_keys):
+        if not reveal_and_find(open_keys, "%s menu" % note, maxn=1):
+            return
+        time.sleep(1.0)
+        if cdp_find(device, cdp, value_keys, "%s options" % note, maxn=8, w=w, h=h):
+            return
+        uia_tap_controls(device, value_keys, "%s options" % note, maxn=8)
+
+    def js_play(note):
+        if not cdp:
+            return
+        cdp.send("Runtime.evaluate", {
+            "expression": "(function(){try{var m=document.querySelector('video,audio');"
+                          "if(!m)return 'no-media';m.muted=false;m.play();return 'play';}"
+                          "catch(e){return 'ERR:'+e;}})()",
+            "userGesture": True, "returnByValue": True})
+        print("[media]     js play (%s)" % note, flush=True)
+
+    # 8) Playback speed: open the speed menu and tap each option.
+    pick(["倍速", "速度", "播放速度", "变速"], "speed",
+         ["0.5X", "0.75X", "1.0X", "1.25X", "1.5X", "2.0X",
+          "0.5x", "1.0x", "1.5x", "2.0x", "正常"])
+
+    # 9) Resolution: open the quality menu and tap each option.
+    pick(["清晰度", "分辨率", "画质"], "resolution",
+         ["4K", "1080P", "720P", "480P", "360P", "蓝光", "超清", "高清", "标清", "自动"])
+
+    # 10) Episodes: open the episode list and tap one.
+    if reveal_and_find(["选集", "剧集", "选集列表"], "episodes", maxn=1):
+        time.sleep(1.0)
+        find_tap(["第1集", "第01集", "第2集", "第02集"], "pick episode", maxn=2)
+
+    # 11) Bilibili audio<->video switch: "视频播放" (audio -> video) then
+    #     "切换音频" (video -> audio). While on video, exercise seek + swipe.
+    if reveal_and_find(["视频播放", "切换到视频", "视频画面"], "switch to video", maxn=1):
+        time.sleep(2)
+        js_play("after switch-to-video")
+        seek0v = _cdp_video(cdp)
+        barv = detect_progress_bar(device)
+        if barv:
+            byv, bx1v, _, _ = barv
+            bxE = int(w * 0.94)
+            curv = (seek0v or {}).get("t") or 0
+            durv = (seek0v or {}).get("d") or 0
+
+            def _xv(ts, fb):
+                f = (ts / durv) if durv > 0 else fb
+                f = max(0.0, min(1.0, f))
+                return int(bx1v + f * (bxE - bx1v))
+
+            for bxx, lbl, note in ((_xv(curv + 30, 0.75), ">>", "fast-forward (video, +30s)"),
+                                   (_xv(curv - 30, 0.25), "<<", "rewind (video, -30s)")):
+                if cdp:
+                    cdp.eval(SEEK_MARK_JS % (bxx, byv, bxx, byv, lbl, bxx, byv))
+                adb_shell(device, "input tap %d %d" % (bxx, byv))
+                print("[media]     gesture: tap %s (%d,%d)" % (note, bxx, byv), flush=True)
+                time.sleep(1.5)
+        else:
+            print("[media]     (video page) progress bar not found; skip seek", flush=True)
+        swipe(0.30, mid_y, 0.75, mid_y, 500, "video ff (swipe right)")
+        swipe(0.75, mid_y, 0.30, mid_y, 500, "video rew (swipe left)")
+    if reveal_and_find(["音频播放", "切换音频", "切换到音频", "听音频", "音频画面"],
+                       "switch to audio", maxn=1):
+        time.sleep(2)
+        js_play("after switch-to-audio")
+
+    # 12) Visible "back to home": must be a real, user-visible control (no
+    #     invisible heuristic taps), so the effect can be seen on screen.
+    if find_tap(["返回", "首页", "主页", "返回首页", "Back"], "back home (visible)", maxn=1):
+        print("[media]     back-to-home via visible control", flush=True)
+    else:
+        print("[media]     back-home control not found; skip (no invisible taps)", flush=True)
+    time.sleep(2)
+
+    # 13) Tabs: switch a few home/top tabs (auto-discovered), play each and,
+    #     when a progress bar exists, seek on that tab's page.
+    tab_keys = ["推荐", "精选", "热门", "直播", "电视剧", "电影", "综艺", "儿童",
+                "动漫", "番剧", "纪录片", "音乐", "游戏", "知识", "资讯", "频道",
+                "发现", "我的"]
+    switched = 0
+    for _ in range(3):
+        # Tap a *different* tab each round (index = switched), not the same first match.
+        tapped = cdp_find_at(device, cdp, tab_keys, "switch tab", switched, w=w, h=h) \
+            or find_tap(tab_keys, "switch tab #%d" % (switched + 1), maxn=1)
+        if not tapped:
+            break
+        switched += 1
+        time.sleep(2)
+        js_play("after tab #%d" % switched)
+        time.sleep(2)
+        bart = detect_progress_bar(device)
+        if bart and cdp:
+            byt, bx1t, _, _ = bart
+            bxt = int(bx1t + 0.75 * (int(w * 0.94) - bx1t))
+            cdp.eval(SEEK_MARK_JS % (bxt, byt, bxt, byt, ">>", bxt, byt))
+            adb_shell(device, "input tap %d %d" % (bxt, byt))
+            print("[media]     gesture: tap fast-forward (tab page) (%d,%d)" % (bxt, byt),
+                  flush=True)
+            time.sleep(1.5)
+    print("[media]     switched %d tab(s)" % switched, flush=True)
+    time.sleep(1)
+
+
+def test_url(device, url, ua, load_wait, attempts, sustain, idx,
+             gestures=True, cdp_enabled=True):
+    print("[media] (%d) url=%s" % (idx, url), flush=True)
+    adb_shell(device, "am force-stop %s" % PKG)
+    run(["-s", device, "logcat", "-c"])
+    # --force-debug: force WebView remote debugging even in release (for CDP injection/assertions).
+    cmd = "am start -W -n %s -e url '%s' --es cr '--force-debug'" % (ACTIVITY, url)
+    if ua:
+        cmd += " -e ua '%s'" % ua
+    rc, out, err = adb_shell(device, cmd, timeout=60)
+    if rc != 0:
+        print("[media]     launch failed: %s" % (err.strip() or out.strip()), flush=True)
+    time.sleep(load_wait)
+    dismiss_ime(device)
+
+    # Home: find a tab and enter the app's inner page through it (if exposed).
+    uia_tap_controls(device, ["推荐", "精选", "电视剧", "电影", "综艺", "儿童",
+                              "动漫", "纪录片", "频道", "发现", "音乐",
+                              "首页", "我的"], "home tab enter", maxn=1)
+    time.sleep(2)
+
+    cdp = None
+    if cdp_enabled:
+        cdp = CDP(device)
+        if cdp.connect():
+            print("[media]     CDP connected", flush=True)
+            # No test-injected overlay: a ripple/trail must not cover the native H5 UI.
+        else:
+            print("[media]     CDP unavailable (WebView debugging not enabled?)", flush=True)
+            cdp = None
+
+    uid = app_uid(device)
+    w, h = screen_size(device)
+
+    def click_first(selector, note):
+        """Tap the center of the first element matching a CSS selector (not random)."""
+        if not cdp:
+            return False
+        r = cdp.eval("(function(){try{var e=document.querySelector(\"%s\");"
+                     "if(!e)return 'none';e.scrollIntoView({block:'center'});"
+                     "var b=e.getBoundingClientRect();"
+                     "return JSON.stringify({x:Math.round(b.left+b.width/2),"
+                     "y:Math.round(b.top+b.height/2)});}catch(e){return 'ERR:'+e;}})()" % selector)
+        if not r or r == "none" or str(r).startswith("ERR"):
+            return False
+        try:
+            d = json.loads(r)
+            x, y = css_to_phys(cdp, device, d["x"], d["y"])
+            adb_shell(device, "input tap %d %d" % (x, y))
+            print("[media]     tap link (%s) at (%d,%d)" % (note, x, y), flush=True)
+            return True
+        except Exception:
+            return False
+
+    def js_play(note):
+        """Ask the page to play its first <video>/<audio> (with a user gesture)."""
+        if not cdp:
+            return
+        r = cdp.send("Runtime.evaluate", {
+            "expression": "(function(){try{var m=document.querySelector('video,audio');"
+                          "if(!m)return 'no-media';m.muted=false;m.play();return 'play';}"
+                          "catch(e){return 'ERR:'+e;}})()",
+            "userGesture": True, "returnByValue": True})
+        print("[media]     js play (%s) -> %s" % (note, (r or {}).get("result", {}).get("value")),
+              flush=True)
+
+    def media_count():
+        if not cdp:
+            return 0
+        try:
+            return int(cdp.eval("document.querySelectorAll('video,audio').length") or 0)
+        except Exception:
+            return 0
+
+    # Media-aware startup (no blind/random tapping):
+    #   1) if the page actually has a <video>/<audio>, play it;
+    #   2) else click a visible play control / content tab (text-driven) and retry.
+    started = False
+    v = a = c = 0
+    au = False
+    mc = media_count()
+    print("[media]   media elements on page: %d" % mc, flush=True)
+    if mc > 0:
+        js_play("media element present")
+        time.sleep(3)
+        dismiss_ime(device)
+        v, a, c, au = signals(device, uid)
+
+    if not (v > 0 or a > 0 or au):
+        if "bilibili" in (url or "").lower():
+            # Bilibili H5 (vehicle-web): FM home, open a card to start playback.
+            print("[media]   bilibili: DOM-click an FM/recommend card to start playback", flush=True)
+            js_click_selector(device, cdp, ".bili-nav__tab", 1, "FM tab", visible_only=False)
+            time.sleep(2)
+            for sel, note in ((".bili-fm-pin-card", "FM card"),
+                              (".bili-primary-rcmd-card", "recommend card"),
+                              (".bili-video-horizontal", "video card")):
+                if js_click_selector(device, cdp, sel, 0, note, visible_only=True):
+                    time.sleep(3)
+                    dismiss_ime(device)
+                    js_play("after %s" % note)
+                    time.sleep(3)
+                    v, a, c, au = signals(device, uid)
+                    if _cdp_media(cdp) or v > 0 or a > 0 or au:
+                        break
+        if "iqiyi" in (url or "").lower():
+            # iqiyi /iv: open a NON-VIP 电视剧 card (VIP items only preview a few minutes).
+            print("[media]   iqiyi: open a non-VIP 电视剧 card", flush=True)
+            iqiyi_open_nonvip(cdp, device)
+            for _ in range(8):
+                time.sleep(2)
+                dismiss_ime(device)
+                js_play("after iqiyi card")
+                v, a, c, au = signals(device, uid)
+                if _cdp_media(cdp) or v > 0 or a > 0 or au:
+                    break
+        media_ok = _cdp_media(cdp) if cdp else None
+        if not (media_ok or v > 0 or a > 0 or au):
+            plans = (
+                (["播放", "视频播放", "播放视频", "开始播放", "立即播放", "play"], "play control"),
+                (["推荐", "精选", "电视剧", "电影", "综艺", "纪录片", "动漫", "频道", "音乐"], "content tab"),
+            )
+            for keys, note in plans:
+                if cdp_find(device, cdp, keys, note, maxn=1) or \
+                        uia_tap_controls(device, keys, note, maxn=1) > 0:
+                    time.sleep(2)
+                    dismiss_ime(device)
+                    js_play("after %s" % note)
+                    time.sleep(3)
+                    v, a, c, au = signals(device, uid)
+                    if _cdp_media(cdp) or v > 0 or a > 0 or au:
+                        break
+            # Lastly, click the first plausible video link/poster (still selector-driven).
+            if not (v > 0 or a > 0 or au):
+                for sel, note in (("a[href*=\"/v_\"]", "video link /v_"),
+                                  ("a[href*=\"play\"]", "play link"),
+                                  ("[class*=\"video\"] a", "video card"),
+                                  ("a[href]", "first link")):
+                    if click_first(sel, note):
+                        time.sleep(2)
+                        dismiss_ime(device)
+                        js_play("after %s" % note)
+                        time.sleep(3)
+                        v, a, c, au = signals(device, uid)
+                        if v > 0 or a > 0 or au:
+                            break
+
+    cdp_media = _cdp_media(cdp) if cdp else None
+    started = (v > 0 or a > 0 or au) or bool(cdp_media)
+    if not started:
+        print("[media]   no playback (media_present=%d video=%d audio=%d audio_started=%s codec=%d) -> FAIL"
+              % (mc, v, a, au, c), flush=True)
+        return False
+    print("[media]     playback started: video=%d audio=%d audio_started=%s cdp_media=%s"
+          % (v, a, au, cdp_media), flush=True)
+
+    # Sustained-playback check. Prefer CDP (SPAs report frames via a single node/page),
+    # else fall back to device frame/ AudioPlayback signals.
+    if cdp_media:
+        print("[media]   confirm sustained playback for %ds via CDP (%s paused=%s) ..."
+              % (sustain, cdp_media["tag"], cdp_media["paused"]), flush=True)
+        deadline = time.time() + sustain
+        while time.time() < deadline:
+            time.sleep(2)
+            dismiss_ime(device)
+        prog = cdp_video_progress(cdp, 2.0)
+        sustained = bool(prog) and prog[0] > 0.3
+        res = "PASS" if sustained else "FAIL"
+        print("[media]   media %s t=%.1f->%.1f delta=%.2fs -> %s"
+              % (cdp_media["tag"], (prog[1] if prog else -1), (prog[2] if prog else -1),
+                 (prog[0] if prog else -1), res), flush=True)
+    else:
+        dismiss_ime(device)
+        v0, a0, c0, _ = signals(device, uid)
+        print("[media]   confirm sustained playback for %ds (v0=%d a0=%d) ..." % (sustain, v0, a0),
+              flush=True)
+        deadline = time.time() + sustain
+        while time.time() < deadline:
+            time.sleep(2)
+            dismiss_ime(device)
+        v1, a1, c1, au = signals(device, uid)
+        sustained = (v1 > v0) or (a1 > a0) or au
+        res = "PASS" if sustained else "FAIL"
+        print("[media]   video %d->%d audio %d->%d audio_started=%s codec=%d -> %s"
+              % (v0, v1, a0, a1, au, c1, res), flush=True)
+
+    # Fullscreen/address-bar check: after playback the demo logs FULLSCREEN on and the top handle dims after 2s.
+    fson, fsoff, hshow, hhide, tshow, thide = fullscreen_state(device)
+    if fson > 0:
+        print("[media]   verify fullscreen: FULLSCREEN on x%d (address bar hidden) handle(show=%d hide=%d) "
+              "toolbar(show=%d hide=%d) -> OK" % (fson, hshow, hhide, tshow, thide), flush=True)
+    else:
+        print("[media]   verify fullscreen: no demo FULLSCREEN on observed (address-bar test n/a for "
+              "this page; HTML5 fullscreen is asserted separately below) -> INCONCLUSIVE", flush=True)
+
+    # HTML5 fullscreen assertion: CDP calls <video>.requestFullscreen() with userGesture, then exits,
+    # reading HTML5 FULLSCREEN show/hide from logcat (triggered by the SDK onShowCustomView bridge).
+    if cdp:
+        run(["-s", device, "logcat", "-c"])
+        rq = cdp.send("Runtime.evaluate", {
+            "expression": "(function(){try{var v=document.querySelector('video');"
+                          "if(!v)return 'no-video';"
+                          "var f=v.requestFullscreen||v.webkitRequestFullscreen;"
+                          "if(!f)return 'no-api';f.call(v);return 'requested';}"
+                          "catch(e){return 'ERR:'+e;}})()",
+            "userGesture": True, "returnByValue": True})
+        rqv = (rq or {}).get("result", {}).get("value")
+        time.sleep(2)
+        cdp.send("Runtime.evaluate", {
+            "expression": "(function(){try{if(document.exitFullscreen)"
+                          "document.exitFullscreen();else if(document.webkitExitFullscreen)"
+                          "document.webkitExitFullscreen();return 'exited';}"
+                          "catch(e){return 'ERR:'+e;}})()",
+            "userGesture": True, "returnByValue": True})
+        time.sleep(1)
+        hshow, hhide = html5_fullscreen_state(device)
+        hv = "OK" if hshow > 0 else ("INCONCLUSIVE" if rqv == "no-video" else "FAIL")
+        print("[media]   verify html5-fullscreen: request=%s show=%d hide=%d -> %s"
+              % (rqv, hshow, hhide, hv), flush=True)
+
+    if sustained and gestures:
+        print("[media]   gestures (best-effort heuristic; effects site-dependent, see verify lines) ...", flush=True)
+        perform_gestures(device, uid, cdp)
+
+    if cdp:
+        cdp.close()
+    return sustained
+
+
+def main():
+    ap = argparse.ArgumentParser(
+        description="afree demo audio/video playback test (random taps; detect ForwardVideoFrame / AudioPlayback state:started)")
+    ap.add_argument("--device", "-s", required=True, help="adb serial, e.g. 30.207.82.150:62464")
+    ap.add_argument("--ua", help="override the default UserAgent")
+    ap.add_argument("--url", action="append", default=[], help="extra url (repeatable; duplicates of defaults are not retested)")
+    ap.add_argument("--only", help="only test urls containing this substring (e.g. bilibili)")
+    ap.add_argument("--runtime", type=int, default=8, help="first-screen load wait in seconds (default 8)")
+    ap.add_argument("--taps", type=int, default=6,
+                    help="playback-start retries on play controls/tabs (default 6; no random taps)")
+    ap.add_argument("--sustain", type=int, default=8, help="sustained-playback confirmation seconds (default 8)")
+    ap.add_argument("--seed", type=int, help="random seed (for reproduction)")
+    ap.add_argument("--no-gestures", dest="gestures", action="store_false",
+                    help="do not run play control/swipe/tab gestures after playback starts")
+    ap.add_argument("--no-cdp", dest="cdp", action="store_false",
+                    help="disable CDP (by default CDP injects a CSS ripple + reads <video> state for assertions)")
+    args = ap.parse_args()
+
+    if args.seed is not None:
+        random.seed(args.seed)
+
+    ua = args.ua if args.ua else DEFAULT_UA
+    urls = list(DEFAULT_URLS)
+    for u in args.url:
+        if u not in urls:
+            urls.append(u)
+    if args.only:
+        urls = [u for u in urls if args.only in u]
+
+    if not urls:
+        print("[media] no urls to test", file=sys.stderr)
+        return 2
+
+    print("[media] device=%s urls=%d ua=%s%s"
+          % (args.device, len(urls),
+             (args.ua and "[override] ") or "[default] ",
+             ua[:80] + ("..." if len(ua) > 80 else "")), flush=True)
+
+    passed = 0
+    set_touch_visual(args.device, True)   # enable tap/swipe visualization
+    try:
+        for i, u in enumerate(urls, 1):
+            ok = test_url(args.device, u, ua, args.runtime, args.taps,
+                          args.sustain, i, args.gestures, args.cdp)
+            passed += 1 if ok else 0
+    finally:
+        set_touch_visual(args.device, False)
+
+    print("[media] ==================== Summary ====================", flush=True)
+    for u in urls:
+        print("[media]   %s" % u, flush=True)
+    print("[media] passed %d / %d" % (passed, len(urls)), flush=True)
+    return 0 if passed == len(urls) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
