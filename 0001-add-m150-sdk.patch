@@ -0,0 +1,408 @@
+package com.afree.chromium;
+
+/**
+ * Afree SDK fork note.
+ *
+ * Original source: android_webview/glue/java/src/com/android/webview/chromium/WebViewChromiumFactoryProvider.java
+ * Purpose: Factory provider: initializes AwBrowserProcess, creates WebViewChromium, implements WebViewFactoryProvider
+ */
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.res.Configuration;
+import android.net.Uri;
+import android.os.Looper;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+
+import com.afree.webkit.CookieManager;
+import com.afree.webkit.GeolocationPermissions;
+import com.afree.webkit.ServiceWorkerController;
+import com.afree.webkit.TracingController;
+import com.afree.webkit.ValueCallback;
+import com.afree.webkit.WebIconDatabase;
+import com.afree.webkit.WebStorage;
+import com.afree.webkit.WebView;
+import com.afree.webkit.WebViewDatabase;
+import com.afree.webkit.WebViewFactoryProvider;
+import com.afree.webkit.WebViewProvider;
+
+import org.chromium.android_webview.AwBrowserProcess;
+import org.chromium.android_webview.AwContents;
+import org.chromium.android_webview.AwContentsStatics;
+import org.chromium.android_webview.AwDevToolsServer;
+import org.chromium.android_webview.common.AwResource;
+import org.chromium.android_webview.common.CommandLineUtil;
+import org.chromium.android_webview.common.WebViewCachedFlags;
+import org.chromium.base.ApkInfo;
+import org.chromium.base.Callback;
+import org.chromium.base.CommandLine;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
+import org.chromium.base.PathUtils;
+import org.chromium.base.ThreadUtils;
+import org.chromium.base.library_loader.LibraryLoader;
+import org.chromium.base.library_loader.LibraryProcessType;
+import org.chromium.ui.base.ResourceBundle;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.util.List;
+
+public class AfreeWebViewFactory implements WebViewFactoryProvider {
+    private static final String TAG = "AfreeWebViewFactory";
+
+    private static AfreeWebViewFactory sInstance;
+    private boolean mInitialized;
+
+    private CookieManagerAdapter mCookieManagerAdapter;
+    private WebStorageAdapter mWebStorageAdapter;
+    private GeolocationPermissionsAdapter mGeolocationPermissionsAdapter;
+    private ServiceWorkerControllerAdapter mServiceWorkerControllerAdapter;
+    private TracingControllerAdapter mTracingControllerAdapter;
+    private WebViewDatabaseAdapter mWebViewDatabaseAdapter;
+    private WebIconDatabaseAdapter mWebIconDatabaseAdapter;
+    private AwDevToolsServer mDevToolsServer;
+
+    public static synchronized AfreeWebViewFactory getInstance() {
+        if (sInstance == null) sInstance = new AfreeWebViewFactory();
+        return sInstance;
+    }
+
+    private AfreeWebViewFactory() {}
+
+    /** Default data-directory suffix (-> <dataDir>/app_webview_afree_webview). */
+    public static final String DEFAULT_DATA_DIR_SUFFIX = "afree_webview";
+
+    private String mDataDirSuffix = DEFAULT_DATA_DIR_SUFFIX;
+
+    /** Data-directory suffix actually used for this process (set at init). */
+    public String getDataDirectorySuffix() {
+        return mDataDirSuffix;
+    }
+
+    public synchronized void init(Context appContext) {
+        init(appContext, null, null);
+    }
+
+    public synchronized void init(Context appContext, String[] chromiumSwitches) {
+        init(appContext, chromiumSwitches, null);
+    }
+
+    /**
+     * @param dataDirSuffix if non-null, the per-process user-data directory becomes
+     *     {@code <appDataDir>/app_webview_<dataDirSuffix>} instead of the default
+     *     {@code app_webview_afree_webview}. Must be chosen before init (process-wide,
+     *     cannot change once the native library is loaded).
+     */
+    public synchronized void init(Context appContext, String[] chromiumSwitches,
+                                  String dataDirSuffix) {
+        if (mInitialized) return;
+        if (dataDirSuffix != null && !dataDirSuffix.isEmpty()) {
+            mDataDirSuffix = dataDirSuffix;
+        }
+
+        Context ctx = appContext.getApplicationContext();
+        ContextUtils.initApplicationContext(ctx);
+
+        AwResource.setResources(ctx.getResources());
+        AwResource.setConfigKeySystemUuidMapping(
+                ctx.getResources().getIdentifier(
+                        "config_key_system_uuid_mapping", "array",
+                        ctx.getPackageName()));
+
+        // Must be sorted ascending: getLocalePakResourcePath() uses
+        // Arrays.binarySearch on this list.
+        ResourceBundle.setAvailablePakLocales(
+                new String[] {"de", "en-US", "ja", "ru", "zh-CN", "zh-HK", "zh-TW"});
+
+        CommandLine.init(new String[] {});
+        // Baseline flags (lowest priority).
+        // Default to MULTI-PROCESS (sandboxed renderer). The demo can switch to
+        // single-process by passing --single-process via the webview-command-line
+        // file or the "-e cr" extra (which overrides this baseline).
+        CommandLine.getInstance().appendSwitch("webview-sandboxed-renderer");
+        // Enable VLOG logging to diagnose the rendering path.
+        CommandLine.getInstance().appendSwitchWithValue("v", "1");
+        CommandLine.getInstance().appendSwitch("enable-logging=stderr");
+        // Merge /data/local/tmp/webview-command-line (mid priority: overrides
+        // baseline). Matches system WebView's CommandLineUtil.initCommandLine().
+        String[] fileSwitches = readCommandLineFile(CommandLineUtil.WEBVIEW_COMMAND_LINE_FILE);
+        if (fileSwitches != null && fileSwitches.length > 0) {
+            CommandLine.getInstance().appendSwitchesAndArguments(fileSwitches);
+            Log.i(TAG, "Merged webview-command-line: " + java.util.Arrays.toString(fileSwitches));
+        }
+        // Append chromium switches passed in from the embedding app (demo's
+        // "-e cr" extra). Highest priority: overrides the file. Must happen
+        // before loadLibrary() below, which calls switchToNativeImpl() and
+        // makes Java-side append a no-op.
+        if (chromiumSwitches != null && chromiumSwitches.length > 0) {
+            CommandLine.getInstance().appendSwitchesAndArguments(chromiumSwitches);
+            Log.i(TAG, "Applied apk chromium switches: " + java.util.Arrays.toString(chromiumSwitches));
+        }
+        // If --single-process was explicitly requested (file or "-e cr"), drop
+        // the default --webview-sandboxed-renderer so isMultiProcess()==false and
+        // the renderer runs in-process without a warmUp'd sandboxed process.
+        if (CommandLine.getInstance().hasSwitch("single-process")) {
+            CommandLine.getInstance().removeSwitch("webview-sandboxed-renderer");
+            Log.i(TAG, "single-process requested: removed webview-sandboxed-renderer");
+        }
+
+        WebViewCachedFlags.init(
+                ctx.getSharedPreferences("WebViewChromiumPrefs", Context.MODE_PRIVATE));
+
+        try {
+            System.loadLibrary("webviewchromium");
+            Log.i(TAG, "libwebviewchromium loaded");
+        } catch (Throwable t) {
+            Log.e(TAG, "Failed to load libwebviewchromium", t);
+            throw new RuntimeException(t);
+        }
+
+        // Load plat_support for DrawFunctor JNI registration
+        try {
+            System.loadLibrary("webviewchromium_plat_support");
+            Log.i(TAG, "libwebviewchromium_plat_support loaded");
+        } catch (Throwable t) {
+            Log.w(TAG, "Failed to load plat_support: " + t.getMessage());
+        }
+
+        // Set up the hardware draw function table (functor mechanism) BEFORE
+        // startForTesting(): aw_main_delegate.cc's IsUsingVulkan() reads
+        // g_draw_fn_function_table->query_render_mode() during browser process
+        // startup, so the table must already be set, otherwise it falls back to
+        // the GL/ANGLE path and crashes on Android 16 (Vulkan-only HWUI).
+        try {
+            Class<?> dc = Class.forName("com.android.webview.chromium.DrawFunctor");
+            java.lang.reflect.Method m = dc.getDeclaredMethod("getDrawFnFunctionTable");
+            m.setAccessible(true);
+            long fnTable = (Long) m.invoke(null);
+            if (fnTable != 0) {
+                org.chromium.android_webview.gfx.AwDrawFnImpl.setDrawFnFunctionTable(fnTable);
+                Log.i(TAG, "DrawFn table set: 0x" + Long.toHexString(fnTable));
+            } else {
+                Log.w(TAG, "DrawFn table is 0");
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "DrawFn table setup failed: " + e.getMessage());
+        }
+
+        // Set up the software draw function table (access_pixels / release_pixels).
+        // This is key for software-compositing hardware buffer content such as
+        // video frames to the screen. Normal WebView sets this in
+        // initPlatSupportLibrary(); missing it causes video to decode/play audio
+        // but not display on screen.
+        try {
+            Class<?> gu = Class.forName("com.android.webview.chromium.GraphicsUtils");
+            java.lang.reflect.Method m = gu.getDeclaredMethod("getDrawSWFunctionTable");
+            m.setAccessible(true);
+            long swTable = (Long) m.invoke(null);
+            if (swTable != 0) {
+                AwContents.setAwDrawSWFunctionTable(swTable);
+                Log.i(TAG, "DrawSW table set: 0x" + Long.toHexString(swTable));
+            } else {
+                Log.w(TAG, "DrawSW table is 0");
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "DrawSW table setup failed: " + e.getMessage());
+        }
+
+        // Use the (optionally) overridden data-directory suffix so a session can get an
+        // isolated user-data dir ("incognito"): <dataDir>/app_webview_<suffix>.
+        AwBrowserProcess.loadLibrary(mDataDirSuffix);
+        Log.i(TAG, "AwBrowserProcess.loadLibrary data-dir suffix=" + mDataDirSuffix);
+        // Configure the child process launcher so the sandboxed renderer uses
+        // LibraryProcessType.PROCESS_WEBVIEW_CHILD (the default PROCESS_CHILD is
+        // rejected by android_webview/lib/webview_entry_point.cc). Use the
+        // "ForTesting" variant: isExternalService=false matches the demo's
+        // exported=false SandboxedProcessService (no BIND_EXTERNAL_SERVICE), and
+        // it uses the embedding app's package (not a WebView provider package).
+        AwBrowserProcess.configureChildProcessLauncherForTesting();
+        AwBrowserProcess.startForTesting();
+
+        // Match system WebView: enable WebView remote debugging (DevTools socket)
+        // automatically on userdebug/debuggable builds, so CDP can inject CSS/JS and
+        // assert <video> state. Also honor the `--force-debug` switch (passed via
+        // `-e cr '--force-debug'`) to force it on release builds for testing.
+        boolean forceDebug = false;
+        if (chromiumSwitches != null) {
+            for (String s : chromiumSwitches) {
+                if ("--force-debug".equals(s)) {
+                    forceDebug = true;
+                } else if (s.startsWith("--force-debug=")) {
+                    String v = s.substring("--force-debug=".length()).trim()
+                            .toLowerCase(java.util.Locale.ROOT);
+                    forceDebug = v.equals("true") || v.equals("1") || v.equals("yes");
+                }
+                if (forceDebug) break;
+            }
+        }
+        if (ApkInfo.isDebugAndroidOrApp() || forceDebug) {
+            ThreadUtils.runOnUiThreadBlocking(() -> setWebContentsDebuggingEnabled(true));
+            Log.i(TAG, "WebContents debugging enabled (debuggable="
+                    + ApkInfo.isDebugAndroidOrApp() + ", force=" + forceDebug + ")");
+        }
+
+        // Rendering path: AwContents.java passes ForceAuxiliaryBitmapRendering.sResult
+        // (= !AwContentsJni.get().hasRequiredHardwareExtensions(), i.e. true when the
+        // device lacks the required hardware draw extensions) to OnDraw. The afree
+        // OnDraw removes the "!force_auxiliary_bitmap_rendering" condition so the
+        // hardware path is used whenever the canvas is accelerated and attached (the
+        // draw functor comes from the DrawSW function table above); the software
+        // fallback uses OnDrawSoftwareAuxiliary (software_canvas=false, skipping the
+        // compositor consumer check) for auxiliary-bitmap compositing. No reflection
+        // setup needed.
+
+        mInitialized = true;
+        Log.i(TAG, "AfreeWebViewFactory initialized");
+
+        mCookieManagerAdapter = new CookieManagerAdapter();
+        mWebStorageAdapter = new WebStorageAdapter();
+        mGeolocationPermissionsAdapter = new GeolocationPermissionsAdapter();
+        mServiceWorkerControllerAdapter = new ServiceWorkerControllerAdapter();
+        mTracingControllerAdapter = new TracingControllerAdapter();
+        mWebViewDatabaseAdapter = new WebViewDatabaseAdapter();
+        mWebIconDatabaseAdapter = new WebIconDatabaseAdapter();
+
+        WebView.setFactory(this);
+    }
+
+    // Reads /data/local/tmp/webview-command-line (same file the system WebView
+    // uses via CommandLineUtil.initCommandLine()). Returns the tokenized args,
+    // or null if the file is missing/unreadable.
+    private String[] readCommandLineFile(String file) {
+        try {
+            java.io.File f = new java.io.File(file);
+            if (!f.exists() || f.length() == 0) return null;
+            java.io.FileReader reader = new java.io.FileReader(f);
+            char[] buffer = new char[(int) f.length()];
+            int n = reader.read(buffer);
+            reader.close();
+            if (n <= 0) return null;
+            return tokenizeCommandLine(buffer, n);
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to read command-line file " + file + ": " + e.getMessage());
+            return null;
+        }
+    }
+
+    // Minimal tokenizer mirroring CommandLine.tokenizeQuotedArguments: split on
+    // whitespace, honoring single/double quotes.
+    private String[] tokenizeCommandLine(char[] buffer, int len) {
+        java.util.ArrayList<String> args = new java.util.ArrayList<>();
+        StringBuilder arg = null;
+        char quote = 0;
+        for (int i = 0; i < len; i++) {
+            char c = buffer[i];
+            if (quote == 0 && (c == '"' || c == '\'')) {
+                quote = c;
+            } else if (c == quote) {
+                quote = 0;
+            } else if (quote == 0 && Character.isWhitespace(c)) {
+                if (arg != null) {
+                    args.add(arg.toString());
+                    arg = null;
+                }
+            } else {
+                if (arg == null) arg = new StringBuilder();
+                arg.append(c);
+            }
+        }
+        if (arg != null) args.add(arg.toString());
+        return args.toArray(new String[0]);
+    }
+
+    boolean isInitialized() { return mInitialized; }
+
+    @Override
+    public WebViewProvider createWebView(WebView view, WebView.PrivateAccess privateAccess) {
+        return new WebViewChromium(this, view, privateAccess);
+    }
+
+    @Override public CookieManager getCookieManager() { return mCookieManagerAdapter; }
+    @Override public WebStorage getWebStorage() { return mWebStorageAdapter; }
+    @Override public GeolocationPermissions getGeolocationPermissions() { return mGeolocationPermissionsAdapter; }
+    @Override public ServiceWorkerController getServiceWorkerController() { return mServiceWorkerControllerAdapter; }
+    @Override public WebViewDatabase getWebViewDatabase(Context context) { return mWebViewDatabaseAdapter; }
+    @Override public WebIconDatabase getWebIconDatabase() { return mWebIconDatabaseAdapter; }
+    @Override public TracingController getTracingController() { return mTracingControllerAdapter; }
+
+    @Override public String findAddress(String addr) { return null; }
+    @Override public String getDefaultUserAgent(Context context) { return AwContentsStatics.getProductVersion(); }
+    @Override public boolean isMultiProcessEnabled() { return false; }
+
+    @Override
+    public void setWebContentsDebuggingEnabled(boolean enabled) {
+        if (mDevToolsServer == null) {
+            if (!enabled) return;
