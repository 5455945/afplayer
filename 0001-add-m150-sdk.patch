+class CDP:
+    """Minimal Chrome DevTools Protocol client (stdlib WebSocket) to inject CSS/JS
+    and read <video> state for deterministic verification. Requires WebView debugging enabled
+    in the demo (--force-debug or a debug/userdebug build)."""
+
+    def __init__(self, device, port=0):
+        self.device = device
+        self.port = port          # 0 => pick a free port at connect() time
+        self.sock = None
+        self._id = 0
+
+    def _recv_exact(self, n):
+        d = b""
+        while len(d) < n:
+            c = self.sock.recv(n - len(d))
+            if not c:
+                raise IOError("cdp socket closed")
+            d += c
+        return d
+
+    def _frame(self, payload):
+        data = json.dumps(payload).encode()
+        n = len(data)
+        hdr = bytearray([0x81])
+        if n < 126:
+            hdr.append(0x80 | n)
+        elif n < 65536:
+            hdr.append(0x80 | 126)
+            hdr += struct.pack(">H", n)
+        else:
+            hdr.append(0x80 | 127)
+            hdr += struct.pack(">Q", n)
+        mask = os.urandom(4)
+        hdr += mask
+        return bytes(hdr) + bytes(b ^ mask[i % 4] for i, b in enumerate(data))
+
+    def _read(self):
+        b = self._recv_exact(2)
+        length = b[1] & 0x7F
+        if length == 126:
+            length = struct.unpack(">H", self._recv_exact(2))[0]
+        elif length == 127:
+            length = struct.unpack(">Q", self._recv_exact(8))[0]
+        return self._recv_exact(length).decode("utf-8", "replace")
+
+    def connect(self):
+        rc, out, _ = adb_shell(self.device, "cat /proc/net/unix")
+        m = re.search(r"@(webview_devtools_remote_\d+)", out)
+        if not m:
+            return False
+        name = m.group(1)
+        if not self.port:
+            self.port = _free_tcp_port()
+        run(["-s", self.device, "forward", "--remove", "tcp:%d" % self.port])
+        run(["-s", self.device, "forward", "tcp:%d" % self.port,
+             "localabstract:%s" % name])
+        info = None
+        for _ in range(12):
+            try:
+                info = json.load(urllib.request.urlopen(
+                    "http://127.0.0.1:%d/json" % self.port, timeout=3))
+                break
+            except Exception:
+                time.sleep(0.5)
+        if not info:
+            return False
+        pages = [t for t in info if t.get("type") == "page"]
+        if not pages:
+            return False
+        path = pages[0]["webSocketDebuggerUrl"].split(str(self.port), 1)[1]
+        try:
+            self.sock = socket.create_connection(("127.0.0.1", self.port), timeout=10)
+            key = base64.b64encode(os.urandom(16)).decode()
+            self.sock.sendall((
+                "GET %s HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nUpgrade: websocket\r\n"
+                "Connection: Upgrade\r\nSec-WebSocket-Key: %s\r\n"
+                "Sec-WebSocket-Version: 13\r\n\r\n" % (path, self.port, key)).encode())
+            resp = self.sock.recv(4096)
+            return b"101" in resp.split(b"\r\n")[0]
+        except Exception:
+            return False
+
+    def eval(self, expr, timeout=8):
+        if not self.sock:
+            return None
+        self._id += 1
+        mid = self._id
+        self.sock.settimeout(timeout)
+        self.sock.sendall(self._frame(
+            {"id": mid, "method": "Runtime.evaluate",
+             "params": {"expression": expr, "returnByValue": True,
+                        "awaitPromise": True}}))
+        deadline = time.time() + max(1, timeout)
+        while time.time() < deadline:
+            try:
+                j = json.loads(self._read())
+            except Exception:
+                time.sleep(0.05)
+                continue
+            if j.get("id") == mid:
+                return j.get("result", {}).get("result", {}).get("value")
+        return None
+
+    def send(self, method, params=None, timeout=10):
+        """Send an arbitrary CDP command and return result (Page.getFrameTree / createIsolatedWorld, etc.)."""
+        if not self.sock:
+            return None
+        self._id += 1
+        mid = self._id
+        self.sock.settimeout(timeout)
+        self.sock.sendall(self._frame({"id": mid, "method": method,
+                                       "params": params or {}}))
+        deadline = time.time() + max(1, timeout)
+        while time.time() < deadline:
+            try:
+                j = json.loads(self._read())
+            except Exception:
+                time.sleep(0.05)
+                continue
+            if j.get("id") == mid:
+                return j.get("result")
+        return None
+
+    def close(self):
+        try:
+            self.sock.close()
+        except Exception:
+            pass
+
