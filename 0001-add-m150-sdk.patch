diff --git a/android_webview/afree/demo/build.gradle b/android_webview/afree/demo/build.gradle
new file mode 100644
index 0000000000..4549d3e521
--- /dev/null
+++ b/android_webview/afree/demo/build.gradle
@@ -0,0 +1,107 @@
+plugins {
+    id 'com.android.application' version '8.5.0'
+}
+
+android {
+    namespace 'com.afree.demo'
+    compileSdk 34
+
+    defaultConfig {
+        applicationId "com.afree.demo"
+        minSdk 24
+        targetSdk 34
+    }
+
+    sourceSets {
+        main {
+            manifest.srcFile 'src/main/AndroidManifest.xml'
+            java.srcDirs = ['src/main/java']
+            res.srcDirs = ['src/main/res']
+        }
+    }
+
+    // Chromium mmaps icudtl.dat / *.pak / v8 snapshots directly from the APK;
+    // these assets must be stored uncompressed or the mmap fails and ICU init
+    // CHECK-crashes at startup.
+    androidResources {
+        noCompress += ['dat', 'pak', 'bin']
+    }
+
+    // The dist_aar classes.jar carries third-party non-class files (kotlin
+    // metadata, protobuf descriptors, play-services .properties, etc.) that
+    // also appear in androidx-deps.jar. Exclude them from packaging.
+    packaging {
+        resources {
+            excludes += [
+                'DebugProbesKt.bin',
+                '**/*.kotlin_module',
+                '**/*.proto',
+                '**/*.proto.bin',
+                '**/*.properties',
+                'META-INF/*.version',
+                'META-INF/services/**',
+            ]
+        }
+    }
+
+    compileOptions {
+        sourceCompatibility JavaVersion.VERSION_1_8
+        targetCompatibility JavaVersion.VERSION_1_8
+    }
+
+    buildTypes {
+        release {
+            minifyEnabled false
+            signingConfig signingConfigs.debug
+        }
+    }
+
+    lint {
+        disable 'HardcodedDebugMode'
+    }
+}
+
+// Determine whether afree_webview.aar is the hand-rolled AAR (com.afree.* shell
+// only, needs chromium-deps.jar) or the dist_aar (self-contained chromium
+// classes, needs androidx-deps.jar). We inspect the AAR's classes.jar for a
+// chromium class that only the dist_aar carries, so both modes can coexist
+// without deleting either deps jar.
+def afreeAarIsDist = false
+def afreeAarFile = file('src/main/libs/afree_webview.aar')
+if (afreeAarFile.exists()) {
+    def aar = new java.util.zip.ZipFile(afreeAarFile)
+    try {
+        def classesEntry = aar.getEntry('classes.jar')
+        if (classesEntry != null) {
+            def tmp = File.createTempFile('afree_classes', '.jar')
+            tmp.deleteOnExit()
+            tmp.withOutputStream { os -> os << aar.getInputStream(classesEntry) }
+            def classes = new java.util.zip.ZipFile(tmp)
+            try {
+                afreeAarIsDist =
+                        classes.getEntry('org/chromium/android_webview/AwContents.class') != null
+            } finally {
+                classes.close()
+            }
+        }
+    } finally {
+        aar.close()
+    }
+}
+
+dependencies {
+    implementation files('src/main/libs/afree_webview.aar')
+    // Hand-rolled mode: the sdk AAR is only the com.afree.* shell, so the demo
+    // needs chromium-deps.jar (chromium + androidx + kotlin classes) at runtime.
+    // dist_aar mode: the AAR is self-contained (chromium classes) and excludes
+    // androidx, so the demo needs androidx-deps.jar instead. bootstrap.sh copies
+    // it into demo/src/main/libs/, so the demo has no dependency on the sdk/
+    // directory (and opens cleanly in Android Studio).
+    if (afreeAarIsDist) {
+        implementation files('src/main/libs/androidx-deps.jar')
+    } else {
+        implementation files('../sdk/src/main/libs/chromium-deps.jar')
+    }
+    // Markdown rendering for the built-in .md viewer (help/copyright/issues).
+    implementation 'org.commonmark:commonmark:0.22.0'
+}
