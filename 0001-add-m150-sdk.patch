diff --git a/android_webview/afree/tools/verify_locale.ps1 b/android_webview/afree/tools/verify_locale.ps1
new file mode 100644
index 0000000000..44ed45fce1
--- /dev/null
+++ b/android_webview/afree/tools/verify_locale.ps1
@@ -0,0 +1,129 @@
+# =============================================================================
+# verify_locale.ps1 - Windows (PowerShell) port of verify_locale.sh
+#
+# Checks:
+#   1) The APK/AAR ships the locale paks: stored-locales/{en-US,ru,zh-CN,de,ja,zh-HK,zh-TW}.pak
+#      (host-side check when an APK path is given; uses python's zipfile).
+#   2) `--lang=<locale>` selects the bundled locale (e.g. ru) and loads without
+#      the "Failed to load locale .pak from apk" failure.
+#   3) An unsupported locale falls back to en-US with a warning instead of
+#      crashing the locale pak mapping.
+#
+# Usage (from any directory):
+#   powershell -ExecutionPolicy Bypass -File verify_locale.ps1 <device_serial> [apk]
+#   ./verify_locale.bat <device_serial> [apk]
+# =============================================================================
+$ErrorActionPreference = 'Continue'
+
+$SCRIPT_DIR = Split-Path -Parent $MyInvocation.MyCommand.Path
+$Serial = if ($args.Count -ge 1) { [string]$args[0] } else { '' }
+$Apk = if ($args.Count -ge 2) { [string]$args[1] } else { '' }
+if (-not $Serial) { Write-Host "usage: verify_locale.ps1 <device_serial> [apk]"; exit 2 }
+
+$PKG = 'com.afree.demo'
+$ACT = "$PKG/.MainActivity"
+
+function Fail([string]$m) { Write-Host "FAIL: $m"; exit 1 }
+
+function Get-AdbPath {
+  if ($env:AFREE_ADB -and (Test-Path $env:AFREE_ADB)) { return $env:AFREE_ADB }
+  $c = Get-Command adb -ErrorAction SilentlyContinue
+  if (-not $c) { return $null }
+  if ($c.Source) { return $c.Source }
+  return $c.Path
+}
+
+function Get-PyInfo {
+  if ($env:AFREE_PY -and (Test-Path $env:AFREE_PY)) {
+    $pa = @()
+    if ($env:AFREE_PYARGS) { $pa = @($env:AFREE_PYARGS -split ',') }
+    return @{ exe = $env:AFREE_PY; args = $pa }
+  }
+  foreach ($c in @('python3', 'python')) {
+    $p = Get-Command $c -ErrorAction SilentlyContinue
+    if ($p) {
+      $v = (& $p.Source -c "import sys;print(sys.version_info[0])" 2>$null | Out-String).Trim()
+      if ($v -eq '3') { return @{ exe = $p.Source; args = @() } }
+    }
+  }
+  $p = Get-Command py -ErrorAction SilentlyContinue
+  if ($p) {
+    $v = (& $p.Source -3 -c "import sys;print(sys.version_info[0])" 2>$null | Out-String).Trim()
+    if ($v -eq '3') { return @{ exe = $p.Source; args = @('-3') } }
+  }
+  return $null
+}
+
+$ADB = Get-AdbPath
+if (-not $ADB) { Fail 'adb not found in PATH' }
+$pyInfo = Get-PyInfo
+if (-not $pyInfo) { Fail 'python3 not found in PATH' }
+
+function Run-Lang([string]$lang) {
+  & $ADB -s $Serial shell "am force-stop $PKG" 2>$null | Out-Null
+  & $ADB -s $Serial logcat -c 2>$null | Out-Null
+  & $ADB -s $Serial shell "am start -n $ACT -e url 'about:blank' --es cr '--lang=$lang'" 2>$null | Out-Null
+  Start-Sleep -Seconds 6
+}
+
+# 1) paks present in the APK (host-side).
+if ($Apk -and (Test-Path $Apk)) {
+  $code = "import zipfile,sys; z=zipfile.ZipFile(sys.argv[1]); n=set(z.namelist()); miss=[l for l in sys.argv[2:] if 'assets/stored-locales/'+l+'.pak' not in n]; print(','.join(miss)); sys.exit(1 if miss else 0)"
+  $za = @($code, $Apk, 'en-US', 'ru', 'zh-CN', 'de', 'ja', 'zh-HK', 'zh-TW')
+  $res = (& $pyInfo.exe @($pyInfo.args + $za) 2>&1 | Out-String)
+  if ($LASTEXITCODE -ne 0) { Fail "APK missing assets/stored-locales/*.pak: $res" }
+  Write-Host 'OK: APK ships stored-locales/{en-US,ru,zh-CN,de,ja,zh-HK,zh-TW}.pak'
+}
+
+# 2) bundled locales load via --lang, with no load failure.
+foreach ($l in @('ru', 'zh-CN', 'en-US', 'de', 'ja', 'zh-HK', 'zh-TW')) {
+  Run-Lang $l
+  $lc = (& $ADB -s $Serial logcat -d 2>$null | Out-String)
+  if ($lc -notmatch "afree: using locale from --lang=$l") {
+    Fail "--lang=$l was not honored (no 'using locale from --lang' log)"
+  }
+  if ($lc -match 'Failed to load locale .pak from apk') {
+    Fail "locale pak load failed for $l"
+  }
+  Write-Host "OK: --lang=$l loaded"
+}
+
+# 3) unsupported locale falls back to en-US, still no load failure.
+Run-Lang 'xx-YY'
+$lc = (& $ADB -s $Serial logcat -d 2>$null | Out-String)
+if ($lc -notmatch 'falling back to en-US') {
+  Fail 'no fallback warning for unsupported locale xx-YY'
+}
+if ($lc -match 'Failed to load locale .pak from apk') {
+  Fail 'locale pak load failed after fallback'
+}
+Write-Host 'OK: --lang=xx-YY fell back to en-US'
+
+# 4) visible effect: Blink <video controls> overflow menu is localized.
+#    Advisory by default on Windows: newer Chromium (e.g. Chrome/150) replaced the
+#    "-internal-media-controls-overflow-button" pseudo element, so locale_ui_test.py
+#    can no longer find it even though locale paks are loaded correctly above.
+#    Set AFREE_STRICT_LOCALE_UI=1 to make this sub-check fatal (Linux behavior).
+$strictUi = ($env:AFREE_STRICT_LOCALE_UI -eq '1')
+$ui = Join-Path $SCRIPT_DIR 'locale_ui_test.py'
+if (Test-Path $ui) {
+  $out = (& $pyInfo.exe @($pyInfo.args + @($ui, '-s', $Serial, '-l', 'ru', '--no-screenshot')) 2>&1 | Out-String)
+  if ($LASTEXITCODE -eq 0) {
+    Write-Host 'OK: --lang=ru media menu is Russian'
+  } else {
+    Write-Host (($out -split "`n" | Select-Object -Last 3) -join "`n")
+    if ($strictUi) { Fail 'media menu is not Russian for --lang=ru' }
+    Write-Host 'WARN: --lang=ru media menu check failed (advisory; set AFREE_STRICT_LOCALE_UI=1 to fail)'
+  }
+  $out = (& $pyInfo.exe @($pyInfo.args + @($ui, '-s', $Serial, '-l', 'en-US', '--no-screenshot')) 2>&1 | Out-String)
+  if ($LASTEXITCODE -eq 0) {
+    Write-Host 'OK: --lang=en-US media menu is English'
+  } else {
+    Write-Host (($out -split "`n" | Select-Object -Last 3) -join "`n")
+    if ($strictUi) { Fail 'media menu is not English for --lang=en-US' }
+    Write-Host 'WARN: --lang=en-US media menu check failed (advisory; set AFREE_STRICT_LOCALE_UI=1 to fail)'
+  }
+}
+
+Write-Host 'PASS: locale pak loading/selection verified'
+exit 0
diff --git a/android_webview/afree/tools/verify_locale.sh b/android_webview/afree/tools/verify_locale.sh
