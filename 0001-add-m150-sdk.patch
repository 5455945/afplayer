index 0000000000..7dbcfdb094
--- /dev/null
+++ b/android_webview/afree/tools/pack_media_test.sh
@@ -0,0 +1,129 @@
+#!/bin/bash
+# =============================================================================
+# pack_media_test.sh — package a self-contained, portable afree media-test bundle
+#
+# Output: <repo>/out/arm64r/apks/afree_media_test_<release|debug>[_<type>].zip
+#
+# --type (default all) selects which runner scripts to include; the shared Python
+# helpers + the APK are always included:
+#   all   : linux (.sh) + windows (.bat/.ps1)   -> afree_media_test_<mode>.zip
+#   linux : only .sh scripts (same as before)   -> afree_media_test_<mode>_linux.zip
+#   win   : only .bat/.ps1 scripts              -> afree_media_test_<mode>_win.zip
+#
+# Contents (rooted at "afree/"):
+#   afree/demo/media_test.py
+#   afree/demo/build/outputs/apk/<mode>/demo-<mode>.apk
+#   afree/tools/{screenshot_analyze.py,locale_ui_test.py}
+#   afree/demo/verify_demo.sh   afree/tools/verify_{scroll,locale,video}.sh        (linux/all)
+#   afree/demo/verify_demo.{bat,ps1}
+#   afree/tools/verify_{scroll,locale,video}.{bat,ps1}                             (win/all)
+#
+# After unzip anywhere (needs adb + python3 in PATH):
+#   Linux  : cd afree/demo && ./verify_demo.sh --no-install --media-test-only <device>
+#   Windows: afree\demo\verify_demo.bat --no-install --media-test <device>
+#   direct : python3 media_test.py --device <device> --only bilibili
+#
+# Usage:
+#   ./pack_media_test.sh [--debug|--release] [--type all|win|linux] [--out <dir>]
+# =============================================================================
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+AFREE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
+
+MODE="release"
+TYPE="all"
+OUT_DIR="$REPO_ROOT/out/arm64r/apks"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --debug)   MODE="debug";   shift ;;
+    --release) MODE="release"; shift ;;
+    --type)    TYPE="$2";      shift 2 ;;
+    --out)     OUT_DIR="$2";   shift 2 ;;
+    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
+    *) echo "unknown option: $1" >&2; exit 2 ;;
+  esac
+done
+
+case "$TYPE" in
+  all|win|linux) ;;
+  *) echo "error: --type must be one of: all|win|linux (got '$TYPE')" >&2; exit 2 ;;
+esac
+
+APK="$AFREE_DIR/demo/build/outputs/apk/$MODE/demo-$MODE.apk"
+if [[ ! -f "$APK" ]]; then
+  echo "error: APK not found: $APK" >&2
+  echo "       build it first: ./build_android.sh --build_aar$([[ $MODE == debug ]] && echo ' --debug')" >&2
+  exit 1
+fi
+
+command -v zip >/dev/null 2>&1 || { echo "error: 'zip' not found in PATH" >&2; exit 1; }
+mkdir -p "$OUT_DIR"
+
+# Always included: shared python helpers (both runners import/call these).
+COMMON_FILES=(
+  "demo/media_test.py"
+  "tools/screenshot_analyze.py"
+  "tools/locale_ui_test.py"
+)
+LINUX_FILES=(
+  "demo/verify_demo.sh"
+  "tools/verify_scroll.sh"
+  "tools/verify_locale.sh"
+  "tools/verify_video.sh"
+)
+WIN_FILES=(
+  "demo/verify_demo.bat"
+  "demo/verify_demo.ps1"
+  "tools/verify_locale.bat"
+  "tools/verify_locale.ps1"
+  "tools/verify_scroll.bat"
+  "tools/verify_scroll.ps1"
+  "tools/verify_video.bat"
+  "tools/verify_video.ps1"
+)
+
+FILES=("${COMMON_FILES[@]}")
+case "$TYPE" in
+  all)   FILES+=("${LINUX_FILES[@]}" "${WIN_FILES[@]}") ;;
+  linux) FILES+=("${LINUX_FILES[@]}") ;;
+  win)   FILES+=("${WIN_FILES[@]}") ;;
+esac
+
+STAGE="$(mktemp -d)"
+trap 'rm -rf "$STAGE"' EXIT
+
+DEST="$STAGE/afree"
+mkdir -p "$DEST/demo/build/outputs/apk/$MODE" "$DEST/tools"
+
+for rel in "${FILES[@]}"; do
+  src="$AFREE_DIR/$rel"
+  [[ -f "$src" ]] || { echo "error: missing file: $src" >&2; exit 1; }
+  mkdir -p "$DEST/$(dirname "$rel")"
+  cp -p "$src" "$DEST/$rel"
+done
+
+# APK at the path verify_demo.* auto-detects (so --apk is not required)
+cp -p "$APK" "$DEST/demo/build/outputs/apk/$MODE/demo-$MODE.apk"
+
+# keep the shell scripts executable
+find "$DEST" -type f -name '*.sh' -exec chmod +x {} +
+
+# never ship Python bytecode caches
+find "$STAGE" -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
+find "$STAGE" -type f -name '*.pyc' -delete 2>/dev/null || true
+
+if [[ "$TYPE" == "all" ]]; then
+  ZIP="$OUT_DIR/afree_media_test_$MODE.zip"
+else
+  ZIP="$OUT_DIR/afree_media_test_${MODE}_${TYPE}.zip"
+fi
+rm -f "$ZIP"
+( cd "$STAGE" && zip -r -q -X "$ZIP" afree )
+
+echo "packed (mode=$MODE, type=$TYPE): $ZIP"
+echo "  size : $(du -h "$ZIP" | cut -f1)"
+echo "  files:"
+( cd "$STAGE" && find afree -type f | sort | sed 's/^/    /' )
