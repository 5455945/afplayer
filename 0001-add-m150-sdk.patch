@@ -0,0 +1,22 @@
+# Gradle
+.gradle/
+build/
+
+# local.properties (machine-specific SDK path)
+local.properties
+
+# Android Studio
+.idea/
+*.iml
+
+# Native libraries (populated by bootstrap.sh)
+src/main/jniLibs/*/
+!src/main/jniLibs/arm64-v8a/.gitkeep
+
+# Assets (populated by bootstrap.sh)
+src/main/assets/*
+!src/main/assets/.gitkeep
+
+# Dependency JARs (populated by bootstrap.sh)
+src/main/libs/*
+!src/main/libs/.gitkeep
diff --git a/android_webview/afree/sdk/build.gradle b/android_webview/afree/sdk/build.gradle
new file mode 100644
index 0000000000..982eb384d1
--- /dev/null
+++ b/android_webview/afree/sdk/build.gradle
@@ -0,0 +1,50 @@
+plugins {
+    id 'com.android.library' version '8.5.0'
+}
+
+android {
+    namespace 'com.afree.webkit'
+    compileSdk 34
+
+    defaultConfig {
+        minSdk 24
+        consumerProguardFiles 'proguard-rules.pro'
+    }
+
+    sourceSets {
+        main {
+            manifest.srcFile 'src/main/AndroidManifest.xml'
+            java.srcDirs = ['src/main/java']
+            // Experimental SurfaceView renderer, kept for reference but not compiled.
+            java.exclude 'org/chromium/afree/renderer/**'
+            jniLibs.srcDirs = ['src/main/jniLibs']
+            assets.srcDirs = ['src/main/assets']
+        }
+    }
+
+    compileOptions {
+        // Use 1.8 instead of 17: 17 triggers `--release`, which uses the JDK
+        // module set where sun.misc.Unsafe is hidden (jdk.unsupported). With
+        // -source/-target 1.8 the bootclasspath stays on android.jar, which
+        // exposes sun.misc.Unsafe (required by HiddenApiBypass).
+        sourceCompatibility JavaVersion.VERSION_1_8
+        targetCompatibility JavaVersion.VERSION_1_8
+    }
+
+    buildTypes {
+        release {
+            minifyEnabled false
+        }
+    }
+}
+
+dependencies {
+    // Chromium runtime deps and annotation libs are declared compileOnly so they are NOT
+    // bundled into the AAR. The AAR consumer (app or demo) must provide them at runtime
+    // via its own dependency on chromium-deps.jar.
+    // androidx-deps.jar is also compileOnly: it's a dist_aar-mode artifact that the demo
+    // depends on directly; bundling it into the hand-rolled AAR causes duplicate-class
+    // errors in the demo (the same androidx/annotation classes appear twice).
+    compileOnly fileTree(dir: 'src/main/libs', include: ['chromium-deps.jar', 'androidx_annotation.jar', 'androidx-deps.jar'])
+    implementation fileTree(dir: 'src/main/libs', exclude: ['chromium-deps.jar', 'androidx_annotation.jar', 'androidx-deps.jar'])
+}
