+            android:process=":privileged_process3"
+            android:exported="false"/>
+
+        <service
+            android:name="org.chromium.content.app.PrivilegedProcessService4"
+            android:process=":privileged_process4"
+            android:exported="false"/>
+
+    </application>
+</manifest>
