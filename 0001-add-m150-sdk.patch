index 0000000000..48e11fec09
--- /dev/null
+++ b/android_webview/afree/tools/locale_ui_test.py
@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""afree locale UI test: open Blink's <video controls> overflow menu in the demo
+and read/verify the (localized) menu labels, saving a screenshot.
+
+This proves the *visible* effect of locale paks on Blink's native media UI
+(e.g. `--lang=ru` => Russian menu), independent of the Android system language.
+
+Usage:
+  ./locale_ui_test.py -s <device> [-l ru] [-o /tmp/locale_ui_ru.png]
+"""
+import argparse
+import base64
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+DEMO_DIR = os.path.normpath(os.path.join(SCRIPT_DIR, "..", "demo"))
+sys.path.insert(0, DEMO_DIR)
+# Do not write media_test/__pycache__ into the (possibly read-only) bundle.
+sys.dont_write_bytecode = True
+from media_test import CDP, adb_shell, screen_size  # noqa: E402
+
+PKG = "com.afree.demo"
+ACT = PKG + "/.MainActivity"
+PAGE = "file:///android_asset/locale_test.html"
+
+
+def attrs(n):
+    a = n.get("attributes") or []
+    return dict(zip(a[0::2], a[1::2]))
+
+
+def has_cyrillic(s):
+    return bool(re.search(r"[\u0400-\u04FF]", s or ""))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("-s", "--device", required=True)
+    ap.add_argument("-l", "--lang", default="ru")
+    ap.add_argument("-o", "--out", default="")
+    ap.add_argument("--no-screenshot", action="store_true")
+    args = ap.parse_args()
+    dev = args.device
+    out_png = args.out or "/tmp/afree_locale_ui_%s.png" % args.lang
+
+    adb_shell(dev, "am force-stop %s" % PKG)
+    adb_shell(dev, "am start -n %s -e url '%s' --es cr '--force-debug --lang=%s'"
+                   % (ACT, PAGE, args.lang))
+    time.sleep(9)
+
+    cdp = CDP(dev)
+    if not cdp.connect():
+        print("FAIL: CDP connect failed (WebView debugging not enabled?)")
+        return 1
+    cdp.eval("(function(){var v=document.querySelector('video');v.muted=true;v.loop=true;"
+             "v.style.width='80%';v.style.maxWidth='1000px';v.style.maxHeight='55vh';"
+             "v.style.height='auto';v.play();v.scrollIntoView({block:'center'});return 1;})()")
+    time.sleep(2)
+    cdp.send("DOM.enable")
+    w, h = screen_size(dev)
+
+    def dump_nodes():
+        doc = cdp.send("DOM.getDocument", {"depth": -1, "pierce": True})
+        nodes = []
+
+        def walk(n):
+            nodes.append(n)
+            for c in n.get("children", []) or []:
+                walk(c)
+            for sh in n.get("shadowRoots", []) or []:
+                walk(sh)
+            if n.get("contentDocument"):
+                walk(n["contentDocument"])
+
+        walk(doc["root"])
+        return nodes
+
+    def find(nodes, sub):
+        for n in nodes:
+            if sub in str(attrs(n).get("pseudo", "")):
+                return n
+        return None
+
+    nodes = dump_nodes()
+    overflow = find(nodes, "-internal-media-controls-overflow-button")
+    if not overflow:
+        print("FAIL: media controls overflow button not found")
+        cdp.close()
+        return 1
+    print("overflow aria-label: %r title: %r"
+          % (attrs(overflow).get("aria-label"), attrs(overflow).get("title")))
+
+    # reveal controls (tap the video), then click the overflow button via CDP.
+    iw = cdp.eval("window.innerWidth") or w
+    scale = float(w) / float(iw)
+    rect = json.loads(cdp.eval(
+        "(function(){var r=document.querySelector('video').getBoundingClientRect();"
+        "return JSON.stringify({x:r.left,y:r.top,w:r.width,h:r.height});})()"))
+    vx = int((rect["x"] + rect["w"] / 2) * scale)
+    vy = int((rect["y"] + rect["h"] / 2) * scale)
+    adb_shell(dev, "input tap %d %d" % (vx, vy))
+    time.sleep(1.2)
+
+    bm = cdp.send("DOM.getBoxModel", {"nodeId": overflow["nodeId"]})
+    if not bm or not bm.get("model"):
+        print("FAIL: overflow button not visible (controls hidden)")
+        cdp.close()
+        return 1
+    q = bm["model"]["content"]
+    cx, cy = sum(q[0::2]) / 4.0, sum(q[1::2]) / 4.0
+    cdp.send("Input.dispatchMouseEvent", {"type": "mouseMoved", "x": cx, "y": cy})
+    cdp.send("Input.dispatchMouseEvent", {"type": "mousePressed", "x": cx, "y": cy,
+                                          "button": "left", "clickCount": 1})
+    cdp.send("Input.dispatchMouseEvent", {"type": "mouseReleased", "x": cx, "y": cy,
+                                          "button": "left", "clickCount": 1})
+    time.sleep(0.5)
+
+    if not args.no_screenshot:
+        adb_shell(dev, "screencap -p /sdcard/afree_locale_ui.png")
+        subprocess.run(["adb", "-s", dev, "pull", "/sdcard/afree_locale_ui.png", out_png],
+                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        print("screenshot: %s" % out_png)
+
+    # read menu labels (localized)
+    nodes = dump_nodes()
+    menu = find(nodes, "-internal-media-controls-overflow-menu-list")
+    labels = []
+    if menu:
+        html = cdp.send("DOM.getOuterHTML", {"nodeId": menu["nodeId"]}).get("outerHTML", "")
+        labels = [s.strip() for s in re.findall(r">([^<>{}]+)<", html) if s.strip()]
+    cyr = [s for s in labels if has_cyrillic(s)]
+    print("menu labels: %s" % labels)
+    print("cyrillic labels: %s" % cyr)
+    cdp.close()
+
+    expect_cyr = args.lang.lower().startswith("ru")
+    if expect_cyr and not cyr:
+        print("RESULT: FAIL (expected Cyrillic menu for lang=%s)" % args.lang)
+        return 1
+    print("RESULT: PASS (lang=%s, cyrillic=%d)" % (args.lang, len(cyr)))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/android_webview/afree/tools/pack_media_test.sh b/android_webview/afree/tools/pack_media_test.sh
