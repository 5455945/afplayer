+rerun_packaging_command() {
+  local script="$1"
+  local output_match="$2"
+  local ninja_file="$OUTPUT_DIR/toolchain.ninja"
+  if [ ! -f "$ninja_file" ]; then
+    log "ERROR: toolchain.ninja does not exist: $ninja_file"
+    return 1
+  fi
+
+  log "Repack via ${script} (${output_match}) ..."
+  local PY3="$REPO_ROOT/init_tools/${M_VERSION}/depot_tools/python-bin/python3"
+  "$PY3" - "$ninja_file" "$script" "$output_match" "$OUTPUT_DIR" 2>&1 <<'PYEOF' | tee -a "$LOG_FILE"
+import sys, subprocess
+ninja_file, script, output_match, output_dir = sys.argv[1:5]
+found = False
+with open(ninja_file, 'r') as f:
+    for line in f:
+        line = line.strip()
+        if not line.startswith('command ='):
+            continue
+        if script not in line:
+            continue
+        if output_match not in line:
+            continue
+        found = True
+        cmd = line[len('command = '):]
