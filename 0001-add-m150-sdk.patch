index 0000000000..c096256a8f
--- /dev/null
+++ b/android_webview/afree/tools/verify_locale.sh
@@ -0,0 +1,89 @@
+#!/bin/bash
+# =============================================================================
+# verify_locale.sh — afree demo locale .pak verification
+#
+# Checks:
+#   1) The APK/AAR ships the locale paks: stored-locales/{en-US,ru,zh-CN}.pak
+#      (host-side check when an APK path is given).
+#   2) `--lang=<locale>` selects the bundled locale (e.g. ru) and loads without
+#      the "Failed to load locale .pak from apk" failure.
+#   3) An unsupported locale falls back to en-US with a warning instead of
+#      crashing the locale pak mapping.
+#
+# Usage:
+#   ./verify_locale.sh <device_serial> [apk]
+#   e.g. ./verify_locale.sh 30.207.82.150:62451
+#        ./verify_locale.sh 30.207.82.150:62451 out/arm64r/apks/AfreeWebViewDemo.apk
+# =============================================================================
+set -u
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SERIAL="${1:?usage: $0 <device_serial> [apk]}"
+APK="${2:-}"
+PKG=com.afree.demo
+ACT="$PKG/.MainActivity"
+
+fail() { echo "FAIL: $*"; exit 1; }
+
+logcat_dump() { adb -s "$SERIAL" logcat -d 2>/dev/null | tr -d '\r'; }
+
+run_lang() {  # $1 = lang
+  adb -s "$SERIAL" shell am force-stop "$PKG" >/dev/null 2>&1 || true
+  adb -s "$SERIAL" logcat -c >/dev/null 2>&1 || true
+  adb -s "$SERIAL" shell \
+    "am start -n $ACT -e url 'about:blank' --es cr '--lang=$1'" >/dev/null 2>&1 || true
+  sleep 6
+}
+
+# 1) paks present in the APK (host-side).
+if [[ -n "$APK" && -f "$APK" ]]; then
+  for l in en-US ru zh-CN de ja zh-HK zh-TW; do
+    if ! unzip -l "$APK" | grep -q "assets/stored-locales/$l.pak"; then
+      fail "APK missing assets/stored-locales/$l.pak"
+    fi
+  done
+  echo "OK: APK ships stored-locales/{en-US,ru,zh-CN,de,ja,zh-HK,zh-TW}.pak"
+fi
+
+# 2) bundled locales load via --lang, with no load failure.
+for l in ru zh-CN en-US de ja zh-HK zh-TW; do
+  run_lang "$l"
+  LC="$(logcat_dump)"
+  if ! echo "$LC" | grep -q "afree: using locale from --lang=$l"; then
+    fail "--lang=$l was not honored (no 'using locale from --lang' log)"
+  fi
+  if echo "$LC" | grep -q "Failed to load locale .pak from apk"; then
+    fail "locale pak load failed for $l"
+  fi
+  echo "OK: --lang=$l loaded"
+done
+
+# 3) unsupported locale falls back to en-US, still no load failure.
+run_lang xx-YY
+LC="$(logcat_dump)"
+if ! echo "$LC" | grep -q "falling back to en-US"; then
+  fail "no fallback warning for unsupported locale xx-YY"
+fi
+if echo "$LC" | grep -q "Failed to load locale .pak from apk"; then
+  fail "locale pak load failed after fallback"
+fi
+echo "OK: --lang=xx-YY fell back to en-US"
+
+# 4) visible effect: Blink <video controls> overflow menu is localized.
+if [[ -f "$SCRIPT_DIR/locale_ui_test.py" ]]; then
+  if out="$(python3 "$SCRIPT_DIR/locale_ui_test.py" -s "$SERIAL" -l ru --no-screenshot 2>&1)"; then
+    echo "OK: --lang=ru media menu is Russian"
+  else
+    echo "$out" | tail -3
+    fail "media menu is not Russian for --lang=ru"
+  fi
+  if out="$(python3 "$SCRIPT_DIR/locale_ui_test.py" -s "$SERIAL" -l en-US --no-screenshot 2>&1)"; then
+    echo "OK: --lang=en-US media menu is English"
+  else
+    echo "$out" | tail -3
+    fail "media menu is not English for --lang=en-US"
+  fi
+fi
+
+echo "PASS: locale pak loading/selection verified"
+exit 0
