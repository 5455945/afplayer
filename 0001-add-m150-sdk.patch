+def cdp_find(device, cdp, keys, note, maxn=8, w=1920, h=720, pause=1.0):
+    """Find controls by text in the page via CDP -> take center coords -> input tap.
+    uiautomator cannot dump during playback; this is unaffected. Returns tap count."""
+    if not cdp:
+        return 0
+    raw = cdp.eval(FIND_BY_TEXT_JS_TMPL % json.dumps(keys, ensure_ascii=False))
