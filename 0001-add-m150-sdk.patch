@@ -0,0 +1,53 @@
+# =============================================================================
+# verify_video.ps1 - Windows (PowerShell) port of verify_video.sh
+#
+# How it works:
+#   Loads the built-in test page audio_zone.html, taps the first video link to start
+#   playback, then counts ForwardVideoFrame lines in logcat (a marker that video
+#   frames were rendered on screen by the renderer); frames > 0 means video
+#   hardware decode/on-screen works.
+#
+# Usage (from any directory):
+#   powershell -ExecutionPolicy Bypass -File verify_video.ps1 <device_serial>
+#   ./verify_video.bat <device_serial>
+#
+# Dependency: none (adb only)
+# =============================================================================
+$ErrorActionPreference = 'Continue'
+
+$Serial = if ($args.Count -ge 1) { [string]$args[0] } else { '' }
+if (-not $Serial) { Write-Host "usage: verify_video.ps1 <device_serial>"; exit 2 }
+
+$VIDEO_PAGE = 'http://47.89.235.173:9090/audio_zone.html'
+
+if ($env:AFREE_ADB -and (Test-Path $env:AFREE_ADB)) {
+  $ADB = $env:AFREE_ADB
+} else {
+  $c = Get-Command adb -ErrorAction SilentlyContinue
+  if (-not $c) { Write-Host 'FAIL: adb not found in PATH'; exit 1 }
+  $ADB = if ($c.Source) { $c.Source } else { $c.Path }
+}
+
+function Adb([string[]]$AdbArgs) { & $ADB -s $Serial @AdbArgs }
+
+Adb @('shell', 'am force-stop com.afree.demo') | Out-Null
+Adb @('logcat', '-c') | Out-Null
+Adb @('shell', "am start -n com.afree.demo/.MainActivity -e url '$VIDEO_PAGE'") | Out-Null
+Write-Host "loading $VIDEO_PAGE ..."
+Start-Sleep -Seconds 14
+
+# Tap the first video link (coordinates of the first link in audio_zone.html's H264 list).
+Write-Host 'tapping video link ...'
+Adb @('shell', 'input tap 300 346') | Out-Null
+Start-Sleep -Seconds 14
+
+$frames = @(Adb @('logcat', '-d') 2>$null | Where-Object { $_ -match 'ForwardVideoFrame' }).Count
+Write-Host "ForwardVideoFrame count: $frames"
+
+if ($frames -gt 0) {
+  Write-Host 'PASS: video hardware decode/on-screen works'
+  exit 0
+} else {
+  Write-Host 'FAIL: no video frames on screen detected'
+  exit 1
+}
