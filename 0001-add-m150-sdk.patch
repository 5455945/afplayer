+  MaybeCreateSynchronousCompositor();
+  if (!sync_compositor_) return;
+
+  // Force Mojo pipe setup regardless of widget state.
+  sync_compositor_->InitMojo();
+
+  // Send async draw to trigger renderer compositor creation.
+  gfx::Size viewport = view_.GetSizeDevicePx();
+  if (viewport.IsEmpty()) return;
+  sync_compositor_->DemandDrawHwAsync(
+      viewport, gfx::Rect(viewport), gfx::Transform());
+}
