diff --git a/android_webview/afree/demo/verify_demo.bat b/android_webview/afree/demo/verify_demo.bat
new file mode 100644
index 0000000000..fceab049a2
--- /dev/null
+++ b/android_webview/afree/demo/verify_demo.bat
@@ -0,0 +1,13 @@
+@echo off
+rem ============================================================================
+rem verify_demo.bat - Windows entry point for verify_demo.ps1
+rem
+rem Usage (from any directory):
+rem   verify_demo.bat [options] <device>
+rem   verify_demo.bat --no-install --media-test 30.207.82.150:62439
+rem
+rem Requires: adb and python3 available in PATH.
+rem ============================================================================
+setlocal
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0verify_demo.ps1" %*
+exit /b %ERRORLEVEL%
diff --git a/android_webview/afree/demo/verify_demo.ps1 b/android_webview/afree/demo/verify_demo.ps1
new file mode 100644
index 0000000000..6333a53c87
--- /dev/null
+++ b/android_webview/afree/demo/verify_demo.ps1
@@ -0,0 +1,748 @@
+# =============================================================================
+# verify_demo.ps1 - Windows (PowerShell) port of verify_demo.sh
+#
+# afree demo push/install + help.md scenario regression verification.
+# Runs from any directory (paths are resolved relative to this script).
+#
+# Windows-specific notes:
+#   * adb and python3 must already be in PATH (or set AFREE_ADB / AFREE_PY).
+#   * Every adb invocation is bounded by a timeout (non-blocking); a hung
+#     `am start -W`/pull becomes a warning/failure instead of freezing the run.
+#   * The Linux script's built-in TCP relay relies on TCP_MAXSEG, which Windows
+#     does not support; --relay-mss is accepted but ignored (direct connection).
+#   * Existing media_test.py / screenshot_analyze.py / locale_ui_test.py are reused.
+#
+# Usage:
+#   verify_demo.bat [options] <device>
+#   powershell -ExecutionPolicy Bypass -File verify_demo.ps1 [options] <device>
+#
+# Examples:
+#   verify_demo.bat 30.207.82.150:62441
+#   verify_demo.bat --no-install --media-test 30.207.82.150:62439
+#   verify_demo.bat --only url,help --no-install 30.207.82.150:62441
+#   verify_demo.bat --list
+#
+# Dependencies: adb; python3 (stdlib only)
+# =============================================================================
+
+$ErrorActionPreference = 'Continue'
+
+$SCRIPT_DIR = Split-Path -Parent $MyInvocation.MyCommand.Path
+$AFREE_DIR  = Split-Path -Parent $SCRIPT_DIR
+$TOOLS_DIR  = Join-Path $AFREE_DIR 'tools'
+$ANALYZER   = Join-Path $TOOLS_DIR 'screenshot_analyze.py'
+$MEDIA_TEST_PY = Join-Path $SCRIPT_DIR 'media_test.py'
+
+$PKG      = 'com.afree.demo'
+$ACTIVITY = 'com.afree.demo/.MainActivity'
+
+# ---------------------------------------------------------------------------
+# State
+# ---------------------------------------------------------------------------
+$script:ARGV = @($args)
+
+$script:WAIT         = if ($env:WAIT) { [int]$env:WAIT } else { 8 }
+$script:PUSH_TIMEOUT = if ($env:PUSH_TIMEOUT) { [int]$env:PUSH_TIMEOUT } else { 180 }
+$script:SCROLL = 1
+$script:LOCALE = 1
+$script:VIDEO  = 0
+$script:NO_INSTALL = 0
+$script:USE_DEBUG = 0
+$script:USE_RELEASE = 0
+$script:APK_OVERRIDE = ''
+$script:SERIAL = ''
+$script:DEVICE = ''
+$script:ONLY = ''
+$script:UA = ''
+$script:MEDIA_TEST_ON = 0
+$script:MEDIA_TEST_ONLY = 0
+$script:MEDIA_RUNTIME = ''
+$script:MEDIA_TAPS = ''
+$script:MEDIA_SUSTAIN = ''
+$script:EXTRA_URLS = @()
+$script:LIST = 0
+$script:REPORT = ''
+$script:RELAY_MSS = ''
+$script:AUTO_RELAY = 1
+$script:TMP_DIR = ''
+$script:ADB = $null
+$script:PY = $null
+$script:PYARGS = @()
+$script:POWERSHELL = ''
+$script:APK = ''
+$script:RESULT_ROWS = @()
+$script:FAILED = 0
+$script:SEQ = 0
+$script:SERVER_STARTED = $false
+
+# name | am extras | process(model: multi|single|any) | min non-black %
+$script:CASES = @(
+  'default||multi|5',
+  'url|-e url ''https://www.baidu.com/?noapp=1''|multi|5',
+  'ua|-e ua ''''|multi|5',
+  'url+ua|-e url ''https://www.baidu.com/?noapp=1'' -e ua ''''|multi|5',
+  'asset-copyright|-e url ''file:///android_asset/copyright.md''|multi|5',
+  'asset-readme|-e url ''file:///android_asset/readme.md''|multi|5',
+  'asset-issues|-e url ''file:///android_asset/issues.md''|multi|5',
+  'help|-e help true|multi|5',
+  'engine-afree|-e engine afree -e url ''https://www.baidu.com/?noapp=1''|multi|5',
+  'engine-system|-e engine system -e url ''https://www.baidu.com/?noapp=1''|any|5',
+  'private|-e private 1|multi|5',
+  'incognito|-e incognito 1|multi|5',
+  'cr-v|--es cr ''--v=2''|multi|5',
+  'cr-disable-gpu|--es cr ''--disable-gpu''|multi|5',
+  'single-process|--es cr ''--single-process''|single|5'
+)
+
+$script:XFAIL_CASES = 'cr-disable-gpu'
+
+# ---------------------------------------------------------------------------
+# Logging
+# ---------------------------------------------------------------------------
+# Colors mirror verify_demo.sh: cyan "[verify]" prefix, default-colored timestamp,
+# and a body colored by status (ok=green, warn=yellow, err=red, run=cyan).
+function Now { Get-Date -Format 'yyyy-MM-dd HH:mm:ss' }
+function log {
+  param([string]$m)
+  Write-Host '[verify]' -ForegroundColor Cyan -NoNewline
+  Write-Host (" {0} {1}" -f (Now), $m)
+}
+function ok {
+  param([string]$m)
+  Write-Host '[verify]' -ForegroundColor Cyan -NoNewline
+  Write-Host (" {0} " -f (Now)) -NoNewline
+  Write-Host $m -ForegroundColor DarkGreen
+}
+function warn {
+  param([string]$m)
+  Write-Host '[verify]' -ForegroundColor Cyan -NoNewline
+  Write-Host (" {0} " -f (Now)) -NoNewline
+  Write-Host $m -ForegroundColor Yellow
+}
+function err {
+  param([string]$m)
+  Write-Host '[verify]' -ForegroundColor Cyan -NoNewline
+  Write-Host (" {0} " -f (Now)) -NoNewline
+  Write-Host $m -ForegroundColor DarkRed
+}
+function run_log {
+  param([string]$m)
+  Write-Host '[verify]' -ForegroundColor Cyan -NoNewline
+  Write-Host (" {0} run: " -f (Now)) -NoNewline
+  Write-Host $m -ForegroundColor DarkCyan
+}
+function run_out {
+  param([string]$m)
+  Write-Host '[verify]' -ForegroundColor Cyan -NoNewline
+  Write-Host (" {0}   " -f (Now)) -NoNewline
+  Write-Host $m -ForegroundColor DarkCyan
+}
+
+function Show-Usage {
+  Write-Host @"
+Usage: verify_demo.ps1 [options] <device>
+
+Push and install the afree demo, then run the help.md scenarios one by one.
+
+Device:
+  <device>                e.g. 30.207.82.150:62441 (or an adb serial); also --serial
+
+Options:
+  -h, --help              show this help
+  --list                  list all scenario names and exit
+  --only <a,b,...>        run only the given scenarios (see --list; media = audio/video test)
+  --url <url>             extra URL to run (repeatable; creates url-custom cases and is passed to the media test)
+  --ua <ua>               set UserAgent (for url-custom and the media test)
+  --media-test            also run the audio/video playback test (media_test.py)
+  --media-test-only       run only the media test, skip all other cases (implies --media-test)
+  --media-runtime <sec>   media test first-screen load wait in seconds
+  --media-taps <n>        media test tap attempts
+  --media-sustain <sec>   media test sustained-playback confirmation seconds
+  --release               use release APK (release preferred by default)
+  --debug                 use debug APK
+  --apk <path>            explicitly specify the APK
+  --no-install            skip push/install and verify the already-installed app
+  --serial <dev>          same as the positional <device>
+  --relay-mss <n>         accepted for compatibility; ignored on Windows (direct connection)
+  --no-auto-relay         no-op on Windows
+  --wait <sec>            seconds to wait after each scenario starts (default $($script:WAIT))
+  --push-timeout <sec>    push timeout (default $($script:PUSH_TIMEOUT))
+  --no-scroll             do not run tools/verify_scroll.ps1 (runs by default)
+  --no-locale             do not run tools/verify_locale.ps1 (runs by default)
+  --with-video            also run tools/verify_video.ps1 (needs network)
+  --report <file>         write a Markdown report to <file>
+
+Examples:
+  verify_demo.bat 30.207.82.150:62441
+  verify_demo.bat --no-install --media-test 30.207.82.150:62439
+  verify_demo.bat --debug --no-install --only url,help <device>
+"@
+}
+
+# ---------------------------------------------------------------------------
+# Argument parsing
+# ---------------------------------------------------------------------------
+function Need-Arg([int]$idx) {
+  if (($idx + 1) -ge $script:ARGV.Count) {
+    err "option $($script:ARGV[$idx]) requires a value"
+    Show-Usage
+    exit 2
+  }
+  return [string]$script:ARGV[$idx + 1]
+}
+
+function Parse-Args {
+  $i = 0
+  while ($i -lt $script:ARGV.Count) {
+    $a = [string]$script:ARGV[$i]
+    if ($a -eq '-h' -or $a -eq '--help') { Show-Usage; exit 0 }
+    elseif ($a -eq '--list') { $script:LIST = 1; $i++ }
+    elseif ($a -eq '--only') { $script:ONLY = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--url') { $script:EXTRA_URLS += (Need-Arg $i); $i += 2 }
+    elseif ($a -eq '--ua') { $script:UA = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--media-test') { $script:MEDIA_TEST_ON = 1; $i++ }
+    elseif ($a -eq '--media-test-only') { $script:MEDIA_TEST_ON = 1; $script:MEDIA_TEST_ONLY = 1; $i++ }
+    elseif ($a -eq '--media-runtime') { $script:MEDIA_RUNTIME = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--media-taps') { $script:MEDIA_TAPS = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--media-sustain') { $script:MEDIA_SUSTAIN = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--release') { $script:USE_RELEASE = 1; $i++ }
+    elseif ($a -eq '--debug') { $script:USE_DEBUG = 1; $i++ }
+    elseif ($a -eq '--apk') { $script:APK_OVERRIDE = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--no-install') { $script:NO_INSTALL = 1; $i++ }
+    elseif ($a -eq '--serial' -or $a -eq '-s') { $script:SERIAL = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--relay-mss') { $script:RELAY_MSS = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--no-auto-relay') { $script:AUTO_RELAY = 0; $i++ }
+    elseif ($a -eq '--wait') { $script:WAIT = [int](Need-Arg $i); $i += 2 }
+    elseif ($a -eq '--push-timeout') { $script:PUSH_TIMEOUT = [int](Need-Arg $i); $i += 2 }
+    elseif ($a -eq '--no-scroll') { $script:SCROLL = 0; $i++ }
+    elseif ($a -eq '--no-locale') { $script:LOCALE = 0; $i++ }
+    elseif ($a -eq '--with-video') { $script:VIDEO = 1; $i++ }
+    elseif ($a -eq '--report') { $script:REPORT = Need-Arg $i; $i += 2 }
+    elseif ($a -eq '--') { break }
+    elseif ($a -match '^-') { err "unknown option: $a"; Show-Usage; exit 2 }
+    else { $script:SERIAL = $a; $i++ }
+  }
+
+  # Append custom URL cases (--url); also listed with --list.
+  if ($script:EXTRA_URLS.Count -gt 0) {
+    $n = 1
+    foreach ($u in $script:EXTRA_URLS) {
+      $nm = 'url-custom'
+      if ($n -gt 1) { $nm = "url-custom-$n" }
+      $ex = "-e url '$u'"
+      if ($script:UA) { $ex = "$ex -e ua '$($script:UA)'" }
+      $script:CASES += ("{0}|{1}|multi|5" -f $nm, $ex)
+      $n++
+    }
+  }
+  if ($script:LIST -eq 1) {
+    foreach ($row in $script:CASES) { Write-Output (($row -split '\|')[0]) }
+    if ($script:MEDIA_TEST_ON -eq 1) { Write-Output 'media' }
+    exit 0
+  }
+}
+
+# ---------------------------------------------------------------------------
+# Bounded (non-blocking) process execution
+# ---------------------------------------------------------------------------
+function Invoke-Cmd {
+  param(
+    [string]$Exe,
+    [string[]]$CmdArgs,
+    [int]$TimeoutSec = 30
+  )
+  $script:SEQ++
+  $o = Join-Path $script:TMP_DIR ("c$($script:SEQ).out")
+  $e = Join-Path $script:TMP_DIR ("c$($script:SEQ).err")
+  $p = $null
+  try {
+    $p = Start-Process -FilePath $Exe -ArgumentList $CmdArgs -NoNewWindow -PassThru `
+      -RedirectStandardOutput $o -RedirectStandardError $e
+  } catch {
+    return @{ rc = 127; out = "Start-Process failed: $_"; timeout = $false }
+  }
+  $deadline = (Get-Date).AddSeconds($TimeoutSec)
+  while ($true) {
+    if (-not (Get-Process -Id $p.Id -ErrorAction SilentlyContinue)) { break }
+    if ((Get-Date) -ge $deadline) {
+      Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue
+      $out = ''
+      if (Test-Path $o) { $out = [string](Get-Content -LiteralPath $o -Raw -ErrorAction SilentlyContinue) }
+      return @{ rc = 124; out = $out; timeout = $true }
+    }
+    Start-Sleep -Milliseconds 150
+  }
+  $out = ''
+  if (Test-Path $o) { $out += [string](Get-Content -LiteralPath $o -Raw -ErrorAction SilentlyContinue) }
+  if (Test-Path $e) { $out += [string](Get-Content -LiteralPath $e -Raw -ErrorAction SilentlyContinue) }
+  # Read the real exit code: Start-Process -PassThru only populates ExitCode after
+  # WaitForExit() (available in normal PowerShell; guarded for locked-down hosts).
+  $rc = 0
+  try {
+    $p.WaitForExit()
+    $rc = $p.ExitCode
+  } catch {
+    try { if ($p.HasExited) { $rc = $p.ExitCode } } catch { $rc = 0 }
+  }
+  return @{ rc = $rc; out = $out; timeout = $false }
+}
+
+function Adb-Run {
+  param([string[]]$AdbArgs, [int]$TimeoutSec = 30)
+  $all = @('-s', $script:SERIAL) + $AdbArgs
+  return Invoke-Cmd -Exe $script:ADB -CmdArgs $all -TimeoutSec $TimeoutSec
+}
+
+# ---------------------------------------------------------------------------
+# Environment / adb
+# ---------------------------------------------------------------------------
+function Setup-Env {
+  $base = $env:TEMP
+  if (-not $base) { $base = $env:TMP }
+  $script:TMP_DIR = Join-Path $base ("afree_verify_" + (Get-Random -Minimum 100000 -Maximum 999999))
+  New-Item -ItemType Directory -Path $script:TMP_DIR -Force | Out-Null
+
+  $c = Get-Command adb -ErrorAction SilentlyContinue
+  if (-not $c) { err 'adb not found in PATH, please add platform-tools to PATH'; exit 1 }
+  $script:ADB = if ($c.Source) { $c.Source } else { $c.Path }
+  log "adb: $($script:ADB)"
+
+  # Make the adb server carry the vendor keys; otherwise TCP devices (especially
+  # newly added connections) may report "device unauthorized".
+  $vk = $env:ADB_VENDOR_KEYS
+  if (-not $vk) { $vk = Join-Path $env:USERPROFILE '.android\adbkey' }
+  $env:ADB_VENDOR_KEYS = $vk
+  if (Test-Path $vk) {
+    Invoke-Cmd -Exe $script:ADB -CmdArgs @('kill-server') -TimeoutSec 15 | Out-Null
+    Start-Sleep -Seconds 1
+    $env:ADB_VENDOR_KEYS = $vk
+    # Start the adb server in a detached hidden console. If it is started in our
+    # own console it inherits the console handle and makes cmd/PowerShell appear
+    # to "hang" after the script has already finished.
+    $line = ('"{0}" start-server 1>nul 2>nul' -f $script:ADB)
+    Start-Process -FilePath (Join-Path $env:SystemRoot 'System32\cmd.exe') -ArgumentList @('/c', $line) -WindowStyle Hidden | Out-Null
+    Start-Sleep -Seconds 2
+    $script:SERVER_STARTED = $true
+  }
+
+  # python3
+  $py = $null
+  $pyargs = @()
+  foreach ($name in @('python3', 'python')) {
+    $p = Get-Command $name -ErrorAction SilentlyContinue
+    if ($p) {
+      $v = (& $p.Source -c "import sys;print(sys.version_info[0])" 2>$null | Out-String).Trim()
+      if ($v -eq '3') { $py = $p.Source; break }
+    }
+  }
+  if (-not $py) {
+    $p = Get-Command py -ErrorAction SilentlyContinue
+    if ($p) {
+      $v = (& $p.Source -3 -c "import sys;print(sys.version_info[0])" 2>$null | Out-String).Trim()
+      if ($v -eq '3') { $py = $p.Source; $pyargs = @('-3') }
+    }
+  }
+  if (-not $py) { err 'python3 not found in PATH (install Python 3, or use the py launcher)'; exit 1 }
+  $script:PY = $py
+  $script:PYARGS = $pyargs
+  log "python: $py $($pyargs -join ' ')"
+
+  if (-not (Test-Path $ANALYZER)) { err "missing $ANALYZER"; exit 1 }
+
+  $ps = Get-Command powershell -ErrorAction SilentlyContinue
+  if ($ps) { $script:POWERSHELL = if ($ps.Source) { $ps.Source } else { $ps.Path } }
+  else { $script:POWERSHELL = Join-Path $PSHOME 'powershell.exe' }
+
+  $env:AFREE_ADB = $script:ADB
+  $env:AFREE_PY = $script:PY
+  $env:AFREE_PYARGS = ($script:PYARGS -join ',')
+}
+
+function Cleanup {
+  # NOTE: do NOT kill the adb server here; it was started detached and killing it
+  # would drop the TCP device connection for later runs.
+  if ($script:TMP_DIR -and (Test-Path $script:TMP_DIR)) {
+    Remove-Item -LiteralPath $script:TMP_DIR -Recurse -Force -ErrorAction SilentlyContinue
+  }
+}
+
+function Wait-Device {
+  for ($i = 1; $i -le 15; $i++) {
+    $r = Invoke-Cmd -Exe $script:ADB -CmdArgs @('-s', $script:SERIAL, 'get-state') -TimeoutSec 10
+    if (($r.out).Trim() -eq 'device') { return $true }
+    Start-Sleep -Seconds 1
+  }
+  return $false
+}
+
+function Setup-Device {
+  if (-not $script:SERIAL) { err 'missing device argument'; Show-Usage; exit 2 }
+  $script:DEVICE = $script:SERIAL
+  if ($script:RELAY_MSS) {
+    warn "--relay-mss=$($script:RELAY_MSS) is not supported on Windows (TCP_MAXSEG unavailable); using a direct connection"
+    $script:AUTO_RELAY = 0
+  }
+  if ($script:SERIAL -match ':') {
+    Invoke-Cmd -Exe $script:ADB -CmdArgs @('connect', $script:SERIAL) -TimeoutSec 20 | Out-Null
+  }
+  if (-not (Wait-Device)) { err "device $($script:SERIAL) not ready (not device)"; exit 1 }
+  $r = Invoke-Cmd -Exe $script:ADB -CmdArgs @('-s', $script:SERIAL, 'shell', 'getprop ro.product.cpu.abi') -TimeoutSec 15
+  log "device: $($script:SERIAL) ($(($r.out).Trim()))"
+}
+
+# ---------------------------------------------------------------------------
+# APK locate & install
+# ---------------------------------------------------------------------------
+function Pick-Apk {
+  if ($script:APK_OVERRIDE) {
+    if (-not (Test-Path $script:APK_OVERRIDE)) { err "APK does not exist: $($script:APK_OVERRIDE)"; exit 1 }
+    $script:APK = $script:APK_OVERRIDE
+    return
+  }
+  $rel = Join-Path $SCRIPT_DIR 'build\outputs\apk\release\demo-release.apk'
+  $dbg = Join-Path $SCRIPT_DIR 'build\outputs\apk\debug\demo-debug.apk'
+  if ($script:USE_DEBUG -eq 1) { $script:APK = $dbg } else { $script:APK = $rel }
+  if (-not (Test-Path $script:APK)) {
+    if (Test-Path $rel) { $script:APK = $rel }
+    elseif (Test-Path $dbg) { $script:APK = $dbg }
+  }
+  if (-not (Test-Path $script:APK)) {
+    err 'demo APK not found (neither release nor debug). Build it first.'
+    exit 1
+  }
+}
+
+function Remote-Size([string]$f) {
+  for ($i = 1; $i -le 3; $i++) {
+    $r = Adb-Run @('shell', "wc -c < '$f' 2>/dev/null") 20
+    $digits = (($r.out) -replace '[^0-9]', '')
+    if ($digits) { return $digits }
+    Start-Sleep -Seconds 1
+  }
+  return ''
+}
+
+function Install-Apk {
+  $remote = '/data/local/tmp/' + (Split-Path -Leaf $script:APK)
+  $lsz = (Get-Item -LiteralPath $script:APK).Length
+  log ("APK: {0} ({1:N1} MB)" -f (Split-Path -Leaf $script:APK), ($lsz / 1MB))
+
+  log "adb push $($script:APK) $remote"
+  $qApk = '"{0}"' -f $script:APK
+  $qRemote = '"{0}"' -f $remote
+  $r = Invoke-Cmd -Exe $script:ADB -CmdArgs @('-s', $script:SERIAL, 'push', $qApk, $qRemote) -TimeoutSec $script:PUSH_TIMEOUT
+  if ($r.timeout) { err "adb push timed out after $($script:PUSH_TIMEOUT)s"; return $false }
+  foreach ($l in (($r.out) -split "`n")) { if ($l.Trim()) { run_out $l.Trim() } }
+
+  $rsz = Remote-Size $remote
+  if ("$lsz" -ne "$rsz") { err "push size mismatch local=$lsz remote=$rsz"; return $false }
+  ok ("push complete ({0} MB)" -f [int]($rsz / 1048576))
+
+  $r = Adb-Run @('shell', "pm install -r -g $remote") 180
+  if (($r.out) -notmatch 'Success') {
+    warn "install failed ($(($r.out).Trim())), trying uninstall then reinstall"
+    Adb-Run @('shell', "pm uninstall $PKG") 60 | Out-Null
+    $r = Adb-Run @('shell', "pm install -g $remote") 180
+    if (($r.out) -notmatch 'Success') { err "install failed: $(($r.out).Trim())"; return $false }
+  }
+  ok 'install succeeded'
+  return $true
+}
+
+# ---------------------------------------------------------------------------
+# Check primitives
+# ---------------------------------------------------------------------------
+function Proc-Alive {
+  $r = Adb-Run @('shell', 'pidof com.afree.demo') 20
+  return (($r.out).Trim().Length -gt 0)
+}
+
+function Sandboxed-Count {
+  $r = Adb-Run @('shell', "ps -A -o NAME 2>/dev/null | grep -c 'com.afree.demo:sandboxed_process'") 20
+  return ($r.out).Trim()
+}
+
+function Crashes {
+  $r = Adb-Run @('logcat', '-d') 60
+  $lines = @(($r.out) -split "`n" | Where-Object { $_ -ne '' } | ForEach-Object { $_ -replace "`r", '' })
+  $res = @()
+  for ($i = 0; $i -lt $lines.Count; $i++) {
+    if ($lines[$i] -match 'FATAL EXCEPTION') {
+      $end = $i + 6
+      if ($end -ge $lines.Count) { $end = $lines.Count - 1 }
+      for ($j = $i; $j -le $end; $j++) {
+        if ($lines[$j] -match $PKG) {
+          $res += $lines[$j]
+          if ($res.Count -ge 2) { break }
+        }
+      }
+    }
+    if ($res.Count -ge 2) { break }
+  }
+  if ($res.Count -gt 0) { return ($res -join "`n") }
+  $res2 = @($lines | Where-Object { $_ -match 'UnsatisfiedLinkError|WebView cannot be started|J\.N\.VO' } | Select-Object -First 3)
+  return ($res2 -join "`n")
+}
+
+function Screen-Ratio([string]$name) {
+  $dev = "/data/local/tmp/afree_shot_$name.png"
+  $local = Join-Path $script:TMP_DIR "shot_$name.png"
+  Adb-Run @('shell', "screencap -p $dev") 25 | Out-Null
+  Adb-Run @('pull', $dev, $local) 60 | Out-Null
+  if (-not (Test-Path $local)) { return '' }
+  $out = (& $script:PY @($script:PYARGS + @($ANALYZER, $local)) 2>$null | Out-String)
+  if ($out -match 'non-black ratio:\s*([0-9.]+)%') { return $Matches[1] }
+  return ''
+}
+
+function Dump-Procs {
+  $cmd = "ps -efw | grep -iE 'com.afree.demo'"
+  run_log $cmd
+  $r = Adb-Run @('shell', $cmd) 20
+  $out = @(($r.out) -split "`n" | ForEach-Object { $_ -replace "`r", '' } | Where-Object { $_ -and ($_ -notmatch 'grep -iE|sh -c ps -efw') })
+  if ($out.Count -eq 0) { run_out '(no matching process)'; return }
+  foreach ($l in $out) { run_out $l }
+}
+
+function Dump-Engine {
+  run_log "ps -efw | grep -iE 'sandboxed_process'"
+  $r = Adb-Run @('shell', "ps -efw | grep -iE 'sandboxed_process'") 20
+  $sandbox = @(($r.out) -split "`n" | ForEach-Object { $_ -replace "`r", '' } | Where-Object { $_ -and ($_ -notmatch 'grep -iE|sh -c ps -efw') })
+  if ($sandbox.Count -eq 0) { run_out '(no sandboxed process)' }
+  else { foreach ($l in $sandbox) { run_out $l } }
+
+  run_log "logcat -d | grep -E 'AfreeWebViewFactory|nativeloader.*libwebviewchromium'"
+  $r = Adb-Run @('logcat', '-d') 60
+  $eng = @(($r.out) -split "`n" | Where-Object { $_ -match 'AfreeWebViewFactory|nativeloader.*libwebviewchromium' } | Select-Object -Last 8)
+  foreach ($l in $eng) { run_out ($l -replace "`r", '') }
+}
+
+# ---------------------------------------------------------------------------
+# Single scenario
+# ---------------------------------------------------------------------------
+function Run-Case([string]$name, [string]$extras, [string]$expect, [string]$minratio) {
+  if ($script:ONLY -and (",$($script:ONLY)," -notmatch ",$name,")) { return }
+
+  log "----- case: $name -----"
+  run_log "am force-stop $PKG"
+  Adb-Run @('shell', "am force-stop $PKG") 20 | Out-Null
+  Adb-Run @('logcat', '-c') 20 | Out-Null
+
+  $cmd = "am start -W -n $ACTIVITY"
+  if ($extras) { $cmd = "$cmd $extras" }
+  run_log $cmd
+  $start = Adb-Run @('shell', $cmd) 60
+  if ($start.timeout) { warn "am start did not return within 60s (continuing)" }
+  elseif (($start.out) -notmatch 'Status: ok|Activity:') { warn "unexpected start output: $(($start.out).Trim())" }
+  Start-Sleep -Seconds $script:WAIT
+
+  $status = 'PASS'
+  $detail = ''
+
+  if (-not (Proc-Alive)) { $status = 'FAIL'; $detail += 'process not alive; ' }
+
+  $cr = Crashes
+  if ($cr) {
+    $first = ($cr -split "`n")[0]
+    $status = 'FAIL'
+    $detail += "crash: $first; "
+  }
+
+  $sc = (Sandboxed-Count).Trim()
+  if ($sc -notmatch '^\d+$') { $sc = '0' }
+  $sci = [int]$sc
+  if ($expect -eq 'multi' -and $sci -eq 0) { $status = 'FAIL'; $detail += 'no sandboxed render process; ' }
+  if ($expect -eq 'single' -and $sci -ne 0) { $status = 'FAIL'; $detail += 'sandboxed render process present (should be single-process); ' }
+  if ($name -eq 'engine-system' -and $sci -ne 0) {
+    $status = 'FAIL'
+    $detail += "system engine but an afree render process appeared (${PKG}:sandboxed_process); "
+  }
+
+  $ratio = Screen-Ratio $name
+  if (-not $ratio) {
+    $status = 'FAIL'; $detail += 'screenshot analysis failed; '
+  } elseif (-not ([double]$ratio -ge [double]$minratio)) {
+    $status = 'FAIL'; $detail += "non-black ratio ${ratio}% < ${minratio}%; "
+  }
+
+  $is_xfail = $false
+  if (",$($script:XFAIL_CASES)," -match ",$name,") { $is_xfail = $true }
+
+  if ($status -eq 'PASS') {
+    ok "PASS  $name  (sandboxed=$sc, non-black=${ratio}%)"
+  } elseif ($is_xfail) {
+    $status = 'KNOWN'
+    $detail = "known issue (expected crash): $detail"
+    warn "KNOWN $name  ($detail)"
+  } else {
+    err "FAIL  $name  ($detail)"
+    $script:FAILED++
+  }
+  $script:RESULT_ROWS += ("{0}|{1}|{2}|sandboxed={3}|non-black={4}%|{5}" -f $status, $name, $extras, $sc, $ratio, $detail)
+
+  if ($name -eq 'url' -or $name -eq 'single-process') { Dump-Procs }
+  if ($name -eq 'engine-afree' -or $name -eq 'engine-system') { Dump-Engine }
+}
+
+# ---------------------------------------------------------------------------
+# Report
+# ---------------------------------------------------------------------------
+function Write-Report {
+  if (-not $script:REPORT) { return }
+  $lines = @()
+  $lines += '# afree demo verification report'
+  $lines += ''
+  $lines += ('- time: ' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'))
+  $lines += ('- device: ' + $script:SERIAL)
+  $lines += ('- APK : ' + $script:APK)
+  $lines += ('- wait: ' + $script:WAIT + 's')
+  $lines += ''
+  $lines += '| result | scenario | extras | sandboxed | non-black | note |'
+  $lines += '|------|------|--------|-----------|----------|------|'
+  foreach ($row in $script:RESULT_ROWS) {
+    $p = $row -split '\|'
+    $lines += ('| {0} | {1} | `{2}` | {3} | {4} | {5} |' -f $p[0], $p[1], $p[2], $p[3], $p[4], $p[5])
+  }
+  Set-Content -LiteralPath $script:REPORT -Value $lines -Encoding UTF8
+  ok "report written: $($script:REPORT)"
+}
+
+# ---------------------------------------------------------------------------
+# Tool scripts (bounded by an overall timeout)
+# ---------------------------------------------------------------------------
+function Invoke-ToolScript([string]$Path, [string[]]$ToolArgs, [int]$TimeoutSec) {
+  $a = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ('"{0}"' -f $Path)) + $ToolArgs
+  return Invoke-Cmd -Exe $script:POWERSHELL -CmdArgs $a -TimeoutSec $TimeoutSec
+}
+
+function Run-ToolCase([string]$label, [string]$scriptName, [string[]]$ToolArgs, [int]$TimeoutSec) {
+  log "----- case: $label ($scriptName) -----"
+  run_log "am force-stop $PKG"
+  Adb-Run @('shell', "am force-stop $PKG") 20 | Out-Null
+  $tool = Join-Path $TOOLS_DIR $scriptName
+  run_log "$tool $($ToolArgs -join ' ')"
+  $r = Invoke-ToolScript $tool $ToolArgs $TimeoutSec
+  Set-Content -LiteralPath (Join-Path $script:TMP_DIR ("$label.log")) -Value $r.out -Encoding UTF8
+  if ($r.timeout) {
+    err "FAIL  $label (timed out after ${TimeoutSec}s)"
+    $script:FAILED++
+    $script:RESULT_ROWS += ("FAIL|{0}|{1}|| |timeout" -f $label, $scriptName)
+    return
+  }
+  $toolPass = ($r.rc -eq 0) -or (($r.out) -match '(?m)^\s*PASS')
+  if ($toolPass) {
+    $msg = ''
+    foreach ($l in (($r.out) -split "`n")) { if ($l -match 'PASS') { $msg = $l.Trim(); break } }
+    ok "PASS  $label  ($msg)"
+    $script:RESULT_ROWS += ("PASS|{0}|{1}|| |{2}" -f $label, $scriptName, $msg)
+  } else {
+    err "FAIL  $label"
+    $tail = ((($r.out) -split "`n") | Select-Object -Last 3) -join ' '
+    Write-Host "    $tail"
+    $script:FAILED++
+    $script:RESULT_ROWS += ("FAIL|{0}|{1}|| |see stdio" -f $label, $scriptName)
+  }
+}
+
+# ---------------------------------------------------------------------------
+# Main
+# ---------------------------------------------------------------------------
+function Main {
+  Parse-Args
+  Setup-Env
+  Setup-Device
+
+  if ($script:NO_INSTALL -eq 0) {
+    Pick-Apk
+    if (-not (Install-Apk)) { exit 1 }
+  } else {
+    $script:APK = '<installed, not pushed>'
+    log '--no-install: skipping push/install'
+  }
+
+  if ($script:MEDIA_TEST_ONLY -eq 1) {
+    log "--media-test-only: skipping $($script:CASES.Count) regular cases, running only media"
+  } else {
+    foreach ($row in $script:CASES) {
+      $parts = $row -split '\|', 4
+      Run-Case $parts[0] $parts[1] $parts[2] $parts[3]
+    }
+  }
+
+  if ($script:MEDIA_TEST_ONLY -eq 0 -and $script:SCROLL -eq 1 -and ((-not $script:ONLY) -or (",$($script:ONLY)," -match ',scroll,'))) {
+    Run-ToolCase 'scroll' 'verify_scroll.ps1' @($script:SERIAL) 240
+  }
+
+  if ($script:MEDIA_TEST_ONLY -eq 0 -and $script:LOCALE -eq 1 -and ((-not $script:ONLY) -or (",$($script:ONLY)," -match ',locale,'))) {
+    $localeApk = ''
+    if ($script:APK -and ($script:APK -notmatch '^<')) { $localeApk = $script:APK }
+    $localeArgs = @($script:SERIAL)
+    if ($localeApk) { $localeArgs += $localeApk }
+    Run-ToolCase 'locale' 'verify_locale.ps1' $localeArgs 600
+  }
+
+  if ($script:MEDIA_TEST_ONLY -eq 0 -and $script:VIDEO -eq 1 -and ((-not $script:ONLY) -or (",$($script:ONLY)," -match ',video,'))) {
+    Run-ToolCase 'video' 'verify_video.ps1' @($script:SERIAL) 180
+  }
+
+  if ($script:MEDIA_TEST_ON -eq 1 -and ($script:MEDIA_TEST_ONLY -eq 1 -or (-not $script:ONLY) -or (",$($script:ONLY)," -match ',media,'))) {
+    log '----- case: media (media_test.py) -----'
+    $margs = @('--device', $script:SERIAL)
+    if ($script:UA) { $margs += @('--ua', $script:UA) }
+    if ($script:MEDIA_RUNTIME) { $margs += @('--runtime', $script:MEDIA_RUNTIME) }
+    if ($script:MEDIA_TAPS) { $margs += @('--taps', $script:MEDIA_TAPS) }
+    if ($script:MEDIA_SUSTAIN) { $margs += @('--sustain', $script:MEDIA_SUSTAIN) }
+    foreach ($u in $script:EXTRA_URLS) { $margs += @('--url', $u) }
+    $all = @()
+    $all += $script:PYARGS
+    $all += @($MEDIA_TEST_PY)
+    $all += $margs
+    run_log ("$($script:PY) " + ($all -join ' '))
+    $r = Invoke-Cmd -Exe $script:PY -CmdArgs $all -TimeoutSec 1800
+    foreach ($l in (($r.out) -split "`n")) {
+      $t = $l -replace "`r", ''
+      if ($t.Trim().Length -gt 0) { run_out $t }
+    }
+    $mediaPass = ($r.rc -eq 0)
+    if (-not $mediaPass) {
+      if (($r.out) -match '\[media\]\s+passed\s+(\d+)\s*/\s*(\d+)') {
+        if ($Matches[1] -eq $Matches[2]) { $mediaPass = $true }
+      }
+    }
+    if ($mediaPass) {
+      ok 'PASS  media'
+      $script:RESULT_ROWS += 'PASS|media|media_test.py|| |ok'
+    } else {
+      err 'FAIL  media (see [media] output above)'
+      $script:FAILED++
+      $script:RESULT_ROWS += 'FAIL|media|media_test.py|| |see output'
+    }
+  }
+
+  Write-Report
+
+  Write-Host ''
+  log '==================== Summary ===================='
+  foreach ($row in $script:RESULT_ROWS) {
+    $p = $row -split '\|'
+    $st = $p[0]; $n = $p[1]
+    if ($st -eq 'PASS') { ok "PASS  $n" }
+    elseif ($st -eq 'KNOWN') { warn "KNOWN $n" }
+    else { err "FAIL  $n" }
+  }
+  Write-Host '--------------------------------------------------'
+  if ($script:FAILED -eq 0) {
+    ok "all passed ($($script:RESULT_ROWS.Count) items)"
+    exit 0
+  } else {
+    err "failed $($script:FAILED) / $($script:RESULT_ROWS.Count) items"
+    exit 1
+  }
+}
+
+try {
+  Main
+}
+finally {
+  Cleanup
+}
diff --git a/android_webview/afree/demo/verify_demo.sh b/android_webview/afree/demo/verify_demo.sh
new file mode 100755
index 0000000000..8854a7b3c0
--- /dev/null
+++ b/android_webview/afree/demo/verify_demo.sh
@@ -0,0 +1,743 @@
+#!/usr/bin/env bash
+# =============================================================================
+# verify_demo.sh — afree demo push/install + help.md scenario regression verification (standalone script)
+#
+# Location: android_webview/afree/demo/verify_demo.sh (runs from any directory)
+#
+# Features:
+#   1) Locate the demo APK (release preferred, then debug; can be set via --apk)
+#   2) Push to the target device and install (skippable via --no-install)
+#   3) Run each runnable scenario from help.md and verify:
+#        - process alive, no crash (FATAL / UnsatisfiedLinkError / J.N.VO)
+#        - rendered content (screenshot -> non-black pixel ratio via tools/screenshot_analyze.py)
+#        - single/multi process (whether com.afree.demo:sandboxed_process appears)
+#   4) optionally run tools/verify_scroll.sh (default on), tools/verify_video.sh (--with-video)
+#   5) summarize PASS/FAIL; write a Markdown report via --report <file>
+#
+# Usage:
+#   ./verify_demo.sh [options] <device>
+#
+# Examples:
+#   ./verify_demo.sh 30.207.82.150:62441
+#   ./verify_demo.sh --relay-mss 1200 30.207.82.150:62441   # when the path MTU is black-holed
+#   ./verify_demo.sh --debug --no-install <device>
+#   ./verify_demo.sh --only url,help,engine-system <device>
+#   ./verify_demo.sh --list
+#   ./android_webview/afree/demo/verify_demo.sh --no-install --media-test-only --relay-mss 1200 30.207.82.150:62451
+#   ./android_webview/afree/demo/media_test.py --runtime 14 --sustain 6 --only bilibili --device 30.207.82.150:62451
+#
+# Dependencies: adb; python3 (stdlib only, for screenshot analysis/built-in relay)
+# Tip: `source env.sh` first to ensure adb is in PATH (the script also tries automatically).
+# =============================================================================
+
+set -u
+
+# Never write __pycache__/*.pyc (keeps the tree/bundle clean).
+export PYTHONDONTWRITEBYTECODE=1
+
+# ---------------------------------------------------------------------------
+# Constants
+# ---------------------------------------------------------------------------
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+AFREE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
+TOOLS_DIR="$AFREE_DIR/tools"
+ANALYZER="$TOOLS_DIR/screenshot_analyze.py"
+
+PKG="com.afree.demo"
+ACTIVITY="$PKG/.MainActivity"
+UA="Mozilla/5.0 (Linux; Android 6.0.99; AS22L Build/YunOSBuildID) AppleWebKit/537.36 (KHTML, like Gecko) Afree/3.0.0.0 Chrome/150.0.7871.255 Mobile Safari/537.36 Edg/150.0.0.0"
+
+WAIT="${WAIT:-8}"          # seconds to wait after each scenario starts
+PUSH_TIMEOUT="${PUSH_TIMEOUT:-120}"  # overall timeout for a normal push (on timeout assume black hole and switch to relay)
+SCROLL=1                   # run verify_scroll.sh by default
+LOCALE=1                   # run verify_locale.sh by default
+VIDEO=0                    # do not run verify_video.sh by default
+NO_INSTALL=0
+USE_DEBUG=0
+USE_RELEASE=0
+APK_OVERRIDE=""
+SERIAL=""
+DEVICE=""
+ONLY=""
+UA=""
+MEDIA_TEST=0
+MEDIA_TEST_ONLY=0
+MEDIA_RUNTIME=""
+MEDIA_TAPS=""
+MEDIA_SUSTAIN=""
+EXTRA_URLS=()
+LIST=0
+REPORT=""
+RELAY_MSS=""
+AUTO_RELAY=1
+RELAY_PID=""
+TMP_DIR=""
+
+# name | am extras | process(model: multi|single|any) | min non-black %
+CASES=(
+"default||multi|5"
+"url|-e url \"https://www.baidu.com/?noapp=1\"|multi|5"
+"ua|-e ua \"$UA\"|multi|5"
+"url+ua|-e url \"https://www.baidu.com/?noapp=1\" -e ua \"$UA\"|multi|5"
+"asset-copyright|-e url \"file:///android_asset/copyright.md\"|multi|5"
+"asset-readme|-e url \"file:///android_asset/readme.md\"|multi|5"
+"asset-issues|-e url \"file:///android_asset/issues.md\"|multi|5"
+"help|-e help true|multi|5"
+"engine-afree|-e engine afree -e url \"https://www.baidu.com/?noapp=1\"|multi|5"
+"engine-system|-e engine system -e url \"https://www.baidu.com/?noapp=1\"|any|5"
+"private|-e private 1|multi|5"
+"incognito|-e incognito 1|multi|5"
+"cr-v|--es cr '--v=2'|multi|5"
+"cr-disable-gpu|--es cr '--disable-gpu'|multi|5"
+"single-process|--es cr '--single-process'|single|5"
+)
+
+# Scenarios known to fail but not a regression (reported as KNOWN)
+#   cr-disable-gpu: --disable-gpu triggers content::GpuDataManagerImplPrivate SIGTRAP
+XFAIL_CASES="cr-disable-gpu"
+
+# ---------------------------------------------------------------------------
+# Logging
+# ---------------------------------------------------------------------------
+c_red=$'\033[0;31m'; c_grn=$'\033[0;32m'; c_yel=$'\033[1;33m'; c_cyn=$'\033[0;36m'; c_nc=$'\033[0m'
+_ts()  { date '+%Y-%m-%d %H:%M:%S'; }
+# [verify] prefix coloring; log messages use the default color; ok/warn/err are colored by status.
+log()  { echo "${c_cyn}[verify]${c_nc} $(_ts) $*"; }
+ok()   { echo "${c_grn}[verify]${c_nc} $(_ts) ${c_grn}$*${c_nc}"; }
+warn() { echo "${c_yel}[verify]${c_nc} $(_ts) ${c_yel}$*${c_nc}" >&2; }
+err()  { echo "${c_red}[verify]${c_nc} $(_ts) ${c_red}$*${c_nc}" >&2; }
+# Specific content coloring: commands (am start/force-stop/ps...) and process/logcat output in cyan.
+run_log() { echo "${c_cyn}[verify]${c_nc} $(_ts) run: ${c_cyn}$*${c_nc}"; }
+run_out() { echo "${c_cyn}[verify]${c_nc} $(_ts)   ${c_cyn}$*${c_nc}"; }
+
+usage() {
+  cat <<EOF
+Usage: $(basename "$0") [options] <device>
+
+Push and install the afree demo, then run the help.md scenarios one by one.
+
+Device:
+  <device>                e.g. 30.207.82.150:62441 (or an adb serial); also --serial
+
+Options:
+  -h, --help              show this help
+  --list                  list all scenario names and exit
+  --only <a,b,...>        run only the given scenarios (see --list; media = audio/video test)
+  --url <url>             extra URL to run (repeatable; creates url-custom cases and is passed to the media test)
+  --ua <ua>               set UserAgent (for url-custom and the media test)
+  --media-test            also run the audio/video playback test (media_test.py)
+  --media-test-only       run only the media test, skip all other cases (implies --media-test)
+  --media-runtime <sec>   media test first-screen load wait in seconds
+  --media-taps <n>        media test tap attempts
+  --media-sustain <sec>   media test sustained-playback confirmation seconds
+  --release               use release APK (release preferred by default)
+  --debug                 use debug APK
+  --apk <path>            explicitly specify the APK
+  --no-install            skip push/install and verify the already-installed app
+  --serial <dev>          same as the positional <device>
+  --relay-mss <n>         force the built-in TCP relay (sets TCP_MAXSEG=n on the upstream socket)
+  --no-auto-relay         disable the auto fallback: a normal push is used by default and
+                          falls back to the built-in relay when a black hole is detected
+  --wait <sec>            seconds to wait after each scenario starts (default $WAIT)
+  --push-timeout <sec>    normal push timeout (default $PUSH_TIMEOUT; on timeout assume black hole and use relay)
+  --no-scroll             do not run tools/verify_scroll.sh (runs by default)
+  --no-locale             do not run tools/verify_locale.sh (runs by default)
+  --with-video            also run tools/verify_video.sh (needs network)
+  --report <file>         write a Markdown report to <file>
+
+Examples:
+  $(basename "$0") 30.207.82.150:62441
+  $(basename "$0") --relay-mss 1200 30.207.82.150:62441
+  $(basename "$0") --debug --no-install --only url,help <device>
+  ./android_webview/afree/demo/verify_demo.sh --no-install --media-test --relay-mss 1200 30.207.82.150:62451
+EOF
+}
+
+# ---------------------------------------------------------------------------
+# Argument parsing
+# ---------------------------------------------------------------------------
+parse_args() {
+  while [[ $# -gt 0 ]]; do
+    case "$1" in
+      -h|--help) usage; exit 0 ;;
+      --list) LIST=1; shift ;;
+      --only) ONLY="$2"; shift 2 ;;
+      --url) EXTRA_URLS+=("$2"); shift 2 ;;
+      --ua) UA="$2"; shift 2 ;;
+      --media-test) MEDIA_TEST=1; shift ;;
+      --media-test-only) MEDIA_TEST=1; MEDIA_TEST_ONLY=1; shift ;;
+      --media-runtime) MEDIA_RUNTIME="$2"; shift 2 ;;
+      --media-taps) MEDIA_TAPS="$2"; shift 2 ;;
+      --media-sustain) MEDIA_SUSTAIN="$2"; shift 2 ;;
+      --release) USE_RELEASE=1; shift ;;
+      --debug) USE_DEBUG=1; shift ;;
+      --apk) APK_OVERRIDE="$2"; shift 2 ;;
+      --no-install) NO_INSTALL=1; shift ;;
+      --serial|-s) SERIAL="$2"; shift 2 ;;
+      --relay-mss) RELAY_MSS="$2"; shift 2 ;;
+      --no-auto-relay) AUTO_RELAY=0; shift ;;
+      --wait) WAIT="$2"; shift 2 ;;
+      --push-timeout) PUSH_TIMEOUT="$2"; shift 2 ;;
+      --no-scroll) SCROLL=0; shift ;;
+      --no-locale) LOCALE=0; shift ;;
+      --with-video) VIDEO=1; shift ;;
+      --report) REPORT="$2"; shift 2 ;;
+      --) shift; break ;;
+      -*) err "unknown option: $1"; usage; exit 2 ;;
+      *) SERIAL="$1"; shift ;;
+    esac
+  done
+
+  # Append custom URL cases (--url); also listed with --list
+  if [[ ${#EXTRA_URLS[@]} -gt 0 ]]; then
+    local i=1
+    for u in "${EXTRA_URLS[@]}"; do
+      local nm="url-custom"
+      [[ $i -gt 1 ]] && nm="url-custom-$i"
+      local ex="-e url \"$u\""
+      [[ -n "$UA" ]] && ex="$ex -e ua \"$UA\""
+      CASES+=("$nm|$ex|multi|5")
+      i=$((i + 1))
+    done
+  fi
+  if [[ "$LIST" == "1" ]]; then
+    for row in "${CASES[@]}"; do IFS='|' read -r n _ _ _ <<<"$row"; echo "$n"; done
+    [[ "$MEDIA_TEST" == "1" ]] && echo "media"
+    exit 0
+  fi
+}
+
+# ---------------------------------------------------------------------------
+# Environment / adb
+# ---------------------------------------------------------------------------
+setup_env() {
+  TMP_DIR="$(mktemp -d /tmp/afree_verify.XXXXXX)"
+  if ! command -v adb >/dev/null 2>&1; then
+    if [[ -f "$REPO_ROOT/env.sh" ]]; then
+      log "adb not in PATH, trying to source $REPO_ROOT/env.sh"
+      # shellcheck disable=SC1091
+      source "$REPO_ROOT/env.sh" >/dev/null 2>&1 || true
+    fi
+  fi
+  ADB="$(command -v adb || true)"
+  if [[ -z "$ADB" ]]; then
+    local p="$REPO_ROOT/third_party/android_sdk/public/platform-tools/adb"
+    [[ -x "$p" ]] && ADB="$p"
+  fi
+  [[ -n "$ADB" ]] || { err "adb not found, please source env.sh first"; exit 1; }
+  # Make the adb server carry vendor keys; otherwise TCP devices (especially newly
+  # added relay connections) may report "device unauthorized". Restarting the server once
+  export ADB_VENDOR_KEYS="${ADB_VENDOR_KEYS:-$HOME/.android/adbkey}"
+  if [[ -f "$ADB_VENDOR_KEYS" ]]; then
+    "$ADB" kill-server >/dev/null 2>&1 || true
+    sleep 1
+    ADB_VENDOR_KEYS="$ADB_VENDOR_KEYS" "$ADB" start-server >/dev/null 2>&1 || true
+    sleep 1
+  fi
+  PY="$(command -v python3 || true)"
+  [[ -n "$PY" ]] || { err "python3 not found"; exit 1; }
+  [[ -f "$ANALYZER" ]] || { err "missing $ANALYZER"; exit 1; }
+}
+
+cleanup() {
+  [[ -n "$RELAY_PID" ]] && kill "$RELAY_PID" 2>/dev/null || true
+  if [[ -n "${ADB:-}" && "$SERIAL" == 127.0.0.1:* ]]; then
+    "$ADB" disconnect "$SERIAL" >/dev/null 2>&1 || true
+  fi
+  [[ -n "$TMP_DIR" && -d "$TMP_DIR" ]] && rm -rf "$TMP_DIR"
+}
+trap cleanup EXIT
+
+# Built-in TCP relay: pick a free port -> <host:port>, set TCP_MAXSEG=n on the upstream socket
+start_relay() {
+  local target="$1" mss="$2"
+  local host="${target%%:*}" port="${target##*:}" listen
+  listen="$("$PY" -c 'import socket
+s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
+  local py="$TMP_DIR/relay.py"
+  cat > "$py" <<'PY'
+import socket, threading, sys
+th, tp, lp, mss = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
+TARGET = (th, tp)
+def pump(a, b):
+    try:
+        while True:
+            d = a.recv(65536)
+            if not d: break
+            b.sendall(d)
+    except Exception:
+        pass
+    finally:
+        for s in (a, b):
+            try: s.shutdown(socket.SHUT_RDWR)
+            except Exception: pass
+def handle(c):
+    u = socket.socket()
+    try: u.setsockopt(socket.IPPROTO_TCP, socket.TCP_MAXSEG, mss)
+    except Exception as e: print("setsockopt:", e, flush=True)
+    try: u.connect(TARGET)
+    except Exception as e:
+        print("connect upstream failed:", e, flush=True); c.close(); return
+    threading.Thread(target=pump, args=(c, u), daemon=True).start()
+    threading.Thread(target=pump, args=(u, c), daemon=True).start()
+srv = socket.socket()
+srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+srv.bind(("127.0.0.1", lp)); srv.listen(32)
+print("relay", lp, "->", TARGET, "MSS", mss, flush=True)
+while True:
+    c, _ = srv.accept()
+    threading.Thread(target=handle, args=(c,), daemon=True).start()
+PY
+  "$PY" "$py" "$host" "$port" "$listen" "$mss" >"$TMP_DIR/relay.log" 2>&1 &
+  RELAY_PID=$!
+  disown "$RELAY_PID" 2>/dev/null || true   # don't let bash print "Terminated" when cleanup kills it
+  sleep 1
+  if ! kill -0 "$RELAY_PID" 2>/dev/null; then
+    err "relay failed to start:"; cat "$TMP_DIR/relay.log" >&2; exit 1
+  fi
+  log "built-in relay: 127.0.0.1:$listen -> $host:$port (MSS=$mss)"
+  SERIAL="127.0.0.1:$listen"
+  "$ADB" connect "$SERIAL" >/dev/null 2>&1 || true
+  if ! wait_device; then
+    warn "relay device not ready, reconnecting once ..."
+    "$ADB" disconnect "$SERIAL" >/dev/null 2>&1 || true
+    "$ADB" connect "$SERIAL" >/dev/null 2>&1 || true
+    wait_device || { err "relay device not ready ($SERIAL)"; return 1; }
+  fi
+}
+
+adb_cmd() { "$ADB" -s "$SERIAL" "$@"; }
+
+# Print demo-related processes (use --url / --single-process scenarios to observe single/multi process)
+dump_procs() {
+  local cmd='ps -efw | grep -iE "com.afree.demo"'
+  run_log "$cmd"
+  local out
+  out=$(adb_cmd shell "$cmd" 2>/dev/null | tr -d '\r' | grep -vE 'grep -iE|sh -c ps -efw')
+  if [[ -z "$out" ]]; then
+    run_out "(no matching process)"
+    return 0
+  fi
+  while IFS= read -r l; do
+    [[ -n "$l" ]] && run_out "$l"
+  done <<<"$out"
+}
+
+# Print engine-decision evidence: sandboxed render process ownership + AfreeWebViewFactory / nativeloader logs
+dump_engine() {
+  local sandbox
+  run_log 'ps -efw | grep -iE "sandboxed_process"'
+  sandbox=$(adb_cmd shell 'ps -efw | grep -iE "sandboxed_process"' 2>/dev/null | tr -d '\r' | grep -vE 'grep -iE|sh -c ps -efw')
+  if [[ -z "$sandbox" ]]; then
+    run_out "(no sandboxed process)"
+  else
+    while IFS= read -r l; do [[ -n "$l" ]] && run_out "$l"; done <<<"$sandbox"
+  fi
+
+  run_log 'logcat -d | grep -E "AfreeWebViewFactory|nativeloader.*libwebviewchromium"'
+  adb_cmd logcat -d 2>/dev/null \
+    | grep -aE 'AfreeWebViewFactory|nativeloader.*libwebviewchromium' | tail -8 \
+    | while IFS= read -r l; do run_out "$l"; done
+}
+
+# Wait for $SERIAL to become device (auth after adb connect can take a few seconds)
+wait_device() {
+  local i state
+  for i in $(seq 1 15); do
+    state="$("$ADB" -s "$SERIAL" get-state 2>/dev/null | tr -d '\r')"
+    [[ "$state" == "device" ]] && return 0
+    sleep 1
+  done
+  return 1
+}
+
+setup_device() {
+  [[ -n "$SERIAL" ]] || { err "missing device argument"; usage; exit 2; }
+  DEVICE="$SERIAL"
+  if [[ -n "$RELAY_MSS" ]]; then
+    start_relay "$DEVICE" "$RELAY_MSS" || exit 1
+  elif [[ "$SERIAL" == *:* ]]; then
+    "$ADB" connect "$SERIAL" >/dev/null 2>&1 || true
+  fi
+  if ! wait_device; then
+    err "device $SERIAL not ready (not device)"; exit 1
+  fi
+  log "device: $SERIAL ($(timeout 15 "$ADB" -s "$SERIAL" shell getprop ro.product.cpu.abi 2>/dev/null | tr -d '\r'))"
+
+  # Auto MTU probe: if black-holed the whole run (including screenshots/pull with --no-install) uses the relay,
+  # otherwise screenshot pulls over a black-holed direct link can hang for a long time.
+  if [[ "$AUTO_RELAY" == "1" && -z "$RELAY_MSS" && "$DEVICE" == *:* && "$SERIAL" != 127.0.0.1:* ]]; then
+    local host="${DEVICE%%:*}" pmtu mss
+    pmtu="$(probe_pmtu "$host")"
+    if [[ -n "$pmtu" && "$pmtu" -lt 1500 ]]; then
+      mss=$((pmtu - 40)); [[ $mss -gt 1460 ]] && mss=1460; [[ $mss -lt 536 ]] && mss=536
+      warn "path MTU black hole detected: PMTU=${pmtu} (<1500), using built-in relay (MSS=${mss})"
+      start_relay "$DEVICE" "$mss" || exit 1
+      log "subsequent adb goes through the relay: $SERIAL -> $DEVICE"
+    elif [[ -n "$pmtu" ]]; then
+      log "path MTU normal (PMTU=${pmtu}), using direct connection"
+    else
+      warn "PMTU probe inconclusive (ICMP may be blocked), using direct (a stalled push switches to relay automatically)"
+    fi
+  fi
+}
+
+# ---------------------------------------------------------------------------
+# APK locate & install
+# ---------------------------------------------------------------------------
+pick_apk() {
+  if [[ -n "$APK_OVERRIDE" ]]; then
+    [[ -f "$APK_OVERRIDE" ]] || { err "APK does not exist: $APK_OVERRIDE"; exit 1; }
+    APK="$APK_OVERRIDE"; return
+  fi
+  local rel="$SCRIPT_DIR/build/outputs/apk/release/demo-release.apk"
+  local dbg="$SCRIPT_DIR/build/outputs/apk/debug/demo-debug.apk"
+  if [[ "$USE_DEBUG" == "1" ]]; then APK="$dbg"; else APK="$rel"; fi
+  if [[ ! -f "$APK" ]]; then
+    if [[ -f "$rel" ]]; then APK="$rel"; elif [[ -f "$dbg" ]]; then APK="$dbg"; fi
+  fi
+  [[ -f "$APK" ]] || { err "demo APK not found (neither release nor debug). Run ./build_android.sh --build_aar first"; exit 1; }
+}
+
+# Probe the path MTU to the device host with ping -M do (= payload+28). Empty if inconclusive.
+probe_pmtu() {
+  local host="$1" s
+  command -v ping >/dev/null 2>&1 || return 0
+  for s in 1472 1452 1420 1400 1380 1360 1340 1320 1300 1280 1260 1240 1220 1200 1100 1000 900 800; do
+    if ping -c1 -W2 -M do -s "$s" "$host" >/dev/null 2>&1; then
+      echo $((s + 28))
+      return 0
+    fi
+  done
+  echo ""
+}
+
+# Background push; watch whether wchar in /proc/<pid>/io stalls.
+# Returns 0=done; 2=stalled (likely MTU black hole); else=failure.
+push_with_watchdog() {
+  local src="$1" dst="$2" logf="$TMP_DIR/push.log"
+  "$ADB" -s "$SERIAL" push "$src" "$dst" >"$logf" 2>&1 &
+  local pid=$! prev=-1 stall=0 cur rc elapsed=0
+  while kill -0 "$pid" 2>/dev/null; do
+    sleep 3
+    elapsed=$((elapsed + 3))
+    cur=$(awk '/^wchar/{print $2}' "/proc/$pid/io" 2>/dev/null || echo 0)
+    [[ -z "$cur" ]] && cur=0
+    if [[ "$cur" == "$prev" ]]; then stall=$((stall + 1)); else stall=0; fi
+    prev="$cur"
+    if [[ "$stall" -ge 8 || "$elapsed" -ge "$PUSH_TIMEOUT" ]]; then
+      kill "$pid" 2>/dev/null || true
+      sleep 1
+      kill -9 "$pid" 2>/dev/null || true
+      wait "$pid" 2>/dev/null || true
+      return 2
+    fi
+  done
+  wait "$pid"; rc=$?
+  cat "$logf"
+  return $rc
+}
+
+# Read the device-side file size (with retries; wc -c is more portable)
+remote_size() {
+  local f="$1" i out
+  for i in 1 2 3; do
+    out=$(timeout 20 "$ADB" -s "$SERIAL" shell "wc -c < '$f' 2>/dev/null" 2>/dev/null | tr -d '\r' | tr -dc '0-9')
+    [[ -n "$out" ]] && { echo "$out"; return 0; }
+    sleep 1
+  done
+  echo ""
+}
+
+# Normal push; on stall/size mismatch probe PMTU and fall back to the relay when a black hole is suspected.
+install_apk() {
+  local remote="/data/local/tmp/$(basename "$APK")" lsz rsz rc rel_apk
+  rel_apk="$APK"; [[ "$APK" == "$REPO_ROOT/"* ]] && rel_apk="${APK#"$REPO_ROOT/"}"
+  log "APK: $rel_apk ($(du -h "$APK" | cut -f1))"
+  lsz=$(stat -c %s "$APK" 2>/dev/null)
+
+  log "adb push $rel_apk $remote"
+  push_with_watchdog "$APK" "$remote"; rc=$?
+  rsz=$(remote_size "$remote")
+
+  if [[ $rc -ne 0 || "$lsz" != "$rsz" ]]; then
+    if [[ "$AUTO_RELAY" == "1" && "$DEVICE" == *:* && "$SERIAL" != 127.0.0.1:* ]]; then
+      warn "normal push failed/stalled, retrying via the built-in relay"
+      start_relay "$DEVICE" 1200 || return 1
+      timeout 20 adb_cmd shell "rm -f $remote" >/dev/null 2>&1 || true
+      log "adb push $rel_apk $remote"
+      push_with_watchdog "$APK" "$remote"; rc=$?
+      rsz=$(remote_size "$remote")
+    fi
+  fi
+
+  if [[ $rc -ne 0 ]]; then err "adb push failed (rc=$rc)"; return 1; fi
+  if [[ "$lsz" != "$rsz" ]]; then err "push size mismatch local=$lsz remote=$rsz"; return 1; fi
+  ok "push complete ($((rsz / 1048576)) MB)"
+
+  local out cmd
+  cmd="pm install -r -g $remote"
+  out=$(adb_cmd shell "$cmd" 2>&1 | tr -d '\r')
+  if ! grep -q "Success" <<<"$out"; then
+    warn "install failed ($out), trying uninstall then reinstall"
+    adb_cmd shell "pm uninstall $PKG" >/dev/null 2>&1 || true
+    cmd="pm install -g $remote"
+    out=$(adb_cmd shell "$cmd" 2>&1 | tr -d '\r')
+    grep -q "Success" <<<"$out" || { err "install failed: $out"; return 1; }
+  fi
+  ok "install succeeded: $cmd"
+}
+
+# ---------------------------------------------------------------------------
+# Check primitives
+# ---------------------------------------------------------------------------
+proc_alive() { [[ -n "$(adb_cmd shell "pidof $PKG" 2>/dev/null | tr -d '\r')" ]]; }
+sandboxed_count() {
+  adb_cmd shell "ps -A -o NAME 2>/dev/null | grep -c '${PKG}:sandboxed_process'" 2>/dev/null | tr -d '\r' | head -1
+}
+crashes() {
+  # Java FATAL EXCEPTION must be attributed to this package (a few lines after FATAL contain "Process: <pkg>"),
+  # otherwise crashes of other processes on the head unit are misattributed.
+  local out
+  out=$(adb_cmd logcat -d 2>/dev/null \
+        | grep -aA6 "FATAL EXCEPTION" | grep -a "$PKG" | head -2)
+  [[ -n "$out" ]] && { echo "$out"; return; }
+  adb_cmd logcat -d 2>/dev/null \
+    | grep -aE "UnsatisfiedLinkError|WebView cannot be started|J\.N\.VO" | head -3
+}
+screen_ratio() {
+  local name="$1" dev="/data/local/tmp/afree_shot_$name.png" local="$TMP_DIR/shot_$name.png"
+  adb_cmd shell "screencap -p $dev" >/dev/null 2>&1 || { echo ""; return; }
+  adb_cmd pull "$dev" "$local" >/dev/null 2>&1 || { echo ""; return; }
+  "$PY" "$ANALYZER" "$local" 2>/dev/null | awk '/non-black ratio/{gsub("%","",$3); print $3; exit}'
+}
+
+# ---------------------------------------------------------------------------
+# Single scenario
+# ---------------------------------------------------------------------------
+RESULT_ROWS=()
+FAILED=0
+
+run_case() {
+  local name="$1" extras="$2" expect="$3" minratio="$4"
+  if [[ -n "$ONLY" ]] && [[ ",$ONLY," != *",$name,"* ]]; then
+    return 0
+  fi
+
+  log "----- case: $name -----"
+  run_log "am force-stop $PKG"
+  adb_cmd shell "am force-stop $PKG" >/dev/null 2>&1 || true
+  adb_cmd logcat -c >/dev/null 2>&1 || true
+
+  local cmd="am start -W -n $ACTIVITY"
+  [[ -n "$extras" ]] && cmd="$cmd $extras"
+  run_log "$cmd"
+  local start_out
+  start_out=$(adb_cmd shell "$cmd" 2>&1 | tr -d '\r')
+  if ! grep -qE "Status: ok|Activity:" <<<"$start_out"; then
+    warn "unexpected start output: $start_out"
+  fi
+  sleep "$WAIT"
+
+  local status="PASS" detail=""
+
+  # process alive
+  if ! proc_alive; then status="FAIL"; detail+="process not alive; "; fi
+
+  # crash
+  local cr; cr=$(crashes)
+  if [[ -n "$cr" ]]; then status="FAIL"; detail+="crash: $(echo "$cr" | head -1); "; fi
+
+  # process model
+  local sc; sc=$(sandboxed_count); sc="${sc:-0}"
+  if [[ "$expect" == "multi" && "$sc" -eq 0 ]]; then status="FAIL"; detail+="no sandboxed render process; "; fi
+  if [[ "$expect" == "single" && "$sc" -ne 0 ]]; then status="FAIL"; detail+="sandboxed render process present (should be single-process); "; fi
+
+  # Engine check: if engine-system shows an afree sandboxed render process, the wrong engine was used
+  if [[ "$name" == "engine-system" && "$sc" -ne 0 ]]; then
+    status="FAIL"; detail+="system engine but an afree render process appeared (${PKG}:sandboxed_process); "
+  fi
+
+  # rendering
+  local ratio; ratio=$(screen_ratio "$name")
+  if [[ -z "$ratio" ]]; then
+    status="FAIL"; detail+="screenshot analysis failed; "
+  elif ! awk "BEGIN{exit !($ratio >= $minratio)}"; then
+    status="FAIL"; detail+="non-black ratio ${ratio}% < ${minratio}%; "
+  fi
+
+  local is_xfail=0
+  [[ ",$XFAIL_CASES," == *",$name,"* ]] && is_xfail=1
+
+  if [[ "$status" == "PASS" ]]; then
+    ok "PASS  $name  (sandboxed=$sc, non-black=${ratio}%)"
+  elif [[ "$is_xfail" == "1" ]]; then
+    status="KNOWN"
+    detail="known issue (expected crash): ${detail}"
+    warn "KNOWN $name  ($detail)"
+  else
+    err "FAIL  $name  ($detail)"
+    FAILED=$((FAILED + 1))
+  fi
+  RESULT_ROWS+=("$status|$name|$extras|sandboxed=$sc|non-black=${ratio}%|$detail")
+
+  # For specific scenarios also print the process list (--url for render process; --single-process for single process)
+  if [[ "$name" == "url" || "$name" == "single-process" ]]; then
+    dump_procs
+  fi
+  # For engine scenarios also print engine-decision evidence (sandboxed ownership + AfreeWebViewFactory logs)
+  if [[ "$name" == "engine-afree" || "$name" == "engine-system" ]]; then
+    dump_engine
+  fi
+}
+
+# ---------------------------------------------------------------------------
+# Report
+# ---------------------------------------------------------------------------
+write_report() {
+  [[ -z "$REPORT" ]] && return 0
+  {
+    echo "# afree demo verification report"
+    echo
+    echo "- time: $(date '+%Y-%m-%d %H:%M:%S')"
+    echo "- device: $SERIAL"
+    echo "- APK : $APK"
+    echo "- wait: ${WAIT}s"
+    echo
+    echo "| result | scenario | extras | sandboxed | non-black | note |"
+    echo "|------|------|--------|-----------|----------|------|"
+    local row
+    for row in "${RESULT_ROWS[@]}"; do
+      IFS='|' read -r st n ex sb nb dt <<<"$row"
+      echo "| $st | $n | \`$ex\` | $sb | $nb | $dt |"
+    done
+  } > "$REPORT"
+  ok "report written: $REPORT"
+}
+
+# ---------------------------------------------------------------------------
+# Main
+# ---------------------------------------------------------------------------
+main() {
+  parse_args "$@"
+  setup_env
+  setup_device
+  if [[ "$NO_INSTALL" == "0" ]]; then
+    pick_apk
+    install_apk || exit 1
+  else
+    APK="<installed, not pushed>"
+    log "--no-install: skipping push/install"
+  fi
+
+  local row
+  if [[ "$MEDIA_TEST_ONLY" == "1" ]]; then
+    log "--media-test-only: skipping ${#CASES[@]} regular cases, running only media"
+  else
+    for row in "${CASES[@]}"; do
+      IFS='|' read -r name extras expect minratio <<<"$row"
+      run_case "$name" "$extras" "$expect" "$minratio"
+    done
+  fi
+
+  # Reuse the tools/ special checks
+  if [[ "$MEDIA_TEST_ONLY" == "0" && "$SCROLL" == "1" ]] && { [[ -z "$ONLY" ]] || [[ ",$ONLY," == *",scroll,"* ]]; }; then
+    log "----- case: scroll (tools/verify_scroll.sh) -----"
+    run_log "am force-stop $PKG"
+    adb_cmd shell "am force-stop $PKG" >/dev/null 2>&1 || true
+    run_log "$TOOLS_DIR/verify_scroll.sh $SERIAL"
+    if bash "$TOOLS_DIR/verify_scroll.sh" "$SERIAL" >"$TMP_DIR/scroll.log" 2>&1; then
+      local scroll_msg
+      scroll_msg="$(grep -E 'PASS' "$TMP_DIR/scroll.log" | head -1)"
+      ok "PASS  scroll  ($scroll_msg)"
+      RESULT_ROWS+=("PASS|scroll|tools/verify_scroll.sh|| |$scroll_msg")
+    else
+      err "FAIL  scroll"
+      echo "    $(tail -3 "$TMP_DIR/scroll.log" | tr '\n' ' ')"
+      FAILED=$((FAILED + 1))
+      RESULT_ROWS+=("FAIL|scroll|tools/verify_scroll.sh|| |see stdio")
+    fi
+  fi
+
+  # afree locale .pak verification (default on; --no-locale to skip).
+  if [[ "$MEDIA_TEST_ONLY" == "0" && "$LOCALE" == "1" ]] && { [[ -z "$ONLY" ]] || [[ ",$ONLY," == *",locale,"* ]]; }; then
+    log "----- case: locale (tools/verify_locale.sh) -----"
+    run_log "am force-stop $PKG"
+    adb_cmd shell "am force-stop $PKG" >/dev/null 2>&1 || true
+    run_log "$TOOLS_DIR/verify_locale.sh $SERIAL $APK"
+    if bash "$TOOLS_DIR/verify_locale.sh" "$SERIAL" "$APK" >"$TMP_DIR/locale.log" 2>&1; then
+      local locale_msg
+      locale_msg="$(grep -E 'PASS' "$TMP_DIR/locale.log" | head -1)"
+      ok "PASS  locale  ($locale_msg)"
+      RESULT_ROWS+=("PASS|locale|tools/verify_locale.sh|| |$locale_msg")
+    else
+      err "FAIL  locale"
+      echo "    $(tail -3 "$TMP_DIR/locale.log" | tr '\n' ' ')"
+      FAILED=$((FAILED + 1))
+      RESULT_ROWS+=("FAIL|locale|tools/verify_locale.sh|| |see stdio")
+    fi
+  fi
+
+  if [[ "$MEDIA_TEST_ONLY" == "0" && "$VIDEO" == "1" ]] && { [[ -z "$ONLY" ]] || [[ ",$ONLY," == *",video,"* ]]; }; then
+    log "----- case: video (tools/verify_video.sh) -----"
+    run_log "am force-stop $PKG"
+    adb_cmd shell "am force-stop $PKG" >/dev/null 2>&1 || true
+    run_log "$TOOLS_DIR/verify_video.sh $SERIAL"
+    if bash "$TOOLS_DIR/verify_video.sh" "$SERIAL" >"$TMP_DIR/video.log" 2>&1; then
+      local video_msg
+      video_msg="$(grep -E 'PASS' "$TMP_DIR/video.log" | head -1)"
+      ok "PASS  video  ($video_msg)"
+      RESULT_ROWS+=("PASS|video|tools/verify_video.sh|| |$video_msg")
+    else
+      err "FAIL  video"
+      echo "    $(tail -3 "$TMP_DIR/video.log" | tr '\n' ' ')"
+      FAILED=$((FAILED + 1))
+      RESULT_ROWS+=("FAIL|video|tools/verify_video.sh|| |see stdio")
+    fi
+  fi
+
+  # Audio/video playback test (standalone case media_test.py; --ua/--url are passed through)
+  if [[ "$MEDIA_TEST" == "1" ]] && { [[ "$MEDIA_TEST_ONLY" == "1" ]] || [[ -z "$ONLY" ]] || [[ ",$ONLY," == *",media,"* ]]; }; then
+    log "----- case: media (media_test.py) -----"
+    local margs=(--device "$SERIAL")
+    [[ -n "$UA" ]] && margs+=(--ua "$UA")
+    [[ -n "$MEDIA_RUNTIME" ]] && margs+=(--runtime "$MEDIA_RUNTIME")
+    [[ -n "$MEDIA_TAPS" ]] && margs+=(--taps "$MEDIA_TAPS")
+    [[ -n "$MEDIA_SUSTAIN" ]] && margs+=(--sustain "$MEDIA_SUSTAIN")
+    for u in "${EXTRA_URLS[@]}"; do margs+=(--url "$u"); done
+    run_log "$PY $SCRIPT_DIR/media_test.py ${margs[*]}"
+    local mrc=0
+    "$PY" "$SCRIPT_DIR/media_test.py" "${margs[@]}" >"$TMP_DIR/media.log" 2>&1 || mrc=$?
+    while IFS= read -r l; do run_out "$l"; done <"$TMP_DIR/media.log"
+    if [[ "$mrc" -eq 0 ]]; then
+      ok "PASS  media"
+      RESULT_ROWS+=("PASS|media|media_test.py|| |ok")
+    else
+      err "FAIL  media (see [media] output above)"
+      FAILED=$((FAILED + 1))
+      RESULT_ROWS+=("FAIL|media|media_test.py|| |see [media] output")
+    fi
+  fi
+
+  write_report
+
+  echo
+  log "==================== Summary ===================="
+  for row in "${RESULT_ROWS[@]}"; do
+    IFS='|' read -r st n _ _ _ _ <<<"$row"
+    if [[ "$st" == "PASS" ]]; then ok "PASS  $n"
+    elif [[ "$st" == "KNOWN" ]]; then warn "KNOWN $n"
+    else err "FAIL  $n"; fi
+  done
+  echo "--------------------------------------------------"
+  if [[ "$FAILED" -eq 0 ]]; then
+    ok "all passed (${#RESULT_ROWS[@]} items)"
+    exit 0
+  else
+    err "failed $FAILED / ${#RESULT_ROWS[@]} items"
+    exit 1
+  fi
+}
+
+main "$@"
