+++ b/android_webview/afree/tools/inject_and_sign_apk.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Post-process APK: inject native .so libs and re-sign."""
+
+import argparse
+import os
+import subprocess
+import sys
+import zipfile
+
+
+def inject_native_libs(input_apk, output_apk, native_libs, assets=None):
+    """Copy input APK to output, injecting native libs into lib/<abi>/ directory
+    and optional assets into assets/ directory."""
+    # Assets that will be overwritten by the --asset list (keyed by dest name).
+    # We only skip those, preserving all other assets (e.g. demo help.md) that
+    # were already packed into the unsigned APK.
+    asset_dsts = {dst for _, dst in assets} if assets else set()
+
+    with zipfile.ZipFile(input_apk, 'r') as zin:
+        with zipfile.ZipFile(output_apk, 'w', zipfile.ZIP_DEFLATED) as zout:
+            for item in zin.infolist():
+                if native_libs and item.filename.startswith('lib/'):
+                    continue
+                if item.filename.startswith('assets/'):
+                    name = item.filename[len('assets/'):]
+                    if name in asset_dsts:
+                        continue
+                data = zin.read(item.filename)
+                zout.writestr(item, data)
+
+            for lib_file, abi in native_libs:
+                arcname = 'lib/%s/%s' % (abi, os.path.basename(lib_file))
+                zout.write(lib_file, arcname, zipfile.ZIP_STORED)
+
+            if assets:
+                for asset_src, asset_dst in assets:
+                    zout.write(asset_src, 'assets/%s' % asset_dst,
+                              zipfile.ZIP_STORED)
+    return output_apk
+
+
+def find_java(chromium_root):
+    """Find the Chromium-bundled JDK."""
+    jdk = os.path.join(chromium_root, 'third_party', 'jdk', 'current', 'bin', 'java')
+    if os.path.isfile(jdk):
+        return jdk
+    # fallback to system java
+    return 'java'
+
+
+def sign_apk(unsigned_apk, signed_apk, keystore_path, keystore_pass,
+             keystore_alias, apksigner_jar, java_bin):
+    """Sign the APK using apksigner.jar."""
+    cmd = [
+        java_bin, '-jar', apksigner_jar, 'sign',
+        '--ks', keystore_path,
+        '--ks-pass', 'pass:' + keystore_pass,
+        '--ks-key-alias', keystore_alias,
+        '--out', signed_apk,
+        unsigned_apk,
+    ]
+    subprocess.check_call(cmd)
+    return signed_apk
+
+
+def find_sdk_build_tools(chromium_root):
+    """Find the SDK build-tools directory."""
+    sdk = os.path.join(chromium_root, 'third_party', 'android_sdk', 'public')
+    bt_dir = os.path.join(sdk, 'build-tools')
+    if not os.path.isdir(bt_dir):
+        raise RuntimeError('SDK build-tools not found: ' + bt_dir)
+    for d in sorted(os.listdir(bt_dir), reverse=True):
+        bt = os.path.join(bt_dir, d)
+        apksigner = os.path.join(bt, 'lib', 'apksigner.jar')
+        if os.path.isfile(apksigner):
+            return bt
+    raise RuntimeError('apksigner.jar not found in ' + bt_dir)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--input-apk', required=True)
+    parser.add_argument('--output-apk', required=True)
+    parser.add_argument('--native-lib', action='append', default=[],
+                        help='Format: /path/to/lib.so:abi')
+    parser.add_argument('--asset', action='append', default=[],
+                        help='Format: /path/to/file:assets/destname')
+    parser.add_argument('--keystore-path', required=True)
+    parser.add_argument('--keystore-pass', required=True)
+    parser.add_argument('--keystore-alias', required=True)
+    parser.add_argument('--chromium-root', required=True)
+    args = parser.parse_args()
+
+    native_libs = []
+    for nl in args.native_lib:
+        if ':' in nl:
+            lib_path, abi = nl.split(':', 1)
+        else:
+            lib_path = nl
+            abi = 'arm64-v8a'
+        native_libs.append((lib_path, abi))
+
+    assets = []
+    for a in args.asset:
+        src, dst = a.split(':', 1)
+        assets.append((src, dst))
+
+    sdk_bt = find_sdk_build_tools(args.chromium_root)
+    apksigner_jar = os.path.join(sdk_bt, 'lib', 'apksigner.jar')
+    java_bin = find_java(args.chromium_root)
+
+    unsigned = args.output_apk + '.unsigned.apk'
+    inject_native_libs(args.input_apk, unsigned, native_libs, assets)
+    sign_apk(unsigned, args.output_apk, args.keystore_path,
+             args.keystore_pass, args.keystore_alias, apksigner_jar, java_bin)
+    os.remove(unsigned)
+    print('Signed APK: %s (%d bytes)' % (args.output_apk, os.path.getsize(args.output_apk)))
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/android_webview/afree/tools/locale_ui_test.py b/android_webview/afree/tools/locale_ui_test.py
