+package com.afree.chromium;
+
+import android.util.Log;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+
+/**
+ * Hidden API bypass utility (approach based on LSPosed AndroidHiddenApiBypass).
+ *
+ * How it works: the ART Class object has a {@code methods} field pointing to the
+ * contiguous array of all the class's ArtMethods. Traverse that array with Unsafe
+ * and write the target ArtMethod pointer into a stub Method's {@code artMethod}
+ * field to invoke the target method (including @hide), fully bypassing hidden API
+ * enforcement.
+ *
+ * Key point: {@code Class.methods} / {@code Executable.artMethod} are themselves
+ * @hide fields; direct reflection is rejected. We obtain the field offsets using
+ * stub classes (the app's own classes) whose field layout matches the real classes
+ * (field offsets depend only on field types and declaration order).
+ */
+public final class HiddenApiBypass {
+    private static final String TAG = "HiddenApiBypass";
+
+    // The Unsafe instance and its methods are obtained via reflection, because
+    // sun.misc.Unsafe is not exposed on the Android Gradle compile classpath
+    // (it lives in jdk.unsupported / bootclasspath but is stripped from the
+    // compile SDK stubs). The field type is Object to avoid the compile-time
+    // reference entirely.
+    private static final Object unsafe;
+    private static final Method objectFieldOffsetMethod;
+    private static final Method getLongMethod;
+    private static final Method getIntMethod;
+    private static final Method putLongMethod;
+
+    private static final long methodOffset;   // Executable.artMethod
+    private static final long methodsOffset;  // Class.methods
+    private static final long artMethodSize;
+    private static final long artMethodBias;
+    private static final Method invokeStub;
+
+    static {
+        Object u = null;
+        Method oo = null;
+        Method gl = null;
+        Method gi = null;
+        Method pl = null;
+        long mOffset = -1;
+        long msOffset = -1;
+        long aSize = -1;
+        long aBias = -1;
+        Method stub = null;
+        try {
+            Class<?> unsafeClass = Class.forName("sun.misc.Unsafe");
+            Field f = unsafeClass.getDeclaredField("theUnsafe");
+            f.setAccessible(true);
+            u = f.get(null);
+            oo = unsafeClass.getMethod("objectFieldOffset", Field.class);
+            gl = unsafeClass.getMethod("getLong", Object.class, long.class);
+            gi = unsafeClass.getMethod("getInt", long.class);
+            pl = unsafeClass.getMethod("putLong", Object.class, long.class, long.class);
+
+            mOffset = (Long) oo.invoke(u,
+                    ExecutableStub.class.getDeclaredField("artMethod"));
+            msOffset = (Long) oo.invoke(u,
+                    ClassStub.class.getDeclaredField("methods"));
+
+            Method mA = Stub.class.getDeclaredMethod("a");
+            Method mB = Stub.class.getDeclaredMethod("b");
+            mA.setAccessible(true);
+            mB.setAccessible(true);
+            long aAddr = (Long) gl.invoke(u, mA, mOffset);
+            long bAddr = (Long) gl.invoke(u, mB, mOffset);
+            long aMethods = (Long) gl.invoke(u, Stub.class, msOffset);
+            aSize = bAddr - aAddr;
