+#!/bin/bash
+# =============================================================================
+# bootstrap.sh — afree AAR/Demo environment bootstrap script
+#
+# Extracts .so, Java dependency JARs and assets from the Chromium build output
+# and populates them into the AAR project (sdk/) and Demo project (demo/).
+#
+# Usage:
+#   ./bootstrap.sh [output_dir] [abi] [build_aar] [use_dist_aar] [toolchain_dir]
+#
+# Arguments:
+#   output_dir    — Chromium build output dir (default: out/DefaultSys_arm64)
+#   abi           — target ABI (default: arm64-v8a)
+#   build_aar     — whether to build the AAR and Demo APK (default: 0; set 1 to build)
+#                   requires sdk/local.properties and demo/local.properties configured
+#                   requires JAVA_HOME set, or a system JDK
+#   use_dist_aar  — 1 (default): use the GN-built dist_aar AAR
+#                   (android_webview/afree:afree_webview_aar); 0: hand-rolled
+#                   Gradle sdk project AAR.
+#   toolchain_dir — (optional) the GN toolchain output subdir under output_dir,
+#                   used to locate libwebviewchromium__jni_registration.srcjar.
+#                   Defaults to empty (locate via find). Examples:
+#                     arm64: android_clang_arm64_webview (PGO phase 2) or
+#                            android_clang_arm64
+#                     arm:   android_clang_arm
+#                     x64:   android_clang_x64
+#                     x86:   android_clang_x86
+#
+# Prerequisites:
+#   1. source env.sh has been run
+#   2. ./build.sh --domono_target_cpu=arm64 has been run
+#   3. libwebviewchromium.so and apks/AfreeWebViewDemo.apk exist in output_dir
+#   4. (dist_aar mode) apks/afree_webview.aar exists (built by afree_webview_aar)
+#
+# Examples:
+#   ./bootstrap.sh                                    # populate deps only, no build
+#   ./bootstrap.sh out/DefaultSys_arm64 arm64-v8a 1   # populate + build (dist_aar)
+#   ./bootstrap.sh out/DefaultSys_arm64 arm64-v8a 1 0 # hand-rolled Gradle AAR
+#   # hand-rolled, with explicit toolchain dir (arm64 PGO phase 2):
+#   ./bootstrap.sh out/DefaultSys_arm64 arm64-v8a 1 0 android_clang_arm64_webview
+#   # arm 32-bit:
+#   ./bootstrap.sh out/DefaultSys_arm armeabi-v7a 1 0 android_clang_arm
+#   JAVA_HOME=.../third_party/jdk/current ./bootstrap.sh out/DefaultSys_arm64 arm64-v8a 1
+# =============================================================================
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# afree lives at android_webview/afree/, so the Chromium root is two levels up.
+CHROMIUM_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
+
+# JAVA_HOME: only set it when not already defined; default to chromium's
+# bundled JDK (required by gradlew in the build steps below).
+if [ -z "${JAVA_HOME:-}" ]; then
+  export JAVA_HOME="$CHROMIUM_DIR/third_party/jdk/current"
+fi
+
+OUTPUT_DIR="${1:-out/DefaultSys_arm64}"
+ABI="${2:-arm64-v8a}"
+BUILD_AAR="${3:-0}"
+USE_DIST_AAR="${4:-1}"
+TOOLCHAIN_DIR="${5:-}"
+
+OUT_PATH="$CHROMIUM_DIR/$OUTPUT_DIR"
+APK_PATH="$OUT_PATH/apks/AfreeWebViewDemo.apk"
+
+AAR_DIR="$SCRIPT_DIR/sdk"
+DEMO_DIR="$SCRIPT_DIR/demo"
+
+# Colors
+RED='\033[0;31m'
+GREEN='\033[0;32m'
+YELLOW='\033[1;33m'
+NC='\033[0m'
+
+log()  { echo -e "${GREEN}[bootstrap]${NC} $1"; }
+warn() { echo -e "${YELLOW}[bootstrap]${NC} $1"; }
+err()  { echo -e "${RED}[bootstrap]${NC} $1" >&2; }
+
+# =============================================================================
+# Shared helper: merge androidx / android_deps / kotlin prebuilt classes into a
+# single jar. These prebuilts ship as .aar/.jar (NOT *.javac.jar), but chromium
+# references them at runtime (e.g. AndroidFontLookupImpl needs
+# androidx.core.provider.FontRequest -> androidx.tracing.Trace).
+#
+# IMPORTANT: list them explicitly from the original cipd .aar/.jar. Do NOT merge
+# the GN obj artifacts (*.classes.dex.jar / *.ijar.jar), which are either
+# dex-ified or interface-only and make D8 fail with "Absent Code attribute".
+# =============================================================================
+make_androidx_deps_jar() {
+    local OUT_JAR="$1"
+    local AX_LIBS_DIR="$CHROMIUM_DIR/third_party/androidx/cipd/libs"
+    local AD_LIBS_DIR="$CHROMIUM_DIR/third_party/android_deps/autorolled/cipd/libs"
+    local KS_JAR="$CHROMIUM_DIR/third_party/kotlin_stdlib/cipd/kotlin-stdlib-jdk8.jar"
+    local TMP_MERGE=$(mktemp -d)
+
+    for aar in \
+        "$AX_LIBS_DIR/androidx_core_core/core.aar" \
+        "$AX_LIBS_DIR/androidx_tracing_tracing_android/tracing-android.aar" \
+        "$AX_LIBS_DIR/androidx_activity_activity/activity.aar" \
+        "$AX_LIBS_DIR/androidx_appcompat_appcompat_resources/appcompat-resources.aar" \
+        "$AX_LIBS_DIR/androidx_recyclerview_recyclerview/recyclerview.aar" \
+        "$AX_LIBS_DIR/androidx_annotation_annotation_experimental/annotation-experimental.aar" \
+        "$AX_LIBS_DIR/androidx_interpolator_interpolator/interpolator.aar" \
+        "$AX_LIBS_DIR/androidx_versionedparcelable_versionedparcelable/versionedparcelable.aar" \
+        "$AX_LIBS_DIR/androidx_core_core_viewtree/core-viewtree.aar" \
+        "$AX_LIBS_DIR/androidx_lifecycle_lifecycle_runtime_android/lifecycle-runtime-android.aar"; do
+        if [ -f "$aar" ]; then
+            local TMP_AX=$(mktemp -d)
+            unzip -o -q "$aar" classes.jar -d "$TMP_AX" 2>/dev/null || true
+            if [ -f "$TMP_AX/classes.jar" ]; then
+                unzip -o -q "$TMP_AX/classes.jar" -d "$TMP_MERGE" 2>/dev/null || true
+            fi
+            rm -rf "$TMP_AX"
+        fi
+    done
+
+    for jar in \
+        "$AX_LIBS_DIR/androidx_collection_collection_jvm/collection-jvm.jar" \
+        "$AX_LIBS_DIR/androidx_concurrent_concurrent_futures/concurrent-futures.jar" \
+        "$AX_LIBS_DIR/androidx_lifecycle_lifecycle_common_jvm/lifecycle-common-jvm.jar" \
+        "$AX_LIBS_DIR/androidx_arch_core_core_common/core-common.jar" \
+        "$AD_LIBS_DIR/com_google_guava_guava/guava.jar" \
+        "$AD_LIBS_DIR/org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm/kotlinx-coroutines-core-jvm.jar" \
+        "$AD_LIBS_DIR/org_jspecify_jspecify/jspecify.jar" \
+        "$KS_JAR"; do
+        if [ -f "$jar" ]; then
+            unzip -o -q "$jar" -d "$TMP_MERGE" 2>/dev/null || true
+        fi
+    done
+
+    (cd "$TMP_MERGE" && zip -r -q "$OUT_JAR" . -x "*.SF" "*.RSA" "*.MF" 2>/dev/null || true)
+    rm -rf "$TMP_MERGE"
+}
+
+# =============================================================================
+# Shared helper: extract assets from the GN APK into a directory.
+# =============================================================================
+extract_assets_to() {
+    local DEST="$1"
+    rm -rf "$DEST"
+    mkdir -p "$DEST"
+    local TMP_ASSETS=$(mktemp -d)
+    unzip -o -q "$APK_PATH" "assets/*" -d "$TMP_ASSETS"
+    cp -r "$TMP_ASSETS/assets/"* "$DEST/"
+    rm -rf "$TMP_ASSETS"
+}
+
+# =============================================================================
+# 0. Check prerequisites
+# =============================================================================
+log "afree bootstrap — output_dir=$OUTPUT_DIR, abi=$ABI, use_dist_aar=$USE_DIST_AAR"
+
+if [ ! -f "$OUT_PATH/libwebviewchromium.so" ]; then
+    err "libwebviewchromium.so not found at $OUT_PATH/"
+    err "Run: source env.sh && ./build.sh --domono_target_cpu=arm64"
+    exit 1
+fi
+
+if [ ! -f "$APK_PATH" ]; then
+    err "AfreeWebViewDemo.apk not found at $OUT_PATH/apks/"
+    err "Run: autoninja -C $OUTPUT_DIR afree_demo_apk"
+    exit 1
+fi
+
+if [ "$USE_DIST_AAR" = "1" ]; then
+    # =========================================================================
+    # dist_aar mode: use the GN-built afree_webview.aar (chromium's native
+    # dist_aar template), whose classes.jar is built from the same deps chain
+    # as the GN APK. Only androidx/android_deps/kotlin and assets are provided
+    # separately.
+    # =========================================================================
+    DIST_AAR="$OUT_PATH/apks/afree_webview.aar"
+    if [ ! -f "$DIST_AAR" ]; then
+        err "afree_webview.aar not found at $DIST_AAR"
+        err "Run: autoninja -C $OUTPUT_DIR android_webview/afree:afree_webview_aar"
+        exit 1
+    fi
+
+    log "Step 1: Copying dist_aar AAR to Demo project"
+    mkdir -p "$DEMO_DIR/src/main/libs"
+    cp "$DIST_AAR" "$DEMO_DIR/src/main/libs/afree_webview.aar"
+    log "  afree_webview.aar ($(du -h "$DEMO_DIR/src/main/libs/afree_webview.aar" | cut -f1))"
+
+    log "Step 2: Generating androidx-deps.jar"
+    mkdir -p "$AAR_DIR/src/main/libs"
+    make_androidx_deps_jar "$AAR_DIR/src/main/libs/androidx-deps.jar"
+    log "  androidx-deps.jar ($(du -h "$AAR_DIR/src/main/libs/androidx-deps.jar" | cut -f1))"
+
+    # Make the demo self-contained: copy androidx-deps.jar into the demo's own
+    # libs/ so demo/build.gradle references 'src/main/libs/androidx-deps.jar'
+    # instead of '../sdk/...'. chromium-deps.jar / androidx_annotation.jar stay
+    # sdk-only (they are only used by the sdk's hand-rolled Gradle build).
+    mkdir -p "$DEMO_DIR/src/main/libs"
+    cp "$AAR_DIR/src/main/libs/androidx-deps.jar" "$DEMO_DIR/src/main/libs/androidx-deps.jar"
+    log "  androidx-deps.jar copied to demo/src/main/libs/ ($(du -h "$DEMO_DIR/src/main/libs/androidx-deps.jar" | cut -f1))"
+
+    # NOTE: keep demo/src/main/assets intact — it holds the demo's own Markdown
+    # docs (help/copyright/readme/issues.md + md.css/template.html). The runtime
+    # assets (.pak / icudtl.dat / v8 snapshots) live in the dist_aar AAR and are
+    # merged into the demo APK by AGP automatically; the two do not overlap.
+
+    find "$DEMO_DIR/src/main/libs" -name ".gitkeep" -delete 2>/dev/null || true
+
+    if [ "$BUILD_AAR" = "1" ]; then
+        log "Step 4: Building Demo APK with Gradle"
+        if [ ! -f "$DEMO_DIR/local.properties" ]; then
+            warn "local.properties not found in $DEMO_DIR/"
+            warn "Copy local.properties.template to local.properties and set sdk.dir"
+            warn "Skipping Demo build"
+            exit 0
+        fi
+        cd "$DEMO_DIR"
+        ./gradlew assembleRelease --no-daemon
+        APK_FILE=$(find build/outputs/apk -name "*.apk" | head -1)
+        log "  Demo APK built: $APK_FILE"
+    else
+        log "Skipping Demo build (set 3rd arg to 1 to build)"
+    fi
+else
+    # =========================================================================
+    # Hand-rolled mode: build the AAR from the sdk/ Gradle project, with a
+    # manually merged chromium-deps.jar (chromium javac jars + androidx).
+    # =========================================================================
+
+    # 1. Extract .so files → AAR jniLibs
+    log "Step 1: Extracting .so files to AAR jniLibs/$ABI/"
+    JNI_DIR="$AAR_DIR/src/main/jniLibs/$ABI"
+    mkdir -p "$JNI_DIR"
+    # Prefer SystemWebView.apk's .so: it is the so_strip-processed version
+    # (strip-all + .gnu_debugdata mini debuginfo for crash symbolication) and
+    # also carries libcrashpad_handler_trampoline.so (crashpad minidump). Fall
+    # back to the so_strip output / afree APK otherwise.
+    SYSTEM_WEBVIEW_APK="$OUT_PATH/apks/SystemWebView.apk"
+    if [ -f "$SYSTEM_WEBVIEW_APK" ]; then
+        TMP_SO=$(mktemp -d)
+        unzip -o -q "$SYSTEM_WEBVIEW_APK" "lib/$ABI/*" -d "$TMP_SO"
+        cp "$TMP_SO/lib/$ABI/libwebviewchromium.so" "$JNI_DIR/"
+        if [ -f "$TMP_SO/lib/$ABI/libcrashpad_handler_trampoline.so" ]; then
+            cp "$TMP_SO/lib/$ABI/libcrashpad_handler_trampoline.so" "$JNI_DIR/"
+            log "  libcrashpad_handler_trampoline.so (crashpad minidump)"
+        fi
+        rm -rf "$TMP_SO"
+        log "  libwebviewchromium.so from SystemWebView.apk ($(du -h "$JNI_DIR/libwebviewchromium.so" | cut -f1))"
+    elif [ -f "$OUT_PATH/libwebviewchromium.so" ]; then
+        cp "$OUT_PATH/libwebviewchromium.so" "$JNI_DIR/libwebviewchromium.so"
+        log "  libwebviewchromium.so from so_strip ($(du -h "$JNI_DIR/libwebviewchromium.so" | cut -f1))"
+    else
+        TMP_SO=$(mktemp -d)
+        unzip -o -q "$APK_PATH" "lib/$ABI/*" -d "$TMP_SO"
+        cp "$TMP_SO/lib/$ABI/libwebviewchromium.so" "$JNI_DIR/"
+        rm -rf "$TMP_SO"
+        log "  libwebviewchromium.so from APK ($(du -h "$JNI_DIR/libwebviewchromium.so" | cut -f1))"
+    fi
+
+    # 2. Merge chromium javac jars + androidx into chromium-deps.jar
+    log "Step 2: Extracting Chromium Java dependencies"
+    LIBS_DIR="$AAR_DIR/src/main/libs"
+    mkdir -p "$LIBS_DIR"
+
+    TMP_MERGE=$(mktemp -d)
+    JAR_LIST=$(find "$OUT_PATH/obj" -name "*.javac.jar" \
+        ! -name "*afree*" \
+        ! -name "*demo*" \
+        | sort -u)
+    log "  Found $(echo "$JAR_LIST" | wc -l) Chromium dependency JARs"
+    for jar in $JAR_LIST; do
+        unzip -o -q "$jar" -d "$TMP_MERGE" 2>/dev/null || true
+    done
+
+    # merge androidx / android_deps / kotlin into the same dir
+    AX_LIBS_DIR="$CHROMIUM_DIR/third_party/androidx/cipd/libs"
+    AD_LIBS_DIR="$CHROMIUM_DIR/third_party/android_deps/autorolled/cipd/libs"
+    KS_JAR="$CHROMIUM_DIR/third_party/kotlin_stdlib/cipd/kotlin-stdlib-jdk8.jar"
+    for aar in \
+        "$AX_LIBS_DIR/androidx_core_core/core.aar" \
+        "$AX_LIBS_DIR/androidx_tracing_tracing_android/tracing-android.aar" \
+        "$AX_LIBS_DIR/androidx_activity_activity/activity.aar" \
+        "$AX_LIBS_DIR/androidx_appcompat_appcompat_resources/appcompat-resources.aar" \
+        "$AX_LIBS_DIR/androidx_recyclerview_recyclerview/recyclerview.aar" \
+        "$AX_LIBS_DIR/androidx_annotation_annotation_experimental/annotation-experimental.aar" \
+        "$AX_LIBS_DIR/androidx_interpolator_interpolator/interpolator.aar" \
+        "$AX_LIBS_DIR/androidx_versionedparcelable_versionedparcelable/versionedparcelable.aar" \
+        "$AX_LIBS_DIR/androidx_core_core_viewtree/core-viewtree.aar" \
+        "$AX_LIBS_DIR/androidx_lifecycle_lifecycle_runtime_android/lifecycle-runtime-android.aar"; do
+        if [ -f "$aar" ]; then
+            TMP_AX=$(mktemp -d)
+            unzip -o -q "$aar" classes.jar -d "$TMP_AX" 2>/dev/null || true
+            if [ -f "$TMP_AX/classes.jar" ]; then
+                unzip -o -q "$TMP_AX/classes.jar" -d "$TMP_MERGE" 2>/dev/null || true
+            fi
+            rm -rf "$TMP_AX"
+        fi
+    done
+    for jar in \
+        "$AX_LIBS_DIR/androidx_collection_collection_jvm/collection-jvm.jar" \
+        "$AX_LIBS_DIR/androidx_concurrent_concurrent_futures/concurrent-futures.jar" \
+        "$AX_LIBS_DIR/androidx_lifecycle_lifecycle_common_jvm/lifecycle-common-jvm.jar" \
+        "$AX_LIBS_DIR/androidx_arch_core_core_common/core-common.jar" \
+        "$AD_LIBS_DIR/com_google_guava_guava/guava.jar" \
+        "$AD_LIBS_DIR/org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm/kotlinx-coroutines-core-jvm.jar" \
+        "$AD_LIBS_DIR/org_jspecify_jspecify/jspecify.jar" \
+        "$KS_JAR"; do
+        if [ -f "$jar" ]; then
+            unzip -o -q "$jar" -d "$TMP_MERGE" 2>/dev/null || true
+        fi
+    done
+
+    (cd "$TMP_MERGE" && zip -r -q "$LIBS_DIR/chromium-deps.jar" . -x "*.SF" "*.RSA" "*.MF" 2>/dev/null || true)
+    rm -rf "$TMP_MERGE"
+
+    # Remove duplicate classes from chromium-deps.jar (GEN_JNI / BuildConfig /
+    # glue DrawFunctor stubs are provided by the AAR itself).
+    JAR_CMD="${JAVA_HOME:+$JAVA_HOME/bin/jar}"
+    JAR_CMD="${JAR_CMD:-jar}"
+    TMP_DUP=$(mktemp -d)
+    cd "$TMP_DUP"
+    "$JAR_CMD" xf "$LIBS_DIR/chromium-deps.jar" 2>/dev/null || true
+    rm -f org/jni_zero/GEN_JNI.class
+    rm -f org/chromium/build/BuildConfig.class
+    rm -f com/android/webview/chromium/DrawFunctor.class
+    rm -f com/android/webview/chromium/DrawGLFunctor.class
+    rm -f com/android/webview/chromium/GraphicsUtils.class
+    "$JAR_CMD" cf "$LIBS_DIR/chromium-deps.jar" . 2>/dev/null || true
+    cd "$CHROMIUM_DIR"
+    rm -rf "$TMP_DUP"
+
+    # Copy the aggregated GEN_JNI.java (JNI registration) into the AAR source
+    # tree. The preferred source is libwebviewchromium__jni_registration.srcjar
+    # (aggregated by the webview toolchain). If TOOLCHAIN_DIR is provided, use
+    # it to build the exact path; otherwise (or if that path is missing) fall
+    # back to a find over the output dir.
+    JNI_REG_SRCJAR=""
+    if [ -n "$TOOLCHAIN_DIR" ]; then
+        JNI_REG_SRCJAR="$OUT_PATH/$TOOLCHAIN_DIR/gen/android_webview/libwebviewchromium__jni_registration.srcjar"
+    fi
+    if [ ! -f "$JNI_REG_SRCJAR" ]; then
+        JNI_REG_SRCJAR=$(find "$OUT_PATH" -name "libwebviewchromium__jni_registration.srcjar" 2>/dev/null | head -1)
+    fi
+    if [ -n "$JNI_REG_SRCJAR" ]; then
+        TMP_GENJNI=$(mktemp -d)
+        unzip -o -q "$JNI_REG_SRCJAR" "org/jni_zero/GEN_JNI.java" -d "$TMP_GENJNI" 2>/dev/null || true
+        if [ -f "$TMP_GENJNI/org/jni_zero/GEN_JNI.java" ]; then
+            mkdir -p "$AAR_DIR/src/main/java/org/jni_zero"
+            cp "$TMP_GENJNI/org/jni_zero/GEN_JNI.java" "$AAR_DIR/src/main/java/org/jni_zero/GEN_JNI.java"
+            log "  GEN_JNI.java (aggregated JNI registration, from $JNI_REG_SRCJAR)"
+        else
+            warn "GEN_JNI.java not found inside $JNI_REG_SRCJAR"
+        fi
+        rm -rf "$TMP_GENJNI"
+    else
+        warn "libwebviewchromium__jni_registration.srcjar not found under $OUT_PATH"
+    fi
+
+    # Copy the afree-specific BuildConfig.java (APK_ASSETS_SUFFIX=null).
+    BUILD_CONFIG_SRC="$OUT_PATH/gen/android_webview/afree/afree_demo_apk_unsigned/generated_java/input_srcjars/org/chromium/build/BuildConfig.java"
+    if [ -f "$BUILD_CONFIG_SRC" ]; then
+        mkdir -p "$AAR_DIR/src/main/java/org/chromium/build"
+        cp "$BUILD_CONFIG_SRC" "$AAR_DIR/src/main/java/org/chromium/build/BuildConfig.java"
+        log "  BuildConfig.java (APK_ASSETS_SUFFIX=null)"
+    else
+        warn "BuildConfig.java not found at $BUILD_CONFIG_SRC"
+    fi
+    log "  chromium-deps.jar ($(du -h "$LIBS_DIR/chromium-deps.jar" | cut -f1))"
+
+    # Copy androidx.annotation JAR (read-only source: remove dest first).
+    ANNOTATION_JAR="$CHROMIUM_DIR/third_party/androidx/cipd/libs/androidx_annotation_annotation_jvm/annotation-jvm.jar"
+    if [ -f "$ANNOTATION_JAR" ]; then
+        rm -f "$LIBS_DIR/androidx_annotation.jar"
+        cp "$ANNOTATION_JAR" "$LIBS_DIR/androidx_annotation.jar"
+        chmod 644 "$LIBS_DIR/androidx_annotation.jar"
+        log "  androidx_annotation.jar"
+    fi
+
+    # 3. Extract assets → AAR assets
+    log "Step 3: Extracting assets to AAR assets/"
+    extract_assets_to "$AAR_DIR/src/main/assets"
+    PAK_COUNT=$(find "$AAR_DIR/src/main/assets" -name "*.pak" | wc -l)
+    log "  $PAK_COUNT pak files + icudtl.dat + snapshot_blob_64.bin + v8_context_snapshot_64.bin"
+
+    find "$AAR_DIR/src/main/jniLibs" -name ".gitkeep" -delete 2>/dev/null || true
+    find "$AAR_DIR/src/main/libs" -name ".gitkeep" -delete 2>/dev/null || true
+    find "$AAR_DIR/src/main/assets" -name ".gitkeep" -delete 2>/dev/null || true
+    log "AAR project populated at $AAR_DIR/"
+
+    # 4. (Optional) Build AAR + Demo APK with Gradle
+    if [ "$BUILD_AAR" = "1" ]; then
+        log "Step 4: Building AAR with Gradle"
+        if [ ! -f "$AAR_DIR/local.properties" ]; then
+            warn "local.properties not found in $AAR_DIR/"
+            warn "Copy local.properties.template to local.properties and set sdk.dir"
+            warn "Skipping AAR build"
+            exit 0
+        fi
+        cd "$AAR_DIR"
+        ./gradlew assembleRelease --no-daemon
+        AAR_FILE=$(find build/outputs/aar -name "*.aar" | head -1)
+        log "  AAR built: $AAR_FILE"
+
+        log "Step 5: Copying AAR to Demo project"
+        mkdir -p "$DEMO_DIR/src/main/libs"
+        DEMO_AAR="$DEMO_DIR/src/main/libs/afree_webview.aar"
+        AAR_REAL=$(readlink -f "$AAR_DIR/$AAR_FILE" 2>/dev/null || echo "")
+        DEMO_REAL=$(readlink -f "$DEMO_AAR" 2>/dev/null || echo "")
+        if [ "$AAR_REAL" = "$DEMO_REAL" ] && [ -n "$AAR_REAL" ]; then
+            log "  afree_webview.aar already up-to-date, skipping copy"
+        else
+            cp --dereference "$AAR_DIR/$AAR_FILE" "$DEMO_AAR"
+            log "  afree_webview.aar copied ($(du -h "$DEMO_AAR" | cut -f1))"
+        fi
+        find "$DEMO_DIR/src/main/libs" -name ".gitkeep" -delete 2>/dev/null || true
+
+        log "Step 6: Building Demo APK with Gradle"
+        if [ ! -f "$DEMO_DIR/local.properties" ]; then
+            warn "local.properties not found in $DEMO_DIR/"
+            warn "Copy local.properties.template to local.properties and set sdk.dir"
+            warn "Skipping Demo build"
+            exit 0
+        fi
+        cd "$DEMO_DIR"
+        ./gradlew assembleRelease --no-daemon
+        APK_FILE=$(find build/outputs/apk -name "*.apk" | head -1)
+        log "  Demo APK built: $APK_FILE"
+    else
+        log "Skipping AAR/Demo build (set 3rd arg to 1 to build)"
+    fi
+fi
+
+# =============================================================================
+# Done
+# =============================================================================
+log "Bootstrap complete!"
+if [ "$USE_DIST_AAR" = "1" ]; then
+    echo "dist_aar mode: AAR from GN (afree_webview_aar), Demo needs androidx-deps.jar"
+else
+    echo "hand-rolled mode: AAR from sdk/ Gradle project"
+fi
