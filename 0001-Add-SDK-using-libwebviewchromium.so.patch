+            }
+        });
+    }
+    @Override public Uri getSafeBrowsingPrivacyPolicyUrl() {
+        return AwContentsStatics.getSafeBrowsingPrivacyPolicyUrl();
+    }
+    @Override public String getVariationsHeader() {
+        return AwContentsStatics.getVariationsHeader();
+    }
+
+    private String ensureAssetFilesExtracted(Context ctx) {
+        File destDir = new File(ctx.getFilesDir(), "afree_paks");
+        if (!destDir.exists()) destDir.mkdirs();
+
+        String[][] assetList = {
+            {"icudtl.dat", "icudtl.dat"},
+            {"resources.pak", "resources.pak"},
+            {"chrome_100_percent.pak", "chrome_100_percent.pak"},
+            {"chrome_200_percent.pak", "chrome_200_percent.pak"},
+            {"snapshot_blob_64.bin", "snapshot_blob_64.bin"},
+            {"v8_context_snapshot_64.bin", "v8_context_snapshot_64.bin"},
+        };
+
+        for (String[] entry : assetList) {
+            String assetName = entry[0];
+            String fileName = entry[1];
+            File destFile = new File(destDir, fileName);
+            if (destFile.exists()) continue;
+
+            try (InputStream is = ctx.getAssets().open(assetName);
+                 FileOutputStream fos = new FileOutputStream(destFile)) {
+                byte[] buf = new byte[8192];
+                int len;
+                while ((len = is.read(buf)) > 0) {
+                    fos.write(buf, 0, len);
+                }
+                Log.i(TAG, "Extracted asset: " + fileName + " (" + destFile.length() + " bytes)");
+            } catch (Exception e) {
+                Log.w(TAG, "Failed to extract " + assetName + ": " + e.getMessage());
+                return null;
+            }
+        }
+        return destDir.getAbsolutePath();
+    }
+}
