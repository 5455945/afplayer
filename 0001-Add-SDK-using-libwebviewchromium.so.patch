+        if (forceDark == FORCE_DARK_ON) return AwSettings.FORCE_DARK_ON;
+        if (forceDark == FORCE_DARK_AUTO) return AwSettings.FORCE_DARK_AUTO;
+        return AwSettings.FORCE_DARK_OFF;
