+#!/bin/bash
+# =============================================================================
+# verify_video.sh — afree demo 视频硬解上屏验证脚本
+#
+# 原理：
+#   加载内置测试页 audio_zone.html，点击第一个视频链接触发视频播放，
+#   然后统计 logcat 里的 ForwardVideoFrame 日志（视频帧由 renderer 上屏
+#   的标志）；帧数 > 0 说明视频硬解上屏正常。
+#
+# 用法：
+#   ./verify_video.sh <device_serial>
+#   例如：./verify_video.sh 30.207.82.150:62482
+#
+# 依赖：无（仅 adb）
+# =============================================================================
+set -e
+
+SERIAL="${1:?用法: $0 <device_serial>}"
+VIDEO_PAGE="http://47.89.235.173:9090/audio_zone.html"
+
+adb -s "$SERIAL" shell am force-stop com.afree.demo
+adb -s "$SERIAL" logcat -c
+adb -s "$SERIAL" shell am start -n com.afree.demo/.MainActivity \
+    -e url "$VIDEO_PAGE" >/dev/null
+echo "加载 $VIDEO_PAGE ..."
+sleep 14
+
+# 点击第一个视频链接（audio_zone.html 的 H264 列表第一个链接坐标）
+echo "点击视频链接 ..."
+adb -s "$SERIAL" shell input tap 300 346
+sleep 14
+
+FRAMES=$(timeout 8 adb -s "$SERIAL" logcat -d 2>/dev/null | grep -c "ForwardVideoFrame" || true)
+echo "ForwardVideoFrame 帧数: $FRAMES"
+
+if [ "$FRAMES" -gt 0 ]; then
+  echo "PASS: 视频硬解上屏正常"
+  exit 0
+else
+  echo "FAIL: 未检测到视频帧上屏"
+  exit 1
+fi
