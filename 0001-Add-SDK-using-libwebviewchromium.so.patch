+package com.afree.demo;
+
+import android.app.Activity;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Environment;
+import android.util.Log;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.inputmethod.EditorInfo;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.MediaController;
+import android.widget.ProgressBar;
+import android.widget.Toast;
+import android.widget.VideoView;
+
+import org.commonmark.parser.Parser;
+import org.commonmark.renderer.html.HtmlRenderer;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+@SuppressWarnings("deprecation")
+public class MainActivity extends Activity {
+
+    private static final String TAG = "AfreeDemo";
+    private static final String DEFAULT_URL = "https://www.baidu.com/?noapp=1";
+
+    // Intent extra keys (command-line style arguments).
+    private static final String EXTRA_HELP = "help";
+    private static final String EXTRA_UA = "ua";
+    private static final String EXTRA_URL = "url";
+    private static final String EXTRA_PLAYER = "player";
+    private static final String EXTRA_ENGINE = "engine";
+    private static final String EXTRA_CR = "cr";
+    private static final String EXTRA_PRIVATE = "private";
+    private static final String EXTRA_INCOGNITO = "incognito";
+
+    private static final Set<String> VIDEO_EXTS = new HashSet<>(Arrays.asList(
+            ".mp4", ".webm", ".ogg", ".m3u8", ".ts", ".mkv", ".mov", ".avi", ".flv", ".3gp"));
+    private static final Set<String> AUDIO_EXTS = new HashSet<>(Arrays.asList(
+            ".mp3", ".wav", ".flac", ".aac", ".m4a", ".opus", ".wma"));
+
+    private final Parser mdParser = Parser.builder().build();
+    private final HtmlRenderer mdRenderer = HtmlRenderer.builder().build();
+
+    private String mdCss;
+    private String htmlTemplate;
+
+    private AfreeWebView mWebView;
+    private EditText mUrlBar;
+    private Button mGoButton;
+    private Button mBackButton;
+    private Button mHomeButton;
+    private ProgressBar mProgressBar;
+    private VideoView mVideoView;
+    private String mHomeUrl = DEFAULT_URL;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        createLayout();
+
+        mGoButton.setOnClickListener(v -> loadUrlFromBar());
+        mHomeButton.setOnClickListener(v -> {
+            mUrlBar.setText(mHomeUrl);
+            loadUrl(mHomeUrl);
+        });
+        mBackButton.setOnClickListener(v -> {
+            if (mWebView.canGoBack()) mWebView.goBack();
+        });
+        mUrlBar.setOnEditorActionListener((v, actionId, event) -> {
+            loadUrlFromBar();
+            return true;
+        });
+
+        if (getIntent().hasExtra(EXTRA_HELP)) {
+            showHelp();
+            return;
+        }
+
+        String ua = getIntent().getStringExtra(EXTRA_UA);
+        if (ua != null && !ua.isEmpty()) {
+            mWebView.setUserAgentString(ua);
+            Log.i(TAG, "UserAgent: " + ua);
+        }
+
+        if ("1".equals(getIntent().getStringExtra(EXTRA_PRIVATE))
+                || "1".equals(getIntent().getStringExtra(EXTRA_INCOGNITO))) {
+            mWebView.setPrivateMode(true);
+            Log.i(TAG, "Private (incognito-like) mode enabled");
+        }
+
+        String url = getIntent().getStringExtra(EXTRA_URL);
+        if (url == null || url.isEmpty()) {
+            url = DEFAULT_URL;
+        }
+        mHomeUrl = url;
+        mUrlBar.setText(url);
+        loadUrl(url);
+    }
+
+    private void loadUrl(String url) {
+        if (url.toLowerCase().endsWith(".md")) {
+            String mdContent = readMdContent(url);
+            if (mdContent != null) {
+                mWebView.loadDataWithBaseURL(null, mdToHtml(mdContent),
+                        "text/html", "UTF-8", null);
+            }
+        } else if (isMediaFile(url)) {
+            loadMedia(url);
+        } else {
+            mWebView.loadUrl(url);
+        }
+    }
+
+    // ==================== layout ====================
+
+    private void createLayout() {
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setLayoutParams(new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT));
+
+        // Android 15+ (targetSdk 35+) enforces edge-to-edge: the window content
+        // is drawn behind the system status bar. Pad the root by the status bar
+        // inset so the address bar / Go button are not hidden behind it.
+        if (android.os.Build.VERSION.SDK_INT >= 30) {
+            root.setOnApplyWindowInsetsListener((v, insets) -> {
+                int top = insets.getInsets(android.view.WindowInsets.Type.statusBars()).top;
+                v.setPadding(v.getPaddingLeft(), top, v.getPaddingRight(), v.getPaddingBottom());
+                return insets;
+            });
+        }
+
+        LinearLayout toolbar = new LinearLayout(this);
+        toolbar.setOrientation(LinearLayout.HORIZONTAL);
+        toolbar.setLayoutParams(new LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.MATCH_PARENT,
+                LinearLayout.LayoutParams.WRAP_CONTENT));
+        toolbar.setPadding(8, 8, 8, 8);
+
+        mHomeButton = new Button(this);
+        mHomeButton.setText("Home");
+        toolbar.addView(mHomeButton);
+
+        mBackButton = new Button(this);
+        mBackButton.setText("Back");
+        toolbar.addView(mBackButton);
+
+        mUrlBar = new EditText(this);
+        mUrlBar.setHint("Enter URL");
+        mUrlBar.setSingleLine(true);
+        mUrlBar.setImeOptions(EditorInfo.IME_ACTION_GO);
+        mUrlBar.setLayoutParams(new LinearLayout.LayoutParams(
+                0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0f));
+
+        mGoButton = new Button(this);
+        mGoButton.setText("Go");
+
+        toolbar.addView(mUrlBar);
+        toolbar.addView(mGoButton);
+        root.addView(toolbar);
+
+        mProgressBar = new ProgressBar(this, null,
+                android.R.attr.progressBarStyleHorizontal);
+        mProgressBar.setLayoutParams(new LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.MATCH_PARENT, 4));
+        mProgressBar.setMax(100);
+        mProgressBar.setVisibility(View.GONE);
+        root.addView(mProgressBar);
+
+        FrameLayout content = new FrameLayout(this);
+        content.setLayoutParams(new LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.MATCH_PARENT, 0, 1.0f));
+
+        // Engine switch: afree (com.afree.webkit.WebView, default, uses the
+        // libwebviewchromium.so from the AAR) vs system (android.webkit.WebView,
+        // selected via "-e engine system").
+        String engine = getIntent().getStringExtra(EXTRA_ENGINE);
+        boolean useAfree = !"system".equalsIgnoreCase(engine);
+        if (useAfree) {
+            // Lazy-init the afree engine (loads libwebviewchromium.so) before
+            // constructing its WebView. Skipped for the system engine, which
+            // must NOT load libwebviewchromium.so.
+            // "-e cr '--flag1 --flag2=val'" forwards chromium switches to the
+            // engine's CommandLine (applied before native init).
+            String cr = getIntent().getStringExtra(EXTRA_CR);
+            String[] chromiumSwitches =
+                    (cr == null || cr.trim().isEmpty()) ? null : cr.trim().split("\\s+");
+            com.afree.AfreeWebViewInit.init(getApplicationContext(), chromiumSwitches);
+        }
+        mWebView = AfreeWebView.create(this, useAfree);
+        mWebView.setLayoutParams(new FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.MATCH_PARENT,
+                FrameLayout.LayoutParams.MATCH_PARENT));
+        mWebView.setListener(new AfreeWebView.Listener() {
+            @Override public void onPageStarted(String url) {
+                mUrlBar.setText(url);
+                mProgressBar.setVisibility(View.VISIBLE);
+            }
+            @Override public void onPageFinished(String url) {
+                mUrlBar.setText(url);
+                mProgressBar.setVisibility(View.GONE);
+            }
+            @Override public void onProgressChanged(int progress) {
+                mProgressBar.setProgress(progress);
+                if (progress == 100) mProgressBar.setVisibility(View.GONE);
+            }
+            @Override public void onReceivedTitle(String title) {
+                if (title != null && !title.isEmpty()) setTitle(title);
+            }
+            @Override public void onReceivedError(String description) {
+                mProgressBar.setVisibility(View.GONE);
+                Toast.makeText(MainActivity.this,
+                        "Error: " + description, Toast.LENGTH_SHORT).show();
+            }
+        });
+        content.addView(mWebView);
+
+        mVideoView = new VideoView(this);
+        mVideoView.setLayoutParams(new FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.MATCH_PARENT,
+                FrameLayout.LayoutParams.MATCH_PARENT));
+        mVideoView.setVisibility(View.GONE);
+        content.addView(mVideoView);
+
+        root.addView(content);
+        setContentView(root);
+        Log.i(TAG, "Engine: " + (useAfree ? "afree" : "system"));
+    }
+
+    private void loadUrlFromBar() {
+        String url = mUrlBar.getText().toString().trim();
+        if (url.isEmpty()) return;
+        if (!url.startsWith("http://") && !url.startsWith("https://")
+                && !url.startsWith("file://")) {
+            url = "https://" + url;
+            mUrlBar.setText(url);
+        }
+        mProgressBar.setVisibility(View.VISIBLE);
+        mWebView.loadUrl(url);
+    }
+
+    // ==================== help / markdown ====================
+
+    private void showHelp() {
+        String mdContent = readMdContent("file:///android_asset/help.md");
+        if (mdContent != null) {
+            mWebView.loadDataWithBaseURL(null, mdToHtml(mdContent),
+                    "text/html", "UTF-8", null);
+            Log.i(TAG, "\n" + mdContent);
+        }
+    }
+
+    private String mdToHtml(String md) {
+        if (mdCss == null) mdCss = readAsset("md.css");
+        if (htmlTemplate == null) htmlTemplate = readAsset("template.html");
+        String body = mdRenderer.render(mdParser.parse(md));
+        String html = htmlTemplate.replace("{{style}}", mdCss).replace("{{body}}", body);
+        Log.i(TAG, "mdToHtml: cssLen=" + mdCss.length() + " tplLen=" + htmlTemplate.length()
+                + " bodyLen=" + body.length() + " htmlLen=" + html.length());
+        return html;
+    }
+
+    private String readMdContent(String url) {
+        InputStream is = null;
+        try {
+            if (url.startsWith("file:///android_asset/")) {
+                String assetPath = url.substring("file:///android_asset/".length());
+                is = getAssets().open(assetPath);
+            } else if (url.startsWith("file://")) {
+                is = new FileInputStream(new File(url.substring("file://".length())));
+            } else {
+                is = new FileInputStream(new File(url));
+            }
+            BufferedReader reader = new BufferedReader(new InputStreamReader(is, "UTF-8"));
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) sb.append(line).append("\n");
+            reader.close();
+            return sb.toString();
+        } catch (Exception e) {
+            return null;
+        } finally {
+            if (is != null) { try { is.close(); } catch (Exception ignored) {} }
+        }
+    }
+
+    private String readAsset(String path) {
+        try (InputStream is = getAssets().open(path)) {
+            BufferedReader r = new BufferedReader(new InputStreamReader(is, "UTF-8"));
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = r.readLine()) != null) sb.append(line).append("\n");
+            return sb.toString();
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    // ==================== media ====================
+
+    private boolean isMediaFile(String url) {
+        String lower = url.toLowerCase();
+        for (String ext : VIDEO_EXTS) if (lower.endsWith(ext)) return true;
+        for (String ext : AUDIO_EXTS) if (lower.endsWith(ext)) return true;
+        return false;
+    }
+
+    private void loadMedia(String url) {
+        String lower = url.toLowerCase();
+        boolean isVideo = false;
+        for (String ext : VIDEO_EXTS) if (lower.endsWith(ext)) { isVideo = true; break; }
+        boolean isLocal = url.startsWith("file://");
+        String player = getIntent().getStringExtra(EXTRA_PLAYER);
+        boolean useWebView = "webview".equalsIgnoreCase(player);
+
+        if (isVideo && isLocal && !useWebView) {
+            playNative(url);
+        } else {
+            playWebView(url, isVideo, isLocal);
+        }
+    }
+
+    private void playNative(String url) {
+        String path = url.substring("file://".length());
+        File srcFile = resolveFile(path);
+        if (srcFile == null) {
+            mWebView.loadDataWithBaseURL(null,
+                    "<h2>File Error</h2><p>" + path + "</p><p>not found</p>",
+                    "text/html", "UTF-8", null);
+            return;
+        }
+        if (!srcFile.canRead()) {
+            File tmp = copyToCache(srcFile);
+            if (tmp == null) {
+                mWebView.loadDataWithBaseURL(null,
+                        "<h2>File Error</h2><p>Cannot read: " + path + "</p>",
+                        "text/html", "UTF-8", null);
+                return;
+            }
+            srcFile = tmp;
+        }
+
+        final File playedFile = srcFile;
+        mVideoView.setVisibility(View.VISIBLE);
+        mWebView.setVisibility(View.GONE);
+        mVideoView.setOnErrorListener((mp, what, extra) -> {
+            Log.e(TAG, "Native error: what=" + what + " extra=" + extra);
+            mVideoView.setVisibility(View.GONE);
+            mWebView.setVisibility(View.VISIBLE);
+            mWebView.loadDataWithBaseURL(null,
+                    "<h2>Video Error</h2><p>code: " + what + "</p>",
+                    "text/html", "UTF-8", null);
+            return true;
+        });
+        mVideoView.setOnPreparedListener(mp -> mp.start());
+        MediaController mc = new MediaController(this);
+        mc.setAnchorView(mVideoView);
+        mVideoView.setMediaController(mc);
+        mVideoView.setVideoURI(Uri.fromFile(playedFile));
+        Log.i(TAG, "Playing native: " + playedFile);
+    }
+
+    private void playWebView(String url, boolean isVideo, boolean isLocal) {
+        mVideoView.setVisibility(View.GONE);
+        mWebView.setVisibility(View.VISIBLE);
+
+        String srcUrl;
+        if (isVideo && isLocal) {
+            String path = url.substring("file://".length());
+            File srcFile = resolveFile(path);
+            if (srcFile == null) {
+                mWebView.loadDataWithBaseURL(null,
+                        "<h2>File Error</h2><p>" + path + "</p><p>not found</p>",
+                        "text/html", "UTF-8", null);
+                return;
+            }
+            if (!srcFile.canRead()) {
+                File tmp = copyToCache(srcFile);
+                if (tmp == null) return;
+                srcFile = tmp;
+            }
+            srcUrl = Uri.fromFile(srcFile).toString();
+        } else {
+            srcUrl = url;
+        }
+
+        String html = "<!DOCTYPE html><html><head><meta charset=\"UTF-8\">"
+                + "<style>body{margin:0;background:#000;display:flex;"
+                + "align-items:center;justify-content:center;height:100vh;overflow:hidden;}"
+                + (isVideo ? "video{max-width:100%;max-height:100%;}" : "audio{width:100%;}")
+                + "</style></head><body>"
+                + (isVideo
+                    ? "<video src=\"" + srcUrl + "\" controls autoplay playsinline></video>"
+                    : "<audio src=\"" + srcUrl + "\" controls autoplay></audio>")
+                + "</body></html>";
+        mWebView.loadDataWithBaseURL(null, html, "text/html", "UTF-8", null);
+        Log.i(TAG, "Playing WebView: " + srcUrl);
+    }
+
+    private File resolveFile(String path) {
+        File f = new File(path);
+        if (f.exists() && f.canRead()) return f;
+        String name = new File(path).getName();
+        File[] dirs = {
+            getExternalFilesDir(null),
+            getCacheDir(),
+            new File(getFilesDir().getParentFile(), "files"),
+            Environment.getExternalStorageDirectory(),
+            new File("/storage/emulated/0"),
+            new File("/data/media/0"),
+        };
+        for (File dir : dirs) {
+            if (dir == null) continue;
+            File candidate = new File(dir, name);
+            if (candidate.exists() && candidate.canRead()) return candidate;
+            candidate = new File(new File(dir, "Download"), name);
+            if (candidate.exists() && candidate.canRead()) return candidate;
+        }
+        return null;
+    }
+
+    private File copyToCache(File src) {
+        if (src.canRead()) {
+            try {
+                String name = src.getName();
+                int dot = name.lastIndexOf('.');
+                String ext = dot > 0 ? name.substring(dot) : "";
+                File tmp = File.createTempFile("video_", ext, getCacheDir());
+                FileInputStream fis = new FileInputStream(src);
+                FileOutputStream fos = new FileOutputStream(tmp);
+                byte[] buf = new byte[8192];
+                int len;
+                while ((len = fis.read(buf)) > 0) fos.write(buf, 0, len);
+                fis.close();
+                fos.close();
+                return tmp;
+            } catch (Exception e) {
+                Log.e(TAG, "copyToCache error: " + e.getMessage());
+            }
+        }
+        try {
+            String name = src.getName();
+            int dot = name.lastIndexOf('.');
+            String ext = dot > 0 ? name.substring(dot) : "";
+            File tmp = File.createTempFile("video_", ext, getCacheDir());
+            Process p = Runtime.getRuntime().exec(new String[]{
+                    "cp", src.getAbsolutePath(), tmp.getAbsolutePath()});
+            p.waitFor();
+            if (tmp.exists() && tmp.length() > 0) return tmp;
+        } catch (Exception e) {
+            Log.e(TAG, "shell copy error: " + e.getMessage());
+        }
+        return null;
+    }
+
+    // ==================== lifecycle ====================
+
+    @Override
+    public void onBackPressed() {
+        if (mWebView.canGoBack()) {
+            mWebView.goBack();
+        } else {
+            super.onBackPressed();
+        }
+    }
+
+    @Override
+    protected void onPause() {
+        super.onPause();
+        mWebView.onPause();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        mWebView.onResume();
+    }
+
+    @Override
+    protected void onDestroy() {
+        if (mWebView != null) {
+            mWebView.destroyWebView();
+        }
+        super.onDestroy();
+    }
+}
