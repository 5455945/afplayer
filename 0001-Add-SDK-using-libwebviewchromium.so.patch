diff --git a/android_webview/afree/sdk/native/draw_fn_hook.cc b/android_webview/afree/sdk/native/draw_fn_hook.cc
new file mode 100644
index 00000000000..36b9648a582
--- /dev/null
+++ b/android_webview/afree/sdk/native/draw_fn_hook.cc
@@ -0,0 +1,85 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "android_webview/afree/sdk/native/draw_fn_hook.h"
+
+#include <dlfcn.h>
+#include <link.h>
+
+#include "android_webview/public/browser/draw_fn.h"
+#include "base/logging.h"
+
+namespace android_webview {
+namespace afree {
+
+namespace {
+
+struct CallbackData {
+  const char* symbol_name;
+  void* result;
+};
+
+int DlIterCallback(struct dl_phdr_info* info, size_t size, void* data) {
+  auto* cb = static_cast<CallbackData*>(data);
+  void* handle = dlopen(info->dlpi_name, RTLD_NOW | RTLD_LOCAL);
+  if (handle) {
+    void* sym = dlsym(handle, cb->symbol_name);
+    if (sym) {
+      cb->result = sym;
+      dlclose(handle);
+      return 1;
+    }
+    dlclose(handle);
+  }
+  return 0;
+}
+
+}  // namespace
+
+AwDrawFnFunctionTable* GetDrawFnFunctionTable() {
+  static AwDrawFnFunctionTable* s_table = nullptr;
+  if (s_table) return s_table;
+
+  auto log_render_mode = [](const char* where, AwDrawFnFunctionTable* t) {
+    if (!t) return;
+    LOG(INFO) << "DrawFn table found via " << where << ", table=" << t
+              << ", version=" << t->version
+              << ", query_render_mode=" << (t->query_render_mode ? t->query_render_mode() : -999);
+  };
+
+  // Strategy 1: Direct dlsym from default namespace
+  s_table = reinterpret_cast<AwDrawFnFunctionTable*>(
+      dlsym(RTLD_DEFAULT, "AwDrawFnFunctionTable"));
+  if (s_table) {
+    log_render_mode("dlsym(RTLD_DEFAULT)", s_table);
+    return s_table;
+  }
+
+  // Strategy 2: dlopen libhwui.so directly
+  void* hwui = dlopen("libhwui.so", RTLD_NOW | RTLD_LOCAL);
+  if (hwui) {
+    s_table = reinterpret_cast<AwDrawFnFunctionTable*>(
+        dlsym(hwui, "AwDrawFnFunctionTable"));
+    if (s_table) {
+      log_render_mode("dlopen(libhwui.so)", s_table);
+      return s_table;
+    }
+    dlclose(hwui);
+  }
+
+  // Strategy 3: Search in all loaded libraries
+  CallbackData cb = {"AwDrawFnFunctionTable", nullptr};
+  dl_iterate_phdr(DlIterCallback, &cb);
+  if (cb.result) {
+    s_table = static_cast<AwDrawFnFunctionTable*>(cb.result);
+    log_render_mode("dl_iterate_phdr", s_table);
+    return s_table;
+  }
+
+  LOG(WARNING) << "DrawFn table not found after all strategies";
+  return nullptr;
