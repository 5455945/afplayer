+package com.afree;
+
+/**
+ * Afree SDK fork note.
+ *
+ * Original source: android_webview/glue/java/src/com/android/webview/chromium/WebViewChromiumAwInit.java
+ * Purpose: Initialization entry point: loads the .so and initializes AfreeWebViewFactory
+ */
+
+import android.content.Context;
+
+import com.afree.chromium.AfreeWebViewFactory;
+import com.afree.webkit.WebView;
+
+import org.chromium.base.Log;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+
+public final class AfreeWebViewInit {
+    private static final String TAG = "AfreeWebViewInit";
+    private static boolean sInitialized;
+
+    private AfreeWebViewInit() {}
+
+    public static void init(Context appContext) {
+        init(appContext, null);
+    }
+
+    public static void init(Context appContext, String[] chromiumSwitches) {
+        if (sInitialized) return;
+        synchronized (AfreeWebViewInit.class) {
+            if (sInitialized) return;
+            Context ctx = appContext.getApplicationContext();
+
+            disableMemoryTagging();
+
+            extractResources(ctx);
+            AfreeWebViewFactory.getInstance().init(ctx, chromiumSwitches);
+            sInitialized = true;
+            Log.i(TAG, "AfreeWebView initialized");
+        }
+    }
+
+    private static void disableMemoryTagging() {
+        try {
+            java.lang.reflect.Method m = android.os.Process.class.getMethod(
+                    "setMemoryTaggingLevel", int.class);
+            m.invoke(null, 0);
+            Log.i(TAG, "Memory tagging disabled via reflection");
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to disable memory tagging: " + e.getMessage());
+        }
+    }
+
+    public static boolean isInitialized() {
+        return sInitialized;
+    }
+
+    private static void extractResources(Context ctx) {
+        File destDir = new File(ctx.getFilesDir(), "afree_paks");
+        if (!destDir.exists()) {
+            destDir.mkdirs();
+        }
+
+        String[] assets = {
+            "afree/webviewchromium.pak",
+            "afree/resources.pak",
+            "afree/chrome_100_percent.pak",
+            "afree/icudtl.dat",
+            "afree/snapshot_blob_64.bin",
+            "afree/v8_context_snapshot_64.bin",
+        };
+
+        for (String assetPath : assets) {
+            String fileName = assetPath.substring(assetPath.lastIndexOf('/') + 1);
+            File destFile = new File(destDir, fileName);
+            if (destFile.exists()) continue;
+
+            try (InputStream is = ctx.getAssets().open(assetPath);
+                 FileOutputStream fos = new FileOutputStream(destFile)) {
+                byte[] buf = new byte[8192];
+                int len;
+                while ((len = is.read(buf)) > 0) {
+                    fos.write(buf, 0, len);
+                }
+                Log.d(TAG, "Extracted: " + fileName);
+            } catch (Exception e) {
+                Log.w(TAG, "Failed to extract " + assetPath + ": " + e.getMessage());
+            }
+        }
+    }
+}
