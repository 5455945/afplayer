+ * Purpose: Tracing configuration
+ */
+
+import java.util.Collections;
+
+public class TracingConfig {
+    public enum TracingMode {
+        RECORD_UNTIL_FULL, RECORD_CONTINUOUSLY
+    }
+
+    private final TracingMode mTracingMode;
+    private final java.util.List<String> mCustomIncludedCategories;
+    private final java.util.List<String> mCustomExcludedCategories;
+    private final java.util.List<Integer> mPredefinedCategories;
+
+    private TracingConfig(TracingMode tracingMode,
+            java.util.List<String> customIncludedCategories,
+            java.util.List<String> customExcludedCategories,
+            java.util.List<Integer> predefinedCategories) {
+        mTracingMode = tracingMode;
+        mCustomIncludedCategories = customIncludedCategories;
+        mCustomExcludedCategories = customExcludedCategories;
+        mPredefinedCategories = predefinedCategories;
+    }
+
+    public TracingMode getTracingMode() { return mTracingMode; }
+    public java.util.List<String> getCustomIncludedCategories() { return mCustomIncludedCategories; }
+    public java.util.List<String> getCustomExcludedCategories() { return mCustomExcludedCategories; }
+    public java.util.List<Integer> getPredefinedCategories() { return mPredefinedCategories; }
+
+    public static class Builder {
+        private TracingMode mTracingMode = TracingMode.RECORD_UNTIL_FULL;
+        private final java.util.List<String> mCustomIncludedCategories = new java.util.ArrayList<>();
+        private final java.util.List<String> mCustomExcludedCategories = new java.util.ArrayList<>();
+        private final java.util.List<Integer> mPredefinedCategories = new java.util.ArrayList<>();
+
+        public Builder addCustomCategories(String... categories) {
+            Collections.addAll(mCustomIncludedCategories, categories);
+            return this;
+        }
+
+        public Builder addPredefinedCategories(Integer... predefinedCategories) {
+            Collections.addAll(mPredefinedCategories, predefinedCategories);
+            return this;
+        }
+
+        public Builder setTracingMode(TracingMode tracingMode) {
+            mTracingMode = tracingMode;
+            return this;
+        }
+
+        public TracingConfig build() {
+            return new TracingConfig(mTracingMode,
+                    mCustomIncludedCategories, mCustomExcludedCategories,
+                    mPredefinedCategories);
+        }
+    }
+}
