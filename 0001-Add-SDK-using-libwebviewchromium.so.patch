diff --git a/android_webview/afree/sdk/src/main/java/com/afree/chromium/HiddenApiBypass.java b/android_webview/afree/sdk/src/main/java/com/afree/chromium/HiddenApiBypass.java
new file mode 100644
index 00000000000..8b13cbc8f09
--- /dev/null
+++ b/android_webview/afree/sdk/src/main/java/com/afree/chromium/HiddenApiBypass.java
@@ -0,0 +1,225 @@
+// Copyright 2024 The Chromium Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package com.afree.chromium;
+
+import android.util.Log;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+
+/**
+ * Hidden API bypass utility (approach based on LSPosed AndroidHiddenApiBypass).
+ *
+ * How it works: the ART Class object has a {@code methods} field pointing to the
+ * contiguous array of all the class's ArtMethods. Traverse that array with Unsafe
+ * and write the target ArtMethod pointer into a stub Method's {@code artMethod}
+ * field to invoke the target method (including @hide), fully bypassing hidden API
+ * enforcement.
+ *
+ * Key point: {@code Class.methods} / {@code Executable.artMethod} are themselves
+ * @hide fields; direct reflection is rejected. We obtain the field offsets using
+ * stub classes (the app's own classes) whose field layout matches the real classes
+ * (field offsets depend only on field types and declaration order).
+ */
+public final class HiddenApiBypass {
+    private static final String TAG = "HiddenApiBypass";
+
+    // The Unsafe instance and its methods are obtained via reflection, because
+    // sun.misc.Unsafe is not exposed on the Android Gradle compile classpath
+    // (it lives in jdk.unsupported / bootclasspath but is stripped from the
+    // compile SDK stubs). The field type is Object to avoid the compile-time
+    // reference entirely.
+    private static final Object unsafe;
+    private static final Method objectFieldOffsetMethod;
+    private static final Method getLongMethod;
+    private static final Method getIntMethod;
+    private static final Method putLongMethod;
+
+    private static final long methodOffset;   // Executable.artMethod
+    private static final long methodsOffset;  // Class.methods
+    private static final long artMethodSize;
+    private static final long artMethodBias;
+    private static final Method invokeStub;
+
+    static {
+        Object u = null;
+        Method oo = null;
+        Method gl = null;
+        Method gi = null;
+        Method pl = null;
+        long mOffset = -1;
+        long msOffset = -1;
+        long aSize = -1;
+        long aBias = -1;
+        Method stub = null;
+        try {
+            Class<?> unsafeClass = Class.forName("sun.misc.Unsafe");
+            Field f = unsafeClass.getDeclaredField("theUnsafe");
+            f.setAccessible(true);
+            u = f.get(null);
+            oo = unsafeClass.getMethod("objectFieldOffset", Field.class);
+            gl = unsafeClass.getMethod("getLong", Object.class, long.class);
+            gi = unsafeClass.getMethod("getInt", long.class);
+            pl = unsafeClass.getMethod("putLong", Object.class, long.class, long.class);
+
+            mOffset = (Long) oo.invoke(u,
+                    ExecutableStub.class.getDeclaredField("artMethod"));
+            msOffset = (Long) oo.invoke(u,
+                    ClassStub.class.getDeclaredField("methods"));
+
+            Method mA = Stub.class.getDeclaredMethod("a");
+            Method mB = Stub.class.getDeclaredMethod("b");
+            mA.setAccessible(true);
+            mB.setAccessible(true);
+            long aAddr = (Long) gl.invoke(u, mA, mOffset);
+            long bAddr = (Long) gl.invoke(u, mB, mOffset);
+            long aMethods = (Long) gl.invoke(u, Stub.class, msOffset);
+            aSize = bAddr - aAddr;
+            aBias = aAddr - aMethods - aSize;
+
+            stub = Stub.class.getDeclaredMethod("invoke", Object[].class);
+            stub.setAccessible(true);
+        } catch (Throwable e) {
+            Log.e(TAG, "init failed", e);
+        }
+        unsafe = u;
+        objectFieldOffsetMethod = oo;
+        getLongMethod = gl;
+        getIntMethod = gi;
+        putLongMethod = pl;
+        methodOffset = mOffset;
+        methodsOffset = msOffset;
+        artMethodSize = aSize;
+        artMethodBias = aBias;
+        invokeStub = stub;
+    }
+
+    private HiddenApiBypass() {}
+
+    /** Whether it is available (initialization succeeded). */
+    public static boolean isAvailable() {
+        return unsafe != null && invokeStub != null && artMethodSize > 0;
+    }
+
+    private static long getLong(Object obj, long offset) {
+        try {
+            return (Long) getLongMethod.invoke(unsafe, obj, offset);
+        } catch (Throwable e) {
+            throw new RuntimeException(e);
+        }
+    }
+
+    private static int getInt(long address) {
+        try {
+            return (Integer) getIntMethod.invoke(unsafe, address);
+        } catch (Throwable e) {
+            throw new RuntimeException(e);
+        }
+    }
+
+    private static void putLong(Object obj, long offset, long value) {
+        try {
+            putLongMethod.invoke(unsafe, obj, offset, value);
+        } catch (Throwable e) {
+            throw new RuntimeException(e);
+        }
+    }
+
+    /**
+     * Directly invoke a (possibly @hide) method of the target class, bypassing
+     * hidden API enforcement.
+     *
+     * @param clazz      the class that declares the target method
+     * @param thiz       the receiver object (null for static methods)
+     * @param methodName the method name
+     * @param paramTypes parameter types (exact match, including primitive types
+     *                   like int.class)
+     * @param args       argument values (boxed)
+     * @return the method return value; null on failure.
+     */
+    public static Object invoke(Class<?> clazz, Object thiz, String methodName,
+            Class<?>[] paramTypes, Object[] args) {
+        try {
+            long methods = getLong(clazz, methodsOffset);
+            if (methods == 0) {
+                Log.e(TAG, "no methods for " + clazz);
+                return null;
+            }
+            int numMethods = getInt(methods);
+            for (int i = 0; i < numMethods; i++) {
+                long method = methods + i * artMethodSize + artMethodBias;
+                putLong(invokeStub, methodOffset, method);
+                if (methodName.equals(invokeStub.getName())) {
+                    Class<?>[] p = invokeStub.getParameterTypes();
+                    if (p.length == paramTypes.length) {
+                        boolean match = true;
+                        for (int j = 0; j < p.length; j++) {
+                            if (p[j] != paramTypes[j]) {
+                                match = false;
+                                break;
+                            }
+                        }
+                        if (match) {
+                            return invokeStub.invoke(thiz, args);
+                        }
+                    }
+                }
+            }
+            Log.e(TAG, "method not found: " + clazz.getName() + "." + methodName);
+        } catch (Throwable e) {
+            Log.e(TAG, "invoke failed: " + methodName + " -> " + e);
+        }
+        return null;
+    }
+
+    // ---- stub classes: field layout matches ART internal classes, used to obtain field offsets ----
+
+    private static class ClassStub {
+        private transient ClassLoader classLoader;
+        private transient Class<?> componentType;
+        private transient Object dexCache;
+        private transient Object extData;
+        private transient Object[] ifTable;
+        private transient String name;
+        private transient Class<?> superClass;
+        private transient Object vtable;
+        private transient long iFields;
+        private transient long methods;
+        private transient long sFields;
+        private transient int accessFlags;
+        private transient int classFlags;
+        private transient int classSize;
+        private transient int clinitThreadId;
+        private transient int dexClassDefIndex;
+        private transient volatile int dexTypeIndex;
+        private transient int numReferenceInstanceFields;
+        private transient int numReferenceStaticFields;
+        private transient int objectSize;
+        private transient int objectSizeAllocFastPath;
+        private transient int primitiveType;
+        private transient int referenceInstanceOffsets;
+        private transient int status;
+        private transient short copiedMethodsOffset;
+        private transient short virtualMethodsOffset;
+    }
+
+    private static class AccessibleObjectStub {
+        private boolean override;
+    }
+
+    private static class ExecutableStub extends AccessibleObjectStub {
+        private Object declaringClass;
+        private Object declaringClassOfOverriddenMethod;
+        private Object[] parameters;
+        private long artMethod;
+        private int accessFlags;
+    }
+
+    private static class Stub {
+        private static void a() {}
+        private static void b() {}
+        private static Object invoke(Object[] args) { return null; }
+    }
+}
