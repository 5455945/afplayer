+# Rerun a packaging command from toolchain.ninja (after so_strip replaced the
+# .so), so the repacked artifact picks up the so_strip-processed .so.
+#   $1 = script filename to match (apkbuilder.py / inject_and_sign_apk.py /
+#        dist_aar.py)
+#   $2 = output substring to match
+rerun_packaging_command() {
+  local script="$1"
+  local output_match="$2"
+  local ninja_file="$OUTPUT_DIR/toolchain.ninja"
+  if [ ! -f "$ninja_file" ]; then
+    echo "ERROR: toolchain.ninja does not exist: $ninja_file"
+    exit 1
+  fi
+
+  echo "Repack via ${script} (${output_match}) ..."
+  ./init_tools/${M_VERSION}/depot_tools/python-bin/python3 - "$ninja_file" "$script" "$output_match" "$OUTPUT_DIR" <<'PYEOF'
+import sys, subprocess
+ninja_file, script, output_match, output_dir = sys.argv[1:5]
+found = False
+with open(ninja_file, 'r') as f:
+    for line in f:
+        line = line.strip()
+        if not line.startswith('command ='):
+            continue
+        if script not in line:
+            continue
+        if output_match not in line:
+            continue
+        found = True
