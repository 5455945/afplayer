diff --git a/tools/afree-login-service/test/protocol.test.mjs b/tools/afree-login-service/test/protocol.test.mjs
index 2b4b2c4527..91020df082 100644
--- a/tools/afree-login-service/test/protocol.test.mjs
+++ b/tools/afree-login-service/test/protocol.test.mjs
@@ -377,3 +377,20 @@ test('logout clears cookies and emits the signout header', async () => {
   });
   assert.deepEqual(decodeListAccountsResponseBase64(list.text), []);
 });
+
+test('post-login page never links to an unreachable Google continue URL', async () => {
+  const response = await request('/signin/chrome/sync?ssp=1', {
+    method: 'POST',
+    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+    body: new URLSearchParams({
+      email: EMAIL,
+      password: PASSWORD,
+      continue: 'https://www.google.com/',
+    }).toString(),
+  });
+  assert.equal(response.status, 200);
+  // The DICE header must still be there; only the dead link is dropped.
+  assert.ok(response.headers.get('x-chrome-id-consistency-response'));
+  assert.ok(!response.text.includes('www.google.com'));
+  assert.match(response.text, /状态页 \/ Status page/);
+});
