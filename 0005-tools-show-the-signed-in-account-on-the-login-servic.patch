@@ -748,6 +772,53 @@ export class GaiaService {
 
   // ----------------------------------------------------------- endpoints
 
+  /**
+   * Returns the accounts attached to the browser session as JSON. This is the
+   * "page login state" view: it reads the same SID cookie Chromium uses, so a
+   * browser that signed in through the profile menu shows up here too.
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   */
+  handleSessionInfo(req, res) {
+    const session = this.getSession(req);
+    if (!session) {
+      sendJson(
+          res,
+          200,
+          {signedIn: false, primary: null, accounts: []},
+          {'Cache-Control': 'no-store'},
+      );
+      return;
+    }
+    const accounts = this.store.getSessionAccounts(session.id)
+                         .filter((entry) => !entry.disabled)
+                         .map((entry) => ({
+                                email: entry.display_email,
+                                gaiaId: entry.gaia_id,
+                                displayName: entry.display_name,
+                                avatarUrl: entry.avatar_url,
+                                position: entry.position,
+                                primary: entry.position === 0,
+                              }));
+    sendJson(
+        res,
+        200,
+        {
+          signedIn: accounts.length > 0,
+          primary: accounts.find((entry) => entry.primary) ?? accounts[0] ??
+              null,
+          accounts,
+          session: {
+            createdAt: session.created_at,
+            expiresAt: session.expires_at,
+            deviceName: session.device_name,
+            ip: session.ip,
+          },
+        },
+        {'Cache-Control': 'no-store'},
+    );
+  }
+
   /**
    * Mirrors the /enable_sync endpoint used by Chromium's dice browsertest:
    * it answers with action=ENABLE_SYNC so the client can finish the sync
