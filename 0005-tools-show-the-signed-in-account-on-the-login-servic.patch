+test('index page and /api/session reflect the browser login', async () => {
+  const page = await request('/', {headers: {Cookie: cookieHeader()}});
+  assert.equal(page.status, 200);
+  assert.ok(page.text.includes(EMAIL), 'index page does not show the account');
+  assert.match(page.text, /已登录 \/ Signed in as/);
+
+  const info = await request('/api/session', {
+    headers: {Cookie: cookieHeader()},
+  });
+  const payload = JSON.parse(info.text);
+  assert.equal(payload.signedIn, true);
+  assert.equal(payload.primary.email, EMAIL);
+  assert.equal(payload.primary.gaiaId, gaiaId);
+  assert.equal(payload.accounts.length, 1);
+  assert.equal(payload.accounts[0].primary, true);
+});
+
+test('index page and /api/session show signed out without cookies', async () => {
+  const page = await request('/');
+  assert.match(page.text, /未登录 \/ Not signed in/);
+  const info = await request('/api/session');
+  assert.equal(JSON.parse(info.text).signedIn, false);
+});
