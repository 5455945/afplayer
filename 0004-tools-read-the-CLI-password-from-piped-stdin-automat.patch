From 35645484f26851a4482f371fcd4fa14ba4a3d1a8 Mon Sep 17 00:00:00 2001
From: "5455945@gmail.com" <5455945@gmail.com>
Date: Tue, 24 Nov 2026 17:00:13 +0800
Subject: [PATCH 4/8] tools: read the CLI password from piped stdin
 automatically

---
 tools/afree-login-service/README.md   |  5 ++---
 tools/afree-login-service/src/cli.mjs | 17 ++++++++++++++---
 2 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/tools/afree-login-service/README.md b/tools/afree-login-service/README.md
index d7297ce78b..e2798889fe 100644
--- a/tools/afree-login-service/README.md
+++ b/tools/afree-login-service/README.md
@@ -65,7 +65,6 @@ cd tools/afree-login-service
 # 1. create an account (reads the password from stdin)
 printf '%s\n' 'your-password' |
   node src/cli.mjs add-user --email you@example.com --name "You"
-
 # 2. start the service
 node src/server.mjs --host 127.0.0.1 --port 8080
 
@@ -267,9 +266,9 @@ and a persistent server secret, so the server can re-emit them on
 ### Admin CLI
 
 ```sh
-node src/cli.mjs add-user        --email a@b.c [--password -] [--name X]
+node src/cli.mjs add-user        --email a@b.c [--password <pw> | --password -]
 node src/cli.mjs list-users
-node src/cli.mjs set-password    --email a@b.c [--password -]
+node src/cli.mjs set-password    --email a@b.c [--password <pw> | --password -]
 node src/cli.mjs disable-user    --email a@b.c
 node src/cli.mjs enable-user     --email a@b.c
 node src/cli.mjs delete-user     --email a@b.c
diff --git a/tools/afree-login-service/src/cli.mjs b/tools/afree-login-service/src/cli.mjs
index 4886e4cec1..4a69594fcb 100644
--- a/tools/afree-login-service/src/cli.mjs
+++ b/tools/afree-login-service/src/cli.mjs
@@ -26,8 +26,9 @@ Commands:
                   [--client-secret <secret>] [--output <path>]
 
 Password input:
-  Pass --password - to read one line from stdin, for example:
-    printf '%s\\n' "$PASSWORD" | node src/cli.mjs add-user --email a@b.c --password -
+  Pass --password <value>, or pipe it:
+    printf '%s\\n' "$PASSWORD" | node src/cli.mjs add-user --email a@b.c
+  --password - also reads one line from stdin explicitly.
 `;
 
 /** @param {string[]} argv */
@@ -90,7 +91,17 @@ async function resolvePassword(flags) {
     return provided === '-' ? await readStdinLine() : provided;
   }
   if (provided === true) {
-    throw new Error('--password requires a value (use --password - for stdin)');
+    // `--password` with no value: read from stdin.
+    return readStdinLine();
+  }
+  // Convenience: `printf 'pw\n' | cli add-user --email ...` works without an
+  // explicit --password. Only do this when stdin is not an interactive TTY,
+  // so an interactive run still fails fast instead of waiting forever.
+  if (!process.stdin.isTTY) {
+    const line = await readStdinLine();
+    if (line.length > 0) {
+      return line;
+    }
   }
   throw new Error('--password is required (use --password - to read stdin)');
 }
-- 
2.56.1

