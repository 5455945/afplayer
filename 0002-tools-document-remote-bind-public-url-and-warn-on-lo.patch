diff --git a/tools/afree-login-service/src/server.mjs b/tools/afree-login-service/src/server.mjs
index 6b918f440d..0f7a5abc2b 100644
--- a/tools/afree-login-service/src/server.mjs
+++ b/tools/afree-login-service/src/server.mjs
@@ -65,6 +65,18 @@ async function main() {
     }
   }
 
+  // Binding a wildcard/non-loopback address while advertising a loopback
+  // origin is almost always a mistake: cookies are host-only, so remote
+  // clients would receive cookies for a host they never talk to.
+  if (!isLoopbackHost(config.host) &&
+      isLoopbackHost(new URL(config.publicUrl).hostname)) {
+    logger.warn(
+        '--host is not loopback but --public-url points at loopback; remote ' +
+        'clients will not be able to use this origin. Pass --public-url ' +
+        'http://<this-machine-ip>:<port> (and regenerate the gaia config ' +
+        'with the same URL).');
+  }
+
   const {server, store} = await startServer(config, logger);
   const address = server.address();
   const actualPort =
@@ -77,8 +89,16 @@ async function main() {
   });
 
   process.stdout.write(`afree login service listening on ${config.publicUrl}
+bind address: ${config.host}:${actualPort}
 database: ${config.dbPath}
 
+Clients on this machine can use ${config.publicUrl} directly.
+Clients on another machine need the address they can reach, for example:
+  node src/server.mjs --host 0.0.0.0 --port ${actualPort} \\
+    --public-url http://<this-machine-ip>:${actualPort}
+  node src/cli.mjs gen-gaia-config --url http://<this-machine-ip>:${actualPort} \\
+    > gaia-config.json
+
 Next steps:
   1) create a user:
        node src/cli.mjs add-user --email you@example.com
