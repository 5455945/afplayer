+#!/usr/bin/env bash
+#############################################################################
+# build_windows.sh - Windows (target_os="win") build driver (shell only).
+#
+# Shell implementation:
+#   * build_windows_def.sh  - default parameter values
+#   * build_windows_help.sh - parameter parsing + help text
+#   * build_windows.sh      - build orchestration (this file)
+#
+# The script lives in init_tools/build/ and resolves the repository root as two
+# levels up from its own location. It can be invoked from the repository root
+# (via the build_windows.sh symlink), from an arbitrary external directory, or
+# directly from inside init_tools/build/.
+#
+# The Windows toolchain is taken from an already extracted/installed toolchain
+# (build/win_toolchain.json) when it is valid. The archive specified by
+# --toolchain-base-url, DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL, or
+# WIN_TOOLCHAIN_BASE_URL_DEFAULT is only required when that toolchain is
+# missing or stale; in that case a missing/invalid archive aborts the build
+# before gn gen/ninja run.
+#############################################################################
+
+SCRIPT_PATH="$(readlink -f "$0")"
+SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+START_DIR="$(pwd)"
+
+# ---------------------------------------------------------------------------
+# Source parameter defaults + help/parsing helpers.
+# ---------------------------------------------------------------------------
+# shellcheck source=build_windows_def.sh
+source "$SCRIPT_DIR/build_windows_def.sh"
+# shellcheck source=build_windows_help.sh
+source "$SCRIPT_DIR/build_windows_help.sh"
+
+# ---------------------------------------------------------------------------
+# Global constants
+# ---------------------------------------------------------------------------
+LOG_FILE=""
+GN_BIN=""
+NINJA_BIN=""
+HOST_OS=""
+CCACHE_BIN=""
+CANONICAL_TOOLCHAIN_HASH=""
+LOCAL_TOOLCHAIN_HASH=""
+TOOLCHAIN_JSON="$REPO_ROOT/build/win_toolchain.json"
+
+# ---------------------------------------------------------------------------
+# Logging helpers
+#
+#   log ...      -> timestamped line (stdout + log file)
+#   run_log ...  -> timestamped command line + execution (stdout + log file)
+# ---------------------------------------------------------------------------
+log() {
+  local ts
+  ts="$(date '+%Y-%m-%d %H:%M:%S')"
+  if [ -n "$LOG_FILE" ]; then
+    printf '[%s] %s\n' "$ts" "$*" | tee -a "$LOG_FILE"
+  else
+    printf '[%s] %s\n' "$ts" "$*"
+  fi
+}
+
+run_log() {
+  local desc="$1"; shift
+  log ">>> $desc"
+  log "RUN: $*"
+  if [ -n "$LOG_FILE" ]; then
+    "$@" 2>&1 | tee -a "$LOG_FILE"
+  else
+    "$@"
+  fi
+  return "${PIPESTATUS[0]}"
+}
+
+error() {
+  printf 'ERROR: %s\n' "$*" >&2
+}
+
+# ---------------------------------------------------------------------------
+# Host / tool resolution
+# ---------------------------------------------------------------------------
+resolve_tools() {
+  case "$(uname -s)" in
+    Linux*)                 HOST_OS="linux64" ;;
+    Darwin*)                HOST_OS="mac" ;;
+    MINGW*|MSYS*|CYGWIN*)   HOST_OS="win" ;;
+    *)                      HOST_OS="linux64" ;;
+  esac
+
+  GN_BIN="$REPO_ROOT/buildtools/$HOST_OS/gn"
+  if [ ! -x "$GN_BIN" ]; then
+    GN_BIN="$REPO_ROOT/buildtools/$HOST_OS/gn.exe"
+  fi
+  if [ ! -x "$GN_BIN" ]; then
+    GN_BIN="$(command -v gn 2>/dev/null || true)"
+  fi
+  if [ -z "$GN_BIN" ] || [ ! -x "$GN_BIN" ]; then
+    error "gn was not found."
+    error "Expected $REPO_ROOT/buildtools/$HOST_OS/gn (or gn.exe), or gn in PATH."
+    return 1
+  fi
+
+  NINJA_BIN="$REPO_ROOT/third_party/ninja/ninja"
+  if [ ! -x "$NINJA_BIN" ]; then
+    NINJA_BIN="$REPO_ROOT/third_party/ninja/ninja.exe"
+  fi
+  if [ ! -x "$NINJA_BIN" ]; then
+    NINJA_BIN="$(command -v ninja 2>/dev/null || true)"
+  fi
+  if [ -z "$NINJA_BIN" ] || [ ! -x "$NINJA_BIN" ]; then
+    error "ninja was not found."
+    error "Expected $REPO_ROOT/third_party/ninja/ninja (or ninja.exe), or ninja in PATH."
+    return 1
+  fi
+
+  log "host os       : $HOST_OS"
+  log "gn            : $GN_BIN"
+  log "ninja         : $NINJA_BIN"
+}
+
+setup_build_env() {
+  export PYTHONDONTWRITEBYTECODE=1
+  export DEPOT_TOOLS_UPDATE=0
+  export DEPOT_TOOLS_WIN_TOOLCHAIN=1
+  export PATH="$REPO_ROOT/init_tools/${M_VERSION}/depot_tools/python-bin:$REPO_ROOT/init_tools/${M_VERSION}/depot_tools:$REPO_ROOT/buildtools/$HOST_OS:$REPO_ROOT/third_party/ninja:$REPO_ROOT/third_party/llvm-build/Release+Asserts/bin:$PATH"
+}
+
+# ---------------------------------------------------------------------------
+# ccache
+#
+# The Windows target is built with clang-cl, a native host binary, so the
+# bundled Linux ccache can wrap both the host and the Windows-target compiler
+# invocations. Chromium's win toolchain honours the GN `cc_wrapper` argument.
+# ---------------------------------------------------------------------------
+handle_ccache_conflicts() {
+  if [[ "$no_ccache" != "true" && "${extra_gn_args:-}" =~ (use_remoteexec|use_reclient)=true ]]; then
+    log "WARNING: ccache cannot be combined with use_remoteexec/use_reclient; disabling ccache"
+    no_ccache=true
+  fi
+}
+
+setup_ccache() {
+  if [[ "$no_ccache" == "true" ]]; then
+    log "ccache disabled (--no-ccache)"
+    CCACHE_BIN=""
+    return 0
+  fi
+
+  CCACHE_BIN="$REPO_ROOT/init_tools/ccache/ccache"
+  if [ ! -x "$CCACHE_BIN" ]; then
+    log "WARNING: ccache not found at $CCACHE_BIN; continuing without ccache"
+    no_ccache=true
+    CCACHE_BIN=""
+    return 0
+  fi
+
+  if [[ -z "${CCACHE_DIR:-}" ]]; then
+    if [ -d /workspace ]; then
+      CCACHE_DIR="/workspace/.ccache/chromium${M_VERSION}_win"
+    else
+      CCACHE_DIR="$HOME/.ccache/chromium${M_VERSION}_win"
+      log "WARNING: /workspace does not exist, fallback to ccache dir: $CCACHE_DIR"
+    fi
+  fi
+  export CCACHE_DIR
+  export CCACHE_COMPILERCHECK=content
+  export CCACHE_NOHASHDIR=true
+  export CCACHE_BASEDIR="$REPO_ROOT"
+  export CCACHE_TEMPDIR="$REPO_ROOT/out/.tmp/"
+  export CCACHE_DEPEND=1
+  export CCACHE_SLOPPINESS="file_macro,time_macros,include_file_mtime,include_file_ctime,pch_defines,modules,clang_index_store"
+
+  mkdir -p "$CCACHE_TEMPDIR" "$CCACHE_DIR" || return 1
+  log "ccache bin    : $CCACHE_BIN"
+  log "ccache dir    : $CCACHE_DIR"
+  run_log "ccache reset stats" "$CCACHE_BIN" -z
+  run_log "ccache set max size" "$CCACHE_BIN" -M 100GB
+}
+
+show_ccache_stats() {
+  [[ "$no_ccache" == "true" ]] && return 0
+  [[ -n "${CCACHE_BIN:-}" ]] || return 0
+  run_log "ccache stats" "$CCACHE_BIN" -s
+}
+
+# ---------------------------------------------------------------------------
+# Windows toolchain validation
+#
+# Produces a clear, actionable error and aborts when the archive directory is
+# missing or does not contain the expected toolchain package.
+# ---------------------------------------------------------------------------
+read_toolchain_hashes() {
+  local base_dir="$1"
+
+  CANONICAL_TOOLCHAIN_HASH="$(sed -n \
+    "s/^TOOLCHAIN_HASH = '\([^']*\)'.*/\1/p" \
+    "$REPO_ROOT/build/vs_toolchain.py" 2>/dev/null | head -n 1)"
+  if [ -z "$CANONICAL_TOOLCHAIN_HASH" ]; then
+    CANONICAL_TOOLCHAIN_HASH="e66617bc68"
+  fi
+
+  local env_key="GYP_MSVS_HASH_${CANONICAL_TOOLCHAIN_HASH}"
+  LOCAL_TOOLCHAIN_HASH="${!env_key:-}"
+
+  local info_file="$base_dir/TOOLCHAIN_INFO.txt"
+  if [ -n "$base_dir" ] && [ -f "$info_file" ]; then
+    local info_canonical info_local
+    info_canonical="$(sed -n 's/^canonical_hash=//p' "$info_file" | head -n 1 | tr -d '\r')"
+    info_local="$(sed -n 's/^local_hash=//p' "$info_file" | head -n 1 | tr -d '\r')"
+
+    if [ -n "$info_canonical" ] && [ "$info_canonical" != "$CANONICAL_TOOLCHAIN_HASH" ]; then
+      error "Windows toolchain archive does not match this Chromium checkout."
+      error "  archive canonical_hash : $info_canonical  ($info_file)"
+      error "  checkout TOOLCHAIN_HASH: $CANONICAL_TOOLCHAIN_HASH  (build/vs_toolchain.py)"
+      error "Use a toolchain archive that matches this source tree, then retry."
+      return 1
+    fi
+
+    if [ -z "$LOCAL_TOOLCHAIN_HASH" ] && [ -n "$info_local" ]; then
+      LOCAL_TOOLCHAIN_HASH="$info_local"
+    fi
+  fi
+
+  if [ -z "$LOCAL_TOOLCHAIN_HASH" ]; then
+    LOCAL_TOOLCHAIN_HASH="$CANONICAL_TOOLCHAIN_HASH"
+  fi
+
+  log "toolchain hash: canonical=$CANONICAL_TOOLCHAIN_HASH local=$LOCAL_TOOLCHAIN_HASH"
+  return 0
+}
+
+resolve_win_toolchain() {
+  local source_desc url local_path
+  if [ -n "${win_toolchain_base_url:-}" ]; then
+    url="$win_toolchain_base_url"
+    source_desc="--toolchain-base-url"
+  elif [ -n "${DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL:-}" ]; then
+    url="$DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL"
+    source_desc="DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL"
+  else
+    url="$WIN_TOOLCHAIN_BASE_URL_DEFAULT"
+    source_desc="built-in default"
+  fi
+
+  local_path="$url"
+  if [[ "$local_path" == file://* ]]; then
+    local_path="${local_path#file://}"
+  fi
+
+  if [[ "$local_path" == http://* || "$local_path" == https://* ]]; then
+    # Remote archives cannot be inspected locally; download happens in
+    # build/vs_toolchain.py when the toolchain is (re)installed.
+    read_toolchain_hashes "" || return 1
+    log "toolchain url : $url (source: $source_desc, remote; local check skipped)"
+    export DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL="$url"
+    export "GYP_MSVS_HASH_${CANONICAL_TOOLCHAIN_HASH}=${LOCAL_TOOLCHAIN_HASH}"
+    export DEPOT_TOOLS_WIN_TOOLCHAIN=1
+    return 0
+  fi
+
+  local base_dir="$local_path"
+  [[ "$base_dir" != */ ]] && base_dir="$base_dir/"
+
+  if [ -z "$base_dir" ] || [ ! -e "$base_dir" ]; then
+    error "Windows toolchain archive directory does not exist:"
+    error "    $base_dir"
+    error "  resolved from: $source_desc"
+    error ""
+    error "The default location is:"
+    error "    $WIN_TOOLCHAIN_BASE_URL_DEFAULT"
+    error ""
+    error "Fix it with one of:"
+    error "    export DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL=/path/to/win_toolchain_archive/"
+    error "    ./build_windows.sh --toolchain-base-url=/path/to/win_toolchain_archive/"
+    error ""
+    error "The directory must contain the packaged toolchain, for example:"
+    error "    <local_hash>.zip   (e.g. ef685b78a0.zip)"
+    error "Build aborted before gn gen."
+    return 1
+  fi
+
+  if [ ! -d "$base_dir" ]; then
+    error "Windows toolchain archive path is not a directory:"
+    error "    $base_dir"
+    error "  resolved from: $source_desc"
+    error "Build aborted before gn gen."
+    return 1
+  fi
+
+  read_toolchain_hashes "$base_dir" || return 1
+
+  local zip_file="${base_dir}${LOCAL_TOOLCHAIN_HASH}.zip"
+  if [ ! -f "$zip_file" ]; then
+    local -a found_zips=("${base_dir%/}"/*.zip)
+    if [ -e "${found_zips[0]}" ] && [ "${#found_zips[@]}" -eq 1 ]; then
+      local zip_base
+      zip_base="$(basename "${found_zips[0]}" .zip)"
+      log "WARNING: expected ${LOCAL_TOOLCHAIN_HASH}.zip but found ${zip_base}.zip"
+      log "WARNING: using ${zip_base}.zip and setting GYP_MSVS_HASH_${CANONICAL_TOOLCHAIN_HASH}=${zip_base}"
+      LOCAL_TOOLCHAIN_HASH="$zip_base"
+      zip_file="${found_zips[0]}"
+    else
+      error "Windows toolchain archive directory has no usable toolchain package."
+      error "    directory : $base_dir"
+      error "    expected  : ${LOCAL_TOOLCHAIN_HASH}.zip"
+      error ""
+      if [ "${#found_zips[@]}" -gt 0 ] && [ -e "${found_zips[0]}" ]; then
+        error "  Found zip files:"
+        local z
+        for z in "${found_zips[@]}"; do
+          error "    $(basename "$z")"
+        done
+        error "  Set GYP_MSVS_HASH_${CANONICAL_TOOLCHAIN_HASH} to the correct package hash,"
+        error "  or pick the matching archive with --toolchain-base-url."
+      else
+        error "  The directory contains no *.zip file."
+        error "  Expected contents (see TOOLCHAIN_INFO.txt in a prepared archive):"
+        error "    ${LOCAL_TOOLCHAIN_HASH}.zip"
+        error "    TOOLCHAIN_INFO.txt   (optional, but recommended)"
+      fi
+      error ""
+      error "Build aborted before gn gen."
+      return 1
+    fi
+  fi
+
+  if [ ! -s "$zip_file" ]; then
+    error "Windows toolchain package is empty:"
+    error "    $zip_file"
+    error "Build aborted before gn gen."
+    return 1
+  fi
+
+  log "toolchain url : $url (source: $source_desc)"
+  log "toolchain pkg : $zip_file"
+  export DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL="$url"
+  export "GYP_MSVS_HASH_${CANONICAL_TOOLCHAIN_HASH}=${LOCAL_TOOLCHAIN_HASH}"
+  export DEPOT_TOOLS_WIN_TOOLCHAIN=1
+  return 0
+}
+
+# Check that build/win_toolchain.json points at paths that exist in *this*
+# checkout. Paths may be absolute or relative to the repository root. A stale
+# json (e.g. after moving the checkout) is refreshed through vs_toolchain.py,
+# which extracts the zip from the archive directory if needed.
+win_toolchain_json_is_valid() {
+  python3 - "$TOOLCHAIN_JSON" "$REPO_ROOT" <<'PY'
+import json
+import os
+import sys
+
+path = sys.argv[1]
+repo_root = os.path.abspath(sys.argv[2])
+try:
+    with open(path, 'r') as f:
+        data = json.load(f)
+except Exception as exc:
+    print('cannot read %s: %s' % (path, exc))
+    sys.exit(1)
+
+def resolve(p):
+    if not p:
+        return p
+    if os.path.isabs(p):
+        return p
+    return os.path.normpath(os.path.join(repo_root, p))
+
+toolchain_path = resolve(data.get('path'))
+win_sdk = resolve(data.get('win_sdk'))
+runtime_dirs = [resolve(p) for p in (data.get('runtime_dirs') or [])]
+
+required = [p for p in [toolchain_path, win_sdk] + runtime_dirs if p]
+
+# Also make sure the extracted toolchain looks complete, not just the top-level
+# directories. This catches partially deleted/corrupt installations.
+if toolchain_path:
+    required.extend([
+        os.path.join(toolchain_path, 'VC'),
+        os.path.join(toolchain_path, 'VS_VERSION'),
+    ])
+if win_sdk:
+    required.append(os.path.join(win_sdk, 'Include'))
+
+missing = [p for p in required if not os.path.exists(p)]
+if missing:
+    for p in missing:
+        print('missing toolchain path: %s' % p)
+    sys.exit(1)
+sys.exit(0)
+PY
+}
+
+# Rewrite build/win_toolchain.json so paths inside the checkout are stored
+# relative to the repository root. This keeps the tracked file stable when the
+# checkout is moved/renamed and stops it from showing up in `git status`.
+# build/vs_toolchain.py resolves such relative paths against the source root.
+normalize_toolchain_json_paths() {
+  if ! grep -q "_NormalizeToolchainPath" "$REPO_ROOT/build/vs_toolchain.py"; then
+    log "WARNING: build/vs_toolchain.py lacks relative-path support; keeping absolute toolchain paths"
+    return 0
+  fi
+
+  python3 - "$TOOLCHAIN_JSON" "$REPO_ROOT" <<'PY'
+import json
+import os
+import sys
+
+path = sys.argv[1]
+repo_root = os.path.abspath(sys.argv[2])
+
+try:
+    with open(path, 'r') as f:
+        data = json.load(f)
+except Exception as exc:
+    print('cannot read %s: %s' % (path, exc), file=sys.stderr)
+    sys.exit(1)
+
+def to_relative(p):
+    if not p:
+        return p
+    absolute = p if os.path.isabs(p) else os.path.join(repo_root, p)
+    absolute = os.path.normpath(absolute)
+    try:
+        rel = os.path.relpath(absolute, repo_root)
+    except ValueError:
+        return absolute
+    # Paths outside the checkout must stay absolute.
+    if rel == os.pardir or rel.startswith(os.pardir + os.sep):
+        return absolute
+    return rel
+
+changed = False
+for key in ('path', 'win_sdk', 'wdk'):
+    if data.get(key):
+        new_value = to_relative(data[key])
+        if new_value != data[key]:
+            data[key] = new_value
+            changed = True
+if isinstance(data.get('runtime_dirs'), list):
+    new_dirs = [to_relative(p) for p in data['runtime_dirs']]
+    if new_dirs != data['runtime_dirs']:
+        data['runtime_dirs'] = new_dirs
+        changed = True
+
+if changed:
+    with open(path, 'w') as f:
+        json.dump(data, f, indent=2)
+        f.write('\n')
+PY
+}
+
+ensure_win_toolchain() {
+  if win_toolchain_json_is_valid; then
+    log "win toolchain : installed toolchain is valid"
+    log "archive       : not required (${DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL:-<unset>})"
+    normalize_toolchain_json_paths || \
+      log "WARNING: failed to make $TOOLCHAIN_JSON use repository-relative paths"
+    return 0
+  fi
+
+  log "Windows toolchain is missing or stale; the toolchain archive is required."
+  resolve_win_toolchain || return 1
+  log "This reads the archive from: ${DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL}"
+
+  if ! run_log "install win toolchain" python3 \
+      "$REPO_ROOT/build/vs_toolchain.py" update --force; then
+    error "Failed to install the Windows toolchain."
+    error "Check that ${DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL} contains a valid"
+    error "${LOCAL_TOOLCHAIN_HASH}.zip and that the checkout is writable."
+    return 1
+  fi
+
+  if ! win_toolchain_json_is_valid; then
+    error "The Windows toolchain was updated but $TOOLCHAIN_JSON is still invalid."
+    error "Please check the toolchain archive and try again."
+    return 1
+  fi
+
+  normalize_toolchain_json_paths || \
+    log "WARNING: failed to make $TOOLCHAIN_JSON use repository-relative paths"
+  return 0
+}
+
+# ---------------------------------------------------------------------------
+# Target / output resolution
+# ---------------------------------------------------------------------------
+resolve_output_dir() {
+  local mode_letter
+  case "$build_mode" in
+    debug)   mode_letter="d" ;;
+    release) mode_letter="r" ;;
+  esac
+
+  OUTPUT_DIR="out/win${target_cpu}${mode_letter}${dir_fix}"
+  export OUTPUT_DIR
+}
+
+# ---------------------------------------------------------------------------
+# gn gen
+# ---------------------------------------------------------------------------
+build_gn_args() {
+  local is_debug_val="false" is_official="true" is_component="false"
+  case "$build_mode" in
+    debug)   is_debug_val="true";  is_official="false"; is_component="true" ;;
+    release) is_debug_val="false"; is_official="true";  is_component="false" ;;
+  esac
+
+  local -a args=(
+    'target_os="win"'
+    "target_cpu=\"${target_cpu}\""
+    "is_component_build=${is_component}"
+    "is_debug=${is_debug_val}"
+    "is_official_build=${is_official}"
+    "google_api_key=false"
+    "google_default_client_id=false"
+    "google_default_client_secret=false"
+    "proprietary_codecs=true"
+    "media_use_ffmpeg=true"
+    'ffmpeg_branding="Chrome"'
+    "enable_mse_mpeg2ts_stream_parser=true"
+  )
+
+  # The Windows toolchain supports cc_wrapper when using clang-cl; the Linux
+  # ccache binary is used for both host and target compiles.
+  if [[ "$no_ccache" != "true" && -n "${CCACHE_BIN:-}" ]]; then
+    args+=("cc_wrapper=\"${CCACHE_BIN}\"")
+  fi
+
+  # Extra user-provided gn args are appended LAST so they override the defaults
+  # above (GN's args.gn is evaluated top-to-bottom, last assignment wins).
+  if [ -n "${extra_gn_args:-}" ]; then
+    args+=("${extra_gn_args}")
+  fi
+
+  GN_ARGS="$(printf '%s ' "${args[@]}")"
+}
+
+run_gn_gen() {
+  build_gn_args
+  log "gn gen args: ${GN_ARGS}"
+
+  local -a ide_args=()
+  if [ "${win_ide:-none}" != "none" ]; then
+    # Older gn binaries do not know about newer --ide values (e.g. vs2026).
+    # IDE project generation is optional, so fall back gracefully.
+    if "$GN_BIN" help gen 2>&1 | grep -q "\"${win_ide}\""; then
+      ide_args=(--ide="$win_ide")
+    else
+      log "WARNING: this gn does not support --ide=$win_ide; skipping IDE project generation"
+    fi
+  fi
+
+  run_log "gn gen" "$GN_BIN" gen "$OUTPUT_DIR" "${ide_args[@]}" \
+    --args="$GN_ARGS" || return 1
+}
+
+run_ninja() {
+  local -a targets=()
+  # shellcheck disable=SC2206
+  targets=($win_targets)
+
+  log "targets      : ${targets[*]}"
+  run_log "ninja" "$NINJA_BIN" -j"$jobs" -C "$OUTPUT_DIR" "${targets[@]}" || return 1
+}
+
+# ---------------------------------------------------------------------------
+# Root symlink
+#
+# Keep the convenient ./build_windows.sh entry point in the repository root.
+# Creating it is best-effort: the build does not depend on it.
+# ---------------------------------------------------------------------------
+ensure_root_symlink() {
+  local link="$REPO_ROOT/build_windows.sh"
+  local target="init_tools/build/build_windows.sh"
+
+  if [ -L "$link" ]; then
+    local current resolved
+    current="$(readlink "$link" 2>/dev/null || true)"
+    resolved="$(readlink -f "$link" 2>/dev/null || true)"
+    if [ "$current" = "$target" ] || [ "$resolved" = "$SCRIPT_PATH" ]; then
+      return 0
+    fi
+    log "WARNING: $link points to '${current:-<unknown>}', expected '$target'; leaving it unchanged"
+    return 0
+  fi
+
+  if [ -e "$link" ]; then
+    log "WARNING: $link exists but is not a symlink; leaving it unchanged"
+    return 0
+  fi
+
+  if ln -s "$target" "$link" 2>/dev/null; then
+    log "created symlink: $link -> $target"
+  else
+    log "WARNING: failed to create $link; create it manually with:"
+    log "  ln -s $target build_windows.sh"
+  fi
+}
+
+# ---------------------------------------------------------------------------
+# Main
+# ---------------------------------------------------------------------------
+main() {
+  log "begin time: $(date "+%Y-%m-%d %H:%M:%S")"
+
+  cd "$REPO_ROOT" || exit 1
+
+  resolve_output_dir
+  mkdir -p "$OUTPUT_DIR" || exit 1
+  LOG_FILE="$REPO_ROOT/$OUTPUT_DIR/build.log"
+
+  log "================ windows build ================"
+  log "repo root     : $REPO_ROOT"
+  log "architecture  : $target_cpu"
+  log "build mode    : $build_mode"
+  log "ide           : $win_ide"
+  log "output dir    : $OUTPUT_DIR"
+  log "jobs          : $jobs"
+  log "ccache        : $([ "$no_ccache" == "true" ] && echo disabled || echo enabled)"
+
+  resolve_tools || exit 1
+  setup_build_env
+  handle_ccache_conflicts
+  setup_ccache || exit 1
+
+  ensure_win_toolchain || exit 1
+
+  run_gn_gen || exit 1
+  run_ninja || exit 1
+
+  show_ccache_stats
+
+  cd "$START_DIR" || true
+  log "end time: $(date "+%Y-%m-%d %H:%M:%S")"
+}
+
+ensure_root_symlink
+
+parse_build_params "$@"
+if [ "${PARSE_HELP:-0}" -eq 1 ]; then
+  print_help
+  exit 0
+fi
+
+main
diff --git a/init_tools/build/build_windows_def.sh b/init_tools/build/build_windows_def.sh
new file mode 100755
index 0000000000..c1692e084d
--- /dev/null
+++ b/init_tools/build/build_windows_def.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+#############################################################################
+# build_windows_def.sh
+#
+# Default build parameters for the Windows (target_os="win") build.
+#
+# This file is sourced by build_windows.sh (and by build_windows_help.sh).
+# Every value defined here is used as the fallback when the matching
+# command-line argument is not supplied. See build_windows_help.sh for the
+# full list of accepted arguments and their defaults.
+#############################################################################
+
+# Chromium branch version (used to locate init_tools paths, depot_tools, ...).
+# Prefer the value exported by env.sh, otherwise read chrome/VERSION.
+if [ -z "${M_VERSION:-}" ]; then
+  _THIS_DIR_WIN_DEF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+  M_VERSION="$(sed -n 's/^MAJOR=//p' \
+    "$_THIS_DIR_WIN_DEF/../../chrome/VERSION" 2>/dev/null | head -n 1)"
+  [ -n "$M_VERSION" ] || M_VERSION=150
+  unset _THIS_DIR_WIN_DEF
+fi
+
+# Local directory (or file:// / http(s):// URL) that contains the packaged
+# Windows toolchain, i.e. <local_hash>.zip. See TOOLCHAIN_INFO.txt inside the
+# archive directory for the canonical/local hashes.
+WIN_TOOLCHAIN_BASE_URL_DEFAULT="/workspace/src/win_toolchain_archive/"
+
+# Default target architecture: x64 | x86 | arm64
+WIN_ARCH_DEFAULT=x64
+
+# Default build mode: debug | release
+WIN_BUILD_MODE_DEFAULT=release
+
+# Default IDE project generation. Set to "none" to skip --ide entirely.
+WIN_IDE_DEFAULT=vs2022
+
+# Default ninja targets.
+WIN_TARGETS_RELEASE_DEFAULT="chrome mini_installer base_unittests"
+WIN_TARGETS_DEBUG_DEFAULT="chrome"
+
+# Use the bundled Linux ccache for host and Windows-target compiles by default.
+# Disable with --no-ccache.
+NO_CCACHE_DEFAULT=false
+
+# Extra chromium GN args appended verbatim to the generated args
+# (e.g. "--gn-args='key=value ...'" or "--gn-arg=key=value").
+WIN_EXTRA_GN_ARGS_DEFAULT=""
+
+# Parallel jobs passed to ninja (default: number of CPU cores).
+WIN_BUILD_JOBS_DEFAULT="$(nproc 2>/dev/null || echo 4)"
diff --git a/init_tools/build/build_windows_help.sh b/init_tools/build/build_windows_help.sh
new file mode 100755
index 0000000000..18df06db22
--- /dev/null
+++ b/init_tools/build/build_windows_help.sh
@@ -0,0 +1,191 @@
+#!/usr/bin/env bash
+#############################################################################
+# build_windows_help.sh
+#
+# Handles build parameter input and prints help information.
+#
+# This file can be used in two ways:
+#   * Sourced by build_windows.sh to obtain parse_build_params() and print_help().
+#   * Executed directly (e.g. `./build_windows_help.sh`) to print help only.
+#
+# Defaults come from build_windows_def.sh (loaded automatically from this
+# script's directory).
+#############################################################################
+
+_THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+# Load defaults (idempotent; safe to source more than once).
+if [ -f "$_THIS_DIR/build_windows_def.sh" ]; then
+  # shellcheck source=build_windows_def.sh
+  source "$_THIS_DIR/build_windows_def.sh"
+fi
+
+print_help() {
+  cat <<EOF
+Usage: ./build_windows.sh [options]
+
+Architecture / build mode:
+  --arch=<cpu>               Target architecture: x64 | x86 | arm64
+                             (default: ${WIN_ARCH_DEFAULT})
+  --cpu=<cpu>                Alias of --arch
+  --target_cpu=<cpu>         Alias of --arch
+
+  --mode=<mode>              Build mode: debug | release
+                             (default: ${WIN_BUILD_MODE_DEFAULT})
+  --type=<mode>              Alias of --mode
+  --build-type=<mode>        Alias of --mode
+  --debug                    Shortcut for --mode=debug
+  --release                  Shortcut for --mode=release
+
+Toolchain:
+  --toolchain-base-url=<path>
+                             Windows toolchain archive directory (or a
+                             file:// / http(s):// URL) containing the
+                             <local_hash>.zip toolchain package.
+                             If not given, DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL
+                             is used when set, otherwise:
+                               ${WIN_TOOLCHAIN_BASE_URL_DEFAULT}
+                             The archive is only needed when the installed
+                             toolchain (build/win_toolchain.json) is missing
+                             or stale. In that case the build stops with a
+                             detailed error if the archive directory is
+                             missing or has no usable <local_hash>.zip.
+
+Targets / misc:
+  --target=<name>            Ninja target to build (repeatable).
+  --targets="a b c"          Space-separated list of ninja targets.
+                             (default release: ${WIN_TARGETS_RELEASE_DEFAULT})
+                             (default debug  : ${WIN_TARGETS_DEBUG_DEFAULT})
+  --ide=<name>               GN --ide value: vs2026 | vs2022 | vs | none
+                             (default: ${WIN_IDE_DEFAULT}; "none" skips --ide)
+  --jobs=<n>, -j<n>          Parallel jobs for ninja (default: ${WIN_BUILD_JOBS_DEFAULT})
+  --gn-args="k=v ..."        Extra chromium GN args (can override the defaults)
+  --gn-arg=k=v               Extra chromium GN arg (repeatable, alias of --gn-args)
+  --dir_fix=<suffix>         Extra suffix appended to the output directory
+  --ccache                   Enable ccache (default)
+  --no-ccache                Disable ccache
+
+  -h, --help                 Show this help message
+
+Environment variables:
+  DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL
+                             Toolchain archive directory used when
+                             --toolchain-base-url is not supplied.
+  GYP_MSVS_HASH_<canonical>  Overrides the local toolchain package hash.
+  M_VERSION                  Chromium major version used to locate
+                             init_tools/<version>/depot_tools.
+  CCACHE_DIR                 ccache cache directory (default:
+                             /workspace/.ccache/chromium<M_VERSION>_win)
+
+Output directories:
+  out/win<arch><mode>        winx64r winx64d winx86r winx86d winarm64r winarm64d
+  Additional suffix is appended when --dir_fix is given.
+
+Examples:
+  ./build_windows.sh --release
+  ./build_windows.sh --debug --arch=x64
+  ./build_windows.sh --release --target=chrome
+  ./build_windows.sh --release --targets="chrome mini_installer base_unittests"
+  ./build_windows.sh --release --toolchain-base-url=/data/win_toolchain_archive/
+EOF
+}
+
+# parse_build_params "$@"
+#
+# Populates the following variables (defaults first, then command-line
+# overrides):
+#   target_cpu  build_mode  win_targets  win_ide
+#   win_toolchain_base_url  jobs  extra_gn_args  dir_fix
+#   PARSE_HELP (set to 1 when help was requested or validation failed)
+parse_build_params() {
+  PARSE_HELP=0
+
+  # Start from the defaults defined in build_windows_def.sh.
+  target_cpu="${WIN_ARCH_DEFAULT}"
+  build_mode="${WIN_BUILD_MODE_DEFAULT}"
+  win_ide="${WIN_IDE_DEFAULT}"
+  win_toolchain_base_url=""
+  dir_fix=""
+  jobs="${WIN_BUILD_JOBS_DEFAULT}"
+  extra_gn_args="${WIN_EXTRA_GN_ARGS_DEFAULT}"
+  win_targets=""
+  no_ccache="${NO_CCACHE_DEFAULT}"
+
+  local arg lower_arg
+  while [ $# -gt 0 ]; do
+    arg="$1"; shift
+    lower_arg="$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')"
+    case "$lower_arg" in
+      -h|--help)                    PARSE_HELP=1 ;;
+      --arch=*|--cpu=*|--target_cpu=*)
+                                    target_cpu="${arg#*=}" ;;
+      --mode=*|--type=*|--build-type=*)
+                                    build_mode="${arg#*=}" ;;
+      --debug)                      build_mode=debug ;;
+      --release)                    build_mode=release ;;
+      --toolchain-base-url=*|--win-toolchain-base-url=*)
+                                    win_toolchain_base_url="${arg#*=}" ;;
+      --target=*)
+                                    win_targets="${win_targets:+${win_targets} }${arg#*=}" ;;
+      --targets=*)
+                                    win_targets="${win_targets:+${win_targets} }${arg#*=}" ;;
+      --ide=*)                      win_ide="${arg#*=}" ;;
+      --dir_fix=*)                  dir_fix="${arg#*=}" ;;
+      --ccache)                     no_ccache=false ;;
+      --no-ccache)                  no_ccache=true ;;
+      --jobs=*)                     jobs="${arg#*=}" ;;
+      --jobs)                       jobs="${1:-}"; shift ;;
+      --gn-args=*)                  extra_gn_args="${extra_gn_args:+${extra_gn_args} }${arg#*=}" ;;
+      --gn-arg=*)                   extra_gn_args="${extra_gn_args:+${extra_gn_args} }${arg#*=}" ;;
+      -j=*)                         jobs="${arg#*=}" ;;
+      -j[0-9]*)                     jobs="${arg#-j}" ;;
+      -j)                           jobs="${1:-}"; shift ;;
+      *)                            echo "WARNING: unknown option ignored: $arg" >&2 ;;
+    esac
+  done
+
+  # Normalise case-sensitive values.
+  target_cpu="$(printf '%s' "$target_cpu" | tr '[:upper:]' '[:lower:]')"
+  build_mode="$(printf '%s' "$build_mode" | tr '[:upper:]' '[:lower:]')"
+  win_ide="$(printf '%s' "$win_ide" | tr '[:upper:]' '[:lower:]')"
+
+  # Validate architecture.
+  case "$target_cpu" in
+    x64|x86|arm64) ;;
+    *)
+      echo "ERROR: unsupported architecture '$target_cpu' (x64|x86|arm64)" >&2
+      PARSE_HELP=1
+      ;;
+  esac
+
+  # Validate build mode.
+  case "$build_mode" in
+    debug|release) ;;
+    *)
+      echo "ERROR: unsupported build mode '$build_mode' (debug|release)" >&2
+      PARSE_HELP=1
+      ;;
+  esac
+
+  # Fall back to the mode-specific default target list.
+  if [ -z "$win_targets" ]; then
+    case "$build_mode" in
+      debug)   win_targets="$WIN_TARGETS_DEBUG_DEFAULT" ;;
+      release) win_targets="$WIN_TARGETS_RELEASE_DEFAULT" ;;
+    esac
+  fi
+
+  # Deprecated / unsupported IDE values are only rejected when clearly wrong.
+  case "$win_ide" in
+    ""|none|vs|vs2019|vs2022|vs2026) ;;
+    *)
+      echo "WARNING: unknown --ide value '$win_ide' (vs2026|vs2022|vs|none)" >&2
+      ;;
+  esac
+}
+
+# When executed directly, just print the help text.
+if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
+  print_help
+  exit 0
+fi
