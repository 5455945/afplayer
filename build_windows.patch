+def _NormalizeToolchainPath(path):
+  """Resolves a path from win_toolchain.json to an absolute path.
+
+  depot_tools writes absolute paths, but paths relative to the Chromium source
+  root are also accepted. Keeping the generated json relative makes it stable
+  when the checkout is moved or renamed.
+  """
+  if not path:
+    return path
+  if os.path.isabs(path):
+    return os.path.normpath(path)
+  return os.path.normpath(os.path.join(os.path.dirname(script_dir), path))
+
+
+def _RelativizeToolchainJson():
+  """Rewrites paths inside the checkout as relative to the source root.
+
+  The file is generated by depot_tools with absolute paths. Storing paths
+  relative to the source root keeps the tracked file unchanged when the
+  checkout is moved or renamed.
+  """
+  if not os.path.exists(json_data_file):
+    return
+
+  repo_root = os.path.dirname(script_dir)
+
+  def to_relative(path):
+    if not path:
+      return path
+    absolute = path if os.path.isabs(path) else os.path.join(repo_root, path)
+    absolute = os.path.normpath(absolute)
+    try:
+      rel = os.path.relpath(absolute, repo_root)
+    except ValueError:
+      # Different drive on Windows.
+      return absolute
+    if rel == os.pardir or rel.startswith(os.pardir + os.sep):
+      return absolute
+    return rel
+
+  try:
+    with open(json_data_file, 'r') as f:
+      data = json.load(f)
+  except Exception:
+    return
+
+  changed = False
+  for key in ('path', 'win_sdk', 'wdk'):
+    if data.get(key):
+      new_value = to_relative(data[key])
+      if new_value != data[key]:
+        data[key] = new_value
+        changed = True
+  if isinstance(data.get('runtime_dirs'), list):
+    new_dirs = [to_relative(p) for p in data['runtime_dirs']]
+    if new_dirs != data['runtime_dirs']:
+      data['runtime_dirs'] = new_dirs
+      changed = True
+
+  if changed:
+    with open(json_data_file, 'w') as f:
+      json.dump(data, f, indent=2)
+      f.write('\n')
+
+
+def _ToolchainPathsExist(toolchain_data):
+  """Returns whether the paths in win_toolchain.json exist on disk."""
+  paths = [toolchain_data.get('path'), toolchain_data.get('win_sdk')]
+  paths.extend(toolchain_data.get('runtime_dirs') or [])
+  for path in paths:
+    if path and not os.path.exists(_NormalizeToolchainPath(path)):
+      return False
+  return True
+
