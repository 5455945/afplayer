index 0000000000..44e994a457
--- /dev/null
+++ b/tools/afree-login-service/src/pb.mjs
@@ -0,0 +1,298 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Minimal protobuf wire-format reader/writer.
+//
+// The sync protocol (components/sync/protocol/*.proto) is protobuf over HTTP.
+// Rather than depending on a protobuf runtime and a codegen step, this module
+// implements the wire format directly and treats most nested messages as
+// opaque byte blobs. Only the fields the server actually needs are decoded;
+// everything else (per-datatype `specifics`, unique positions, ...) is stored
+// and echoed back verbatim, which keeps the server datatype-agnostic.
+
+export const WIRE_VARINT = 0;
+export const WIRE_FIXED64 = 1;
+export const WIRE_LENGTH = 2;
+export const WIRE_START_GROUP = 3;
+export const WIRE_END_GROUP = 4;
+export const WIRE_FIXED32 = 5;
+
+/**
+ * Encodes a non-negative integer as a varint.
+ * @param {number|bigint} value
+ * @returns {Buffer}
+ */
+export function encodeVarint(value) {
+  let remaining = typeof value === 'bigint' ? value : BigInt(Math.trunc(value));
+  if (remaining < 0n) {
+    throw new RangeError(`negative varint: ${value}`);
+  }
+  const bytes = [];
+  while (remaining >= 0x80n) {
+    bytes.push(Number(remaining & 0x7fn) | 0x80);
+    remaining >>= 7n;
+  }
+  bytes.push(Number(remaining));
+  return Buffer.from(bytes);
+}
+
+function tag(fieldNumber, wireType) {
+  return encodeVarint((BigInt(fieldNumber) << 3n) | BigInt(wireType));
+}
+
+export class Writer {
+  constructor() {
+    /** @type {Buffer[]} */
+    this.parts = [];
+  }
+
+  /** @param {Buffer} bytes */
+  raw(bytes) {
+    this.parts.push(bytes);
+    return this;
+  }
+
+  /** @param {number} field @param {number|bigint} value */
+  varint(field, value) {
+    this.parts.push(tag(field, WIRE_VARINT), encodeVarint(value));
+    return this;
+  }
+
+  /** @param {number} field @param {boolean} value */
+  bool(field, value) {
+    return this.varint(field, value ? 1 : 0);
+  }
+
+  /** @param {number} field @param {string} value */
+  string(field, value) {
+    const data = Buffer.from(value, 'utf8');
+    this.parts.push(
+        tag(field, WIRE_LENGTH), encodeVarint(data.length), data);
+    return this;
+  }
+
+  /** @param {number} field @param {Buffer} value */
+  bytes(field, value) {
+    this.parts.push(
+        tag(field, WIRE_LENGTH), encodeVarint(value.length), value);
+    return this;
+  }
+
+  /** @param {number} field @param {Buffer} message */
+  message(field, message) {
+    return this.bytes(field, message);
+  }
+
+  /**
+   * Emits a proto2 `group` (used by CommitResponse.EntryResponse).
+   * @param {number} field
+   * @param {(writer: Writer) => void} body
+   */
+  group(field, body) {
+    this.parts.push(tag(field, WIRE_START_GROUP));
+    body(this);
+    this.parts.push(tag(field, WIRE_END_GROUP));
+    return this;
+  }
+
+  /** @returns {Buffer} */
+  finish() {
+    return Buffer.concat(this.parts);
+  }
+}
+
+/**
+ * @typedef {object} Field
+ * @property {number} field
+ * @property {number} wireType
+ * @property {Buffer|number|bigint} value
+ */
+
+/**
+ * Reads the top-level fields of a message.
+ * @param {Buffer} buffer
+ * @returns {Field[]}
+ */
+export function readFields(buffer) {
+  /** @type {Field[]} */
+  const fields = [];
+  let offset = 0;
+  while (offset < buffer.length) {
+    let fieldTag;
+    [fieldTag, offset] = readVarintNumber(buffer, offset);
+    const field = Math.floor(fieldTag / 8);
+    const wireType = fieldTag & 0x7;
+    if (field === 0) {
+      throw new RangeError('invalid field number 0');
+    }
+    switch (wireType) {
+      case WIRE_VARINT: {
+        let value;
+        [value, offset] = readVarintNumber(buffer, offset);
+        fields.push({field, wireType, value});
+        break;
+      }
+      case WIRE_FIXED64: {
+        if (offset + 8 > buffer.length) {
+          throw new RangeError('truncated fixed64');
+        }
+        fields.push({field, wireType, value: buffer.subarray(offset, offset + 8)});
+        offset += 8;
+        break;
+      }
+      case WIRE_LENGTH: {
+        let length;
+        [length, offset] = readVarintNumber(buffer, offset);
+        if (offset + length > buffer.length) {
+          throw new RangeError('truncated length-delimited field');
+        }
+        fields.push({
+          field,
+          wireType,
+          value: buffer.subarray(offset, offset + length),
+        });
+        offset += length;
+        break;
+      }
+      case WIRE_FIXED32: {
+        if (offset + 4 > buffer.length) {
+          throw new RangeError('truncated fixed32');
+        }
+        fields.push({field, wireType, value: buffer.subarray(offset, offset + 4)});
+        offset += 4;
+        break;
+      }
+      case WIRE_START_GROUP: {
+        // Capture the group body so callers can decode proto2 groups
+        // (CommitResponse.EntryResponse uses one).
+        const bodyStart = offset;
+        const endTag = (field << 3) | WIRE_END_GROUP;
+        for (;;) {
+          let innerTag;
+          const innerTagStart = offset;
+          [innerTag, offset] = readVarintNumber(buffer, offset);
+          if (innerTag === endTag) {
+            fields.push({
+              field,
+              wireType,
+              value: buffer.subarray(bodyStart, innerTagStart),
+            });
+            break;
+          }
+          const innerWire = innerTag & 0x7;
+          if (innerWire === WIRE_VARINT) {
+            [, offset] = readVarintNumber(buffer, offset);
+          } else if (innerWire === WIRE_LENGTH) {
+            let length;
+            [length, offset] = readVarintNumber(buffer, offset);
+            offset += length;
+          } else if (innerWire === WIRE_FIXED32) {
+            offset += 4;
+          } else if (innerWire === WIRE_FIXED64) {
+            offset += 8;
+          } else {
+            throw new RangeError(`invalid wire type ${innerWire} in group`);
+          }
+          if (offset > buffer.length) {
+            throw new RangeError('truncated group');
+          }
+        }
+        break;
+      }
+      case WIRE_END_GROUP:
+        // End tags are consumed by the group loop above.
+        throw new RangeError('unexpected end-group tag');
+      default:
+        throw new RangeError(`unsupported wire type ${wireType}`);
+    }
+  }
+  return fields;
+}
+
+function readVarintNumber(buffer, offset) {
+  let value = 0;
+  let multiplier = 1;
+  let index = offset;
+  for (;;) {
+    if (index >= buffer.length) {
+      throw new RangeError('truncated varint');
+    }
+    const byte = buffer[index++];
+    value += (byte & 0x7f) * multiplier;
+    if ((byte & 0x80) === 0) {
+      return [value, index];
+    }
+    multiplier *= 128;
+    if (multiplier > Number.MAX_SAFE_INTEGER) {
+      throw new RangeError('varint too large');
+    }
+  }
+}
+
+/** @param {Field[]} fields @param {number} field @param {number} [wireType] */
+export function fieldValues(fields, field, wireType = WIRE_LENGTH) {
+  return fields
+      .filter((entry) => entry.field === field && entry.wireType === wireType)
+      .map((entry) => entry.value);
+}
+
+/** @param {Field[]} fields @param {number} field @param {number} [wireType] */
+export function firstField(fields, field, wireType = WIRE_LENGTH) {
+  const match =
+      fields.find((entry) => entry.field === field && entry.wireType === wireType);
+  return match ? match.value : null;
+}
+
+/** @param {Field[]} fields @param {number} field */
+export function firstNumber(fields, field) {
+  const value = firstField(fields, field, WIRE_VARINT);
+  return value === null ? null : Number(value);
+}
+
+/** @param {Field[]} fields @param {number} field */
+export function firstString(fields, field) {
+  const value = firstField(fields, field, WIRE_LENGTH);
+  return value === null ? null : value.toString('utf8');
+}
+
+/** @param {Field[]} fields @param {number} field */
+export function firstBool(fields, field) {
+  const value = firstNumber(fields, field);
+  return value === null ? null : value !== 0;
+}
+
+/** @param {Buffer} buffer */
+export function decodeMessage(buffer) {
+  return readFields(buffer);
+}
+
+/**
+ * Returns the field number of the first field of `EntitySpecifics`, which is
+ * how Chromium identifies a datatype (`specifics_variant_case()`).
+ * @param {Buffer} specifics
+ */
+export function entitySpecificsType(specifics) {
+  if (!specifics || specifics.length === 0) {
+    return 0;
+  }
+  try {
+    for (const entry of readFields(specifics)) {
+      return entry.field;
+    }
+  } catch {
+    return 0;
+  }
+  return 0;
+}
+
+/**
+ * Builds an `EntitySpecifics` with the datatype's oneof field present but
+ * empty, e.g. for tombstones and permanent folders.
+ * @param {number} dataType  EntitySpecifics field number
+ */
+export function defaultSpecifics(dataType) {
+  const writer = new Writer();
+  writer.message(dataType, Buffer.alloc(0));
+  return writer.finish();
+}
