+-- ---------------------------------------------------------------- Chrome Sync
+--
+-- One row per account that has used the sync endpoint. `next_version` is a
+-- per-account monotonic counter shared by all datatypes; clients compare
+-- entity versions against the progress tokens issued by GetUpdates.
+CREATE TABLE IF NOT EXISTS sync_stores (
+  user_id        TEXT PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
+  store_birthday TEXT NOT NULL,
+  next_version   INTEGER NOT NULL DEFAULT 0,
+  -- 16 random bytes returned in GetUpdatesResponse.encryption_keys.
+  keystore_key   BLOB,
+  created_at     INTEGER NOT NULL
+) STRICT;
+
+-- Sync entities. `specifics` is the opaque EntitySpecifics payload, so the
+-- same table stores bookmarks, preferences, nigori, ... without the server
+-- having to understand each datatype.
+CREATE TABLE IF NOT EXISTS sync_entities (
+  user_id                   TEXT NOT NULL,
+  id                        TEXT NOT NULL,
+  -- EntitySpecifics field number (BOOKMARKS = 32904, NIGORI = 47745, ...).
+  data_type                 INTEGER NOT NULL,
+  parent_id                 TEXT NOT NULL DEFAULT '0',
+  name                      TEXT NOT NULL DEFAULT '',
+  version                   INTEGER NOT NULL,
+  ctime                     INTEGER NOT NULL DEFAULT 0,
+  mtime                     INTEGER NOT NULL DEFAULT 0,
+  deleted                   INTEGER NOT NULL DEFAULT 0,
+  folder                    INTEGER NOT NULL DEFAULT 0,
+  specifics                 BLOB,
+  client_tag_hash           TEXT NOT NULL DEFAULT '',
+  unique_position           BLOB,
+  originator_cache_guid     TEXT NOT NULL DEFAULT '',
+  originator_client_item_id TEXT NOT NULL DEFAULT '',
+  -- Non-empty only for server-created permanent entities (roots and the
+  -- bookmark folders), which clients match by this tag.
+  server_tag                TEXT NOT NULL DEFAULT '',
+  PRIMARY KEY (user_id, id)
+) STRICT;
+
+CREATE INDEX IF NOT EXISTS sync_entities_by_type
+  ON sync_entities(user_id, data_type, version);
+
