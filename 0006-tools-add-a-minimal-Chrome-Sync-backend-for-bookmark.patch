diff --git a/tools/afree-login-service/src/sync-store.mjs b/tools/afree-login-service/src/sync-store.mjs
new file mode 100644
index 0000000000..b22847ac4d
--- /dev/null
+++ b/tools/afree-login-service/src/sync-store.mjs
@@ -0,0 +1,306 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {randomBytes} from 'node:crypto';
+import {defaultSpecifics} from './pb.mjs';
+
+export const BOOKMARKS_TYPE = 32904;
+export const NIGORI_TYPE = 47745;
+
+// Root tags follow syncer::DataTypeToProtocolRootTag() in
+// components/sync/base/data_type.cc: "google_chrome_" + stable lowercase name.
+const BOOKMARKS_ROOT_TAG = 'google_chrome_bookmarks';
+const NIGORI_ROOT_TAG = 'google_chrome_nigori';
+
+/**
+ * Permanent entities that Chromium expects to exist in every sync store.
+ * Mirrors CreateDefaultPermanentItems() and CreatePermanentBookmarkFolder()
+ * in components/sync/engine/loopback_server/loopback_server.cc.
+ *
+ * @type {{id: string, dataType: number, parentId: string, name: string,
+ *         folder: boolean, serverTag: string}[]}
+ */
+const PERMANENT_ENTITIES = [
+  {
+    id: `${BOOKMARKS_TYPE}_${BOOKMARKS_ROOT_TAG}`,
+    dataType: BOOKMARKS_TYPE,
+    parentId: '0',
+    name: 'Bookmarks',
+    folder: true,
+    serverTag: BOOKMARKS_ROOT_TAG,
+  },
+  {
+    id: `${BOOKMARKS_TYPE}_bookmark_bar`,
+    dataType: BOOKMARKS_TYPE,
+    parentId: `${BOOKMARKS_TYPE}_${BOOKMARKS_ROOT_TAG}`,
+    name: 'Bookmark Bar',
+    folder: true,
+    serverTag: 'bookmark_bar',
+  },
+  {
+    id: `${BOOKMARKS_TYPE}_other_bookmarks`,
+    dataType: BOOKMARKS_TYPE,
+    parentId: `${BOOKMARKS_TYPE}_${BOOKMARKS_ROOT_TAG}`,
+    name: 'Other Bookmarks',
+    folder: true,
+    serverTag: 'other_bookmarks',
+  },
+  {
+    id: `${BOOKMARKS_TYPE}_synced_bookmarks`,
+    dataType: BOOKMARKS_TYPE,
+    parentId: `${BOOKMARKS_TYPE}_${BOOKMARKS_ROOT_TAG}`,
+    name: 'Synced Bookmarks',
+    folder: true,
+    serverTag: 'synced_bookmarks',
+  },
+  {
+    id: `${NIGORI_TYPE}_${NIGORI_ROOT_TAG}`,
+    dataType: NIGORI_TYPE,
+    parentId: '0',
+    name: 'Encryption Keys',
+    folder: true,
+    serverTag: NIGORI_ROOT_TAG,
+  },
+];
+
+/**
+ * Sync storage on top of the shared SQLite database.
+ */
+export class SyncStore {
+  /** @param {import('./db.mjs').Store} store */
+  constructor(store) {
+    this.db = store.db;
+  }
+
+  /** @param {string} userId */
+  get(userId) {
+    return this.db
+               .prepare('SELECT * FROM sync_stores WHERE user_id = ?')
+               .get(userId) ??
+        null;
+  }
+
+  /**
+   * Creates the store (birthday, keystore key, permanent entities) on first
+   * use. Idempotent.
+   * @param {string} userId
+   */
+  ensure(userId) {
+    const existing = this.get(userId);
+    if (existing) {
+      return existing;
+    }
+    this.db.exec('BEGIN IMMEDIATE');
+    try {
+      // Another process could have created it between the SELECT and BEGIN.
+      const second = this.get(userId);
+      if (second) {
+        this.db.exec('COMMIT');
+        return second;
+      }
+      const now = Math.floor(Date.now() / 1000);
+      this.db
+          .prepare(
+              'INSERT INTO sync_stores(' +
+              'user_id, store_birthday, next_version, keystore_key, created_at' +
+              ') VALUES(?, ?, 0, ?, ?)')
+          .run(
+              userId,
+              randomBytes(16).toString('hex'),
+              randomBytes(16),
+              now,
+          );
+      for (const permanent of PERMANENT_ENTITIES) {
+        this.savePermanent(userId, permanent, now * 1000);
+      }
+      this.db.exec('COMMIT');
+    } catch (error) {
+      this.db.exec('ROLLBACK');
+      throw error;
+    }
+    return this.get(userId);
+  }
+
+  /**
+   * @param {string} userId
+   * @param {(typeof PERMANENT_ENTITIES)[number]} permanent
+   * @param {number} nowMs
+   */
+  savePermanent(userId, permanent, nowMs) {
+    this.save({
+      userId,
+      id: permanent.id,
+      dataType: permanent.dataType,
+      parentId: permanent.parentId,
+      name: permanent.name,
+      ctime: nowMs,
+      mtime: nowMs,
+      deleted: false,
+      folder: permanent.folder,
+      specifics: defaultSpecifics(permanent.dataType),
+      clientTagHash: '',
+      uniquePosition: null,
+      originatorCacheGuid: '',
+      originatorClientItemId: '',
+      serverTag: permanent.serverTag,
+    });
+  }
+
+  /**
+   * Allocates the next version for an account. Node's sqlite bindings are
+   * synchronous and the server is single-threaded, so the read after the
+   * update cannot race with another writer in this process.
+   * @param {string} userId
+   */
+  allocateVersion(userId) {
+    this.db
+        .prepare(
+            'UPDATE sync_stores SET next_version = next_version + 1 ' +
+            'WHERE user_id = ?')
+        .run(userId);
+    const row = this.db
+                    .prepare('SELECT next_version FROM sync_stores WHERE user_id = ?')
+                    .get(userId);
+    return row.next_version;
+  }
+
+  /**
+   * Inserts or updates an entity with a freshly allocated version.
+   * @param {object} entity
+   * @param {string} entity.userId
+   * @param {string} entity.id
+   * @param {number} entity.dataType
+   * @param {string} entity.parentId
+   * @param {string} entity.name
+   * @param {number} entity.ctime
+   * @param {number} entity.mtime
+   * @param {boolean} entity.deleted
+   * @param {boolean} entity.folder
+   * @param {Buffer} entity.specifics
+   * @param {string} entity.clientTagHash
+   * @param {Buffer|null} entity.uniquePosition
+   * @param {string} entity.originatorCacheGuid
+   * @param {string} entity.originatorClientItemId
+   * @param {string} entity.serverTag
+   * @returns {number} the new version
+   */
+  save(entity) {
+    const version = this.allocateVersion(entity.userId);
+    this.db
+        .prepare(
+            'INSERT INTO sync_entities(' +
+            'user_id, id, data_type, parent_id, name, version, ctime, mtime,' +
+            ' deleted, folder, specifics, client_tag_hash, unique_position,' +
+            ' originator_cache_guid, originator_client_item_id, server_tag' +
+            ') VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ' +
+            'ON CONFLICT(user_id, id) DO UPDATE SET ' +
+            'data_type = excluded.data_type, parent_id = excluded.parent_id,' +
+            ' name = excluded.name, version = excluded.version,' +
+            ' ctime = excluded.ctime, mtime = excluded.mtime,' +
+            ' deleted = excluded.deleted, folder = excluded.folder,' +
+            ' specifics = excluded.specifics,' +
+            ' client_tag_hash = excluded.client_tag_hash,' +
+            ' unique_position = excluded.unique_position,' +
+            ' originator_cache_guid = excluded.originator_cache_guid,' +
+            ' originator_client_item_id = excluded.originator_client_item_id,' +
+            ' server_tag = excluded.server_tag')
+        .run(
+            entity.userId,
+            entity.id,
+            entity.dataType,
+            entity.parentId ?? '',
+            entity.name ?? '',
+            version,
+            entity.ctime ?? 0,
+            entity.mtime ?? 0,
+            entity.deleted ? 1 : 0,
+            entity.folder ? 1 : 0,
+            entity.specifics ?? Buffer.alloc(0),
+            entity.clientTagHash ?? '',
+            entity.uniquePosition ?? null,
+            entity.originatorCacheGuid ?? '',
+            entity.originatorClientItemId ?? '',
+            entity.serverTag ?? '',
+        );
+    return version;
+  }
+
+  /** @param {string} userId @param {string} id */
+  entity(userId, id) {
+    return this.db
+               .prepare(
+                   'SELECT * FROM sync_entities WHERE user_id = ? AND id = ?')
+               .get(userId, id) ??
+        null;
+  }
+
+  /**
+   * Returns entities of one datatype newer than `sinceVersion`, oldest first.
+   * @param {string} userId
+   * @param {number} dataType
+   * @param {number} sinceVersion
+   * @param {number} limit
+   * @param {boolean} includeDeleted
+   */
+  list(userId, dataType, sinceVersion, limit, includeDeleted) {
+    return this.db
+        .prepare(
+            'SELECT * FROM sync_entities WHERE user_id = ? AND data_type = ?' +
+            ' AND version > ? AND (? = 1 OR deleted = 0)' +
+            ' ORDER BY version ASC LIMIT ?')
+        .all(userId, dataType, sinceVersion, includeDeleted ? 1 : 0, limit);
+  }
+
+  /**
+   * @param {string} userId
+   * @param {number} dataType
+   * @param {number} sinceVersion
+   * @param {boolean} includeDeleted
+   */
+  countAfter(userId, dataType, sinceVersion, includeDeleted) {
+    const row = this.db
+                    .prepare(
+                        'SELECT COUNT(*) AS count FROM sync_entities ' +
+                        'WHERE user_id = ? AND data_type = ? AND version > ?' +
+                        ' AND (? = 1 OR deleted = 0)')
+                    .get(userId, dataType, sinceVersion, includeDeleted ? 1 : 0);
+    return row.count;
+  }
+
+  /**
+   * Handles ClearServerData: drop all entities, rotate the birthday and
+   * recreate the permanent entities.
+   * @param {string} userId
+   */
+  clear(userId) {
+    this.db.exec('BEGIN IMMEDIATE');
+    try {
+      this.db
+          .prepare('DELETE FROM sync_entities WHERE user_id = ?')
+          .run(userId);
+      this.db
+          .prepare(
+              'UPDATE sync_stores SET store_birthday = ?, next_version = 0 ' +
+              'WHERE user_id = ?')
+          .run(randomBytes(16).toString('hex'), userId);
+      this.db.exec('COMMIT');
+    } catch (error) {
+      this.db.exec('ROLLBACK');
+      throw error;
+    }
+    // Recreate the permanent entities with fresh versions. The row already
+    // exists, so ensure() would return early; do it explicitly.
+    this.db.exec('BEGIN IMMEDIATE');
+    try {
+      const now = Date.now();
+      for (const permanent of PERMANENT_ENTITIES) {
+        this.savePermanent(userId, permanent, now);
+      }
+      this.db.exec('COMMIT');
+    } catch (error) {
+      this.db.exec('ROLLBACK');
+      throw error;
+    }
+  }
+}
diff --git a/tools/afree-login-service/src/sync.mjs b/tools/afree-login-service/src/sync.mjs
new file mode 100644
index 0000000000..870852217c
--- /dev/null
+++ b/tools/afree-login-service/src/sync.mjs
@@ -0,0 +1,655 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Minimal Chrome Sync server (`/command/`).
+//
+// Chromium posts a gzip-compressed `sync_pb::ClientToServerMessage` to
+// `<sync-url>/command/` and expects a `sync_pb::ClientToServerResponse`:
+//
+//   components/sync/engine/net/http_bridge.cc        request/response transport
+//   components/sync/engine/net/sync_server_connection_manager.cc
+//   components/sync/engine/sync_manager_impl.cc      "/command/" path
+//   components/sync/protocol/sync.proto              message shapes
+//   components/sync/protocol/sync_entity.proto       SyncEntity
+//   components/sync/engine/loopback_server/          reference implementation
+//
+// The implementation below is datatype-agnostic: `EntitySpecifics` payloads are
+// stored as opaque blobs and echoed back. That is enough for bookmarks (and in
+// practice for preferences/theme/extensions as well) because Chromium never
+// asks the server to interpret the payload - it only relies on the ids,
+// versions, parent hierarchy, `folder`/`deleted` flags and progress tokens.
+//
+// Datatypes are keyed by their `EntitySpecifics` field number:
+//   BOOKMARKS = 32904    (components/sync/protocol/entity_specifics.proto)
+//   NIGORI    = 47745
+
+import {randomUUID} from 'node:crypto';
+import {gunzipSync, inflateSync} from 'node:zlib';
+import {
+  WIRE_LENGTH,
+  Writer,
+  defaultSpecifics,
+  entitySpecificsType,
+  fieldValues,
+  firstBool,
+  firstField,
+  firstNumber,
+  firstString,
+  readFields,
+} from './pb.mjs';
+import {BOOKMARKS_TYPE, NIGORI_TYPE, SyncStore} from './sync-store.mjs';
+
+const MAX_BODY_BYTES = 64 * 1024 * 1024;
+const MAX_GET_UPDATES_BATCH = 500;
+
+// sync_pb::CommitResponse::ResponseType
+const COMMIT_SUCCESS = 1;
+const COMMIT_INVALID_MESSAGE = 4;
+
+// sync_pb::SyncEnums::ErrorType
+const ERROR_SUCCESS = 0;
+const ERROR_NOT_MY_BIRTHDAY = 2;
+const ERROR_UNKNOWN = 100;
+
+// sync_pb::NigoriSpecifics::PassphraseType
+const KEYSTORE_PASSPHRASE = 2;
+const NIGORI_PASSPHRASE_TYPE_FIELD = 30;
+
+// ClientToServerMessage::Contents
+const CONTENTS_COMMIT = 1;
+const CONTENTS_GET_UPDATES = 2;
+const CONTENTS_CLEAR_SERVER_DATA = 5;
+
+/** @param {unknown} value */
+function toBuffer(value) {
+  if (!value) {
+    return null;
+  }
+  return Buffer.isBuffer(value) ? value : Buffer.from(/** @type {any} */ (value));
+}
+
+function pathnameOf(req) {
+  try {
+    return new URL(req.url ?? '/', 'http://localhost').pathname;
+  } catch {
+    return '';
+  }
+}
+
+/** @param {import('node:http').IncomingMessage} req */
+function bearerToken(req) {
+  const header = String(req.headers.authorization ?? '');
+  const match = /^Bearer\s+(.+)$/i.exec(header);
+  return match ? match[1].trim() : null;
+}
+
+/**
+ * Progress tokens are opaque to the client. This server uses the decimal
+ * version of the newest entity it has sent; loopback-style "<migration>/<v>"
+ * tokens are accepted too.
+ * @param {string} token
+ */
+function parseProgressToken(token) {
+  if (!token) {
+    return 0;
+  }
+  const tail = String(token).split('/').pop() ?? '0';
+  const value = Number(tail);
+  return Number.isFinite(value) && value >= 0 ? Math.trunc(value) : 0;
+}
+
+/**
+ * @param {Uint8Array|Buffer|null} specifics
+ * @returns {number} passphrase type from NigoriSpecifics
+ */
+function nigoriPassphraseType(specifics) {
+  const buffer = toBuffer(specifics);
+  if (!buffer || buffer.length === 0) {
+    return 1;
+  }
+  try {
+    const outer = readFields(buffer);
+    const nigori = firstField(outer, NIGORI_TYPE, WIRE_LENGTH);
+    if (!nigori) {
+      return 1;
+    }
+    return firstNumber(readFields(toBuffer(nigori)), NIGORI_PASSPHRASE_TYPE_FIELD) ??
+        1;
+  } catch {
+    return 1;
+  }
+}
+
+/**
+ * @param {import('node:http').IncomingMessage} req
+ */
+async function readRequestBody(req) {
+  /** @type {Buffer[]} */
+  const chunks = [];
+  let total = 0;
+  for await (const chunk of req) {
+    total += chunk.length;
+    if (total > MAX_BODY_BYTES) {
+      const error = new Error('sync request too large');
+      // @ts-ignore
+      error.statusCode = 413;
+      throw error;
+    }
+    chunks.push(chunk);
+  }
+  let body = Buffer.concat(chunks);
+  const encoding = String(req.headers['content-encoding'] ?? '').toLowerCase();
+  if (encoding.includes('gzip')) {
+    body = gunzipSync(body);
+  } else if (encoding.includes('deflate')) {
+    body = inflateSync(body);
+  }
+  return body;
+}
+
+export class SyncService {
+  /**
+   * @param {object} options
+   * @param {import('./db.mjs').Store} options.store
+   * @param {import('./config.mjs').Config} options.config
+   * @param {ReturnType<import('./config.mjs').createLogger>} options.logger
+   */
+  constructor({store, config, logger}) {
+    this.store = store;
+    this.config = config;
+    this.logger = logger;
+    this.syncStore = new SyncStore(store);
+  }
+
+  /** @param {import('node:http').IncomingMessage} req */
+  handles(req) {
+    const path = pathnameOf(req);
+    // Accept any prefix so both `--sync-url=http://host:8080` (which becomes
+    // /command/) and Chromium's default dev URL (<host>/chrome-sync/dev/command/)
+    // work without extra configuration.
+    return /(^|\/)command\/?$/.test(path) || /(^|\/)event\/?$/.test(path);
+  }
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   */
+  async handle(req, res) {
+    const path = pathnameOf(req);
+    try {
+      if (req.method !== 'POST') {
+        res.writeHead(405, {'Allow': 'POST'});
+        res.end();
+        return;
+      }
+
+      const body = await readRequestBody(req);
+
+      // /event is only used by SyncStoppedReporter; the response is empty.
+      if (path.endsWith('/event') || path.endsWith('/event/')) {
+        res.writeHead(200, {
+          'Content-Type': 'application/octet-stream',
+          'Cache-Control': 'no-store',
+        });
+        res.end();
+        return;
+      }
+
+      const token = bearerToken(req);
+      const access = token ? this.store.getAccessToken(token) : null;
+      const user = access ? this.store.getUserById(access.user_id) : null;
+      if (!user || user.disabled) {
+        res.writeHead(401, {
+          'WWW-Authenticate': 'Bearer',
+          'Content-Type': 'text/plain; charset=utf-8',
+        });
+        res.end('unauthorized');
+        return;
+      }
+
+      let requestFields;
+      try {
+        requestFields = readFields(body);
+      } catch (error) {
+        this.logger.warn('sync: malformed request', {
+          error: String(error?.message ?? error),
+        });
+        res.writeHead(400, {'Content-Type': 'text/plain; charset=utf-8'});
+        res.end('malformed sync request');
+        return;
+      }
+
+      const response = this.dispatch(user, requestFields);
+      res.writeHead(200, {
+        'Content-Type': 'application/octet-stream',
+        'Cache-Control': 'no-store',
+        'Content-Length': response.length,
+      });
+      res.end(response);
+    } catch (error) {
+      const status = /** @type {any} */ (error)?.statusCode ?? 500;
+      this.logger.error('sync request failed', {
+        path,
+        error: String(/** @type {any} */ (error)?.stack ?? error),
+      });
+      if (!res.headersSent) {
+        res.writeHead(status, {'Content-Type': 'text/plain; charset=utf-8'});
+      }
+      res.end(status === 413 ? 'payload too large' : 'internal error');
+    }
+  }
+
+  /**
+   * @param {any} user
+   * @param {import('./pb.mjs').Field[]} fields
+   * @returns {Buffer}
+   */
+  dispatch(user, fields) {
+    const contents = firstNumber(fields, 3) ?? 0;
+    const clientBirthday = firstString(fields, 7) ?? '';
+    let sync = this.syncStore.ensure(user.id);
+
+    const response = new Writer();
+    let errorCode = ERROR_SUCCESS;
+    let errorMessage = '';
+
+    if (clientBirthday && clientBirthday !== sync.store_birthday) {
+      // Chromium treats this as "clear local sync metadata and start over".
+      errorCode = ERROR_NOT_MY_BIRTHDAY;
+      errorMessage = 'store birthday mismatch';
+    } else if (contents === CONTENTS_GET_UPDATES) {
+      const message = firstField(fields, 5, WIRE_LENGTH);
+      if (!message) {
+        errorCode = ERROR_UNKNOWN;
+        errorMessage = 'missing get_updates';
+      } else {
+        response.message(
+            2, this.handleGetUpdates(user.id, toBuffer(message), sync));
+      }
+    } else if (contents === CONTENTS_COMMIT) {
+      const message = firstField(fields, 4, WIRE_LENGTH);
+      if (!message) {
+        errorCode = ERROR_UNKNOWN;
+        errorMessage = 'missing commit';
+      } else {
+        response.message(1, this.handleCommit(user.id, toBuffer(message)));
+      }
+    } else if (contents === CONTENTS_CLEAR_SERVER_DATA) {
+      this.syncStore.clear(user.id);
+      sync = this.syncStore.get(user.id);
+      this.logger.info('sync: cleared server data', { userId: user.id });
+    } else {
+      errorCode = ERROR_UNKNOWN;
+      errorMessage = `unsupported message_contents ${contents}`;
+    }
+
+    response.varint(4, errorCode);
+    if (errorMessage) {
+      response.string(5, errorMessage);
+    }
+    response.string(6, sync.store_birthday);
+    return response.finish();
+  }
+
+  /**
+   * @param {string} userId
+   * @param {Buffer} message
+   * @param {any} sync
+   */
+  handleGetUpdates(userId, message, sync) {
+    const fields = readFields(message);
+    /** @type {{dataType: number, token: string}[]} */
+    const markers = fieldValues(fields, 6, WIRE_LENGTH).map((raw) => {
+      const marker = readFields(toBuffer(raw));
+      return {
+        dataType: firstNumber(marker, 1) ?? 0,
+        token: firstString(marker, 2) ?? '',
+      };
+    });
+    const needEncryptionKey = firstBool(fields, 8) === true;
+
+    const response = new Writer();
+    let changesRemaining = 0;
+    /** @type {Buffer[]} */
+    const newMarkers = [];
+    let includeKeystoreKey = needEncryptionKey;
+
+    for (const marker of markers) {
+      if (marker.dataType === NIGORI_TYPE) {
+        const nigori = this.syncStore.entity(
+            userId, `${NIGORI_TYPE}_google_chrome_nigori`);
+        if (nigori &&
+            nigoriPassphraseType(nigori.specifics) === KEYSTORE_PASSPHRASE) {
+          includeKeystoreKey = true;
+        }
+      }
+
+      const since = parseProgressToken(marker.token);
+      const includeDeleted = since > 0;
+      const rows = this.syncStore.list(
+          userId, marker.dataType, since, MAX_GET_UPDATES_BATCH,
+          includeDeleted);
+      for (const row of rows) {
+        response.message(1, this.encodeEntity(row));
+      }
+
+      const token = rows.length > 0 ?
+          String(rows[rows.length - 1].version) :
+          (marker.token || '0');
+      const remaining = this.syncStore.countAfter(
+                            userId, marker.dataType, since, includeDeleted) -
+          rows.length;
+      if (remaining > 0) {
+        changesRemaining += remaining;
+      }
+
+      const newMarker = new Writer();
+      newMarker.varint(1, marker.dataType);
+      newMarker.string(2, token);
+      newMarkers.push(newMarker.finish());
+    }
+
+    for (const marker of newMarkers) {
+      response.message(5, marker);
+    }
+    response.varint(4, changesRemaining);
+    if (includeKeystoreKey && sync.keystore_key) {
+      response.bytes(6, toBuffer(sync.keystore_key));
+    }
+
+    this.logger.debug('sync: get updates', {
+      userId,
+      types: markers.map((marker) => marker.dataType),
+      changesRemaining,
+    });
+    return response.finish();
+  }
+
+  /**
+   * @param {string} userId
+   * @param {Buffer} message
+   */
+  handleCommit(userId, message) {
+    const fields = readFields(message);
+    const cacheGuid = firstString(fields, 2) ?? '';
+    const entries = fieldValues(fields, 1, WIRE_LENGTH);
+
+    const response = new Writer();
+    /** @type {Map<string, string>} */
+    const renamedIds = new Map();
+    let committed = 0;
+
+    for (const rawEntry of entries) {
+      const entity = this.decodeEntity(toBuffer(rawEntry));
+      const result =
+          this.commitEntity(userId, entity, cacheGuid, renamedIds);
+      response.group(1, (group) => {
+        group.varint(2, result.responseType);
+        if (result.id) {
+          group.string(3, result.id);
+        }
+        if (result.version) {
+          group.varint(6, result.version);
+        }
+        if (result.error) {
+          group.string(9, result.error);
+        }
+      });
+      if (result.responseType === COMMIT_SUCCESS) {
+        committed += 1;
+      }
+      if (result.clientId && result.id && result.clientId !== result.id) {
+        renamedIds.set(result.clientId, result.id);
+      }
+    }
+
+    this.logger.debug('sync: commit', {userId, entries: entries.length, committed});
+    return response.finish();
+  }
+
+  /**
+   * @param {string} userId
+   * @param {object} entity
+   * @param {string} cacheGuid
+   * @param {Map<string, string>} renamedIds
+   */
+  commitEntity(userId, entity, cacheGuid, renamedIds) {
+    const existing = entity.id ? this.syncStore.entity(userId, entity.id) : null;
+
+    let dataType = entitySpecificsType(entity.specifics);
+    if (dataType === 1) {
+      // EntitySpecifics.encrypted: the datatype is not readable. Fall back to
+      // the type prefix of the id/parent, which bookmarks always carry.
+      dataType = 0;
+    }
+    if (!dataType) {
+      dataType = this.typeFromId(entity.id) || this.typeFromId(entity.parentId);
+    }
+    if (existing) {
+      dataType = existing.data_type;
+    }
+
+    if (!dataType) {
+      return {
+        responseType: COMMIT_INVALID_MESSAGE,
+        id: entity.id,
+        version: 0,
+        error: 'cannot determine datatype',
+        clientId: entity.id,
+      };
+    }
+
+    let id = entity.id;
+    if (!existing) {
+      if (dataType === BOOKMARKS_TYPE && entity.id) {
+        id = entity.id.startsWith(`${BOOKMARKS_TYPE}_`) ?
+            entity.id :
+            `${BOOKMARKS_TYPE}_${entity.id}`;
+      } else if (entity.clientTagHash && entity.version === 0) {
+        id = `${dataType}_${entity.clientTagHash}`;
+      } else if (entity.id) {
+        id = entity.id.startsWith(`${dataType}_`) ?
+            entity.id :
+            `${dataType}_${entity.id}`;
+      } else {
+        id = `${dataType}_${randomUUID()}`;
+      }
+    }
+
+    let parentId = renamedIds.get(entity.parentId) ?? entity.parentId;
+    if (!parentId) {
+      parentId = existing ? existing.parent_id : '';
+    }
+    if (!parentId && dataType === BOOKMARKS_TYPE) {
+      // Every bookmark must live under a folder; default to "Other bookmarks"
+      // rather than dropping it.
+      parentId = `${BOOKMARKS_TYPE}_other_bookmarks`;
+    }
+
+    const now = Date.now();
+
+    if (entity.deleted) {
+      if (!existing && entity.version === 0) {
+        // Deleting something that was never uploaded: nothing to do.
+        return {
+          responseType: COMMIT_SUCCESS,
+          id,
+          version: 0,
+          clientId: entity.id,
+        };
+      }
+      const version = this.syncStore.save({
+        userId,
+        id,
+        dataType,
+        parentId: existing ? existing.parent_id : parentId,
+        name: '',
+        ctime: existing ? existing.ctime : 0,
+        mtime: now,
+        deleted: true,
+        folder: existing ? existing.folder === 1 : false,
+        specifics: existing ?
+            toBuffer(existing.specifics) :
+            defaultSpecifics(dataType),
+        clientTagHash: existing ? existing.client_tag_hash : '',
+        uniquePosition: existing ? toBuffer(existing.unique_position) : null,
+        originatorCacheGuid: existing ? existing.originator_cache_guid : '',
+        originatorClientItemId:
+            existing ? existing.originator_client_item_id : '',
+        serverTag: existing ? existing.server_tag : '',
+      });
+      if (existing && existing.folder === 1) {
+        this.deleteDescendants(userId, id, now);
+      }
+      return {
+        responseType: COMMIT_SUCCESS,
+        id,
+        version,
+        clientId: entity.id,
+      };
+    }
+
+    const specifics = entity.specifics && entity.specifics.length > 0 ?
+        entity.specifics :
+        (existing && existing.specifics ?
+             toBuffer(existing.specifics) :
+             defaultSpecifics(dataType));
+
+    const version = this.syncStore.save({
+      userId,
+      id,
+      dataType,
+      parentId,
+      name: entity.name || (existing ? existing.name : ''),
+      ctime: entity.ctime || (existing ? existing.ctime : now),
+      mtime: entity.mtime || now,
+      deleted: false,
+      folder: entity.folder || (existing ? existing.folder === 1 : false),
+      specifics,
+      clientTagHash:
+          entity.clientTagHash || (existing ? existing.client_tag_hash : ''),
+      uniquePosition: entity.uniquePosition ??
+          (existing ? toBuffer(existing.unique_position) : null),
+      originatorCacheGuid: existing ? existing.originator_cache_guid :
+                                     (entity.version === 0 ? cacheGuid : ''),
+      originatorClientItemId: existing ? existing.originator_client_item_id :
+                                        (entity.version === 0 ? entity.id : ''),
+      serverTag: existing ? existing.server_tag : '',
+    });
+
+    return {
+      responseType: COMMIT_SUCCESS,
+      id,
+      version,
+      clientId: entity.id,
+    };
+  }
+
+  /**
+   * Marks every non-deleted descendant of a deleted folder as deleted.
+   * @param {string} userId
+   * @param {string} parentId
+   * @param {number} now
+   */
+  deleteDescendants(userId, parentId, now) {
+    const children = this.syncStore.db
+                         .prepare(
+                             'SELECT * FROM sync_entities WHERE user_id = ? ' +
+                             'AND parent_id = ? AND deleted = 0')
+                         .all(userId, parentId);
+    for (const child of children) {
+      this.syncStore.save({
+        userId,
+        id: child.id,
+        dataType: child.data_type,
+        parentId: child.parent_id,
+        name: '',
+        ctime: child.ctime,
+        mtime: now,
+        deleted: true,
+        folder: child.folder === 1,
+        specifics: toBuffer(child.specifics),
+        clientTagHash: child.client_tag_hash,
+        uniquePosition: toBuffer(child.unique_position),
+        originatorCacheGuid: child.originator_cache_guid,
+        originatorClientItemId: child.originator_client_item_id,
+        serverTag: child.server_tag,
+      });
+      this.deleteDescendants(userId, child.id, now);
+    }
+  }
+
+  /** @param {string} id */
+  typeFromId(id) {
+    const match = /^(\d+)_/.exec(String(id ?? ''));
+    return match ? Number(match[1]) : 0;
+  }
+
+  /** @param {Buffer} buffer */
+  decodeEntity(buffer) {
+    const fields = readFields(buffer);
+    return {
+      id: firstString(fields, 1) ?? '',
+      parentId: firstString(fields, 2) ?? '',
+      version: firstNumber(fields, 4) ?? 0,
+      mtime: firstNumber(fields, 5) ?? 0,
+      ctime: firstNumber(fields, 6) ?? 0,
+      name: firstString(fields, 7) ?? firstString(fields, 8) ?? '',
+      deleted: firstBool(fields, 18) ?? false,
+      folder: firstBool(fields, 22) ?? false,
+      specifics: toBuffer(firstField(fields, 21, WIRE_LENGTH)) ??
+          Buffer.alloc(0),
+      clientTagHash: firstString(fields, 23) ?? '',
+      uniquePosition: toBuffer(firstField(fields, 25, WIRE_LENGTH)),
+    };
+  }
+
+  /** @param {any} row */
+  encodeEntity(row) {
+    const specifics = row.deleted === 1 ? defaultSpecifics(row.data_type) :
+        (row.specifics && row.specifics.length > 0 ?
+             toBuffer(row.specifics) :
+             defaultSpecifics(row.data_type));
+    const writer = new Writer();
+    writer.string(1, row.id);
+    if (row.parent_id) {
+      writer.string(2, row.parent_id);
+    }
+    writer.varint(4, row.version);
+    writer.varint(5, row.mtime);
+    writer.varint(6, row.ctime);
+    if (row.name) {
+      writer.string(7, row.name);
+    }
+    if (row.server_tag) {
+      writer.string(10, row.server_tag);
+    }
+    writer.bool(18, row.deleted === 1);
+    if (row.originator_cache_guid) {
+      writer.string(19, row.originator_cache_guid);
+    }
+    if (row.originator_client_item_id) {
+      writer.string(20, row.originator_client_item_id);
+    }
+    writer.message(21, specifics);
+    writer.bool(22, row.folder === 1);
+    if (row.client_tag_hash) {
+      writer.string(23, row.client_tag_hash);
+    }
+    if (row.unique_position) {
+      writer.message(25, toBuffer(row.unique_position));
+    }
+    return writer.finish();
+  }
+}
+
+/**
+ * @param {object} options
+ * @param {import('./db.mjs').Store} options.store
+ * @param {import('./config.mjs').Config} options.config
+ * @param {ReturnType<import('./config.mjs').createLogger>} options.logger
+ */
+export function createSyncService({store, config, logger}) {
+  return new SyncService({store, config, logger});
+}
diff --git a/tools/afree-login-service/test/sync.test.mjs b/tools/afree-login-service/test/sync.test.mjs
new file mode 100644
index 0000000000..a37e104960
--- /dev/null
+++ b/tools/afree-login-service/test/sync.test.mjs
@@ -0,0 +1,460 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// End-to-end tests for the minimal Chrome Sync backend. The messages are built
+// with the same protobuf field numbers Chromium uses:
+//   components/sync/protocol/sync.proto
+//   components/sync/protocol/sync_entity.proto
+//   components/sync/protocol/bookmark_specifics.proto
+
+import assert from 'node:assert/strict';
+import {mkdtempSync, rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {gzipSync} from 'node:zlib';
+import {after, before, test} from 'node:test';
+
+import {createLogger} from '../src/config.mjs';
+import {Store} from '../src/db.mjs';
+import {
+  WIRE_LENGTH,
+  WIRE_START_GROUP,
+  Writer,
+  entitySpecificsType,
+  fieldValues,
+  firstBool,
+  firstField,
+  firstNumber,
+  firstString,
+  readFields,
+} from '../src/pb.mjs';
+import {createHttpServer} from '../src/server.mjs';
+
+const EMAIL = 'sync-tester@example.com';
+const PASSWORD = 'sync correct horse battery staple';
+const BOOKMARKS = 32904;
+const NIGORI = 47745;
+
+/** @type {Store} */
+let store;
+/** @type {import('node:http').Server} */
+let server;
+/** @type {string} */
+let base;
+/** @type {string} */
+let tempDir;
+/** @type {string} */
+let accessToken;
+/** @type {string} */
+let userId;
+/** @type {string} */
+let birthday = '';
+
+async function postCommand(body, token = accessToken) {
+  const response = await fetch(`${base}/command/`, {
+    method: 'POST',
+    headers: {
+      'Authorization': `Bearer ${token}`,
+      'Content-Type': 'application/octet-stream',
+      'Content-Encoding': 'gzip',
+    },
+    body: gzipSync(body),
+  });
+  return {
+    status: response.status,
+    body: Buffer.from(await response.arrayBuffer()),
+  };
+}
+
+function buildGetUpdates({markers, needKey = false}) {
+  const getUpdates = new Writer();
+  for (const marker of markers) {
+    const entry = new Writer().varint(1, marker.type);
+    if (marker.token !== undefined) {
+      entry.string(2, marker.token);
+    }
+    getUpdates.message(6, entry.finish());
+  }
+  if (needKey) {
+    getUpdates.bool(8, true);
+  }
+  const message = new Writer();
+  message.string(1, EMAIL);
+  message.varint(3, 2);  // GET_UPDATES
+  message.message(5, getUpdates.finish());
+  if (birthday) {
+    message.string(7, birthday);
+  }
+  return message.finish();
+}
+
+function buildCommit(entries) {
+  const commit = new Writer();
+  for (const entry of entries) {
+    const entity = new Writer();
+    if (entry.id) {
+      entity.string(1, entry.id);
+    }
+    if (entry.parentId) {
+      entity.string(2, entry.parentId);
+    }
+    if (entry.version !== undefined) {
+      entity.varint(4, entry.version);
+    }
+    if (entry.mtime) {
+      entity.varint(5, entry.mtime);
+    }
+    if (entry.ctime) {
+      entity.varint(6, entry.ctime);
+    }
+    if (entry.name) {
+      entity.string(7, entry.name);
+    }
+    if (entry.deleted) {
+      entity.bool(18, true);
+    }
+    if (entry.specifics) {
+      entity.message(21, entry.specifics);
+    }
+    if (entry.folder !== undefined) {
+      entity.bool(22, entry.folder);
+    }
+    if (entry.clientTagHash) {
+      entity.string(23, entry.clientTagHash);
+    }
+    commit.message(1, entity.finish());
+  }
+  commit.string(2, 'test-cache-guid');
+  const message = new Writer();
+  message.string(1, EMAIL);
+  message.varint(3, 1);  // COMMIT
+  message.message(4, commit.finish());
+  if (birthday) {
+    message.string(7, birthday);
+  }
+  return message.finish();
+}
+
+function buildClearServerData() {
+  const message = new Writer();
+  message.string(1, EMAIL);
+  message.varint(3, 5);  // CLEAR_SERVER_DATA
+  if (birthday) {
+    message.string(7, birthday);
+  }
+  return message.finish();
+}
+
+function bookmarkSpecifics({guid, url, title}) {
+  const specifics = new Writer()
+                        .string(1, url)     // BookmarkSpecifics.url
+                        .string(10, guid)   // guid
+                        .string(11, title)  // full_title
+                        .varint(15, 1);     // type = URL
+  return new Writer().message(BOOKMARKS, specifics.finish()).finish();
+}
+
+function parseGetUpdates(buffer) {
+  const fields = readFields(buffer);
+  return {
+    entries: fieldValues(fields, 1, WIRE_LENGTH).map(decodeEntity),
+    markers: fieldValues(fields, 5, WIRE_LENGTH).map((raw) => {
+      const marker = readFields(raw);
+      return {
+        type: firstNumber(marker, 1) ?? 0,
+        token: firstString(marker, 2) ?? '',
+      };
+    }),
+    changesRemaining: firstNumber(fields, 4) ?? 0,
+    encryptionKeys: fieldValues(fields, 6, WIRE_LENGTH),
+  };
+}
+
+function decodeEntity(buffer) {
+  const fields = readFields(buffer);
+  return {
+    id: firstString(fields, 1) ?? '',
+    parentId: firstString(fields, 2) ?? '',
+    version: firstNumber(fields, 4) ?? 0,
+    name: firstString(fields, 7) ?? '',
+    serverTag: firstString(fields, 10) ?? '',
+    deleted: firstBool(fields, 18) ?? false,
+    specifics: Buffer.from(firstField(fields, 21, WIRE_LENGTH) ?? Buffer.alloc(0)),
+    folder: firstBool(fields, 22) ?? false,
+  };
+}
+
+function parseCommitResponse(buffer) {
+  const fields = readFields(buffer);
+  const commit = firstField(fields, 1, WIRE_LENGTH);
+  return fieldValues(readFields(commit), 1, WIRE_START_GROUP).map((group) => {
+    const entry = readFields(group);
+    return {
+      responseType: firstNumber(entry, 2) ?? 0,
+      id: firstString(entry, 3) ?? '',
+      version: firstNumber(entry, 6) ?? 0,
+    };
+  });
+}
+
+function responseHeader(buffer) {
+  const fields = readFields(buffer);
+  return {
+    errorCode: firstNumber(fields, 4) ?? 0,
+    errorMessage: firstString(fields, 5) ?? '',
+    birthday: firstString(fields, 6) ?? '',
+    getUpdates: firstField(fields, 2, WIRE_LENGTH),
+  };
+}
+
+before(async () => {
+  tempDir = mkdtempSync(path.join(tmpdir(), 'afree-sync-test-'));
+  store = Store.open(path.join(tempDir, 'sync.sqlite3'));
+  const user = store.createUser({email: EMAIL, password: PASSWORD});
+  userId = user.id;
+  accessToken = store.createAccessToken({
+    userId: user.id,
+    clientId: 'afree-client-id',
+    scope: 'https://www.googleapis.com/auth/chromesync',
+    ttlSeconds: 3600,
+  });
+
+  /** @type {import('../src/config.mjs').Config} */
+  const config = {
+    host: '127.0.0.1',
+    port: 0,
+    dbPath: path.join(tempDir, 'sync.sqlite3'),
+    publicUrl: 'http://127.0.0.1',
+    cookieHost: '127.0.0.1',
+    secureCookies: false,
+    accessTokenTtlSeconds: 3600,
+    refreshTokenTtlDays: 0,
+    authCodeTtlSeconds: 300,
+    sessionTtlDays: 30,
+    logLevel: 'silent',
+    allowRegistration: false,
+    allowedContinueHosts: [],
+    emitOAuthCodeCookie: true,
+    redirectContinue: false,
+  };
+
+  const {server: created} =
+      createHttpServer({store, config, logger: createLogger('silent')});
+  server = created;
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  const address = server.address();
+  base = `http://127.0.0.1:${address.port}`;
+  config.port = address.port;
+  config.publicUrl = base;
+});
+
+after(async () => {
+  await new Promise((resolve) => server.close(resolve));
+  store.close();
+  rmSync(tempDir, {recursive: true, force: true});
+});
+
+let bookmarkToken = '';
+let nigoriToken = '';
+
+test('initial GetUpdates returns permanent folders and keystore key', async () => {
+  const response = await postCommand(buildGetUpdates({
+    markers: [{type: BOOKMARKS}, {type: NIGORI}],
+    needKey: true,
+  }));
+  assert.equal(response.status, 200);
+
+  const header = responseHeader(response.body);
+  assert.equal(header.errorCode, 0);
+  assert.ok(header.birthday);
+  birthday = header.birthday;
+
+  const updates = parseGetUpdates(header.getUpdates);
+  const ids = updates.entries.map((entry) => entry.id);
+  for (const expected of [
+    '32904_google_chrome_bookmarks',
+    '32904_bookmark_bar',
+    '32904_other_bookmarks',
+    '32904_synced_bookmarks',
+    '47745_google_chrome_nigori',
+  ]) {
+    assert.ok(ids.includes(expected), `missing ${expected}`);
