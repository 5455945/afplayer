diff --git a/build/win/rewrite_def.py b/build/win/rewrite_def.py
new file mode 100644
index 0000000000..80e7efafb7
--- /dev/null
+++ b/build/win/rewrite_def.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Rewrites the LIBRARY name in a Windows .def file."""
+
+import sys
+
+
+def main(argv):
+  if len(argv) != 3:
+    print('usage: rewrite_def.py <input.def> <output.def> <library_name>')
+    return 1
+  input_path, output_path, library_name = argv
+  with open(input_path, 'r') as f:
+    contents = f.read()
+  contents = contents.replace('chrome_elf.dll', library_name)
+  with open(output_path, 'w') as f:
+    f.write(contents)
+  return 0
+
+
+if __name__ == '__main__':
+  sys.exit(main(sys.argv[1:]))
