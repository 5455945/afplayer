diff --git a/build/config/BUILDCONFIG.gn b/build/config/BUILDCONFIG.gn
index 077a26fc97..0ba8bf3862 100644
--- a/build/config/BUILDCONFIG.gn
+++ b/build/config/BUILDCONFIG.gn
@@ -204,6 +204,10 @@ declare_args() {
   # Only honoured when is_afree=true. Empty keeps the upstream chrome://
   # behaviour unchanged.
   chrome_scheme = ""
+  # Optional main browser executable / process / default data-directory name.
+  # Only honoured when is_afree=true. Empty keeps the upstream platform
+  # defaults (chrome on Linux/Windows, the branded product name on macOS).
+  chrome_executable_name = ""
 }
 assert(!is_afree_sdk || is_afree,
        "is_afree_sdk=true requires is_afree=true")
@@ -217,6 +221,11 @@ chrome_scheme_alias = ""
 if (is_afree && chrome_scheme != "") {
   chrome_scheme_alias = chrome_scheme
 }
+
+# Runtime executable/process/data-directory rename. This is an afree-only
+# feature; a value without is_afree=true is ignored. The build scripts print a
+# warning when this happens.
+chrome_executable_name_enabled = is_afree && chrome_executable_name != ""
 # is_afree add end
 
 if (enable_strict_deps) {
diff --git a/build/win/reorder-imports.py b/build/win/reorder-imports.py
index 88851609d4..9dc2fb19ec 100755
--- a/build/win/reorder-imports.py
+++ b/build/win/reorder-imports.py
@@ -15,8 +15,8 @@ sys.path.insert(
                  'pefile_py3'))
 import pefile
 
-def reorder_imports(input_dir, output_dir, architecture):
-  """Swap chrome_elf.dll to be the first import of chrome.exe.
+def reorder_imports(input_dir, output_dir, architecture, exe_name='chrome'):
+  """Swap chrome_elf.dll to be the first import of the browser executable.
   Also copy over any related files that might be needed
   (pdbs, manifests etc.).
   """
@@ -24,8 +24,8 @@ def reorder_imports(input_dir, output_dir, architecture):
   # correct executable in the first place, so that this script
   # only needs to verify that and not write a whole new exe.
 
-  input_image = os.path.join(input_dir, 'chrome.exe')
-  output_image = os.path.join(output_dir, 'chrome.exe')
+  input_image = os.path.join(input_dir, exe_name + '.exe')
+  output_image = os.path.join(output_dir, exe_name + '.exe')
 
   # pefile mmap()s the whole executable, and then parses parts of
   # it into python data structures for ease of processing.
@@ -73,25 +73,28 @@ def reorder_imports(input_dir, output_dir, architecture):
 
   pe.write(filename=output_image)
 
-  for fname in glob.iglob(os.path.join(input_dir, 'chrome.exe.*')):
+  for fname in glob.iglob(os.path.join(input_dir, exe_name + '.exe.*')):
     shutil.copy(fname, os.path.join(output_dir, os.path.basename(fname)))
   return 0
 
 
 def main(argv):
-  usage = 'reorder_imports.py -i <input_dir> -o <output_dir> -a <target_arch>'
+  usage = ('reorder_imports.py -i <input_dir> -o <output_dir> '
+           '-a <target_arch> [-n <exe_name>]')
   parser = optparse.OptionParser(usage=usage)
-  parser.add_option('-i', '--input', help='reorder chrome.exe in DIR',
+  parser.add_option('-i', '--input', help='reorder browser exe in DIR',
       metavar='DIR')
-  parser.add_option('-o', '--output', help='write new chrome.exe to DIR',
+  parser.add_option('-o', '--output', help='write new browser exe to DIR',
       metavar='DIR')
   parser.add_option('-a', '--arch', help='architecture of build (optional)',
       default='ia32')
+  parser.add_option('-n', '--exe-name', help='executable basename',
+      default='chrome', metavar='NAME')
   opts, args = parser.parse_args()
 
   if not opts.input or not opts.output:
     parser.error('Please provide and input and output directory')
-  return reorder_imports(opts.input, opts.output, opts.arch)
+  return reorder_imports(opts.input, opts.output, opts.arch, opts.exe_name)
 
 if __name__ == "__main__":
   sys.exit(main(sys.argv[1:]))
