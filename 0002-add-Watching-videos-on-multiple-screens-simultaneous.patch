 #include "ui/gl/gl_context.h"
 #include "ui/gl/scoped_make_current.h"
 
@@ -124,6 +130,29 @@ bool CodecOutputBufferRenderer::RenderToTextureOwnerFrontBuffer() {
     }
   }
 
+#if BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
+  // afree multi_display: the decoded frame is now in the
+  // TextureOwner front buffer. Forward its AHardwareBuffer to the registered
+  // multi_display callback, which imports it as an EGLImage and draws it to the
+  // target surfaces.
+  if (texture_owner()) {
+    gfx::Size md_coded_size;
+    gfx::Rect md_visible_rect;
+    if (texture_owner()->GetCodedSizeAndVisibleRect(size(), &md_coded_size,
+                                                    &md_visible_rect)) {
+      std::unique_ptr<base::android::ScopedHardwareBufferFenceSync> hb =
+          texture_owner()->GetAHardwareBuffer();
+      AHardwareBuffer* buffer = hb ? hb->buffer() : nullptr;
+      if (buffer) {
+        AHardwareBuffer_acquire(buffer);  // reference handed to the callback
+        base::ScopedFD fence = hb->TakeFence();
+        afree::multi_display::OnDecodedVideoFrame(md_coded_size, md_visible_rect,
+                                                  buffer, fence.release());
+      }
+    }
+  }
+#endif
+
   return true;
 }
 
