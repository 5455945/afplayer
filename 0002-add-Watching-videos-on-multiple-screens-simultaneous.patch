--- /dev/null
+++ b/android_webview/afree/sdk/src/main/java/com/afree/chromium/AfreeMultiDisplay.java
@@ -0,0 +1,66 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package com.afree.chromium;
+
+import android.view.Surface;
+
+import java.nio.ByteBuffer;
+
+/**
+ * afree SDK multi_display (multi-screen same-view) interface.
+ *
+ * <p>This class is part of the afree SDK AAR and is only present when the SDK
+ * is built with the GN arg {@code afree_multi_display=true}. It lets an app
+ * (e.g. the MultiDisplayDemo APK) show the video decoded by the afree WebView
+ * on multiple screens: one decode, fanned out to multiple Surfaces.
+ *
+ * <p>Usage (app side):
+ * <pre>{@code
+ * AfreeMultiDisplay.attachSurface(displayId, surfaceView.getHolder().getSurface(), w, h);
+ * AfreeMultiDisplay.detachSurface(displayId);
+ * }</pre>
+ *
+ * <p>The engine side (afree SDK) owns the single decoder output and the
+ * multi-surface fan-out; the app only provides the target Surfaces.
+ */
+public final class AfreeMultiDisplay {
+    private AfreeMultiDisplay() {}
+
+    /** @return true if the SDK was built with multi_display support. */
+    public static native boolean isSupported();
+
+    /**
+     * Attach a Surface (from a SurfaceView on the given display) as a fan-out
+     * output. Returns true on success.
+     */
+    public static native boolean attachSurface(
+            int displayId, Surface surface, int width, int height);
+
+    /** Detach (stop drawing to) the Surface previously attached for displayId. */
+    public static native void detachSurface(int displayId);
+
+    /** Detach all attached surfaces. */
+    public static native void detachAll();
+
+    /**
+     * Runtime aspect mode: {@code true} (default) preserves the video aspect
+     * ratio with black letterbox bars; {@code false} stretches to fill each
+     * surface. Can be called at any time after the first surface is attached.
+     */
+    public static native void setContain(boolean contain);
+
+    /**
+     * Submit a whole-page frame (frame source "page"): the app captures the
+     * WebView page (e.g. via PixelCopy) and pushes it here; the SDK draws it to
+     * every attached Surface.
+     *
+     * <p>Use {@code --afree-multi-display-source=page} (or {@code -e source page})
+     * to select this source. {@code rgba} must be a direct ByteBuffer holding
+     * ARGB_8888 pixel memory (already RGBA byte order); the native side uploads
+     * it directly. {@code bytesPerRow} must equal {@code width * 4}.
+     */
+    public static native void submitPageFrame(
+            int width, int height, int bytesPerRow, ByteBuffer rgba);
+}
