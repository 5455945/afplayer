diff --git a/third_party/blink/renderer/platform/media/afree_multi_display_software_frame.cc b/third_party/blink/renderer/platform/media/afree_multi_display_software_frame.cc
new file mode 100644
index 0000000000..bcb825c77a
--- /dev/null
+++ b/third_party/blink/renderer/platform/media/afree_multi_display_software_frame.cc
@@ -0,0 +1,197 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/media/afree_multi_display_software_frame.h"
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+#include "base/logging.h"
+#include "base/memory/unsafe_shared_memory_region.h"
+#include "base/no_destructor.h"
+#include "media/base/video_frame.h"
+#include "media/mojo/mojom/afree_multi_display.mojom.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/platform.h"
+
+namespace blink {
+namespace {
+
+// At most one submit in flight; further frames are dropped (coalesced) so a slow
+// IPC never blocks video playback.
+std::atomic<bool> g_submitting{false};
+std::atomic<uint64_t> g_submitted{0};
+std::atomic<uint64_t> g_dropped{0};
+
+mojo::Remote<media::mojom::AfreeMultiDisplayFrameSink>& Sink() {
+  static base::NoDestructor<mojo::Remote<media::mojom::AfreeMultiDisplayFrameSink>>
+      sink;
+  return *sink;
+}
+
+inline int Clamp(int v) {
+  return v < 0 ? 0 : (v > 255 ? 255 : v);
+}
+
+// BT.601 limited-range YUV -> RGB, writing tightly-packed RGBA (R,G,B,A).
+// Returns false if the format is unsupported.
+bool CopyToRgba(const media::VideoFrame& f, int w, int h,
+                std::vector<uint8_t>* out) {
+  const auto fmt = f.format();
+  // Use the visible area only: coded_size may include padding whose chroma is
+  // zeroed, which would show up as a green band.
+  const uint8_t* y = f.visible_data(media::VideoFrame::Plane::kY);
+  const int ys = f.stride(media::VideoFrame::Plane::kY);
+  if (!y || ys <= 0) {
+    return false;
+  }
+  out->resize(static_cast<size_t>(w) * h * 4);
+  uint8_t* dst = out->data();
+
+  const bool is_nv12 = fmt == media::PIXEL_FORMAT_NV12;
+  const bool is_i420 = fmt == media::PIXEL_FORMAT_I420;
+  if (!is_nv12 && !is_i420) {
+    // Passthrough for already-RGBA (byte-order) frames.
+    if (fmt == media::PIXEL_FORMAT_ABGR) {
+      for (int j = 0; j < h; ++j) {
+        const uint8_t* src = f.visible_data(media::VideoFrame::Plane::kY) + j * ys;
+        std::memcpy(dst + static_cast<size_t>(j) * w * 4, src,
+                    static_cast<size_t>(w) * 4);
+      }
+      return true;
+    }
+    return false;
+  }
+
+  const uint8_t* u_plane = f.visible_data(media::VideoFrame::Plane::kU);
+  const uint8_t* v_plane = f.visible_data(media::VideoFrame::Plane::kV);
+  const uint8_t* uv_plane = f.visible_data(media::VideoFrame::Plane::kUV);
+  const int us = f.stride(media::VideoFrame::Plane::kU);
+  const int vs = f.stride(media::VideoFrame::Plane::kV);
+  const int uvs = f.stride(media::VideoFrame::Plane::kUV);
+  if (is_i420 && (!u_plane || !v_plane || us <= 0 || vs <= 0)) {
+    return false;
+  }
+  if (is_nv12 && (!uv_plane || uvs <= 0)) {
+    return false;
+  }
+
+  for (int j = 0; j < h; ++j) {
+    const int cj = j >> 1;
+    for (int i = 0; i < w; ++i) {
+      const int ci = i >> 1;
+      int U, V;
+      if (is_nv12) {
+        U = uv_plane[cj * uvs + ci * 2];
+        V = uv_plane[cj * uvs + ci * 2 + 1];
+      } else {
+        U = u_plane[cj * us + ci];
+        V = v_plane[cj * vs + ci];
+      }
+      const int Y = y[j * ys + i];
+      const int c = Y - 16 < 0 ? 0 : Y - 16;
+      const int d = U - 128;
+      const int e = V - 128;
+      const int r = (298 * c + 409 * e + 128) >> 8;
+      const int g = (298 * c - 100 * d - 208 * e + 128) >> 8;
+      const int b = (298 * c + 516 * d + 128) >> 8;
+      uint8_t* p = dst + (static_cast<size_t>(j) * w + i) * 4;
+      p[0] = static_cast<uint8_t>(Clamp(r));
+      p[1] = static_cast<uint8_t>(Clamp(g));
+      p[2] = static_cast<uint8_t>(Clamp(b));
+      p[3] = 255;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+void MaybeSubmitAfreeMultiDisplaySoftwareFrame(
+    const scoped_refptr<media::VideoFrame>& frame) {
+  if (!frame) {
+    return;
+  }
+  // Only software-decoded CPU frames. Hardware/opaque frames are handled by
+  // 方案 B; touching their planes (stride/data) would CHECK-fail.
+  const media::VideoFrame::StorageType st = frame->storage_type();
+  if (st != media::VideoFrame::STORAGE_UNOWNED_MEMORY &&
+      st != media::VideoFrame::STORAGE_OWNED_MEMORY &&
+      st != media::VideoFrame::STORAGE_SHMEM) {
+    return;
+  }
+  if (!frame->data(media::VideoFrame::Plane::kY)) {
+    return;
+  }
+  const int w = frame->visible_rect().width();
+  const int h = frame->visible_rect().height();
+  if (w <= 0 || h <= 0 || w > 4096 || h > 4096) {
+    return;
+  }
+
+  bool expected = false;
+  if (!g_submitting.compare_exchange_strong(expected, true)) {
+    g_dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+
+  std::vector<uint8_t> rgba;
+  if (!CopyToRgba(*frame, w, h, &rgba)) {
+    g_submitting.store(false, std::memory_order_release);
+    return;
+  }
+
+  const size_t bytes = rgba.size();
+  base::UnsafeSharedMemoryRegion region =
+      base::UnsafeSharedMemoryRegion::Create(bytes);
+  if (!region.IsValid()) {
+    g_submitting.store(false, std::memory_order_release);
+    return;
+  }
+  base::WritableSharedMemoryMapping mapping = region.Map();
+  if (!mapping.IsValid()) {
+    g_submitting.store(false, std::memory_order_release);
+    return;
+  }
+  std::memcpy(mapping.memory(), rgba.data(), bytes);
+
+  mojo::Remote<media::mojom::AfreeMultiDisplayFrameSink>& sink = Sink();
+  if (!sink.is_bound()) {
+    Platform* platform = Platform::Current();
+    ThreadSafeBrowserInterfaceBrokerProxy* broker =
+        platform ? platform->GetBrowserInterfaceBroker() : nullptr;
+    if (!broker) {
+      g_submitting.store(false, std::memory_order_release);
+      return;
+    }
+    broker->GetInterface(sink.BindNewPipeAndPassReceiver());
+  }
+  if (!sink.is_connected()) {
+    // No receiver registered (e.g. afree multi_display disabled) or not yet
+    // connected; skip without blocking playback.
+    g_submitting.store(false, std::memory_order_release);
+    return;
+  }
+
+  auto mojom_frame = media::mojom::AfreeSoftwareVideoFrame::New();
+  mojom_frame->width = static_cast<uint32_t>(w);
+  mojom_frame->height = static_cast<uint32_t>(h);
+  mojom_frame->bytes_per_row = static_cast<uint32_t>(w) * 4;
+  mojom_frame->region = std::move(region);
+  sink->SubmitFrame(std::move(mojom_frame));
+
+  g_submitted.fetch_add(1, std::memory_order_relaxed);
+  g_submitting.store(false, std::memory_order_release);
+}
+
+}  // namespace blink
+
+#endif  // BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
