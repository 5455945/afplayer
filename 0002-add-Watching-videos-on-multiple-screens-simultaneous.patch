+@echo off
+rem ============================================================================
+rem multi_display_test.bat - Windows entry point for multi_display_test.ps1
+rem
+rem Usage (from any directory):
+rem   multi_display_test.bat [options] --device <serial|host:port>
+rem   multi_display_test.bat --device 30.207.82.135:61449 --matrix
+rem
+rem Requires: adb and python3 available in PATH.
+rem ============================================================================
+setlocal
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0multi_display_test.ps1" %*
+exit /b %ERRORLEVEL%
diff --git a/android_webview/afree/tools/multi_display_test.ps1 b/android_webview/afree/tools/multi_display_test.ps1
new file mode 100644
index 0000000000..130f38258a
--- /dev/null
+++ b/android_webview/afree/tools/multi_display_test.ps1
@@ -0,0 +1,600 @@
+﻿# =============================================================================
+# multi_display_test.ps1 - Windows (PowerShell) port of multi_display_test.sh
+#
+# standalone afree multi_display (multi-screen same-view) regression. Integrated
+# into verify_demo.ps1 via --multi-display-only.
+#
+# It launches com.afree.demo/.MultiDisplayActivity on a device and verifies:
+#   * baseline: no external screens yet,
+#   * two-finger/single-finger swipe starts the mapped screen (same frame, skew=0),
+#   * runtime aspect toggle (SET_CONTAIN),
+#   * runtime close a screen (CLOSE_DISPLAY) and close-all (CLOSE_ALL -> process exits).
+#
+# Usage (from any directory):
+#   multi_display_test.bat [options]
+#   powershell -ExecutionPolicy Bypass -File multi_display_test.ps1 [options]
+#
+#   --device D        adb serial OR physical HOST:PORT (connected directly on
+#                     Windows; see --relay-mss). Alias: --serial|-s.
+#                     Default: $env:ANDROID_SERIAL/first.
+#   --apk PATH        demo APK (auto-detected like verify_demo.ps1 by default)
+#   --no-install      use the already-installed app
+#   --relay-mss N     accepted for compatibility; ignored on Windows
+#                     (TCP_MAXSEG unavailable) -> direct connection
+#   --no-auto-relay   no-op on Windows (there is no relay)
+#   --mode M          broadcast | touch   (default broadcast)
+#   --source S        frame source: hardwarebuffer|software|auto|testpattern|page
+#   --page-hw-video   page mode: keep the WebView video overlay SurfaceControl
+#   --video V         <video> for the built-in page (asset name or URL)
+#   --url U           load this URL instead of the built-in page
+#   --ua  U           User-Agent for --url
+#   --include "3,10,11"  include-only mode (--es displays) instead of exclude
+#   --matrix          run the FULL matrix (all frame sources + force-hw + touch +
+#                     include); each scenario is a fresh launch, results aggregate
+#   --order "3,10,11" right = first not-yet-shown, left = last not-yet-shown
+#   --map "right=3,left=11,down=10"  explicit direction -> display id
+#   --force-hw        pass --enable-features=AfreePreferPlatformVideoDecoder
+#   --duration N      settle seconds (default 6)
+# Exit: 0 PASS, 1 FAIL. A missing/uninstalled APK or a non-running activity is a
+# FAIL (with a fix hint), never a silent PASS.
+#
+# Dependencies: adb and python3 in PATH (page_play.py for the real-site page
+# scenarios); screenshot helpers not needed here.
+# =============================================================================
+$ErrorActionPreference = 'Continue'
+$env:PYTHONDONTWRITEBYTECODE = '1'
+
+# Console default foreground, applied explicitly to "uncolored" segments so a
+# status color from a previous line cannot bleed into the next line's timestamp.
+# Read it from [Console] (the real attribute); $Host.UI.RawUI can be stale.
+$script:FG_DEFAULT = 'Gray'
+try { $script:FG_DEFAULT = [Console]::ForegroundColor } catch { }
+
+$SCRIPT_DIR = Split-Path -Parent $MyInvocation.MyCommand.Path
+$AFREE_DIR  = Split-Path -Parent $SCRIPT_DIR
+$DEF_APK    = Join-Path $AFREE_DIR 'demo/build/outputs/apk/release/demo-release.apk'
+$PAGE_PLAY  = Join-Path $SCRIPT_DIR 'page_play.py'
+
+# State
+$script:DEVICE   = if ($env:ANDROID_SERIAL) { $env:ANDROID_SERIAL } else { '' }
+$script:APK      = ''
+$script:MODE     = 'broadcast'
+$script:SOURCE   = 'auto'
+$script:VIDEO    = ''
+$script:INCLUDE  = ''
+$script:MATRIX   = 0
+$script:DESC     = ''
+$script:URL      = ''
+$script:UA       = ''
+$script:PLAY_SITE = ''
+$script:PAGE_HW_VIDEO = 0
+$script:ORDER    = ''
+$script:MAP      = ''
+$script:MSS      = 1200
+$script:MSS_SET  = 0
+$script:ALLOW_RELAY = 1
+$script:DO_INSTALL = 1
+$script:FORCE_HW = 0
+$script:DURATION = 6
+$script:SERIAL   = ''
+$script:EXTERNAL_ORDER = ''
+$script:FAILED   = 0
+$script:EXP      = @{}
+$script:SW_W     = 1920
+$script:SW_H     = 720
+$script:RELAY_PID = 0
+$script:RELAY_PY  = ''
+$script:ADB      = $null
+$script:PY       = $null
+$script:PYARGS   = @()
+
+$PKG           = 'com.afree.demo'
+$ACT           = "$PKG/.MultiDisplayActivity"
+$ACTION_PREFIX = 'com.afree.demo.multi_display'
+
+# ---------------------------------------------------------------------------
+# Logging (same [verify] prefix/format as verify_demo.ps1)
+# ---------------------------------------------------------------------------
+function Now { Get-Date -Format 'yyyy-MM-dd HH:mm:ss' }
+function log  { param([string]$m) Write-Host '[verify]' -ForegroundColor Cyan -NoNewline; Write-Host (" {0} {1}" -f (Now), $m) -ForegroundColor $script:FG_DEFAULT }
+function ok   { param([string]$m) Write-Host '[verify]' -ForegroundColor DarkGreen -NoNewline; Write-Host (" {0} " -f (Now)) -ForegroundColor $script:FG_DEFAULT -NoNewline; Write-Host $m -ForegroundColor DarkGreen }
+function warn { param([string]$m) Write-Host '[verify]' -ForegroundColor Yellow -NoNewline; Write-Host (" {0} " -f (Now)) -ForegroundColor $script:FG_DEFAULT -NoNewline; Write-Host $m -ForegroundColor Yellow }
+function err  { param([string]$m) Write-Host '[verify]' -ForegroundColor DarkRed -NoNewline; Write-Host (" {0} " -f (Now)) -ForegroundColor $script:FG_DEFAULT -NoNewline; Write-Host $m -ForegroundColor DarkRed }
+function run_log { param([string]$m) Write-Host '[verify]' -ForegroundColor Cyan -NoNewline; Write-Host (" {0} run: " -f (Now)) -ForegroundColor $script:FG_DEFAULT -NoNewline; Write-Host $m -ForegroundColor DarkCyan }
+
+function pass { param([string]$m) ok "PASS  $m" }
+function fail { param([string]$m) err "FAIL  $m"; $script:FAILED++ }
+function skip { param([string]$m) warn "SKIP  $m" }
+function die  { param([string]$m) err $m; exit 2 }
+
+# Restore the console foreground at exit so the last status color never leaks
+# into the interactive prompt / typed input. Skipped when the output is
+# redirected (e.g. when run via verify_demo.ps1), where it would only inject a
+# raw ESC sequence into the captured log.
+function Reset-ConsoleColor {
+  $redirected = $true
+  try { $redirected = [Console]::IsOutputRedirected } catch { }
+  if ($redirected) { return }
+  try { [Console]::ResetColor(); return } catch { }
+  try { [Console]::ForegroundColor = $script:FG_DEFAULT; return } catch { }
+  if ($env:WT_SESSION -or $env:TERM) { Write-Host ("{0}[0m" -f [char]27) -NoNewline }
+}
+
+function Cleanup {
+  Reset-ConsoleColor
+  if ($script:RELAY_PID -gt 0) { try { Stop-Process -Id $script:RELAY_PID -Force -ErrorAction SilentlyContinue } catch {} }
+  if ($script:RELAY_PY) { Remove-Item -LiteralPath $script:RELAY_PY -ErrorAction SilentlyContinue }
+}
+
+function Show-Usage {
+  $lines = Get-Content -LiteralPath $PSCommandPath
+  foreach ($l in $lines) {
+    if ($l -match '^#') { Write-Host $l } else { break }
+  }
+}
+
+# ---------------------------------------------------------------------------
+# adb / python discovery
+# ---------------------------------------------------------------------------
+function Get-AdbPath {
+  if ($env:AFREE_ADB -and (Test-Path $env:AFREE_ADB)) { return $env:AFREE_ADB }
+  if ($env:ADB) { $c0 = Get-Command $env:ADB -ErrorAction SilentlyContinue; if ($c0) { return $c0.Source } }
+  $c = Get-Command adb -ErrorAction SilentlyContinue
+  if ($c) { return $c.Source }
+  return $null
+}
+function Get-PyInfo {
+  if ($env:AFREE_PY -and (Test-Path $env:AFREE_PY)) {
+    $pa = @(); if ($env:AFREE_PYARGS) { $pa = @($env:AFREE_PYARGS -split ',') }
+    return @{ exe = $env:AFREE_PY; args = $pa }
+  }
+  foreach ($c in @('python3', 'python')) {
+    $p = Get-Command $c -ErrorAction SilentlyContinue
+    if ($p) {
+      $v = (& $p.Source -c "import sys;print(sys.version_info[0])" 2>$null | Out-String).Trim()
+      if ($v -eq '3') { return @{ exe = $p.Source; args = @() } }
+    }
+  }
+  $p = Get-Command py -ErrorAction SilentlyContinue
+  if ($p) {
+    $v = (& $p.Source -3 -c "import sys;print(sys.version_info[0])" 2>$null | Out-String).Trim()
+    if ($v -eq '3') { return @{ exe = $p.Source; args = @('-3') } }
+  }
+  return $null
+}
+
+function Adb { param([string[]]$AdbArgs) & $script:ADB -s $script:SERIAL @AdbArgs }
+
+# ---------------------------------------------------------------------------
+# Argument parsing
+# ---------------------------------------------------------------------------
+$argv = @($args)
+$i = 0
+while ($i -lt $argv.Count) {
+  $a = [string]$argv[$i]
+  $next = { param($n) if (($i + $n) -ge $argv.Count) { die "option $a requires a value" }; return [string]$argv[$i + $n] }
+  switch ($a) {
+    '--device' { $script:DEVICE = (& $next 1); $i += 2 }
+    '--serial' { $script:DEVICE = (& $next 1); $i += 2 }
+    '-s'       { $script:DEVICE = (& $next 1); $i += 2 }
+    '--apk'    { $script:APK = (& $next 1); $i += 2 }
+    '--no-install' { $script:DO_INSTALL = 0; $i++ }
+    '--relay-mss'  { $script:MSS = [int](& $next 1); $script:MSS_SET = 1; $i += 2 }
+    '--no-auto-relay' { $script:ALLOW_RELAY = 0; $i++ }
+    '--mode'   { $script:MODE = (& $next 1); $i += 2 }
+    '--source' { $script:SOURCE = (& $next 1); $i += 2 }
+    '--video'  { $script:VIDEO = (& $next 1); $i += 2 }
+    '--include' { $script:INCLUDE = (& $next 1); $i += 2 }
+    '--url'    { $script:URL = (& $next 1); $i += 2 }
+    '--ua'     { $script:UA = (& $next 1); $i += 2 }
+    '--page-hw-video' { $script:PAGE_HW_VIDEO = 1; $i++ }
+    '--matrix' { $script:MATRIX = 1; $i++ }
+    '--order'  { $script:ORDER = (& $next 1); $i += 2 }
+    '--map'    { $script:MAP = (& $next 1); $i += 2 }
+    '--force-hw' { $script:FORCE_HW = 1; $i++ }
+    '--duration' { $script:DURATION = [int](& $next 1); $i += 2 }
+    '-h' { Show-Usage; exit 0 }
+    '--help' { Show-Usage; exit 0 }
+    default { die "unknown option: $a" }
+  }
+}
+
+$script:ADB = Get-AdbPath
+if (-not $script:ADB) { die 'adb not found' }
+$pyInfo = Get-PyInfo
+if ($pyInfo) { $script:PY = $pyInfo.exe; $script:PYARGS = $pyInfo.args }
+if (-not $script:APK) { $script:APK = $DEF_APK }
+
+# 方案C (software) needs a software-decoded clip.
+if ($script:SOURCE -eq 'software' -and -not $script:VIDEO) { $script:VIDEO = 'sd-320x240.mp4' }
+
+# ---------------------------------------------------------------------------
+# adb relay (MTU black hole workaround), same as the .sh version
+# ---------------------------------------------------------------------------
+$RELAY_CODE = @'
+import socket, threading, sys
+th, tp, lp, mss = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
+def pump(a, b):
+    try:
+        while True:
+            d = a.recv(65536)
+            if not d: break
+            b.sendall(d)
+    except Exception: pass
+    finally:
+        for s in (a, b):
+            try: s.shutdown(socket.SHUT_RDWR)
+            except Exception: pass
+def handle(c):
+    u = socket.socket()
+    try: u.setsockopt(socket.IPPROTO_TCP, socket.TCP_MAXSEG, mss)
+    except Exception as e: print("setsockopt:", e, flush=True)
+    try: u.connect((th, tp))
+    except Exception as e:
+        print("connect upstream failed:", e, flush=True); c.close(); return
+    threading.Thread(target=pump, args=(c, u), daemon=True).start()
+    threading.Thread(target=pump, args=(u, c), daemon=True).start()
+srv = socket.socket(); srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+srv.bind(("127.0.0.1", lp)); srv.listen(32)
+print("relay", lp, "->", (th, tp), "MSS", mss, flush=True)
+while True:
+    c, _ = srv.accept(); threading.Thread(target=handle, args=(c,), daemon=True).start()
+'@
+
+function Pick-FreePort {
+  # NOTE: use single quotes inside the -c snippet; Windows PowerShell 5.1 strips
+  # embedded double quotes when passing the argument to a native executable.
+  $a = @($script:PYARGS) + @('-c', "import socket;s=socket.socket();s.bind(('127.0.0.1',0));print(s.getsockname()[1]);s.close()")
+  return ((& $script:PY @a | Out-String).Trim())
+}
+function Start-Relay([string]$host_, [string]$port, [string]$listen) {
+  if (-not $script:PY) { die 'python3 required for the relay' }
+  $script:RELAY_PY = Join-Path $env:TEMP ("md_relay_" + (Get-Random -Minimum 100000 -Maximum 999999) + ".py")
+  Set-Content -LiteralPath $script:RELAY_PY -Value $RELAY_CODE -Encoding ASCII
+  $out = Join-Path $env:TEMP 'md_relay.out.log'
+  $er  = Join-Path $env:TEMP 'md_relay.err.log'
+  $p = Start-Process -FilePath $script:PY -ArgumentList (@($script:PYARGS) + @($script:RELAY_PY, $host_, $port, $listen, [string]$script:MSS)) -PassThru -NoNewWindow -RedirectStandardOutput $out -RedirectStandardError $er
+  $script:RELAY_PID = $p.Id
+  Start-Sleep -Seconds 1
+  if ($p.HasExited) { Write-Host ((Get-Content $out -ErrorAction SilentlyContinue) -join "`n"); die 'relay failed' }
+  & $script:ADB connect "127.0.0.1:$listen" | Out-Null
+}
+function Wait-Device([string]$s) {
+  for ($k = 0; $k -lt 15; $k++) {
+    $st = (& $script:ADB -s $s get-state 2>$null | Out-String).Trim()
+    if ($st -eq 'device') { return $true }
+    Start-Sleep -Seconds 1
+  }
+  return $false
+}
+function Setup-Device {
+  if (-not $script:DEVICE) {
+    $dl = (& $script:ADB devices 2>$null | Out-String) -split "`n"
+    foreach ($l in $dl) { if ($l -match '^\s*(\S+)\s+device') { $script:DEVICE = $Matches[1]; break } }
+  }
+  if (-not $script:DEVICE) { die 'no device: pass --device <serial|host:port>' }
+  if ($script:DEVICE -match ':') {
+    $h = $script:DEVICE.Substring(0, $script:DEVICE.LastIndexOf(':'))
+    $pt = $script:DEVICE.Substring($script:DEVICE.LastIndexOf(':') + 1)
+    if ($h -eq '127.0.0.1' -or $h -eq 'localhost') {
+      & $script:ADB connect $script:DEVICE | Out-Null; $script:SERIAL = $script:DEVICE
+    } else {
+      # Windows cannot set TCP_MAXSEG, so the built-in relay gives no MTU-black-hole
+      # benefit here; connect directly, exactly like verify_demo.ps1 does.
+      if ($script:MSS_SET -eq 1) {
+        warn "--relay-mss=$($script:MSS) is not supported on Windows (TCP_MAXSEG unavailable); using a direct connection"
+      }
+      & $script:ADB connect $script:DEVICE | Out-Null; $script:SERIAL = $script:DEVICE
+    }
+  } else { $script:SERIAL = $script:DEVICE }
+  if (-not (Wait-Device $script:SERIAL)) { die "device '$($script:SERIAL)' unavailable" }
+  log "device: $($script:SERIAL)"
+}
+
+# ---------------------------------------------------------------------------
+# STATS parsing
+# ---------------------------------------------------------------------------
+function Stat-Line {
+  $out = @(& $script:ADB -s $script:SERIAL shell logcat -d -s 'AfreeMultiDisplay:V' 2>$null)
+  $hit = @($out | Where-Object { $_ -match 'AFREE_MD-STATS' })
+  if ($hit.Count -gt 0) { return [string]$hit[-1] }
+  return ''
+}
+function Stat-Ready {
+  for ($k = 0; $k -lt 4; $k++) { $l = Stat-Line; if ($l) { return $l }; Start-Sleep -Seconds 2 }
+  return ''
+}
+function Drawn-Of([string]$s)   { if ($s -match 'drawn=\[([^\]]*)\]') { return $Matches[1] }; return '' }
+function Contain-Of([string]$s) { if ($s -match 'contain=([0-9]+)') { return $Matches[1] }; return '' }
+function Skew-Of([string]$s)    { if ($s -match 'skew=([0-9]+)') { return $Matches[1] }; return '' }
+function Has-Key([string]$k, [string]$s) {
+  foreach ($t in ($s -split ',')) { $p = $t -split ':'; if ($p.Count -ge 1 -and $p[0] -eq $k) { return $true } }
+  return $false
+}
+function Has-Id([int]$id, [string]$s) { return (Has-Key ([string](1000 + $id)) $s) }
+
+# ---------------------------------------------------------------------------
+# Setup / install
+# ---------------------------------------------------------------------------
+Setup-Device
+
+log 'available devices (adb devices -l):'
+(& $script:ADB devices -l 2>$null) | ForEach-Object { Write-Host "    $_" }
+
+function List-External-Displays {
+  $disp = (& $script:ADB -s $script:SERIAL shell dumpsys display 2>$null | Out-String)
+  $ids = @()
+  foreach ($seg in ($disp -split '\{')) {
+    if ($seg -match 'type=EXTERNAL') { if ($seg -match 'displayId=([0-9]+)') { $ids += [int]$Matches[1] } }
+  }
+  return (($ids | Sort-Object -Unique) -join ',')
+}
+$script:EXTERNAL_ORDER = List-External-Displays
+if (-not $script:ORDER -and -not $script:MAP -and -not $script:INCLUDE) { $script:ORDER = $script:EXTERNAL_ORDER }
+if ($script:EXTERNAL_ORDER) { log "external (presentation) displays: $($script:EXTERNAL_ORDER)" }
+else { warn 'no external (presentation) display found; swipe/close checks will SKIP' }
+
+$FLAGS = '--v=1 --enable-logging=stderr'
+
+if ($script:DO_INSTALL -eq 1) {
+  if (-not (Test-Path $script:APK)) { die "APK not found: $($script:APK)" }
+  log "installing $(Split-Path -Leaf $script:APK) ... (use --no-install to skip)"
+  Adb @('install', '-r', '-d', '-t', $script:APK) | Out-Null
+  log 'install done'
+}
+
+function Pkg-Installed { $o = (& $script:ADB -s $script:SERIAL shell pm path $PKG 2>$null | Out-String); return ($o -match 'package:') }
+$present = 0
+for ($k = 0; $k -lt 3; $k++) { if (Pkg-Installed) { $present = 1; break }; Start-Sleep -Seconds 1 }
+if ($present -ne 1) {
+  if ($script:DO_INSTALL -eq 0) {
+    err "package $PKG is NOT installed on $($script:SERIAL), but --no-install was given."
+    err "  -> install it first, or drop --no-install so this script installs: $($script:APK)"
+  } else {
+    err "package $PKG is NOT installed on $($script:SERIAL) after install (APK: $($script:APK))."
+  }
+  exit 1
+}
+
+Adb @('shell', 'logcat -G 16M') | Out-Null
+
+$sizeLine = ((& $script:ADB -s $script:SERIAL shell wm size 2>$null | Out-String).Trim() -split "`n")[0]
+if ($sizeLine -match ':\s*(\d+)x(\d+)') { $script:SW_W = [int]$Matches[1]; $script:SW_H = [int]$Matches[2] }
+
+# NOTE: no global early-skip here. With no external (presentation) display the
+# matrix still runs (frame sources, launch, baseline, contain); only the
+# external-screen checks (swipe/close) SKIP, matching multi_display_test.sh.
+
+# ---------------------------------------------------------------------------
+# Scenario engine
+# ---------------------------------------------------------------------------
+function Swipe-Dir([string]$dir) {
+  if ($script:MODE -eq 'broadcast') {
+    Adb @('shell', 'am', 'broadcast', '-a', "$ACTION_PREFIX.SWIPE", '--ei', 'dir', $dir) | Out-Null
+  } else {
+    $x1 = [int]($script:SW_W / 3); $y1 = [int]($script:SW_H / 2); $x2 = $x1; $y2 = $y1
+    switch ($dir) {
+      '0' { $x2 = $x1 - [int]($script:SW_W / 5) }
+      '1' { $x2 = $x1 + [int]($script:SW_W / 5) }
+      '2' { $y2 = $y1 - [int]($script:SW_H / 5) }
+      '3' { $y2 = $y1 + [int]($script:SW_H / 5) }
+    }
+    Adb @('shell', 'input', 'swipe', [string]$x1, [string]$y1, [string]$x2, [string]$y2, '400') | Out-Null
+  }
+  Start-Sleep -Seconds 3
+}
+function Check-Swipe([string]$dir, [string]$id, [string]$name) {
+  Swipe-Dir $dir
+  $line = Stat-Ready; $d = Drawn-Of $line; $sk = Skew-Of $line
+  if (-not $id -or $id -eq '0') { skip "swipe $name (no external target)"; return }
+  if (Has-Id ([int]$id) $d) {
+    pass "swipe $name -> display $id (drawn=[$d] skew=$sk)"
+    if ($sk -ne '0') { fail "swipe $name skew=$sk" }
+  } elseif ($script:MODE -eq 'touch') {
+    skip "swipe $name (touch injection not delivered -> display $id; a system window on top may intercept input; try --mode broadcast)"
+  } else {
+    fail "swipe $name -> display $id missing (drawn=[$d])"
+  }
+}
+function End-Scenario([string]$name, [int]$before) {
+  $n = $script:FAILED - $before
+  if ($n -eq 0) { ok "================= END   scenario: $name -> PASS =================" }
+  else { err "================= END   scenario: $name -> FAIL ($n) =================" }
+}
+function Invoke-PyJob([string[]]$PyArgs, [int]$TimeoutSec) {
+  if (-not $script:PY) { return @{ rc = 127; out = 'python not found'; timeout = $false } }
+  $job = Start-Job -ScriptBlock {
+    param($exe, $ar)
+    $o = (& $exe @ar 2>&1 | Out-String)
+    @{ rc = $LASTEXITCODE; out = $o }
+  } -ArgumentList $script:PY, $PyArgs
+  $done = Wait-Job $job -Timeout $TimeoutSec
+  if (-not $done) { Stop-Job $job -ErrorAction SilentlyContinue; Remove-Job $job -Force -ErrorAction SilentlyContinue; return @{ rc = -1; out = '(timeout)'; timeout = $true } }
+  $res = Receive-Job $job; Remove-Job $job -Force -ErrorAction SilentlyContinue
+  if (-not $res) { return @{ rc = 1; out = ''; timeout = $false } }
+  return @{ rc = [int]$res.rc; out = [string]$res.out; timeout = $false }
+}
+
+function Run-One([string]$name) {
+  $video = $script:VIDEO
+  if ($script:SOURCE -eq 'software' -and -not $video) { $video = 'sd-320x240.mp4' }
+  $failedBefore = $script:FAILED
+  $script:EXP = @{}
+  if ($script:MAP) {
+    foreach ($t in ($script:MAP -split ',')) {
+      $d = ($t -split '=')[0]; $v = ($t -split '=')[-1]
+      if (@('right', 'left', 'up', 'down') -contains $d) { $script:EXP[$d] = $v }
+    }
+  } elseif ($script:ORDER) {
+    $o = $script:ORDER -split ','
+    $script:EXP['right'] = $o[0]; $script:EXP['left'] = $o[-1]
+  }
+  log "================= BEGIN scenario: $name ================="
+  if ($script:DESC) { log "  tests : $($script:DESC)" }
+  log "  params: source=$($script:SOURCE) video=$(if ($video) { $video } else { '<default>' }) mode=$($script:MODE) order=$($script:ORDER) map=$($script:MAP) include=$($script:INCLUDE) force_hw=$($script:FORCE_HW)"
+  log "  expect: right=$(if ($script:EXP['right']) { $script:EXP['right'] } else { '<none>' }) left=$(if ($script:EXP['left']) { $script:EXP['left'] } else { '<none>' }) up=$(if ($script:EXP['up']) { $script:EXP['up'] } else { '<none>' }) down=$(if ($script:EXP['down']) { $script:EXP['down'] } else { '<none>' })"
+
+  $flags = $FLAGS
+  if ($script:FORCE_HW -eq 1) { $flags = "$flags --enable-features=AfreePreferPlatformVideoDecoder" }
+  Adb @('shell', "echo '$flags' > /data/local/tmp/webview-command-line") | Out-Null
+  Adb @('shell', 'am', 'force-stop', $PKG) | Out-Null
+  Adb @('shell', 'logcat', '-c') | Out-Null
+
+  $cmd = "am start -n $ACT --es source '$($script:SOURCE)'"
+  if ($video -and -not $script:URL) { $cmd += " --es video '$video'" }
+  if ($script:URL) { $cmd += " --es url '$($script:URL)'" }
+  if ($script:UA) { $cmd += " --es ua '$($script:UA)'" }
+  if ($script:INCLUDE) { $cmd += " --es displays '$($script:INCLUDE)'" }
+  elseif ($script:MAP) { $cmd += " --es exclude '$($script:ORDER)' --es map '$($script:MAP)'" }
+  else { $cmd += " --es exclude '$($script:ORDER)' --es order '$($script:ORDER)'" }
+  if ($script:MODE -eq 'touch') { $cmd += ' --ez one_finger true' }
+  if ($script:PAGE_HW_VIDEO -eq 1) { $cmd += ' --ez hwvideo true' }
+  if ($script:PLAY_SITE) { $cmd += " -e cr '--force-debug'" }
+  Adb @('shell', $cmd) | Out-Null
+  Start-Sleep -Seconds $script:DURATION
+
+  $pidVal = ((& $script:ADB -s $script:SERIAL shell pidof $PKG 2>$null | Out-String).Trim())
+  if (-not $pidVal) {
+    err "app not running after launching $ACT."
+    err "  -> $PKG is installed, so either the AAR was built without afree_multi_display"
+    err '     (MultiDisplayActivity disabled) or startup crashed. Rebuild with --multi-display,'
+    err "     and check: adb -s $($script:SERIAL) logcat | grep AfreeMultiDisplay"
+    fail "${name}: app not running"
+    End-Scenario $name $failedBefore
+    return
+  }
+  pass "${name}: app running (pid=$pidVal)"
+
+  if ($script:PLAY_SITE) {
+    $sec = '2.0'; $cnt = '1'
+    if ($script:PLAY_SITE -eq 'bilibili') { $sec = '1.5'; $cnt = '2' }
+    if ($script:PLAY_SITE -eq 'iqiyi') { $sec = '2.5'; $cnt = '1' }
+    $pargs = @($script:PYARGS) + @($PAGE_PLAY, '--device', $script:SERIAL, '--site', $script:PLAY_SITE, '--seconds', $sec, '--count', $cnt)
+    if ($script:UA) { $pargs += @('--ua', $script:UA) }
+    log "${name}: driving $($script:PLAY_SITE) playback via CDP (count=$cnt sec=$sec) ..."
+    $r = Invoke-PyJob $pargs 200
+    foreach ($l in (($r.out) -split "`n")) { $t = $l -replace "`r", ''; if ($t.Trim().Length -gt 0) { Write-Host $t } }
+    if ($r.rc -eq 0) { pass "${name}: $($script:PLAY_SITE) video played" } else { fail "${name}: $($script:PLAY_SITE) playback failed" }
+  }
+
+  $base = Stat-Ready; log "$name baseline drawn=[$(Drawn-Of $base)]"
+  if (-not $script:INCLUDE -and (Drawn-Of $base) -match '100[0-9]:') { warn "$name baseline already has external outputs (exclude did not apply?)" }
+
+  Check-Swipe '1' ([string]$script:EXP['right']) "$name/right"
+  Check-Swipe '0' ([string]$script:EXP['left'])  "$name/left"
+  if ($script:EXP['down']) { Check-Swipe '3' $script:EXP['down'] "$name/down" }
+  if ($script:EXP['up'])   { Check-Swipe '2' $script:EXP['up']   "$name/up" }
+
+  $cl = Stat-Ready
+  if (Contain-Of $cl) {
+    Adb @('shell', 'am', 'broadcast', '-a', "$ACTION_PREFIX.SET_CONTAIN", '--ez', 'contain', 'false') | Out-Null
+    $c0 = ''
+    for ($k = 0; $k -lt 4; $k++) { Start-Sleep -Seconds 2; $c0 = Contain-Of (Stat-Ready); if ($c0 -eq '0') { break } }
+    Adb @('shell', 'am', 'broadcast', '-a', "$ACTION_PREFIX.SET_CONTAIN", '--ez', 'contain', 'true') | Out-Null
+    $c1 = ''
+    for ($k = 0; $k -lt 4; $k++) { Start-Sleep -Seconds 2; $c1 = Contain-Of (Stat-Ready); if ($c1 -eq '1') { break } }
+    if ($c0 -eq '0' -and $c1 -eq '1') { pass "$name/contain toggle (0->1)" } else { fail "$name/contain toggle (got $c0->$c1)" }
+  } else { skip "$name/contain (no stats contain= field)" }
+
+  $any = Drawn-Of (Stat-Ready)
+  if ($any -match '100[0-9]:') {
+    $first = $null
+    foreach ($tok in ($any -split ',')) { $pp = $tok -split ':'; if ($pp.Count -ge 1 -and [int]$pp[0] -ge 1000) { $first = [int]$pp[0] - 1000; break } }
+    Adb @('shell', 'am', 'broadcast', '-a', "$ACTION_PREFIX.CLOSE_DISPLAY", '--ei', 'display', [string]$first) | Out-Null
+    Start-Sleep -Seconds 3
+    if (Has-Id ([int]$first) (Drawn-Of (Stat-Ready))) { fail "$name/CLOSE_DISPLAY $first still present" } else { pass "$name/CLOSE_DISPLAY $first" }
+    Adb @('shell', 'am', 'broadcast', '-a', "$ACTION_PREFIX.CLOSE_ALL") | Out-Null
+    Start-Sleep -Seconds 3
+    if (-not ((& $script:ADB -s $script:SERIAL shell pidof $PKG 2>$null | Out-String).Trim())) { pass "$name/CLOSE_ALL -> process exited" } else { fail "$name/CLOSE_ALL did not exit" }
+  } else { skip "$name/close (no external screen attached)" }
+
+  End-Scenario $name $failedBefore
+}
+
+function Run-Matrix {
+  $ext = $script:EXTERNAL_ORDER
+  $total = 10
+  log '################################################################'
+  log "# multi_display FULL MATRIX: $total scenarios, external displays=$(if ($ext) { $ext } else { '<none>' })"
+  log '#   each scenario = fresh launch + checks: baseline / swipe right+left /'
+  log '#   contain 0->1 / CLOSE_DISPLAY / CLOSE_ALL, asserting drawn + skew=0'
+  log '################################################################'
+  $script:MAP = ''; $script:INCLUDE = ''; $script:FORCE_HW = 0; $script:MODE = 'broadcast'
+
+  $script:SOURCE = 'auto'; $script:ORDER = $ext; $script:VIDEO = ''
+  $script:DESC = 'frame source auto (HD video -> HW decode, option B); broadcast right/left swipe to attach external screen + contain + close'
+  Run-One 'src-auto'
+
+  $script:SOURCE = 'hardwarebuffer'; $script:ORDER = $ext; $script:VIDEO = ''
+  $script:DESC = 'frame source hardwarebuffer (HW decode AHardwareBuffer, option B)'
+  Run-One 'src-hardwarebuffer'
+
+  $script:SOURCE = 'software'; $script:ORDER = $ext; $script:VIDEO = ''
+  $script:DESC = 'frame source software (SW decode CPU frames, option C, auto-selects sd-320x240.mp4)'
+  Run-One 'src-software'
+
+  $script:SOURCE = 'testpattern'; $script:ORDER = $ext; $script:VIDEO = ''
+  $script:DESC = 'frame source testpattern (built-in checkerboard self-test, no video/network needed)'
+  Run-One 'src-testpattern'
+
+  $script:SOURCE = 'page'; $script:ORDER = $ext; $script:VIDEO = ''
+  $script:DESC = 'whole-page mirror (built-in page multidisplay.html; app pushes page frames via PixelCopy)'
+  Run-One 'src-page'
+
+  $script:SOURCE = 'page'; $script:ORDER = $ext; $script:VIDEO = ''
+  $script:URL = 'https://www.bilibili.com/h5/vehicle-web/v2'
+  $script:UA = 'Mozilla/5.0 (Linux; Android 6.0.99; AS22L Build/YunOSBuildID) AppleWebKit/537.36 (KHTML, like Gecko) Domono/3.0.0.0 Chrome/150.0.7871.255 Mobile Safari/537.36 Edg/150.0.0.0'
+  $script:PLAY_SITE = 'bilibili'
+  $script:DESC = 'whole-page mirror: bilibili video tab -> music category -> play 2 random videos (1-2s each)'
+  Run-One 'src-page-bili'
+
+  $script:SOURCE = 'page'; $script:ORDER = $ext; $script:VIDEO = ''
+  $script:URL = 'https://www.iqiyi.com/iv#/?ver=bm_zj&dodge=true'
+  $script:PLAY_SITE = 'iqiyi'
+  $script:DESC = 'whole-page mirror: iqiyi plays a non-VIP TV episode 2-3s, mirrored page includes video'
+  Run-One 'src-page-iqiyi'
+  $script:URL = ''; $script:UA = ''; $script:PLAY_SITE = ''
+
+  $script:SOURCE = 'hardwarebuffer'; $script:ORDER = $ext; $script:VIDEO = 'sd-320x240.mp4'; $script:FORCE_HW = 1
+  $script:DESC = 'small video forced HW decode (--enable-features=AfreePreferPlatformVideoDecoder)'
+  Run-One 'force-hw'
+  $script:FORCE_HW = 0
+
+  $script:SOURCE = 'auto'; $script:VIDEO = ''; $script:MODE = 'touch'; $script:ORDER = $ext
+  $script:DESC = 'real touch (input swipe, one finger) to attach external screen'
+  Run-One 'mode-touch'
+  $script:MODE = 'broadcast'
+
+  $script:SOURCE = 'auto'; $script:VIDEO = ''; $script:ORDER = $ext; $script:INCLUDE = $ext
+  $script:DESC = 'include mode (--es displays attaches external screens directly, bypassing exclude)'
+  Run-One 'include-mode'
+  $script:INCLUDE = ''
+
+  log '################################################################'
+  if ($script:FAILED -eq 0) { ok "# FULL MATRIX RESULT: PASS (all $total scenarios)" }
+  else { err "# FULL MATRIX RESULT: FAIL ($($script:FAILED) failure(s) across $total scenarios)" }
+  log '################################################################'
+}
+
+try {
+  if ($script:MATRIX -eq 1) {
+    Run-Matrix
+  } else {
+    $script:DESC = 'single scenario: verify frame source (app default/explicit) + swipe attach + contain + close'
+    Run-One 'single'
+  }
+} finally {
+  Cleanup
+}
+
+Write-Host '--------------------------------------------------'
+if ($script:FAILED -eq 0) {
+  ok 'multi_display PASS'
+  Write-Host 'PASS: multi_display verified'
+  exit 0
+} else {
+  err "multi_display FAIL ($($script:FAILED))"
+  Write-Host "FAIL: multi_display ($($script:FAILED) failure(s))"
+  exit 1
+}
+
diff --git a/android_webview/afree/tools/multi_display_test.sh b/android_webview/afree/tools/multi_display_test.sh
new file mode 100755
index 0000000000..b24d554b03
--- /dev/null
+++ b/android_webview/afree/tools/multi_display_test.sh
@@ -0,0 +1,493 @@
+#!/bin/bash
+# =============================================================================
+# multi_display_test.sh — standalone afree multi_display (multi-screen same-view)
+# regression. Integrated into verify_demo.sh via --multi-display-only.
+#
+# It launches com.afree.demo/.MultiDisplayActivity on a device and verifies:
+#   * baseline: no external screens yet,
+#   * two-finger/single-finger swipe starts the mapped screen (same frame, skew=0),
+#   * runtime aspect toggle (SET_CONTAIN),
+#   * runtime close a screen (CLOSE_DISPLAY) and close-all (CLOSE_ALL -> process exits).
+#
+# Logging uses the same [verify] prefix/format as verify_demo.sh.
+#
+# Usage:
+#   multi_display_test.sh [options]
+#   --device D        adb serial OR physical HOST:PORT (auto-relays on MTU black
+#                     hole). Alias: --serial|-s. Default: $ANDROID_SERIAL/first.
+#   --apk PATH        demo APK (auto-detected like verify_demo.sh by default)
+#   --no-install      use the already-installed app
+#   --relay-mss N     relay MSS (default 1200)
+#   --no-auto-relay   disable relay fallback
+#   --mode M          broadcast | touch   (default broadcast)
+#   --source S        frame source: hardwarebuffer|software|auto|testpattern|page (default auto)
+#                     page = whole WebView page mirrored (app captures via PixelCopy)
+#   --page-hw-video   page mode: keep the WebView video overlay SurfaceControl
+#                     (default disables it so PixelCopy can capture the video;
+#                     with the overlay the mirrored video shows black). HW decode kept.
+#   --video V         <video> for the built-in page (asset name or URL). Defaults to
+#                     sd-320x240.mp4 when --source software (方案C needs a
+#                     software-decoded clip; the HD default is hardware-decoded).
+#   --url U           load this URL instead of the built-in page (real site; with
+#                     --source page this mirrors the real page). Overrides --video.
+#   --ua  U           User-Agent for --url
+#   --include "3,10,11"  include-only mode (--es displays) instead of exclude
+#   --matrix          run the FULL matrix (all frame sources + force-hw + touch +
+#                     include); each scenario is a fresh launch, results aggregate
+#   --order "3,10,11" right = first not-yet-shown, left = last not-yet-shown
+#   --map "right=3,left=11,down=10"  explicit direction -> display id
+#   --force-hw        pass --enable-features=AfreePreferPlatformVideoDecoder
+#   --duration N      settle seconds (default 6)
+# Exit: 0 PASS, 1 FAIL. A missing/uninstalled APK or a non-running activity is a
+# FAIL (with a fix hint), never a silent PASS.
+# =============================================================================
+set -u
+
+# Keep Python helpers (page_play.py -> media_test.py) from writing __pycache__.
+export PYTHONDONTWRITEBYTECODE=1
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+DEF_APK="$SCRIPT_DIR/../demo/build/outputs/apk/release/demo-release.apk"
+
+DEVICE="${ANDROID_SERIAL:-}"
+APK=""
+MODE="broadcast"
+SOURCE="auto"
+VIDEO=""
+INCLUDE=""
+MATRIX=0
+DESC=""
+URL=""
+UA=""
+PLAY_SITE=""
+PAGE_HW_VIDEO=0
+ORDER=""
+MAP=""
+MSS=1200
+ALLOW_RELAY=1
+DO_INSTALL=1
+FORCE_HW=0
+DURATION=6
+
+PKG="com.afree.demo"
+ACT="$PKG/.MultiDisplayActivity"
+ACTION_PREFIX="com.afree.demo.multi_display"
+
+RELAY_PID=""; RELAY_PY=""; SERIAL=""
+
+# ---------- logging (same format as verify_demo.sh) ----------
+c_red=$'\033[0;31m'; c_grn=$'\033[0;32m'; c_yel=$'\033[1;33m'; c_cyn=$'\033[0;36m'; c_nc=$'\033[0m'
+_ts()  { date '+%Y-%m-%d %H:%M:%S'; }
+log()  { echo "${c_cyn}[verify]${c_nc} $(_ts) $*"; }
+ok()   { echo "${c_grn}[verify]${c_nc} $(_ts) ${c_grn}$*${c_nc}"; }
+warn() { echo "${c_yel}[verify]${c_nc} $(_ts) ${c_yel}$*${c_nc}" >&2; }
+err()  { echo "${c_red}[verify]${c_nc} $(_ts) ${c_red}$*${c_nc}" >&2; }
+run_log(){ echo "${c_cyn}[verify]${c_nc} $(_ts) run: ${c_cyn}$*${c_nc}"; }
+
+die(){ err "$*"; exit 2; }
+cleanup(){ [[ -n "$RELAY_PID" ]] && kill "$RELAY_PID" 2>/dev/null || true; [[ -n "$RELAY_PY" ]] && rm -f "$RELAY_PY" || true; }
+trap cleanup EXIT
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --device|--serial|-s) DEVICE="$2"; shift 2 ;;
+    --apk) APK="$2"; shift 2 ;;
+    --no-install) DO_INSTALL=0; shift ;;
+    --relay-mss) MSS="$2"; shift 2 ;;
+    --no-auto-relay) ALLOW_RELAY=0; shift ;;
+    --mode) MODE="$2"; shift 2 ;;
+    --source) SOURCE="$2"; shift 2 ;;
+    --video) VIDEO="$2"; shift 2 ;;
+    --include) INCLUDE="$2"; shift 2 ;;
+    --url) URL="$2"; shift 2 ;;
+    --ua) UA="$2"; shift 2 ;;
+    --page-hw-video) PAGE_HW_VIDEO=1; shift ;;
+    --matrix) MATRIX=1; shift ;;
+    --order) ORDER="$2"; shift 2 ;;
+    --map) MAP="$2"; shift 2 ;;
+    --force-hw) FORCE_HW=1; shift ;;
+    --duration) DURATION="$2"; shift 2 ;;
+    -h|--help) awk 'NR>1{ if ($0 ~ /^#/) print; else exit }' "$0"; exit 0 ;;
+    *) die "unknown option: $1" ;;
+  esac
+done
+
+ADB="${ADB:-adb}"
+command -v "$ADB" >/dev/null 2>&1 || die "adb not found"
+[[ -n "$APK" ]] || APK="$DEF_APK"
+
+# 方案C (software) needs a software-decoded clip: the built-in page default is HD
+# and gets hardware-decoded, so no CPU frame reaches the SDK (drawn stays 0).
+if [[ "$SOURCE" == "software" && -z "$VIDEO" ]]; then
+  VIDEO="sd-320x240.mp4"
+fi
+
+pick_free_port(){ python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()'; }
+
+start_relay(){ # host port listen mss
+  local host="$1" port="$2" listen="$3" mss="$4"
+  command -v python3 >/dev/null 2>&1 || die "python3 required for the relay"
+  RELAY_PY="$(mktemp -t md_relay.XXXXXX.py)"
+  cat > "$RELAY_PY" <<'PY'
+import socket, threading, sys
+th, tp, lp, mss = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
+def pump(a, b):
+    try:
+        while True:
+            d = a.recv(65536)
+            if not d: break
+            b.sendall(d)
+    except Exception: pass
+    finally:
+        for s in (a, b):
+            try: s.shutdown(socket.SHUT_RDWR)
+            except Exception: pass
+def handle(c):
+    u = socket.socket()
+    try: u.setsockopt(socket.IPPROTO_TCP, socket.TCP_MAXSEG, mss)
+    except Exception as e: print("setsockopt:", e, flush=True)
+    try: u.connect((th, tp))
+    except Exception as e:
+        print("connect upstream failed:", e, flush=True); c.close(); return
+    threading.Thread(target=pump, args=(c, u), daemon=True).start()
+    threading.Thread(target=pump, args=(u, c), daemon=True).start()
+srv = socket.socket(); srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+srv.bind(("127.0.0.1", lp)); srv.listen(32)
+print("relay", lp, "->", (th, tp), "MSS", mss, flush=True)
+while True:
+    c, _ = srv.accept(); threading.Thread(target=handle, args=(c,), daemon=True).start()
+PY
+  setsid python3 "$RELAY_PY" "$host" "$port" "$listen" "$mss" >/tmp/md_relay.log 2>&1 </dev/null &
+  RELAY_PID=$!; sleep 1
+  kill -0 "$RELAY_PID" 2>/dev/null || { cat /tmp/md_relay.log >&2; die "relay failed"; }
+  "$ADB" connect "127.0.0.1:$listen" >/dev/null 2>&1 || true
+}
+
+wait_device(){ local s="$1" i; for i in $(seq 1 15); do "$ADB" -s "$s" get-state 2>/dev/null | grep -q '^device' && return 0; sleep 1; done; return 1; }
+
+setup_device(){
+  [[ -z "$DEVICE" ]] && DEVICE="$("$ADB" devices 2>/dev/null | awk 'NR>1 && $2=="device"{print $1; exit}')"
+  [[ -n "$DEVICE" ]] || die "no device: pass --device <serial|host:port>"
+  case "$DEVICE" in
+    *:*)
+      local host="${DEVICE%:*}" port="${DEVICE##*:}"
+      case "$host" in
+        127.0.0.1|localhost)
+          "$ADB" connect "$DEVICE" >/dev/null 2>&1 || true; SERIAL="$DEVICE" ;;
+        *)
+          if [[ "$ALLOW_RELAY" == "1" ]]; then
+            local lp; lp="$(pick_free_port)"; start_relay "$host" "$port" "$lp" "$MSS"
+            SERIAL="127.0.0.1:$lp"; log "relaying $DEVICE via $SERIAL (MSS=$MSS)"
+          else
+            timeout 15 "$ADB" connect "$DEVICE" >/dev/null 2>&1 || true; SERIAL="$DEVICE"
+          fi ;;
+      esac ;;
+    *) SERIAL="$DEVICE" ;;
+  esac
+  wait_device "$SERIAL" || die "device '$SERIAL' unavailable"
+  log "device: $SERIAL"
+}
+
+setup_device
+
+# List the available devices so a wrong/missing target is obvious.
+log "available devices (adb devices -l):"
+"$ADB" devices -l 2>/dev/null | sed 's/^/    /' || true
+
+# Auto-detect the device's external (presentation-capable) display ids.
+list_external_displays(){
+  "$ADB" -s "$SERIAL" shell dumpsys display 2>/dev/null | tr '{' '\n' \
+    | grep -E '^type=EXTERNAL' | grep -oE 'displayId=[0-9]+' | cut -d= -f2 \
+    | sort -n | paste -sd, -
+}
+EXTERNAL_ORDER="$(list_external_displays)"
+if [[ -z "$ORDER" && -z "$MAP" && -z "$INCLUDE" ]]; then
+  ORDER="$EXTERNAL_ORDER"
+fi
+if [[ -n "$EXTERNAL_ORDER" ]]; then
+  log "external (presentation) displays: $EXTERNAL_ORDER"
+else
+  warn "no external (presentation) display found; swipe/close checks will SKIP"
+fi
+
+# ---------- STATS parsing ----------
+stat_line(){ "$ADB" -s "$SERIAL" logcat -d -s 'AfreeMultiDisplay:V' 2>/dev/null | grep -a 'AFREE_MD-STATS' | tail -1; }
+# Wait until a STATS line is available (the 2s cadence can miss a single read,
+# especially over an adb relay); up to ~8s.
+stat_ready(){ local i l=""; for i in 1 2 3 4; do l="$(stat_line)"; [[ -n "$l" ]] && break; sleep 2; done; printf '%s' "$l"; }
+# Poll the contain= field until it reaches $1 (broadcast + 2s STATS cadence).
+contain_until(){ local want="$1" i v=""; for i in 1 2 3 4; do sleep 2; v="$(contain_of "$(stat_ready)")"; [[ "$v" == "$want" ]] && break; done; printf '%s' "$v"; }
+drawn_of(){ printf '%s' "$1" | sed -n 's/.*drawn=\[\([^]]*\)\].*/\1/p'; }
+contain_of(){ printf '%s' "$1" | sed -n 's/.*contain=\([0-9]*\).*/\1/p'; }
+skew_of(){ printf '%s' "$1" | sed -n 's/.*skew=\([0-9]*\).*/\1/p'; }
+has_key(){ printf '%s' "$2" | tr ',' '\n' | awk -F: -v k="$1" '$1==k{print "y"}' | head -1 | grep -q y; }
+has_id(){ has_key "$(( 1000 + $1 ))" "$2"; }
+
+FAILED=0
+pass(){ ok "PASS  $*"; }
+fail(){ err "FAIL  $*"; FAILED=$((FAILED+1)); }
+skip(){ warn "SKIP  $*"; }
+
+# ---------- install once ----------
+FLAGS="--v=1 --enable-logging=stderr"
+
+if [[ "$DO_INSTALL" == "1" ]]; then
+  [[ -f "$APK" ]] || die "APK not found: $APK"
+  log "installing $(basename "$APK") ... (use --no-install to skip)"
+  "$ADB" -s "$SERIAL" install -r -d -t "$APK" >/dev/null 2>&1 || \
+    "$ADB" -s "$SERIAL" install -r -d -t "$APK" >/dev/null 2>&1
+  log "install done"
+fi
+
+# The package must actually be installed; otherwise the launch below would no-op
+# and the checks would be mis-reported as PASS. Fail loudly with a fix hint.
+pkg_installed(){ "$ADB" -s "$SERIAL" shell pm path "$PKG" 2>/dev/null | grep -q 'package:'; }
+present=0
+for _ in 1 2 3; do pkg_installed && { present=1; break; }; sleep 1; done
+if [[ "$present" != "1" ]]; then
+  if [[ "$DO_INSTALL" == "0" ]]; then
+    err "package $PKG is NOT installed on $SERIAL, but --no-install was given."
+    err "  -> install it first, or drop --no-install so this script installs: $APK"
+  else
+    err "package $PKG is NOT installed on $SERIAL after install (APK: $APK)."
+  fi
+  exit 1
+fi
+
+"$ADB" -s "$SERIAL" shell logcat -G 16M >/dev/null 2>&1 || true
+
+geom(){ "$ADB" -s "$SERIAL" shell wm size 2>/dev/null | sed -n 's/.*: //p' | head -1; }
+SIZE="$(geom)"; SW_W="${SIZE%x*}"; SW_H="${SIZE#*x}"; [[ -n "$SW_W" ]] || { SW_W=1920; SW_H=720; }
+
+declare -A EXP
+
+swipe_dir(){ # 0=left 1=right 2=up 3=down
+  local dir="$1"
+  if [[ "$MODE" == "broadcast" ]]; then
+    "$ADB" -s "$SERIAL" shell am broadcast -a "$ACTION_PREFIX.SWIPE" --ei dir "$dir" >/dev/null 2>&1
+  else
+    local x1=$(( SW_W/3 )) y1=$(( SW_H/2 ))
+    local x2="$x1" y2="$y1"
+    case "$dir" in 0) x2=$(( x1 - SW_W/5 ));; 1) x2=$(( x1 + SW_W/5 ));; 2) y2=$(( y1 - SW_H/5 ));; 3) y2=$(( y1 + SW_H/5 ));; esac
+    "$ADB" -s "$SERIAL" shell input swipe "$x1" "$y1" "$x2" "$y2" 400 >/dev/null 2>&1
+  fi
+  sleep 3
+}
+check_swipe(){ # dir expid name
+  local dir="$1" id="$2" name="$3" line d sk
+  swipe_dir "$dir"; line="$(stat_ready)"; d="$(drawn_of "$line")"; sk="$(skew_of "$line")"
+  if [[ -z "$id" || "$id" == "0" ]]; then skip "swipe $name (no external target)"; return; fi
+  if has_id "$id" "$d"; then
+    pass "swipe $name -> display $id (drawn=[$d] skew=$sk)"
+    [[ "$sk" == "0" ]] || fail "swipe $name skew=$sk"
+  elif [[ "$MODE" == "touch" ]]; then
+    # Injected touch may be intercepted by a system window (e.g. a car startup
+    # overlay on the main display); broadcast mode is not affected. Treat as
+    # best-effort skip rather than a failure.
+    skip "swipe $name (touch injection not delivered -> display $id; a system window on top may intercept input; try --mode broadcast)"
+  else
+    fail "swipe $name -> display $id missing (drawn=[$d])"
+  fi
+}
+
+# Print a scenario's end banner and its pass/fail result (failures since $2).
+end_scenario(){
+  local name="$1" n=$(( FAILED - $2 ))
+  if [[ "$n" -eq 0 ]]; then
+    ok "================= END   scenario: $name -> PASS ================="
+  else
+    err "================= END   scenario: $name -> FAIL ($n) ================="
+  fi
+}
+
+# Run ONE scenario using the current globals (SOURCE/VIDEO/MODE/ORDER/MAP/
+# INCLUDE/FORCE_HW, DURATION, DESC): launch, then verify baseline, swipes,
+# contain and close.
+run_one(){ # <scenario name>
+  local name="$1"
+  local video="$VIDEO"
+  [[ "$SOURCE" == "software" && -z "$video" ]] && video="sd-320x240.mp4"
+  local failed_before="$FAILED"
+
+  EXP=()
+  if [[ -n "$MAP" ]]; then
+    IFS=',' read -ra _t <<< "$MAP"
+    for t in "${_t[@]}"; do d="${t%%=*}"; v="${t##*=}"; case "$d" in right|left|up|down) EXP[$d]="$v";; esac; done
+  elif [[ -n "$ORDER" ]]; then
+    IFS=',' read -ra _o <<< "$ORDER"
+    EXP[right]="${_o[0]:-}"; EXP[left]="${_o[${#_o[@]}-1]:-}"
+  fi
+  log "================= BEGIN scenario: $name ================="
+  [[ -n "$DESC" ]] && log "  tests : $DESC"
+  log "  params: source=$SOURCE video=${video:-<default>} mode=$MODE order=${ORDER:-} map=${MAP:-} include=${INCLUDE:-} force_hw=$FORCE_HW"
+  log "  expect: right=${EXP[right]:-<none>} left=${EXP[left]:-<none>} up=${EXP[up]:-<none>} down=${EXP[down]:-<none>}"
+
+  local flags="$FLAGS"
+  [[ "$FORCE_HW" == "1" ]] && flags="$flags --enable-features=AfreePreferPlatformVideoDecoder"
+  "$ADB" -s "$SERIAL" shell "echo '$flags' > /data/local/tmp/webview-command-line"
+  "$ADB" -s "$SERIAL" shell am force-stop "$PKG"
+  "$ADB" -s "$SERIAL" logcat -c 2>/dev/null
+
+  # Build the device-side command with each value single-quoted so the device
+  # shell parses spaces/parentheses (e.g. the UA) correctly. No eval here.
+  local cmd="am start -n $ACT --es source '$SOURCE'"
+  [[ -n "$video" && -z "$URL" ]] && cmd="$cmd --es video '$video'"
+  [[ -n "$URL" ]] && cmd="$cmd --es url '$URL'"
+  [[ -n "$UA" ]] && cmd="$cmd --es ua '$UA'"
+  if [[ -n "$INCLUDE" ]]; then
+    cmd="$cmd --es displays '$INCLUDE'"
+  elif [[ -n "$MAP" ]]; then
+    cmd="$cmd --es exclude '$ORDER' --es map '$MAP'"
+  else
+    cmd="$cmd --es exclude '$ORDER' --es order '$ORDER'"
+  fi
+  [[ "$MODE" == "touch" ]] && cmd="$cmd --ez one_finger true"
+  # page 模式默认软解；--page-hw-video 让 page 模式保留硬解（镜像视频会黑）
+  [[ "$PAGE_HW_VIDEO" == "1" ]] && cmd="$cmd --ez hwvideo true"
+  [[ -n "$PLAY_SITE" ]] && cmd="$cmd -e cr '--force-debug'"   # enable CDP for playback
+  "$ADB" -s "$SERIAL" shell "$cmd" >/dev/null 2>&1
+  sleep "$DURATION"
+
+  local pid; pid="$("$ADB" -s "$SERIAL" shell pidof "$PKG" 2>/dev/null | tr -d '\r')"
+  if [[ -z "$pid" ]]; then
+    err "app not running after launching $ACT."
+    err "  -> $PKG is installed, so either the AAR was built without afree_multi_display"
+    err "     (MultiDisplayActivity disabled) or startup crashed. Rebuild with --multi-display,"
+    err "     and check: adb -s $SERIAL logcat | grep AfreeMultiDisplay"
+    fail "$name: app not running"
+    end_scenario "$name" "$failed_before"
+    return
+  fi
+  pass "$name: app running (pid=$pid)"
+
+  # Real-site page scenarios: drive the site's video(s) so the mirrored page
+  # actually shows playing video (iqiyi 1 episode, bilibili 2 FM videos).
+  if [[ -n "$PLAY_SITE" ]]; then
+    local sec="2.0" cnt="1"
+    [[ "$PLAY_SITE" == "bilibili" ]] && { sec="1.5"; cnt="2"; }
+    [[ "$PLAY_SITE" == "iqiyi" ]] && { sec="2.5"; cnt="1"; }
+    local ua_args=(); [[ -n "$UA" ]] && ua_args=(--ua "$UA")
+    log "$name: driving $PLAY_SITE playback via CDP (count=$cnt sec=$sec) ..."
+    if timeout 200 python3 "$SCRIPT_DIR/page_play.py" --device "$SERIAL" \
+        --site "$PLAY_SITE" --seconds "$sec" --count "$cnt" "${ua_args[@]}"; then
+      pass "$name: $PLAY_SITE video played"
+    else
+      fail "$name: $PLAY_SITE playback failed"
+    fi
+  fi
+
+  local base; base="$(stat_ready)"; log "$name baseline drawn=[$(drawn_of "$base")]"
+  if [[ -z "$INCLUDE" ]] && printf '%s' "$(drawn_of "$base")" | grep -q '100[0-9]:'; then
+    warn "$name baseline already has external outputs (exclude did not apply?)"
+  fi
+
+  check_swipe 1 "${EXP[right]:-}" "$name/right"
+  check_swipe 0 "${EXP[left]:-}"  "$name/left"
+  [[ -n "${EXP[down]:-}" ]] && check_swipe 3 "${EXP[down]}" "$name/down"
+  [[ -n "${EXP[up]:-}" ]]   && check_swipe 2 "${EXP[up]}"   "$name/up"
+
+  local cl; cl="$(stat_ready)"
+  if [[ -n "$(contain_of "$cl")" ]]; then
+    "$ADB" -s "$SERIAL" shell am broadcast -a "$ACTION_PREFIX.SET_CONTAIN" --ez contain false >/dev/null 2>&1
+    local c0; c0="$(contain_until 0)"
+    "$ADB" -s "$SERIAL" shell am broadcast -a "$ACTION_PREFIX.SET_CONTAIN" --ez contain true >/dev/null 2>&1
+    local c1; c1="$(contain_until 1)"
+    [[ "$c0" == "0" && "$c1" == "1" ]] && pass "$name/contain toggle (0->1)" || fail "$name/contain toggle (got $c0->$c1)"
+  else
+    skip "$name/contain (no stats contain= field)"
+  fi
+
+  local any; any="$(drawn_of "$(stat_ready)")"
+  if printf '%s' "$any" | grep -q '100[0-9]:'; then
+    local first; first="$(printf '%s' "$any" | tr ',' '\n' | awk -F: '$1>=1000{print $1-1000; exit}')"
+    "$ADB" -s "$SERIAL" shell am broadcast -a "$ACTION_PREFIX.CLOSE_DISPLAY" --ei display "$first" >/dev/null 2>&1
+    sleep 3
+    if has_id "$first" "$(drawn_of "$(stat_ready)")"; then fail "$name/CLOSE_DISPLAY $first still present"; else pass "$name/CLOSE_DISPLAY $first"; fi
+    "$ADB" -s "$SERIAL" shell am broadcast -a "$ACTION_PREFIX.CLOSE_ALL" >/dev/null 2>&1
+    sleep 3
+    if [[ -z "$("$ADB" -s "$SERIAL" shell pidof "$PKG" 2>/dev/null | tr -d '\r')" ]]; then pass "$name/CLOSE_ALL -> process exited"; else fail "$name/CLOSE_ALL did not exit"; fi
+  else
+    skip "$name/close (no external screen attached)"
+  fi
+
+  end_scenario "$name" "$failed_before"
+}
+
+# Full matrix: every frame source, forced-HW small clip, touch mode, include mode.
+run_matrix(){
+  local ext="$EXTERNAL_ORDER"
+  local total=10
+  log "################################################################"
+  log "# multi_display FULL MATRIX: ${total} scenarios, external displays=${ext:-<none>}"
+  log "#   each scenario = fresh launch + checks: baseline / swipe right+left /"
+  log "#   contain 0->1 / CLOSE_DISPLAY / CLOSE_ALL, asserting drawn + skew=0"
+  log "################################################################"
+  MAP=""; INCLUDE=""; FORCE_HW=0; MODE=broadcast
+
+  SOURCE=auto; ORDER="$ext"; VIDEO=""
+  DESC="frame source auto (HD video -> HW decode, option B); broadcast right/left swipe to attach external screen + contain + close"
+  run_one "src-auto"
+
+  SOURCE=hardwarebuffer; ORDER="$ext"; VIDEO=""
+  DESC="frame source hardwarebuffer (HW decode AHardwareBuffer, option B)"
+  run_one "src-hardwarebuffer"
+
+  SOURCE=software; ORDER="$ext"; VIDEO=""
+  DESC="frame source software (SW decode CPU frames, option C, auto-selects sd-320x240.mp4)"
+  run_one "src-software"
+
+  SOURCE=testpattern;    ORDER="$ext"; VIDEO=""
+  DESC="frame source testpattern (built-in checkerboard self-test, no video/network needed)"
+  run_one "src-testpattern"
+
+  SOURCE=page;           ORDER="$ext"; VIDEO=""
+  DESC="whole-page mirror (built-in page multidisplay.html; app pushes page frames via PixelCopy)"
+  run_one "src-page"
+
+  SOURCE=page; ORDER="$ext"; VIDEO=""
+  URL='https://www.bilibili.com/h5/vehicle-web/v2'
+  UA='Mozilla/5.0 (Linux; Android 6.0.99; AS22L Build/YunOSBuildID) AppleWebKit/537.36 (KHTML, like Gecko) Domono/3.0.0.0 Chrome/150.0.7871.255 Mobile Safari/537.36 Edg/150.0.0.0'
+  PLAY_SITE=bilibili
+  DESC="whole-page mirror: bilibili video tab -> music category -> play 2 random videos (1-2s each)"
+  run_one "src-page-bili"
+
+  SOURCE=page; ORDER="$ext"; VIDEO=""
+  URL='https://www.iqiyi.com/iv#/?ver=bm_zj&dodge=true'
+  PLAY_SITE=iqiyi
+  DESC="whole-page mirror: iqiyi plays a non-VIP TV episode 2-3s, mirrored page includes video"
+  run_one "src-page-iqiyi"
+  URL=""; UA=""; PLAY_SITE=""
+
+  SOURCE=hardwarebuffer; ORDER="$ext"; VIDEO="sd-320x240.mp4"; FORCE_HW=1
+  DESC="small video forced HW decode (--enable-features=AfreePreferPlatformVideoDecoder)"
+  run_one "force-hw"
+  FORCE_HW=0
+
+  SOURCE=auto; VIDEO=""; MODE=touch; ORDER="$ext"
+  DESC="real touch (input swipe, one finger) to attach external screen"
+  run_one "mode-touch"
+  MODE=broadcast
+
+  SOURCE=auto; VIDEO=""; ORDER="$ext"; INCLUDE="$ext"
+  DESC="include mode (--es displays attaches external screens directly, bypassing exclude)"
+  run_one "include-mode"
+  INCLUDE=""
+
+  log "################################################################"
+  if [[ "$FAILED" -eq 0 ]]; then
+    ok "# FULL MATRIX RESULT: PASS (all ${total} scenarios)"
+  else
+    err "# FULL MATRIX RESULT: FAIL (${FAILED} failure(s) across ${total} scenarios)"
+  fi
+  log "################################################################"
+}
+
+if [[ "$MATRIX" == "1" ]]; then
+  run_matrix
+else
+  DESC="single scenario: verify frame source (app default/explicit) + swipe attach + contain + close"
+  run_one "single"
+fi
+
+echo "--------------------------------------------------"
+if [[ "$FAILED" -eq 0 ]]; then ok "multi_display PASS"; exit 0; else err "multi_display FAIL ($FAILED)"; exit 1; fi
