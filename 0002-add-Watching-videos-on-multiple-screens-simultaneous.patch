+    private String[] intentExtraDisplays(String name) {
+        // Accept either --eia (int[]) or --es "a,b,c".
+        int[] ints = getIntent().getIntArrayExtra(name);
+        if (ints != null && ints.length > 0) {
+            String[] out = new String[ints.length];
+            for (int i = 0; i < ints.length; ++i) {
+                out[i] = Integer.toString(ints[i]);
+            }
+            return out;
+        }
+        String s = getIntent().getStringExtra(name);
+        if (s == null || s.isEmpty()) {
+            return new String[0];
+        }
+        return s.split("[,\\s]+");
+    }
+
+    private Set<Integer> parseIntSet(String[] tokens) {
+        Set<Integer> set = new HashSet<>();
+        for (String t : tokens) {
+            try {
+                set.add(Integer.parseInt(t.trim()));
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return set;
+    }
+
+    // Create a Presentation + SurfaceView on each selected public display and
+    // attach it to the SDK fan-out, so the same video shows on multiple screens.
+    private void setupExternalDisplays(Set<Integer> include, Set<Integer> exclude) {
+        DisplayManager dm = (DisplayManager) getSystemService(DISPLAY_SERVICE);
+        if (dm == null) {
+            return;
+        }
+        for (final Display display : dm.getDisplays()) {
+            final int id = display.getDisplayId();
+            if (id == Display.DEFAULT_DISPLAY) {
+                continue;
+            }
+            if ((display.getFlags() & Display.FLAG_PRESENTATION) == 0) {
+                continue;  // not a public/secondary presentation display
+            }
+            if (!include.isEmpty() && !include.contains(id)) {
+                continue;
+            }
+            if (exclude.contains(id)) {
+                continue;
+            }
+            showPresentationFor(display);
+        }
+    }
+
+    // Create a Presentation + SurfaceView on |display| and attach it. No-op (with
+    // a log) if it is already managed or not a public presentation display.
+    private boolean showPresentationFor(Display display) {
+        final int id = display.getDisplayId();
+        if (mDisplayPresentations.containsKey(id)) {
+            return true;
+        }
+        if ((display.getFlags() & Display.FLAG_PRESENTATION) == 0) {
+            Log.w(TAG, "display=" + id + " is not a presentation display");
+            return false;
+        }
+        final int key = 1000 + id;  // avoid clashing with local ids 0/1
+        final Presentation presentation = new Presentation(this, display);
+        SurfaceView sv = new SurfaceView(this);
+        sv.getHolder().addCallback(new SurfaceHolder.Callback() {
+            @Override
+            public void surfaceCreated(SurfaceHolder holder) {}
+
+            @Override
+            public void surfaceChanged(SurfaceHolder holder, int format, int w, int h) {
+                boolean ok = AfreeMultiDisplay.attachSurface(
+                        key, holder.getSurface(), w, h);
+                Log.i(TAG, "attachSurface(ext) display=" + id + " " + w + "x" + h
+                        + " -> " + ok);
+            }
+
+            @Override
+            public void surfaceDestroyed(SurfaceHolder holder) {
+                AfreeMultiDisplay.detachSurface(key);
+            }
+        });
+        presentation.setContentView(sv);
+        try {
+            presentation.show();
+            mDisplayPresentations.put(id, presentation);
+            Log.i(TAG, "presentation shown on display=" + id + " "
+                    + display.getMode().getPhysicalWidth() + "x"
+                    + display.getMode().getPhysicalHeight());
+            return true;
+        } catch (Exception e) {
+            Log.w(TAG, "presentation on display=" + id + " failed: " + e);
+            return false;
+        }
+    }
+
+    private void parseSwipeMapping() {
+        // --es map "right=3,left=11,down=10,up=0"
+        String map = getIntent().getStringExtra("map");
+        if (map != null && !map.isEmpty()) {
+            for (String tok : map.split("[,\\s]+")) {
+                String[] kv = tok.split("=");
+                if (kv.length != 2) {
+                    continue;
+                }
+                int id;
+                try {
+                    id = Integer.parseInt(kv[1].trim());
+                } catch (NumberFormatException e) {
+                    continue;
+                }
+                switch (kv[0].trim().toLowerCase()) {
+                    case "left": mMapLeft = id; break;
+                    case "right": mMapRight = id; break;
+                    case "up": mMapUp = id; break;
+                    case "down": mMapDown = id; break;
+                }
+            }
+        }
+        // Individual overrides: --es map_right 3  (or --ei map_right 3)
+        mMapLeft = pick(mMapLeft, intExtra("map_left"));
+        mMapRight = pick(mMapRight, intExtra("map_right"));
+        mMapUp = pick(mMapUp, intExtra("map_up"));
+        mMapDown = pick(mMapDown, intExtra("map_down"));
+
+        // --es order "3,10,11": right = first not-yet-shown, left = last.
+        String order = getIntent().getStringExtra("order");
+        if (order != null && !order.isEmpty()) {
+            String[] toks = order.split("[,\\s]+");
+            mOrder = new int[toks.length];
+            for (int i = 0; i < toks.length; ++i) {
+                try {
+                    mOrder[i] = Integer.parseInt(toks[i].trim());
+                } catch (NumberFormatException e) {
+                    mOrder[i] = -1;
+                }
+            }
+        }
+    }
+
+    private static int pick(int cur, int override) {
+        return override >= 0 ? override : cur;
+    }
+
+    private int intExtra(String name) {
+        int[] a = getIntent().getIntArrayExtra(name);
+        if (a != null && a.length > 0) {
+            return a[0];
+        }
+        String s = getIntent().getStringExtra(name);
+        if (s != null && !s.isEmpty()) {
+            try {
+                return Integer.parseInt(s.trim());
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return -1;
+    }
+
+    private Display getDisplayById(int id) {
+        DisplayManager dm = (DisplayManager) getSystemService(DISPLAY_SERVICE);
+        return dm == null ? null : dm.getDisplay(id);
+    }
+
+    private int resolveTargetDisplay(int direction) {
+        int id = -1;
+        switch (direction) {
+            case DIR_LEFT: id = mMapLeft; break;
+            case DIR_RIGHT: id = mMapRight; break;
+            case DIR_UP: id = mMapUp; break;
+            case DIR_DOWN: id = mMapDown; break;
+        }
+        if (id >= 0) {
+            return id;
+        }
+        // Fallback: use --es order for horizontal directions.
+        if (direction == DIR_RIGHT) {
+            for (int o : mOrder) {
+                if (o >= 0 && !mDisplayPresentations.containsKey(o)) {
+                    return o;
+                }
+            }
+        } else if (direction == DIR_LEFT) {
+            for (int i = mOrder.length - 1; i >= 0; --i) {
+                if (mOrder[i] >= 0 && !mDisplayPresentations.containsKey(mOrder[i])) {
+                    return mOrder[i];
+                }
+            }
+        }
+        return -1;
+    }
+
+    // A two-finger swipe in |direction| starts same-view on the mapped screen if
+    // it exists and is not already showing the video.
+    private void onDirectionalSwipe(int direction) {
+        final int id = resolveTargetDisplay(direction);
+        if (id < 0) {
+            Log.i(TAG, "swipe dir=" + direction + " has no target display");
+            Toast.makeText(this, "no screen mapped for dir " + direction,
+                    Toast.LENGTH_SHORT).show();
+            return;
+        }
+        if (id == Display.DEFAULT_DISPLAY) {
+            // The main screen already shows the video (local outputs 0/1); it is
+            // not a presentation display, so there is nothing to start.
+            Log.i(TAG, "swipe dir=" + direction
+                    + " maps to the main display (already showing); ignored");
+            Toast.makeText(this, "display 0 is the main screen (already showing)",
+                    Toast.LENGTH_SHORT).show();
+            return;
+        }
+        if (mDisplayPresentations.containsKey(id)) {
+            Log.i(TAG, "swipe dir=" + direction + " display=" + id
+                    + " already showing");
+            Toast.makeText(this, "display " + id + " already showing",
+                    Toast.LENGTH_SHORT).show();
+            return;
+        }
+        Display d = getDisplayById(id);
+        if (d == null) {
+            Log.w(TAG, "swipe target display=" + id + " not found");
+            return;
+        }
+        boolean ok = showPresentationFor(d);
+        Log.i(TAG, "swipe dir=" + direction + " -> display=" + id + " started=" + ok);
+        Toast.makeText(this, "same-view on display " + id + (ok ? "" : " failed"),
+                Toast.LENGTH_SHORT).show();
+    }
+
+    private int dpToPx(int dp) {
+        return Math.round(dp * getResources().getDisplayMetrics().density);
+    }
+
+    private static float centroidX(MotionEvent e) {
+        float s = 0f;
+        for (int i = 0; i < e.getPointerCount(); ++i) {
+            s += e.getX(i);
+        }
+        return s / e.getPointerCount();
+    }
+
+    private static float centroidY(MotionEvent e) {
+        float s = 0f;
+        for (int i = 0; i < e.getPointerCount(); ++i) {
+            s += e.getY(i);
+        }
+        return s / e.getPointerCount();
+    }
+
+    private void setSwipeEnabled(boolean enabled) {
+        mSwipeEnabled = enabled;
+        Log.w(TAG, "swipe enabled=" + enabled);
+        Toast.makeText(this, "swipe " + (enabled ? "on" : "off"),
+                Toast.LENGTH_SHORT).show();
+    }
+
+    private void setSwipeMode(String mode) {
+        if (mode == null) {
+            return;
+        }
+        if ("single".equalsIgnoreCase(mode) || "one".equalsIgnoreCase(mode)) {
+            mOneFingerSwipe = true;
+        } else if ("double".equalsIgnoreCase(mode) || "two".equalsIgnoreCase(mode)) {
+            mOneFingerSwipe = false;
+        }
+        Log.w(TAG, "swipe mode oneFinger=" + mOneFingerSwipe);
+        Toast.makeText(this, "swipe mode " + (mOneFingerSwipe ? "single" : "double"),
+                Toast.LENGTH_SHORT).show();
+    }
+
+    // Observe two-finger swipes on the WebView; single-finger events pass
+    // through so normal <video> controls keep working.
+    // Observe swipes on the WebView. Finger count: two (default) or one
+    // (mOneFingerSwipe, for cloud-device mouse simulation). In two-finger mode
+    // single-finger events pass through so <video> controls keep working.
+    private void installSwipeGesture() {
+        final int threshold = dpToPx(80);
+        mWebView.setOnTouchListener(new View.OnTouchListener() {
+            private boolean mActive = false;
+            private boolean mFired = false;
+            private float mX0 = 0f;
+            private float mY0 = 0f;
+
+            private void begin(MotionEvent e) {
+                mActive = true;
+                mFired = false;
+                mX0 = centroidX(e);
+                mY0 = centroidY(e);
+            }
+
+            @Override
+            public boolean onTouch(View v, MotionEvent e) {
+                if (!mSwipeEnabled) {
+                    mActive = false;
+                    mFired = false;
+                    return false;
+                }
+                final int pointers = e.getPointerCount();
+                switch (e.getActionMasked()) {
+                    case MotionEvent.ACTION_DOWN:
+                        if (mOneFingerSwipe && pointers == 1) {
+                            begin(e);
+                        }
+                        break;
+                    case MotionEvent.ACTION_POINTER_DOWN:
+                        if (!mOneFingerSwipe && pointers == 2) {
+                            begin(e);
+                        }
+                        break;
+                    case MotionEvent.ACTION_MOVE:
+                        if (mActive && !mFired) {
+                            final float dx = centroidX(e) - mX0;
+                            final float dy = centroidY(e) - mY0;
+                            if (Math.abs(dx) > threshold || Math.abs(dy) > threshold) {
+                                mFired = true;
+                                if (Math.abs(dx) >= Math.abs(dy)) {
+                                    onDirectionalSwipe(dx > 0 ? DIR_RIGHT : DIR_LEFT);
+                                } else {
+                                    onDirectionalSwipe(dy > 0 ? DIR_DOWN : DIR_UP);
+                                }
+                            }
+                        }
+                        if (mActive && mFired) {
+                            return true;  // consume the rest of this gesture
+                        }
+                        break;
+                    case MotionEvent.ACTION_POINTER_UP:
+                        if (!mOneFingerSwipe) {
+                            mActive = false;
+                            mFired = false;
+                        }
+                        break;
+                    case MotionEvent.ACTION_UP:
+                    case MotionEvent.ACTION_CANCEL:
+                        mActive = false;
+                        mFired = false;
+                        break;
+                    default:
+                        break;
+                }
+                return false;
+            }
+        });
+    }
+
+    // Runtime control: close one display; close the process when none is left.
+    private void closeDisplay(int id) {
+        Presentation p = mDisplayPresentations.remove(id);
+        if (p != null) {
+            p.dismiss();
+            AfreeMultiDisplay.detachSurface(1000 + id);
+            Log.i(TAG, "closed display=" + id + " remaining="
+                    + mDisplayPresentations.keySet());
+        } else {
+            Log.w(TAG, "closeDisplay: display=" + id + " not managed");
+        }
+        if (mDisplayPresentations.isEmpty()) {
+            Log.i(TAG, "no managed displays left -> finishing process");
+            finishAndRemoveTask();
+            android.os.Process.killProcess(android.os.Process.myPid());
+        }
+    }
+
+    private void closeAllDisplays() {
+        for (Integer id : new ArrayList<>(mDisplayPresentations.keySet())) {
+            Presentation p = mDisplayPresentations.remove(id);
+            if (p != null) {
+                p.dismiss();
+                AfreeMultiDisplay.detachSurface(1000 + id);
+            }
+        }
+        Log.i(TAG, "closed all displays -> finishing process");
+        finishAndRemoveTask();
+        android.os.Process.killProcess(android.os.Process.myPid());
+    }
+
+    private void registerControlReceiver() {
+        mControlReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                String action = intent.getAction();
+                Log.i(TAG, "control broadcast action=" + action
+                        + " display=" + intent.getIntExtra("display", -1));
+                if (ACTION_CLOSE_DISPLAY.equals(action)) {
+                    closeDisplay(intent.getIntExtra("display", -1));
+                } else if (ACTION_CLOSE_ALL.equals(action)) {
+                    closeAllDisplays();
+                } else if (ACTION_SET_CONTAIN.equals(action)) {
+                    boolean contain = intent.getBooleanExtra("contain", true);
+                    AfreeMultiDisplay.setContain(contain);
+                    Log.i(TAG, "setContain=" + contain);
+                } else if (ACTION_SWIPE.equals(action)) {
+                    onDirectionalSwipe(intent.getIntExtra("dir", DIR_RIGHT));
+                } else if (ACTION_SET_SWIPE.equals(action)) {
+                    setSwipeEnabled(intent.getBooleanExtra("enabled", true));
+                } else if (ACTION_SET_SWIPE_MODE.equals(action)) {
+                    setSwipeMode(intent.getStringExtra("mode"));
+                }
+            }
+        };
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(ACTION_CLOSE_DISPLAY);
+        filter.addAction(ACTION_CLOSE_ALL);
+        filter.addAction(ACTION_SET_CONTAIN);
+        filter.addAction(ACTION_SWIPE);
+        filter.addAction(ACTION_SET_SWIPE);
+        filter.addAction(ACTION_SET_SWIPE_MODE);
+        // RECEIVER_EXPORTED so `adb shell am broadcast` can reach it (required
+        // on Android 13+ for non-system broadcast actions).
+        registerReceiver(mControlReceiver, filter, Context.RECEIVER_EXPORTED);
+    }
+
+    private void addSurfaceView(LinearLayout parent) {
+        final int displayId = mNextSurfaceId++;
+        SurfaceView surfaceView = new SurfaceView(this);
+        surfaceView.getHolder().addCallback(new SurfaceHolder.Callback() {
+            @Override
+            public void surfaceCreated(SurfaceHolder holder) {}
+
+            @Override
+            public void surfaceChanged(SurfaceHolder holder, int format, int w, int h) {
+                Surface surface = holder.getSurface();
+                boolean ok = AfreeMultiDisplay.attachSurface(displayId, surface, w, h);
+                Log.i(TAG, "attachSurface id=" + displayId + " " + w + "x" + h
+                        + " -> " + ok);
+            }
+
+            @Override
+            public void surfaceDestroyed(SurfaceHolder holder) {
+                AfreeMultiDisplay.detachSurface(displayId);
+                Log.i(TAG, "detachSurface id=" + displayId);
+            }
+        });
+        parent.addView(surfaceView, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+    }
+
+    // ==================== built-in help (assets/multi_display_help.md) ====================
+
+    private void showHelp() {
+        // The multi_display help is the SDK help doc (docs/multi_display_help.md),
+        // copied into the (gated) assets by build.gradle -> single source of truth.
+        String md = readMdContent("file:///android_asset/multi_display_help.md");
+        if (md == null) {
+            Log.w(TAG, "showHelp: multi_display_help.md not found");
+            return;
+        }
+        mWebView.loadDataWithBaseURL(null, mdToHtml(md), "text/html", "UTF-8", null);
+        Log.i(TAG, "\n" + md);
+    }
+
+    private String mdToHtml(String md) {
+        if (mMarkdownCss == null) {
+            mMarkdownCss = readAsset("md.css");
+        }
+        if (mHtmlTemplate == null) {
+            mHtmlTemplate = readAsset("template.html");
+        }
+        String body = mMarkdownRenderer.render(mMarkdownParser.parse(md));
+        return mHtmlTemplate.replace("{{style}}", mMarkdownCss)
+                .replace("{{body}}", body);
+    }
+
+    private String readMdContent(String url) {
+        InputStream is = null;
+        try {
+            if (url.startsWith("file:///android_asset/")) {
+                is = getAssets().open(url.substring("file:///android_asset/".length()));
+            } else if (url.startsWith("file://")) {
+                is = new FileInputStream(new File(url.substring("file://".length())));
+            } else {
+                is = new FileInputStream(new File(url));
+            }
+            BufferedReader reader = new BufferedReader(new InputStreamReader(is, "UTF-8"));
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) {
+                sb.append(line).append("\n");
+            }
+            reader.close();
+            return sb.toString();
+        } catch (Exception e) {
+            return null;
+        } finally {
+            if (is != null) {
+                try {
+                    is.close();
+                } catch (Exception ignored) {
+                }
+            }
+        }
+    }
+
+    private String readAsset(String path) {
+        try (InputStream is = getAssets().open(path)) {
+            BufferedReader r = new BufferedReader(new InputStreamReader(is, "UTF-8"));
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = r.readLine()) != null) {
+                sb.append(line).append("\n");
+            }
+            return sb.toString();
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    // ==================== page same-view (source "page") ====================
+
+    private void schedulePageCapture() {
+        if (!mPageMode) {
+            return;
+        }
+        mPageHandler.postDelayed(this::capturePageOnce, PAGE_FRAME_MS);
+    }
+
+    @SuppressLint("NewApi")
+    private void capturePageOnce() {
+        if (!mPageMode || isFinishing() || isDestroyed()) {
+            return;
+        }
+        final int w = mWebView.getWidth();
+        final int h = mWebView.getHeight();
+        if (w <= 0 || h <= 0 || Build.VERSION.SDK_INT < Build.VERSION_CODES.O) {
+            schedulePageCapture();
+            return;
+        }
+        if (mPageBitmap == null || mPageBitmap.getWidth() != w
+                || mPageBitmap.getHeight() != h) {
+            mPageBitmap = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+            mPageBuffer = ByteBuffer.allocateDirect(w * h * 4);
+        }
+        final int[] loc = new int[2];
+        mWebView.getLocationInWindow(loc);
+        final Rect rect = new Rect(loc[0], loc[1], loc[0] + w, loc[1] + h);
+        try {
+            PixelCopy.request(getWindow(), rect, mPageBitmap, result -> {
+                if (result == PixelCopy.SUCCESS) {
+                    if (mSavePageDebug) {
+                        long now = android.os.SystemClock.uptimeMillis();
+                        if (now - mLastDebugSave > 2000) {
+                            mLastDebugSave = now;
+                            try {
+                                File f = new File(getFilesDir(), "page_cap.png");
+                                try (FileOutputStream os = new FileOutputStream(f)) {
+                                    mPageBitmap.compress(Bitmap.CompressFormat.PNG, 100, os);
+                                }
+                                Log.i(TAG, "saved page capture -> " + f.getAbsolutePath());
+                            } catch (Exception e) {
+                                Log.w(TAG, "save page capture failed: " + e);
+                            }
+                        }
+                    }
+                    // ARGB_8888 -> raw (BGRA) bytes; native converts to RGBA.
+                    mPageBitmap.copyPixelsToBuffer(mPageBuffer);
+                    mPageBuffer.rewind();
+                    AfreeMultiDisplay.submitPageFrame(w, h, w * 4, mPageBuffer);
+                }
+                schedulePageCapture();
+            }, mPageHandler);
+        } catch (Exception e) {
+            Log.w(TAG, "page capture failed: " + e);
+            schedulePageCapture();
+        }
+    }
+
+    @Override
+    protected void onDestroy() {
+        mPageMode = false;
+        mPageHandler.removeCallbacksAndMessages(null);
+        if (mControlReceiver != null) {
+            try {
+                unregisterReceiver(mControlReceiver);
+            } catch (Exception ignored) {
+            }
+            mControlReceiver = null;
+        }
+        for (Presentation p : mDisplayPresentations.values()) {
+            p.dismiss();
+        }
+        mDisplayPresentations.clear();
+        AfreeMultiDisplay.detachAll();
+        super.onDestroy();
+    }
+}
