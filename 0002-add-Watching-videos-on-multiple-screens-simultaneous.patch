diff --git a/android_webview/afree/demo/src/multiDisplay/assets/multidisplay.html b/android_webview/afree/demo/src/multiDisplay/assets/multidisplay.html
new file mode 100644
index 0000000000..6200634eeb
--- /dev/null
+++ b/android_webview/afree/demo/src/multiDisplay/assets/multidisplay.html
@@ -0,0 +1,39 @@
+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>afree multi_display</title>
+<style>
+  html, body { margin: 0; padding: 0; height: 100%; background: #000; }
+  video { width: 100%; height: 100%; object-fit: contain; }
+</style>
+</head>
+<body>
+<video id="v" autoplay muted loop playsinline></video>
+<script>
+  var v = document.getElementById('v');
+  // Default: bundled 1280x720 H.264 (hardware-decoded on device).
+  // Test content can be overridden via ?src=<url|asset-relative-name>.
+  var src = 'bear-1280x720.mp4';
+  try {
+    var q = new URLSearchParams(location.search).get('src');
+    if (q) { src = q; }
+  } catch (e) { /* URLSearchParams unavailable: keep default */ }
+  v.src = src;
+  function play() {
+    var p = v.play();
+    if (p && p.catch) { p.catch(function (e) { document.title = 'play: ' + e; }); }
+  }
+  v.addEventListener('canplay', play);
+  v.addEventListener('timeupdate', function () {
+    document.title = 't=' + v.currentTime.toFixed(2) + ' paused=' + v.paused
+        + ' vw=' + v.videoWidth;
+  });
+  v.addEventListener('error', function () {
+    document.title = 'err=' + (v.error ? v.error.code : '?');
+  });
+  play();
+</script>
+</body>
+</html>
