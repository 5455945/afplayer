+#define AFREE_MD_TAG "AfreeMultiDisplay"
+#define AFREE_MD_LOGI(...) __android_log_print(ANDROID_LOG_INFO, AFREE_MD_TAG, __VA_ARGS__)
+#define AFREE_MD_LOGE(...) __android_log_print(ANDROID_LOG_ERROR, AFREE_MD_TAG, __VA_ARGS__)
