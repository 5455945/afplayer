+/**
+ * MultiDisplayDemo: consumes the afree SDK AAR's multi_display API.
+ *
+ * <p>A single afree WebView plays a local video; the decoded frame is fanned out
+ * by the SDK to every Surface attached through {@link AfreeMultiDisplay}. This
+ * demo uses two SurfaceViews on the main display to show that both receive the
+ * same frame (multi-screen same-view).
+ */
+public class MultiDisplayActivity extends Activity {
+    private static final String TAG = "AfreeDemo";
+
+    public static final String ACTION_CLOSE_DISPLAY = "com.afree.demo.multi_display.CLOSE_DISPLAY";
+    public static final String ACTION_CLOSE_ALL = "com.afree.demo.multi_display.CLOSE_ALL";
+    public static final String ACTION_SET_CONTAIN = "com.afree.demo.multi_display.SET_CONTAIN";
+    // Debug/test: trigger a directional "swipe" (0=left,1=right,2=up,3=down).
