+AfreeSurfaceFanout::~AfreeSurfaceFanout() {
+  Shutdown();
+}
+
+bool AfreeSurfaceFanout::Initialize(EGLContext share_context) {
+  if (initialized_) {
+    return true;
+  }
+  display_ = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+  if (display_ == EGL_NO_DISPLAY) {
+    AFREE_MD_LOGE("eglGetDisplay failed");
+    return false;
+  }
+  EGLint major = 0, minor = 0;
+  if (!eglInitialize(display_, &major, &minor)) {
+    AFREE_MD_LOGE("eglInitialize failed: 0x%x", eglGetError());
+    return false;
+  }
+  if (!eglBindAPI(EGL_OPENGL_ES_API)) {
+    AFREE_MD_LOGE("eglBindAPI failed: 0x%x", eglGetError());
+    return false;
+  }
+
+  // Resolve EGLImage import entry points (方案 B). Optional: if unavailable,
+  // DrawHardwareBuffer() reports unsupported and we keep using textures.
+  egl_get_native_client_buffer_ =
+      reinterpret_cast<void*>(eglGetProcAddress("eglGetNativeClientBufferANDROID"));
+  egl_create_image_ =
+      reinterpret_cast<void*>(eglGetProcAddress("eglCreateImageKHR"));
+  egl_destroy_image_ =
+      reinterpret_cast<void*>(eglGetProcAddress("eglDestroyImageKHR"));
+  gl_egl_image_target_oes_ =
+      reinterpret_cast<void*>(eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+  hb_supported_ = egl_get_native_client_buffer_ && egl_create_image_ &&
+                  egl_destroy_image_ && gl_egl_image_target_oes_;
+  AFREE_MD_LOGI("EGLImage import supported=%d", hb_supported_ ? 1 : 0);
+
+  const EGLint config_attribs[] = {
+      EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+      EGL_SURFACE_TYPE,    EGL_WINDOW_BIT,
+      EGL_RED_SIZE,        8,
+      EGL_GREEN_SIZE,      8,
+      EGL_BLUE_SIZE,       8,
+      EGL_ALPHA_SIZE,      8,
+      EGL_NONE};
+  EGLint num_configs = 0;
+  if (!eglChooseConfig(display_, config_attribs, &config_, 1, &num_configs) ||
+      num_configs < 1) {
+    AFREE_MD_LOGE("eglChooseConfig failed: 0x%x", eglGetError());
+    return false;
+  }
+
+  const EGLint context_attribs[] = {EGL_CONTEXT_CLIENT_VERSION, 2, EGL_NONE};
+  context_ = eglCreateContext(display_, config_, share_context, context_attribs);
+  if (context_ == EGL_NO_CONTEXT) {
+    AFREE_MD_LOGE("eglCreateContext failed: 0x%x", eglGetError());
+    return false;
+  }
+
+  // A 1x1 pbuffer is needed to make the context current for shader setup.
+  const EGLint pbuffer_attribs[] = {EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE};
+  EGLSurface pbuffer =
+      eglCreatePbufferSurface(display_, config_, pbuffer_attribs);
+  if (pbuffer == EGL_NO_SURFACE ||
+      !eglMakeCurrent(display_, pbuffer, pbuffer, context_)) {
+    AFREE_MD_LOGE("pbuffer/context setup failed: 0x%x", eglGetError());
+    if (pbuffer != EGL_NO_SURFACE) {
+      eglDestroySurface(display_, pbuffer);
+    }
+    return false;
+  }
+
+  bool ok = CompileTestPatternProgram() && CompileTextureProgram();
+  CompileOesProgram();  // optional (OES external texture); ignored if unavailable
+  eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+  eglDestroySurface(display_, pbuffer);
+  if (!ok) {
+    return false;
+  }
+
+  initialized_ = true;
+  AFREE_MD_LOGI("fanout initialized (EGL %d.%d)", major, minor);
+  return true;
+}
+
+GLuint AfreeSurfaceFanout::CompileShader(GLenum type, const char* src) {
+  GLuint shader = glCreateShader(type);
+  glShaderSource(shader, 1, &src, nullptr);
+  glCompileShader(shader);
+  GLint compiled = 0;
+  glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+  if (!compiled) {
+    char log[512] = {0};
+    glGetShaderInfoLog(shader, sizeof(log) - 1, nullptr, log);
+    AFREE_MD_LOGE("shader compile failed: %s", log);
+    glDeleteShader(shader);
+    return 0;
+  }
+  return shader;
+}
+
+bool AfreeSurfaceFanout::CompileTestPatternProgram() {
+  GLuint vs = CompileShader(GL_VERTEX_SHADER, kVertexShader);
+  GLuint fs = CompileShader(GL_FRAGMENT_SHADER, kFragmentShader);
+  if (!vs || !fs) {
+    if (vs)
+      glDeleteShader(vs);
+    if (fs)
+      glDeleteShader(fs);
+    return false;
+  }
+  program_ = glCreateProgram();
+  glAttachShader(program_, vs);
+  glAttachShader(program_, fs);
+  glBindAttribLocation(program_, 0, "a_pos");
+  glLinkProgram(program_);
+  glDeleteShader(vs);
+  glDeleteShader(fs);
+  GLint linked = 0;
+  glGetProgramiv(program_, GL_LINK_STATUS, &linked);
+  if (!linked) {
+    char log[512] = {0};
+    glGetProgramInfoLog(program_, sizeof(log) - 1, nullptr, log);
+    AFREE_MD_LOGE("program link failed: %s", log);
+    glDeleteProgram(program_);
+    program_ = 0;
+    return false;
+  }
+  u_time_loc_ = glGetUniformLocation(program_, "u_time");
+  glGenBuffers(1, &vbo_);
+  glBindBuffer(GL_ARRAY_BUFFER, vbo_);
+  glBufferData(GL_ARRAY_BUFFER, sizeof(kQuad), kQuad, GL_STATIC_DRAW);
+  glBindBuffer(GL_ARRAY_BUFFER, 0);
+  return true;
+}
+
+bool AfreeSurfaceFanout::CompileTextureProgram() {
+  GLuint vs = CompileShader(GL_VERTEX_SHADER, kTexVertexShader);
+  GLuint fs = CompileShader(GL_FRAGMENT_SHADER, kTexFragmentShader);
+  if (!vs || !fs) {
+    if (vs)
+      glDeleteShader(vs);
+    if (fs)
+      glDeleteShader(fs);
+    return false;
+  }
+  tex_program_ = glCreateProgram();
+  glAttachShader(tex_program_, vs);
+  glAttachShader(tex_program_, fs);
+  glBindAttribLocation(tex_program_, 0, "a_pos");
+  glLinkProgram(tex_program_);
+  glDeleteShader(vs);
+  glDeleteShader(fs);
+  GLint linked = 0;
+  glGetProgramiv(tex_program_, GL_LINK_STATUS, &linked);
+  if (!linked) {
+    char log[512] = {0};
+    glGetProgramInfoLog(tex_program_, sizeof(log) - 1, nullptr, log);
+    AFREE_MD_LOGE("texture program link failed: %s", log);
+    glDeleteProgram(tex_program_);
+    tex_program_ = 0;
+    return false;
+  }
+  u_tex_loc_ = glGetUniformLocation(tex_program_, "u_tex");
+  return true;
+}
+
+bool AfreeSurfaceFanout::CompileOesProgram() {
+  GLuint vs = CompileShader(GL_VERTEX_SHADER, kTexVertexShader);
+  GLuint fs = CompileShader(GL_FRAGMENT_SHADER, kOesFragmentShader);
+  if (!vs || !fs) {
+    if (vs)
+      glDeleteShader(vs);
+    if (fs)
+      glDeleteShader(fs);
+    AFREE_MD_LOGE("OES shader compile failed (vs=%u fs=%u)", vs, fs);
+    return false;
+  }
+  oes_program_ = glCreateProgram();
+  glAttachShader(oes_program_, vs);
+  glAttachShader(oes_program_, fs);
+  glBindAttribLocation(oes_program_, 0, "a_pos");
+  glLinkProgram(oes_program_);
+  glDeleteShader(vs);
+  glDeleteShader(fs);
+  GLint linked = 0;
+  glGetProgramiv(oes_program_, GL_LINK_STATUS, &linked);
+  if (!linked) {
+    char log[512] = {0};
+    GLsizei len = 0;
+    glGetProgramInfoLog(oes_program_, sizeof(log), &len, log);
+    AFREE_MD_LOGE("OES program link failed: %s", log);
+    glDeleteProgram(oes_program_);
+    oes_program_ = 0;
+    return false;
+  }
+  u_oes_tex_loc_ = glGetUniformLocation(oes_program_, "u_tex");
+  u_oes_matrix_loc_ = glGetUniformLocation(oes_program_, "u_matrix");
+  return true;
+}
+
+GLuint AfreeSurfaceFanout::CreateCheckerboardTexture(int size) {
+  if (!initialized_ || size <= 0) {
+    return 0;
+  }
+  // Need a current context to create/bind the texture.
+  const EGLint pbuffer_attribs[] = {EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE};
+  EGLSurface pbuffer =
+      eglCreatePbufferSurface(display_, config_, pbuffer_attribs);
+  if (pbuffer == EGL_NO_SURFACE ||
+      !eglMakeCurrent(display_, pbuffer, pbuffer, context_)) {
+    if (pbuffer != EGL_NO_SURFACE) {
+      eglDestroySurface(display_, pbuffer);
+    }
+    return 0;
+  }
+  const int kCells = 8;
+  std::vector<unsigned char> pixels(static_cast<size_t>(size) * size * 4);
+  for (int y = 0; y < size; ++y) {
+    for (int x = 0; x < size; ++x) {
+      const bool on = (((x * kCells) / size) + ((y * kCells) / size)) % 2 == 0;
+      const size_t i = (static_cast<size_t>(y) * size + x) * 4;
+      pixels[i + 0] = on ? 230 : 40;   // R
+      pixels[i + 1] = on ? 60 : 200;   // G
+      pixels[i + 2] = on ? 40 : 230;   // B
+      pixels[i + 3] = 255;             // A
+    }
+  }
+  GLuint tex = 0;
+  glGenTextures(1, &tex);
+  glBindTexture(GL_TEXTURE_2D, tex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, size, size, 0, GL_RGBA,
+               GL_UNSIGNED_BYTE, pixels.data());
+  glBindTexture(GL_TEXTURE_2D, 0);
+  eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+  eglDestroySurface(display_, pbuffer);
+  return tex;
+}
+
+void AfreeSurfaceFanout::ComputeViewport(int out_w,
+                                         int out_h,
+                                         int img_w,
+                                         int img_h,
+                                         int* vx,
+                                         int* vy,
+                                         int* vw,
+                                         int* vh) const {
+  *vx = 0;
+  *vy = 0;
+  *vw = out_w;
+  *vh = out_h;
+  if (!contain_ || out_w <= 0 || out_h <= 0 || img_w <= 0 || img_h <= 0) {
+    return;
+  }
+  const double sx = static_cast<double>(out_w) / img_w;
+  const double sy = static_cast<double>(out_h) / img_h;
+  const double s = sx < sy ? sx : sy;
+  *vw = static_cast<int>(img_w * s + 0.5);
+  *vh = static_cast<int>(img_h * s + 0.5);
+  if (*vw > out_w) {
+    *vw = out_w;
+  }
+  if (*vh > out_h) {
+    *vh = out_h;
+  }
+  *vx = (out_w - *vw) / 2;
+  *vy = (out_h - *vh) / 2;
+}
+
+void AfreeSurfaceFanout::DrawQuad(GLuint program,
+                                  GLint tex_loc,
+                                  GLuint texture,
+                                  int crop_width,
+                                  int crop_height) {
+  if (!initialized_ || outputs_.empty() || !program) {
+    return;
+  }
+  for (auto& kv : outputs_) {
+    Output& out = kv.second;
+    if (out.egl_surface == EGL_NO_SURFACE) {
+      continue;
+    }
+    if (!eglMakeCurrent(display_, out.egl_surface, out.egl_surface, context_)) {
+      continue;
+    }
+    glViewport(0, 0, out.width, out.height);
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    int vx = 0, vy = 0, vw = out.width, vh = out.height;
+    ComputeViewport(out.width, out.height, crop_width, crop_height, &vx, &vy,
+                    &vw, &vh);
+    glViewport(vx, vy, vw, vh);
+    glUseProgram(program);
+    if (tex_loc >= 0) {
+      glActiveTexture(GL_TEXTURE0);
+      glBindTexture(GL_TEXTURE_2D, texture);
+      glUniform1i(tex_loc, 0);
+    }
+    glBindBuffer(GL_ARRAY_BUFFER, vbo_);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, nullptr);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    eglSwapBuffers(display_, out.egl_surface);
+  }
+  eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+}
+
+void AfreeSurfaceFanout::DrawTexture2D(GLuint texture,
+                                       int texture_width,
+                                       int texture_height,
+                                       int crop_width,
+                                       int crop_height) {
+  (void)texture_width;
+  (void)texture_height;
+  DrawQuad(tex_program_, u_tex_loc_, texture, crop_width, crop_height);
+}
+
+bool AfreeSurfaceFanout::DrawRgbaFrame(const uint8_t* pixels,
+                                       int width,
+                                       int height,
+                                       int bytes_per_row) {
+  if (!initialized_ || !pixels || width <= 0 || height <= 0 ||
+      outputs_.empty() || !tex_program_ || bytes_per_row != width * 4) {
+    return false;
+  }
+  // Any valid output surface can make the (single, shared) context current for
+  // the texture upload.
+  EGLSurface upload_surface = EGL_NO_SURFACE;
+  for (auto& kv : outputs_) {
+    if (kv.second.egl_surface != EGL_NO_SURFACE) {
+      upload_surface = kv.second.egl_surface;
+      break;
+    }
+  }
+  if (upload_surface == EGL_NO_SURFACE) {
+    return false;
+  }
+  if (!eglMakeCurrent(display_, upload_surface, upload_surface, context_)) {
+    return false;
+  }
+  if (rgba_tex_ == 0) {
+    glGenTextures(1, &rgba_tex_);
+  }
+  glBindTexture(GL_TEXTURE_2D, rgba_tex_);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA,
+               GL_UNSIGNED_BYTE, pixels);
+  glBindTexture(GL_TEXTURE_2D, 0);
+  eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+
+  DrawQuad(tex_program_, u_tex_loc_, rgba_tex_, width, height);
+  return true;
+}
+
+bool AfreeSurfaceFanout::DrawExternalTextureOes(GLuint texture,
+                                                const GLfloat matrix[16],
+                                                int texture_width,
+                                                int texture_height,
+                                                int crop_width,
+                                                int crop_height) {
+  (void)texture_width;
+  (void)texture_height;
+  if (!initialized_ || outputs_.empty() || !oes_program_) {
+    return false;
+  }
+  for (auto& kv : outputs_) {
+    Output& out = kv.second;
+    if (out.egl_surface == EGL_NO_SURFACE) {
+      continue;
+    }
+    if (!eglMakeCurrent(display_, out.egl_surface, out.egl_surface, context_)) {
+      continue;
+    }
+    glViewport(0, 0, out.width, out.height);
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    int vx = 0, vy = 0, vw = out.width, vh = out.height;
+    ComputeViewport(out.width, out.height, crop_width, crop_height, &vx, &vy,
+                    &vw, &vh);
+    glViewport(vx, vy, vw, vh);
+    glUseProgram(oes_program_);
+    if (u_oes_tex_loc_ >= 0) {
+      glActiveTexture(GL_TEXTURE0);
+      glBindTexture(GL_TEXTURE_EXTERNAL_OES, texture);
+      glUniform1i(u_oes_tex_loc_, 0);
+    }
+    if (u_oes_matrix_loc_ >= 0) {
+      glUniformMatrix4fv(u_oes_matrix_loc_, 1, GL_FALSE, matrix);
+    }
+    glBindBuffer(GL_ARRAY_BUFFER, vbo_);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, nullptr);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    eglSwapBuffers(display_, out.egl_surface);
+  }
+  eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+  return true;
+}
+
+bool AfreeSurfaceFanout::DrawHardwareBuffer(AHardwareBuffer* buffer,
+                                            int width,
+                                            int height) {
+  if (!initialized_ || !buffer || outputs_.empty() || !hb_supported_ ||
+      !oes_program_) {
+    return false;
+  }
+  auto get_client_buffer =
+      reinterpret_cast<PFNEGLGETNATIVECLIENTBUFFERANDROIDPROC>(
+          egl_get_native_client_buffer_);
+  auto create_image =
+      reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(egl_create_image_);
+  auto destroy_image =
+      reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(egl_destroy_image_);
+  auto target_texture =
+      reinterpret_cast<PFNGLEGLIMAGETARGETTEXTURE2DOESPROC>(
+          gl_egl_image_target_oes_);
+  static const GLfloat kIdentity[16] = {1.f, 0.f, 0.f, 0.f, 0.f, 1.f, 0.f, 0.f,
+                                        0.f, 0.f, 1.f, 0.f, 0.f, 0.f, 0.f, 1.f};
+  bool drew = false;
+  for (auto& kv : outputs_) {
+    Output& out = kv.second;
+    if (out.egl_surface == EGL_NO_SURFACE) {
+      continue;
+    }
+    if (!eglMakeCurrent(display_, out.egl_surface, out.egl_surface, context_)) {
+      continue;
+    }
+    EGLClientBuffer client_buffer = get_client_buffer(buffer);
+    if (!client_buffer) {
+      continue;
+    }
+    EGLImageKHR image = create_image(display_, EGL_NO_CONTEXT,
+                                     EGL_NATIVE_BUFFER_ANDROID, client_buffer,
+                                     nullptr);
+    if (image == EGL_NO_IMAGE_KHR) {
+      continue;
+    }
+    GLuint tex = 0;
+    glGenTextures(1, &tex);
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, tex);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    target_texture(GL_TEXTURE_EXTERNAL_OES, image);
+
+    glViewport(0, 0, out.width, out.height);
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    int vx = 0, vy = 0, vw = out.width, vh = out.height;
+    ComputeViewport(out.width, out.height, width, height, &vx, &vy, &vw, &vh);
+    glViewport(vx, vy, vw, vh);
+    glUseProgram(oes_program_);
+    if (u_oes_tex_loc_ >= 0) {
+      glActiveTexture(GL_TEXTURE0);
+      glBindTexture(GL_TEXTURE_EXTERNAL_OES, tex);
+      glUniform1i(u_oes_tex_loc_, 0);
+    }
+    if (u_oes_matrix_loc_ >= 0) {
+      glUniformMatrix4fv(u_oes_matrix_loc_, 1, GL_FALSE, kIdentity);
+    }
+    glBindBuffer(GL_ARRAY_BUFFER, vbo_);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, nullptr);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+
+    glDeleteTextures(1, &tex);
+    destroy_image(display_, image);
+    eglSwapBuffers(display_, out.egl_surface);
+    drew = true;
+  }
+  eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+  return drew;
+}
+
+bool AfreeSurfaceFanout::AttachSurface(int display_id,
+                                       ANativeWindow* window,
+                                       int width,
+                                       int height) {
+  if (!initialized_ || !window) {
+    return false;
+  }
+  auto it = outputs_.find(display_id);
+  if (it != outputs_.end()) {
+    DestroyOutput(&it->second);
+  }
+  EGLSurface surf = eglCreateWindowSurface(
+      display_, config_, reinterpret_cast<EGLNativeWindowType>(window), nullptr);
+  if (surf == EGL_NO_SURFACE) {
+    AFREE_MD_LOGE("eglCreateWindowSurface(display=%d) failed: 0x%x", display_id,
+                  eglGetError());
+    return false;
+  }
+  Output out;
+  out.egl_surface = surf;
+  out.width = width;
+  out.height = height;
+  outputs_[display_id] = out;
+  AFREE_MD_LOGI("attached surface display=%d %dx%d (outputs=%zu)", display_id,
+                width, height, outputs_.size());
+  return true;
+}
+
+void AfreeSurfaceFanout::DestroyOutput(Output* out) {
+  if (out->egl_surface != EGL_NO_SURFACE) {
+    eglDestroySurface(display_, out->egl_surface);
+    out->egl_surface = EGL_NO_SURFACE;
+  }
+}
+
+void AfreeSurfaceFanout::DetachSurface(int display_id) {
+  auto it = outputs_.find(display_id);
+  if (it == outputs_.end()) {
+    return;
+  }
+  DestroyOutput(&it->second);
+  outputs_.erase(it);
+  AFREE_MD_LOGI("detached surface display=%d (outputs=%zu)", display_id,
+                outputs_.size());
+}
+
+void AfreeSurfaceFanout::DetachAll() {
+  for (auto& kv : outputs_) {
+    DestroyOutput(&kv.second);
+  }
+  outputs_.clear();
+}
+
+void AfreeSurfaceFanout::RenderTestPattern(double time_seconds) {
+  if (!initialized_ || outputs_.empty()) {
+    return;
+  }
+  for (auto& kv : outputs_) {
+    Output& out = kv.second;
+    if (out.egl_surface == EGL_NO_SURFACE) {
+      continue;
+    }
+    if (!eglMakeCurrent(display_, out.egl_surface, out.egl_surface, context_)) {
+      continue;
+    }
+    glViewport(0, 0, out.width, out.height);
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glUseProgram(program_);
+    if (u_time_loc_ >= 0) {
+      glUniform1f(u_time_loc_, static_cast<GLfloat>(time_seconds));
+    }
+    glBindBuffer(GL_ARRAY_BUFFER, vbo_);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, nullptr);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    eglSwapBuffers(display_, out.egl_surface);
+  }
+  eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+}
+
+void AfreeSurfaceFanout::Shutdown() {
+  if (!initialized_) {
+    return;
+  }
+  DetachAll();
+  if (vbo_) {
+    glDeleteBuffers(1, &vbo_);
+    vbo_ = 0;
+  }
+  if (program_) {
+    glDeleteProgram(program_);
+    program_ = 0;
+  }
+  if (tex_program_) {
+    glDeleteProgram(tex_program_);
+    tex_program_ = 0;
+  }
+  if (oes_program_) {
+    glDeleteProgram(oes_program_);
+    oes_program_ = 0;
+  }
+  if (display_ != EGL_NO_DISPLAY) {
+    eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (context_ != EGL_NO_CONTEXT) {
+      eglDestroyContext(display_, context_);
+      context_ = EGL_NO_CONTEXT;
+    }
+    eglTerminate(display_);
+    display_ = EGL_NO_DISPLAY;
+  }
+  initialized_ = false;
+}
