+struct AHardwareBuffer;
+
+namespace afree {
+namespace multi_display {
+
+class AfreeSurfaceFanout {
+ public:
+  AfreeSurfaceFanout();
+  ~AfreeSurfaceFanout();
+
+  AfreeSurfaceFanout(const AfreeSurfaceFanout&) = delete;
+  AfreeSurfaceFanout& operator=(const AfreeSurfaceFanout&) = delete;
+
+  // Creates the EGL display/context and compiles the shaders.
+  // |share_context| lets the fan-out share textures with the GPU's context
+  // (used later to draw decoded video textures directly); EGL_NO_CONTEXT for a
+  // standalone context (test pattern / texture drawing).
+  bool Initialize(EGLContext share_context = EGL_NO_CONTEXT);
+
+  void Shutdown();
+
+  bool initialized() const { return initialized_; }
+
+  // Aspect-ratio mode for drawing: true (default) preserves the frame's aspect
+  // ratio and letterboxes with black bars; false stretches to fill the surface.
+  void SetContain(bool contain) {
+    contain_.store(contain, std::memory_order_relaxed);
+  }
+  bool contain() const { return contain_.load(std::memory_order_relaxed); }
+
+  // Attach a native window (from a SurfaceView's Surface) as an output.
+  // |display_id| is the target display (e.g. 0 / 2, or a virtual display id).
+  // The window is retained by EGLSurface; caller keeps its ANativeWindow ref.
+  bool AttachSurface(int display_id, ANativeWindow* window, int width, int height);
+
+  void DetachSurface(int display_id);
+  void DetachAll();
+  size_t output_count() const { return outputs_.size(); }
+
+  // Render one test-pattern frame (moving bars) to every attached surface.
+  // |time_seconds| drives the animation.
+  void RenderTestPattern(double time_seconds);
+
+  // Test helper: create a checkerboard GL_TEXTURE_2D in the fan-out context.
+  // Returns 0 on failure. (Stands in for a decoded video texture.)
+  GLuint CreateCheckerboardTexture(int size);
+
+  // Draw an existing GL_TEXTURE_2D (e.g. a video frame texture) to every
+  // attached surface, cropping to |crop_width| x |crop_height|.
+  void DrawTexture2D(GLuint texture,
+                     int texture_width,
+                     int texture_height,
+                     int crop_width,
+                     int crop_height);
+
+  // Draw an external (OES) texture — e.g. a decoded video frame's SurfaceTexture
+  // — to every attached surface. |matrix| is the 4x4 texture transform from the
+  // SurfaceTexture. Requires the fan-out context to share with the texture's
+  // context (see Initialize(share_context)). Returns false if the OES program is
+  // unavailable.
+  bool DrawExternalTextureOes(GLuint texture,
+                              const GLfloat matrix[16],
+                              int texture_width,
+                              int texture_height,
+                              int crop_width,
+                              int crop_height);
+
+  // Draw a tightly-packed RGBA software frame (方案 C) to every attached
+  // surface. |bytes_per_row| must equal width * 4. Returns false if the
+  // texture program is unavailable or there are no outputs.
+  bool DrawRgbaFrame(const uint8_t* pixels, int width, int height,
+                     int bytes_per_row);
+
+  // Draw an AHardwareBuffer-backed video frame (方案 B): imports the buffer as
+  // an EGLImage and draws it to every attached surface (via the OES program).
+  // No shared GL context is required. Returns false if unsupported.
+  bool DrawHardwareBuffer(AHardwareBuffer* buffer, int width, int height);
+
+  // Whether AHardwareBuffer/EGLImage importing is available on this device.
+  bool hardware_buffer_supported() const { return hb_supported_; }
+
+ private:
+  struct Output {
+    EGLSurface egl_surface = EGL_NO_SURFACE;
+    int width = 0;
+    int height = 0;
+  };
+
+  bool CompileTestPatternProgram();
+  bool CompileTextureProgram();
+  bool CompileOesProgram();
+  static GLuint CompileShader(GLenum type, const char* src);
+  void DestroyOutput(Output* out);
+  void DrawQuad(GLuint program, GLint tex_loc, GLuint texture,
+                int crop_width, int crop_height);
+  // Computes the destination viewport for an image of |img_w| x |img_h| drawn
+  // into a |out_w| x |out_h| surface, honoring |contain_|.
+  void ComputeViewport(int out_w, int out_h, int img_w, int img_h, int* vx,
+                       int* vy, int* vw, int* vh) const;
+
+  EGLDisplay display_ = EGL_NO_DISPLAY;
+  EGLContext context_ = EGL_NO_CONTEXT;
+  EGLConfig config_ = nullptr;
+  GLuint program_ = 0;
+  GLint u_time_loc_ = -1;
+  GLuint tex_program_ = 0;
+  GLint u_tex_loc_ = -1;
+  GLuint rgba_tex_ = 0;  // 方案 C: persistent RGBA texture for CPU frames.
+  GLuint oes_program_ = 0;
+  GLint u_oes_tex_loc_ = -1;
+  GLint u_oes_matrix_loc_ = -1;
+  GLuint vbo_ = 0;
+  std::map<int, Output> outputs_;
+  bool initialized_ = false;
+  std::atomic<bool> contain_{true};
+
+  // EGL/GLES extension entry points for EGLImage importing (方案 B).
+  void* egl_get_native_client_buffer_ = nullptr;
+  void* egl_create_image_ = nullptr;
+  void* egl_destroy_image_ = nullptr;
+  void* gl_egl_image_target_oes_ = nullptr;
+  bool hb_supported_ = false;
+};
+
+}  // namespace multi_display
+}  // namespace afree
+
+#endif  // BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
+
+#endif  // ANDROID_WEBVIEW_AFREE_MULTI_DISPLAY_AFREE_SURFACE_FANOUT_H_
