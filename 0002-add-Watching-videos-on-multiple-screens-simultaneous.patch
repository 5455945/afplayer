diff --git a/android_webview/afree/demo/build.gradle b/android_webview/afree/demo/build.gradle
index 4549d3e521..99877e27eb 100644
--- a/android_webview/afree/demo/build.gradle
+++ b/android_webview/afree/demo/build.gradle
@@ -2,6 +2,47 @@ plugins {
     id 'com.android.application' version '8.5.0'
 }
 
+// Inspect src/main/libs/afree_webview.aar (copied by android_webview/afree/
+// bootstrap.sh) to decide:
+//   * afreeAarIsDist      : dist_aar (self-contained chromium classes) vs the
+//                           hand-rolled com.afree.* shell AAR;
+//   * afreeHasMultiDisplay: the AAR was built with afree_multi_display=true and
+//                           exposes com.afree.chromium.AfreeMultiDisplay.
+// The latter gates MultiDisplayActivity (src/multiDisplay) + its assets, so a
+// default build (AAR without the feature) compiles cleanly without the sources.
+// No manual step is needed: ./build_android.sh --multi-display produces an AAR
+// with the class and the demo then includes the activity automatically.
+// When enabled, the multi_display in-app help is the SDK help doc
+// (android_webview/afree/docs/multi_display_help.md), copied into a generated
+// assets dir by copyMultiDisplayHelp (single source of truth).
+def afreeAarIsDist = false
+def afreeHasMultiDisplay = false
+def afreeAarFile = file('src/main/libs/afree_webview.aar')
+if (afreeAarFile.exists()) {
+    def aar = new java.util.zip.ZipFile(afreeAarFile)
+    try {
+        def classesEntry = aar.getEntry('classes.jar')
+        if (classesEntry != null) {
+            def tmp = File.createTempFile('afree_classes', '.jar')
+            tmp.deleteOnExit()
+            tmp.withOutputStream { os -> os << aar.getInputStream(classesEntry) }
+            def classes = new java.util.zip.ZipFile(tmp)
+            try {
+                afreeAarIsDist =
+                        classes.getEntry('org/chromium/android_webview/AwContents.class') != null
+                afreeHasMultiDisplay =
+                        classes.getEntry('com/afree/chromium/AfreeMultiDisplay.class') != null
+            } finally {
+                classes.close()
+            }
+        }
+    } finally {
+        aar.close()
+    }
+}
+logger.lifecycle("afree demo: afreeAarIsDist=${afreeAarIsDist} " +
+        "afreeHasMultiDisplay=${afreeHasMultiDisplay}")
+
 android {
     namespace 'com.afree.demo'
     compileSdk 34
@@ -10,6 +51,11 @@ android {
         applicationId "com.afree.demo"
         minSdk 24
         targetSdk 34
+        // MultiDisplayActivity is declared in the manifest but disabled unless
+        // the AAR provides the feature (launching a disabled component fails
+        // cleanly instead of crashing).
+        resValue "bool", "multi_display_enabled",
+                afreeHasMultiDisplay ? "true" : "false"
     }
 
     sourceSets {
@@ -17,6 +63,10 @@ android {
             manifest.srcFile 'src/main/AndroidManifest.xml'
             java.srcDirs = ['src/main/java']
             res.srcDirs = ['src/main/res']
+            if (afreeHasMultiDisplay) {
+                java.srcDirs += 'src/multiDisplay/java'
+                assets.srcDirs += 'src/multiDisplay/assets'
+            }
         }
     }
 
@@ -61,31 +111,36 @@ android {
     }
 }
 
