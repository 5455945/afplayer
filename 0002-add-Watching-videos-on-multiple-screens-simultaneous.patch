+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# afree SDK multi_display (multi-screen same-view) — SDK-side only.
+#
+# The implementation lives in the afree SDK and is compiled into the SDK AAR
+# (Java API in classes.jar, native in libwebviewchromium.so) when the GN arg
+# afree_multi_display=true. When false, nothing here is compiled.
+#
+# The test entry (MultiDisplayActivity) is part of the afree SDK demo
+# (android_webview/afree/demo, package com.afree.demo) and is gated by whether
+# this AAR exposes com.afree.chromium.AfreeMultiDisplay; it is NOT built here.
+
+if (is_afree && is_afree_sdk && afree_multi_display) {
+  # The fan-out uses raw system GLES. Keep it in its own target with no
+  # Chromium media/gpu deps so it does not pick up Chromium's GL bindings
+  # (which remap gl* -> GLES2*/gl:: on the include path).
+  source_set("afree_surface_fanout") {
+    sources = [
+      "afree_surface_fanout.cc",
+      "afree_surface_fanout.h",
+    ]
+    libs = [
+      "EGL",
+      "GLESv2",
+      "android",
+      "log",
+    ]
+  }
+
+  # SDK native: multi-surface fan-out controller/JNI + 方案 C software-frame
+  # sink. Linked into libwebviewchromium.so (see
+  # //android_webview:libwebviewchromium).
+  source_set("afree_multi_display_native") {
+    sources = [
+      "afree_multi_display.cc",
+      "afree_multi_display.h",
+      "afree_multi_display_stub.cc",
+    ]
+    # base::CommandLine for --afree-multi-display-source; Mojo for the 方案 C
+    # renderer->browser software-frame sink.
+    deps = [
+      ":afree_surface_fanout",
+      "//base",
+      "//media/mojo/mojom",
+      "//mojo/public/cpp/bindings",
+    ]
+    libs = [
+      "android",
+      "log",
+    ]
+  }
+}
diff --git a/android_webview/afree/sdk/native/multi_display/afree_multi_display.cc b/android_webview/afree/sdk/native/multi_display/afree_multi_display.cc
new file mode 100644
index 0000000000..3ded45c463
--- /dev/null
+++ b/android_webview/afree/sdk/native/multi_display/afree_multi_display.cc
@@ -0,0 +1,590 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// afree SDK multi_display (multi-screen same-view): SDK-side implementation.
+//
+// This lives in the afree SDK (compiled into libwebviewchromium.so) and is only
+// built when the GN arg afree_multi_display=true. It owns:
+//   * the single multi-surface fan-out (AfreeSurfaceFanout) on a render thread;
+//   * registration with the engine's decoded-frame callback (方案 B:
+//     AHardwareBuffer forwarded from the GPU process);
+//   * the Java-facing JNI used by the (separate) MultiDisplayDemo APK.
+//
+// The demo only calls com.afree.chromium.AfreeMultiDisplay.attachSurface() etc.
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
+
+#include <jni.h>
+#include <android/hardware_buffer.h>
+#include <android/log.h>
+#include <android/native_window.h>
+#include <android/native_window_jni.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "android_webview/afree/sdk/native/multi_display/afree_multi_display.h"
+#include "android_webview/afree/sdk/native/multi_display/afree_surface_fanout.h"
+#include "base/command_line.h"
+#include "base/memory/unsafe_shared_memory_region.h"
+#include "media/mojo/mojom/afree_multi_display.mojom.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+
+#define AFREE_MD_TAG "AfreeMultiDisplay"
+#define AFREE_MD_LOGI(...) \
+  __android_log_print(ANDROID_LOG_INFO, AFREE_MD_TAG, __VA_ARGS__)
+#define AFREE_MD_LOGE(...) \
+  __android_log_print(ANDROID_LOG_ERROR, AFREE_MD_TAG, __VA_ARGS__)
+
+// Implemented in the engine (media/gpu/android/afree_multi_display_gpu_hook.cc).
+extern "C" void AfreeMultiDisplaySetFrameBufferCallback(
+    void (*callback)(AHardwareBuffer*, int)) __attribute__((visibility("default")));
+
+namespace {
+
+struct PendingSurface {
+  ANativeWindow* window = nullptr;  // owned reference
+  int width = 0;
+  int height = 0;
+};
+
+std::mutex g_mutex;
+std::unique_ptr<afree::multi_display::AfreeSurfaceFanout> g_fanout;
+std::thread g_render_thread;
+std::atomic<bool> g_running{false};
+GLuint g_checker_texture = 0;
+constexpr int kCheckerSize = 256;
+
+// Surfaces requested by the app; the render thread creates EGLSurfaces from them.
+std::set<int> g_attach_requests;
+std::set<int> g_detach_requests;
+std::map<int, PendingSurface> g_pending_surfaces;
+std::set<int> g_attached_ids;
+
+// Latest decoded frame from the engine (GPU thread -> render thread).
+AHardwareBuffer* g_pending_buffer = nullptr;
+int g_pending_fence = -1;
+int g_pending_width = 0;
+int g_pending_height = 0;
+uint64_t g_pending_frame_id = 0;  // guarded by g_mutex
+
+// Frame-source selection (dynamic switch; see --afree-multi-display-source).
+enum class SourceMode {
+  kHardwareBuffer,
+  kSoftware,
+  kAuto,
+  kTestPattern,
+  kPage
+};
+SourceMode g_source_mode = SourceMode::kHardwareBuffer;
+
+// Latest software (CPU) frame submitted by the renderer (方案 C).
+struct SoftwareFrame {
+  std::vector<uint8_t> pixels;
+  int width = 0;
+  int height = 0;
+  int bytes_per_row = 0;
+  uint64_t fid = 0;
+};
+SoftwareFrame g_sw;  // guarded by g_mutex
+
+// Runtime-adjustable aspect mode (true = preserve aspect/letterbox).
+std::atomic<bool> g_contain{true};
+
+// Low-frequency statistics counters.
+std::atomic<uint64_t> g_frames_delivered{0};
+std::atomic<uint64_t> g_frames_coalesced{0};
+std::atomic<uint64_t> g_frame_id{0};
+
+// Render-thread-only state / per-output counters.
+std::map<int, uint64_t> g_drawn_frames;
+std::map<int, uint64_t> g_last_fid;
+bool g_logged_first_frame = false;
+bool g_hw_seen = false;      // a hardware (方案 B) frame has been received
+uint64_t g_last_sw_fid = 0;  // last software frame id drawn
+
+const char* SourceModeName(SourceMode m) {
+  switch (m) {
+    case SourceMode::kSoftware:
+      return "software";
+    case SourceMode::kAuto:
+      return "auto";
+    case SourceMode::kTestPattern:
+      return "testpattern";
+    case SourceMode::kPage:
+      return "page";
+    case SourceMode::kHardwareBuffer:
+    default:
+      return "hardwarebuffer";
+  }
+}
+
+void OnEngineFrame(AHardwareBuffer* buffer, int acquire_fence_fd) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_pending_buffer) {
+    // The previous decoded frame was superseded before it could be drawn.
+    AHardwareBuffer_release(g_pending_buffer);
+    if (g_pending_fence >= 0) {
+      ::close(g_pending_fence);
+    }
+    g_frames_coalesced.fetch_add(1, std::memory_order_relaxed);
+  }
+  g_pending_buffer = buffer;
+  g_pending_fence = acquire_fence_fd;
+  g_pending_frame_id = g_frame_id.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (buffer) {
+    AHardwareBuffer_Desc desc = {};
+    AHardwareBuffer_describe(buffer, &desc);
+    g_pending_width = static_cast<int>(desc.width);
+    g_pending_height = static_cast<int>(desc.height);
+  }
+  g_frames_delivered.fetch_add(1, std::memory_order_relaxed);
+}
+
+void ProcessSurfaceRequests() {
+  std::set<int> attach;
+  std::set<int> detach;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    attach.swap(g_attach_requests);
+    detach.swap(g_detach_requests);
+  }
+  for (int id : detach) {
+    g_fanout->DetachSurface(id);
+    g_attached_ids.erase(id);
+  }
+  for (int id : attach) {
+    PendingSurface ps;
+    {
+      std::lock_guard<std::mutex> lock(g_mutex);
+      auto it = g_pending_surfaces.find(id);
+      if (it == g_pending_surfaces.end()) {
+        continue;
+      }
+      ps = it->second;
+    }
+    if (ps.window) {
+      g_fanout->AttachSurface(id, ps.window, ps.width, ps.height);
+      g_attached_ids.insert(id);
+    }
+  }
+}
+
+void RenderLoop() {
+  const auto start = std::chrono::steady_clock::now();
+  auto last_stats = start;
+  while (g_running.load()) {
+    ProcessSurfaceRequests();
+    AHardwareBuffer* buffer = nullptr;
+    int fence = -1;
+    int width = 0;
+    int height = 0;
+    uint64_t fid = 0;
+    {
+      std::lock_guard<std::mutex> lock(g_mutex);
+      buffer = g_pending_buffer;
+      fence = g_pending_fence;
+      fid = g_pending_frame_id;
+      width = g_pending_width;
+      height = g_pending_height;
+      g_pending_buffer = nullptr;
+      g_pending_fence = -1;
+      g_pending_frame_id = 0;
+    }
+    if (buffer) {
+      g_hw_seen = true;
+    }
+
+    // Source selection: software when explicitly requested, or in auto mode
+    // until a hardware (方案 B) frame has been seen.
+    const bool use_software =
+        g_source_mode == SourceMode::kSoftware ||
+        g_source_mode == SourceMode::kPage ||
+        (g_source_mode == SourceMode::kAuto && !g_hw_seen);
+    bool drew = false;
+
+    if (use_software) {
+      SoftwareFrame sw;
+      uint64_t sw_fid = 0;
+      {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_sw.fid != 0 && g_sw.fid != g_last_sw_fid) {
+          sw = g_sw;  // copy the latest software frame; older ones coalesce
+          sw_fid = g_sw.fid;
+        }
+      }
+      if (sw_fid != 0) {
+        if (g_last_sw_fid != 0 && sw_fid > g_last_sw_fid + 1) {
+          g_frames_coalesced.fetch_add(sw_fid - g_last_sw_fid - 1,
+                                       std::memory_order_relaxed);
+        }
+        if (!g_logged_first_frame) {
+          g_logged_first_frame = true;
+          AFREE_MD_LOGI("[AFREE_MD] first frame drawn fid=%llu %dx%d",
+                        static_cast<unsigned long long>(sw_fid), sw.width,
+                        sw.height);
+        }
+        if (g_fanout->DrawRgbaFrame(sw.pixels.data(), sw.width, sw.height,
+                                    sw.bytes_per_row)) {
+          g_last_sw_fid = sw_fid;
+          std::lock_guard<std::mutex> lock(g_mutex);
+          for (int id : g_attached_ids) {
+            g_drawn_frames[id] += 1;
+            g_last_fid[id] = sw_fid;
+          }
+          drew = true;
+        }
+      }
+    } else if (buffer) {
+      if (!g_logged_first_frame) {
+        g_logged_first_frame = true;
+        AFREE_MD_LOGI("[AFREE_MD] first frame drawn fid=%llu %dx%d",
+                      static_cast<unsigned long long>(fid), width, height);
+      }
+      g_fanout->DrawHardwareBuffer(buffer, width, height);
+      {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        for (int id : g_attached_ids) {
+          g_drawn_frames[id] += 1;
+          g_last_fid[id] = fid;
+        }
+      }
+      drew = true;
+    }
+
+    if (buffer) {
+      AHardwareBuffer_release(buffer);
+      if (fence >= 0) {
+        ::close(fence);
+      }
+    }
+
+    if (!drew &&
+        (g_source_mode == SourceMode::kTestPattern || !g_logged_first_frame)) {
+      if (g_checker_texture) {
+        g_fanout->DrawTexture2D(g_checker_texture, kCheckerSize, kCheckerSize,
+                                kCheckerSize, kCheckerSize);
+        if (g_source_mode == SourceMode::kTestPattern) {
+          // Count test-pattern draws so the stats line still proves every
+          // attached Surface is being fed.
+          std::lock_guard<std::mutex> lock(g_mutex);
+          for (int id : g_attached_ids) {
+            g_drawn_frames[id] += 1;
+          }
+        }
+      }
+    }
+
+    // Low-frequency (2s) evidence log: proves both outputs drew the same decoded
+    // frame (skew) and exposes coalesced/dropped frames. Never per-frame.
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_stats >= std::chrono::seconds(2)) {
+      last_stats = now;
+      std::string drawn_str;
+      std::string fid_str;
+      uint64_t fid_min = 0;
+      uint64_t fid_max = 0;
+      bool have_fid = false;
+      {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        for (int id : g_attached_ids) {
+          auto dit = g_drawn_frames.find(id);
+          auto fit = g_last_fid.find(id);
+          const uint64_t d = dit == g_drawn_frames.end() ? 0 : dit->second;
+          const uint64_t f = fit == g_last_fid.end() ? 0 : fit->second;
+          drawn_str += (drawn_str.empty() ? "" : ",") + std::to_string(id) + ":" +
+                       std::to_string(d);
+          fid_str += (fid_str.empty() ? "" : ",") + std::to_string(id) + ":" +
+                     std::to_string(f);
+          if (f != 0) {
+            if (!have_fid) {
+              fid_min = fid_max = f;
+              have_fid = true;
+            } else {
+              fid_min = std::min(fid_min, f);
+              fid_max = std::max(fid_max, f);
+            }
+          }
+        }
+      }
+      const long long secs =
+          std::chrono::duration_cast<std::chrono::seconds>(now - start).count();
+      AFREE_MD_LOGI(
+          "[AFREE_MD-STATS] t=%llds source=%s contain=%d delivered=%llu "
+          "coalesced=%llu drawn=[%s] fid=[%s] skew=%llu",
+          secs, SourceModeName(g_source_mode), g_contain.load() ? 1 : 0,
+          static_cast<unsigned long long>(
+              g_frames_delivered.load(std::memory_order_relaxed)),
+          static_cast<unsigned long long>(
+              g_frames_coalesced.load(std::memory_order_relaxed)),
+          drawn_str.c_str(), fid_str.c_str(),
+          static_cast<unsigned long long>(have_fid ? (fid_max - fid_min) : 0));
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(16));
+  }
+}
+
+bool EnsureStarted() {
+  if (g_running.load()) {
+    return true;
+  }
+  if (!g_fanout) {
+    g_fanout = std::make_unique<afree::multi_display::AfreeSurfaceFanout>();
+    if (!g_fanout->Initialize()) {
+      AFREE_MD_LOGE("fan-out Initialize failed");
+      g_fanout.reset();
+      return false;
+    }
+    g_checker_texture = g_fanout->CreateCheckerboardTexture(kCheckerSize);
+  }
+  // Frame-source selection (dynamic switch):
+  //   --afree-multi-display-source=hardwarebuffer|software|auto|testpattern
+  // hardwarebuffer (default): consume engine AHardwareBuffer frames (方案 B).
+  // software: consume renderer CPU frames delivered over the frame sink (方案 C).
+  // auto    : use hardwarebuffer if any is seen, otherwise software.
+  // testpattern: always draw the built-in checkerboard (diagnostic).
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch("afree-multi-display-source")) {
+    const std::string v =
+        cl->GetSwitchValueASCII("afree-multi-display-source");
+    if (v == "testpattern") {
+      g_source_mode = SourceMode::kTestPattern;
+    } else if (v == "hardwarebuffer") {
+      g_source_mode = SourceMode::kHardwareBuffer;
+    } else if (v == "software") {
+      g_source_mode = SourceMode::kSoftware;
+    } else if (v == "auto") {
+      g_source_mode = SourceMode::kAuto;
+    } else if (v == "page") {
+      g_source_mode = SourceMode::kPage;
+    } else {
+      AFREE_MD_LOGE(
+          "unknown --afree-multi-display-source=%s "
+          "(use hardwarebuffer|software|auto|testpattern|page)",
+          v.c_str());
+    }
+  }
+
+  // Aspect mode: --afree-multi-display-contain=0 stretches to fill; default is
+  // to preserve aspect ratio with black letterbox bars. Can also be changed at
+  // runtime via AfreeMultiDisplay.setContain().
+  if (cl->HasSwitch("afree-multi-display-contain")) {
+    g_contain.store(cl->GetSwitchValueASCII("afree-multi-display-contain") != "0");
+  }
+  g_fanout->SetContain(g_contain.load());
+
+  // Register for engine (GPU) decoded frames.
+  AfreeMultiDisplaySetFrameBufferCallback(&OnEngineFrame);
+  g_running.store(true);
+  g_render_thread = std::thread(RenderLoop);
+  AFREE_MD_LOGI("multi_display started (hb_supported=%d source=%s)",
+                g_fanout->hardware_buffer_supported() ? 1 : 0,
+                SourceModeName(g_source_mode));
+  return true;
+}
+
+void EnsureStopped() {
+  if (!g_running.load()) {
+    return;
+  }
+  g_running.store(false);
+  if (g_render_thread.joinable()) {
+    g_render_thread.join();
+  }
+  AfreeMultiDisplaySetFrameBufferCallback(nullptr);
+}
+
+}  // namespace
+
+namespace afree {
+namespace multi_display {
+
+namespace {
+
+// Browser-process receiver for software (CPU) frames submitted by the renderer
+// (方案 C). Runs on the thread that bound it (the browser UI thread).
+class AfreeFrameSinkImpl : public media::mojom::AfreeMultiDisplayFrameSink {
+ public:
+  void SubmitFrame(media::mojom::AfreeSoftwareVideoFramePtr frame) override {
+    // In "page" mode frames are pushed by the app via submitPageFrame(); ignore
+    // renderer software frames so the two sources don't fight over g_sw.
+    if (g_source_mode == SourceMode::kPage) {
+      return;
+    }
+    if (!frame || !frame->region.IsValid() || frame->width == 0 ||
+        frame->height == 0 || frame->bytes_per_row != frame->width * 4u) {
+      return;
+    }
+    base::WritableSharedMemoryMapping mapping = frame->region.Map();
+    if (!mapping.IsValid()) {
+      return;
+    }
+    const size_t bytes =
+        static_cast<size_t>(frame->bytes_per_row) * frame->height;
+    if (bytes > mapping.size()) {
+      return;
+    }
+    const uint8_t* src = static_cast<const uint8_t*>(mapping.memory());
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_sw.pixels.assign(src, src + bytes);
+    g_sw.width = static_cast<int>(frame->width);
+    g_sw.height = static_cast<int>(frame->height);
+    g_sw.bytes_per_row = static_cast<int>(frame->bytes_per_row);
+    g_sw.fid = g_frame_id.fetch_add(1, std::memory_order_relaxed) + 1;
+    g_frames_delivered.fetch_add(1, std::memory_order_relaxed);
+  }
+};
+
+}  // namespace
+
+void BindFrameSinkReceiver(
+    mojo::PendingReceiver<media::mojom::AfreeMultiDisplayFrameSink> receiver) {
+  // Process-lifetime singleton bound on the calling (UI) thread.
+  static AfreeFrameSinkImpl* impl = new AfreeFrameSinkImpl();
+  static mojo::Receiver<media::mojom::AfreeMultiDisplayFrameSink>* recv =
+      new mojo::Receiver<media::mojom::AfreeMultiDisplayFrameSink>(impl);
+  if (recv->is_bound()) {
+    recv->reset();
+  }
+  recv->Bind(std::move(receiver));
+}
