+
+const char kVertexShader[] =
+    "attribute vec2 a_pos;\n"
+    "varying vec2 v_uv;\n"
+    "void main() {\n"
+    // Images are stored top-down but GL samples bottom-up, so flip V to keep the
+    // picture upright.
+    "  v_uv = vec2(a_pos.x * 0.5 + 0.5, 0.5 - a_pos.y * 0.5);\n"
+    "  gl_Position = vec4(a_pos, 0.0, 1.0);\n"
+    "}\n";
+
+// Simple moving-bars test pattern (M3a).
+const char kFragmentShader[] =
+    "precision mediump float;\n"
+    "uniform float u_time;\n"
+    "varying vec2 v_uv;\n"
+    "void main() {\n"
+    "  float x = v_uv.x + 0.20 * sin(u_time);\n"
+    "  float bar = step(0.5, fract(x * 6.0));\n"
+    "  float ybar = step(0.5, fract(v_uv.y * 4.0 + 0.5 * sin(u_time)));\n"
+    "  vec3 c = vec3(bar * 0.9, (1.0 - bar) * 0.6, 0.2 + 0.4 * ybar);\n"
+    "  gl_FragColor = vec4(c, 1.0);\n"
+    "}\n";
+
+const GLfloat kQuad[] = {
+    -1.f, -1.f, 1.f, -1.f, -1.f, 1.f, 1.f, 1.f,
+};
+
+// Texture drawing path (used for real video frame textures in M3b).
+const char kTexVertexShader[] =
+    "attribute vec2 a_pos;\n"
+    "varying vec2 v_uv;\n"
+    "void main() {\n"
+    // Flip V: uploaded RGBA rows and EGLImage buffers are top-down, but GL
+    // samples textures bottom-up.
+    "  v_uv = vec2(a_pos.x * 0.5 + 0.5, 0.5 - a_pos.y * 0.5);\n"
+    "  gl_Position = vec4(a_pos, 0.0, 1.0);\n"
+    "}\n";
+
+const char kTexFragmentShader[] =
+    "precision mediump float;\n"
+    "uniform sampler2D u_tex;\n"
+    "varying vec2 v_uv;\n"
+    "void main() {\n"
+    "  gl_FragColor = vec4(texture2D(u_tex, v_uv).rgb, 1.0);\n"
+    "}\n";
+
+// External (OES) video texture path (方案 A): draws a SurfaceTexture-backed
+// decoded video frame. May be unavailable on some contexts; tolerated.
+const char kOesFragmentShader[] =
+    "#extension GL_OES_EGL_image_external : require\n"
+    "precision mediump float;\n"
+    "uniform samplerExternalOES u_tex;\n"
+    "uniform mat4 u_matrix;\n"
+    "varying vec2 v_uv;\n"
+    "void main() {\n"
+    "  gl_FragColor = vec4(texture2D(u_tex, (u_matrix * vec4(v_uv, 0.0, 1.0)).xy).rgb, 1.0);\n"
+    "}\n";
+
+}  // namespace
