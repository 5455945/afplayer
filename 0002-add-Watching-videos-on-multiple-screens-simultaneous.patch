+JNIEXPORT jboolean JNICALL
+Java_com_afree_chromium_AfreeMultiDisplay_isSupported(JNIEnv*, jclass) {
+  return JNI_TRUE;
+}
+
+JNIEXPORT void JNICALL
+Java_com_afree_chromium_AfreeMultiDisplay_setContain(JNIEnv*,
+                                                     jclass,
+                                                     jboolean contain) {
+  const bool value = (contain == JNI_TRUE);
+  g_contain.store(value, std::memory_order_relaxed);
+  if (g_fanout) {
+    g_fanout->SetContain(value);
+  }
+  AFREE_MD_LOGI("setContain=%d", value ? 1 : 0);
+}
+
+JNIEXPORT void JNICALL
+Java_com_afree_chromium_AfreeMultiDisplay_submitPageFrame(JNIEnv* env,
+                                                          jclass,
+                                                          jint width,
+                                                          jint height,
+                                                          jint bytes_per_row,
+                                                          jobject buffer) {
+  if (!buffer || width <= 0 || height <= 0 || bytes_per_row != width * 4) {
+    return;
+  }
+  if (!EnsureStarted()) {
+    return;
+  }
+  void* data = env->GetDirectBufferAddress(buffer);
+  if (!data || env->GetDirectBufferCapacity(buffer) <
+                   static_cast<jlong>(bytes_per_row) * height) {
+    return;
+  }
+  const uint8_t* src = static_cast<const uint8_t*>(data);
+  const size_t pixels = static_cast<size_t>(width) * height;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  // Bitmap.copyPixelsToBuffer() gives the raw ARGB_8888 memory, which is
+  // RGBA byte order (NDK ANDROID_BITMAP_FORMAT_RGBA_8888) -> upload as-is.
+  g_sw.pixels.assign(src, src + pixels * 4);
+  g_sw.width = static_cast<int>(width);
+  g_sw.height = static_cast<int>(height);
+  g_sw.bytes_per_row = static_cast<int>(width) * 4;
+  g_sw.fid = g_frame_id.fetch_add(1, std::memory_order_relaxed) + 1;
+  g_frames_delivered.fetch_add(1, std::memory_order_relaxed);
+}
+
+JNIEXPORT jboolean JNICALL
+Java_com_afree_chromium_AfreeMultiDisplay_attachSurface(JNIEnv* env,
+                                                        jclass,
+                                                        jint display_id,
+                                                        jobject surface,
+                                                        jint width,
+                                                        jint height) {
+  if (surface == nullptr || !EnsureStarted()) {
+    return JNI_FALSE;
+  }
+  ANativeWindow* window = ANativeWindow_fromSurface(env, surface);
+  if (window == nullptr) {
+    return JNI_FALSE;
+  }
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    auto it = g_pending_surfaces.find(display_id);
+    if (it != g_pending_surfaces.end() && it->second.window) {
+      ANativeWindow_release(it->second.window);
+    }
+    PendingSurface ps;
+    ps.window = window;  // take ownership
+    ps.width = width;
+    ps.height = height;
+    g_pending_surfaces[display_id] = ps;
+    g_attach_requests.insert(display_id);
+  }
+  AFREE_MD_LOGI("attachSurface display=%d %dx%d", display_id, width, height);
+  return JNI_TRUE;
+}
+
+JNIEXPORT void JNICALL
+Java_com_afree_chromium_AfreeMultiDisplay_detachSurface(JNIEnv*,
+                                                        jclass,
+                                                        jint display_id) {
+  ANativeWindow* window = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    auto it = g_pending_surfaces.find(display_id);
+    if (it != g_pending_surfaces.end()) {
+      window = it->second.window;
+      g_pending_surfaces.erase(it);
+    }
+    g_detach_requests.insert(display_id);
+  }
+  if (window) {
+    ANativeWindow_release(window);
+  }
+  AFREE_MD_LOGI("detachSurface display=%d", display_id);
+}
+
+JNIEXPORT void JNICALL
+Java_com_afree_chromium_AfreeMultiDisplay_detachAll(JNIEnv*, jclass) {
+  std::set<int> ids;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    for (auto& kv : g_pending_surfaces) {
+      if (kv.second.window) {
+        ANativeWindow_release(kv.second.window);
+      }
+      ids.insert(kv.first);
+    }
+    g_pending_surfaces.clear();
+    for (int id : ids) {
+      g_detach_requests.insert(id);
+    }
+  }
+  AFREE_MD_LOGI("detachAll (%zu)", ids.size());
+}
