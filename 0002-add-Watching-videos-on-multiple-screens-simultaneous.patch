new file mode 100644
index 0000000000..f29140b553
--- /dev/null
+++ b/media/gpu/android/afree_multi_display_gpu_hook.cc
@@ -0,0 +1,62 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/android/afree_multi_display_gpu_hook.h"
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
+
+#include <android/hardware_buffer.h>
+#include <unistd.h>
+
+#include <atomic>
+
+#include "base/logging.h"
+
+namespace afree {
+namespace multi_display {
+static std::atomic<AfreeFrameBufferCallback> g_frame_callback{nullptr};
+static std::atomic<int> g_frame_count{0};
+
+void OnDecodedVideoFrame(const gfx::Size& coded_size,
+                         const gfx::Rect& visible_rect,
+                         AHardwareBuffer* buffer,
+                         int acquire_fence_fd) {
+  const int n = g_frame_count.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n % 60 == 1) {
+    VLOG(1) << "[AfreeMultiDisplay] decoded frame " << coded_size.ToString()
+            << " visible=" << visible_rect.ToString()
+            << " buffer=" << (buffer ? "yes" : "no") << " fence="
+            << acquire_fence_fd << " n=" << n;
+  }
+
+  AfreeFrameBufferCallback callback =
+      g_frame_callback.load(std::memory_order_acquire);
+  if (!callback) {
+    // No consumer: the caller handed us ownership; release it.
+    if (buffer) {
+      AHardwareBuffer_release(buffer);
+    }
+    if (acquire_fence_fd >= 0) {
+      close(acquire_fence_fd);
+    }
+    return;
+  }
+  // Hand ownership of the buffer ref + fence fd to the consumer.
+  callback(buffer, acquire_fence_fd);
+}
+
+}  // namespace multi_display
+}  // namespace afree
+
+extern "C" void AfreeMultiDisplaySetFrameBufferCallback(
+    AfreeFrameBufferCallback callback) {
+  afree::multi_display::g_frame_callback.store(callback,
+                                               std::memory_order_release);
+  VLOG(1) << "[AfreeMultiDisplay] SetFrameBufferCallback "
+          << (callback ? "registered" : "cleared");
+}
+
+#endif  // BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
diff --git a/media/gpu/android/afree_multi_display_gpu_hook.h b/media/gpu/android/afree_multi_display_gpu_hook.h
new file mode 100644
index 0000000000..6d81d9bd51
--- /dev/null
+++ b/media/gpu/android/afree_multi_display_gpu_hook.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_GPU_ANDROID_AFREE_MULTI_DISPLAY_GPU_HOOK_H_
+#define MEDIA_GPU_ANDROID_AFREE_MULTI_DISPLAY_GPU_HOOK_H_
+
+// afree multi_display (multi-screen same-view), M3b / 方案 B: GPU-process hook.
+//
+// CodecOutputBufferRenderer calls OnDecodedVideoFrame() right after a decoded
+// video frame is promoted to the TextureOwner front buffer. The frame's
+// AHardwareBuffer is forwarded to a callback (registered via the exported C API
+// AfreeMultiDisplaySetFrameBufferCallback, discoverable with dlsym from the
+// embedding app), which imports it as an EGLImage and draws it to the target
+// surfaces.
+//
+// The callback runs on the GPU thread and takes ownership of the buffer
+// reference and the fence fd it receives.
+//
+// Only compiled when the GN arg afree_multi_display=true.
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
+
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+struct AHardwareBuffer;
+
+// C callback type used by the exported entry point below.
+// |buffer|: caller owns a reference (release with AHardwareBuffer_release).
+// |acquire_fence_fd|: close when done; may be -1.
+typedef void (*AfreeFrameBufferCallback)(AHardwareBuffer* buffer,
+                                         int acquire_fence_fd);
+
+// Exported C API: register (or clear with nullptr) the multi_display frame
+// callback. The embedding app/demo can find this via
+// dlsym(RTLD_DEFAULT, "AfreeMultiDisplaySetFrameBufferCallback").
+extern "C" void AfreeMultiDisplaySetFrameBufferCallback(
+    AfreeFrameBufferCallback callback) __attribute__((visibility("default")));
+
+namespace afree {
+namespace multi_display {
+
+// Internal: called by CodecOutputBufferRenderer on the GPU thread.
+void OnDecodedVideoFrame(const gfx::Size& coded_size,
+                         const gfx::Rect& visible_rect,
+                         AHardwareBuffer* buffer,
+                         int acquire_fence_fd);
+
+}  // namespace multi_display
+}  // namespace afree
+
+#endif  // BUILDFLAG(IS_AFREE) && BUILDFLAG(IS_AFREE_SDK) && BUILDFLAG(IS_AFREE_MULTI_DISPLAY)
+
+#endif  // MEDIA_GPU_ANDROID_AFREE_MULTI_DISPLAY_GPU_HOOK_H_
