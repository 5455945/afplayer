diff --git a/android_webview/afree/tools/page_play.py b/android_webview/afree/tools/page_play.py
new file mode 100644
index 0000000000..86b128260a
--- /dev/null
+++ b/android_webview/afree/tools/page_play.py
@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Drive real-site playback for the multi_display `page` scenarios.
+
+Assumes MultiDisplayActivity is already running with the site URL and WebView
+debugging enabled (the test tool launches it with `-e cr '--force-debug'`).
+Connects over CDP, starts the site's video(s), and prints evidence. Exit 0 when
+the required playback happened.
+
+  iqiyi    : open a NON-VIP 电视剧 episode and play it for N seconds.
+  bilibili : open the FM (音乐) tab and play `count` videos, each N seconds.
+"""
+
+import argparse
+import importlib.util
+import os
+import sys
+import time
+
+# Never emit __pycache__ for the lazily imported media_test (or its own imports).
+sys.dont_write_bytecode = True
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+MT_PATH = os.path.join(HERE, "..", "demo", "media_test.py")
+_spec = importlib.util.spec_from_file_location("media_test", MT_PATH)
+mt = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(mt)
+
+
+def log(msg):
+    print("[page-play] %s" % msg, flush=True)
+
+
+def force_play(cdp):
+    cdp.eval("(function(){try{var a=document.querySelectorAll('video,audio');"
+             "for(var i=0;i<a.length;i++){a[i].muted=false;try{a[i].play();}catch(e){}}"
+             "return a.length;}catch(e){return 0;}})()")
+
+
+def playing_for(cdp, seconds):
+    """Return the media state if a media element stays playing ~seconds, else None."""
+    m = mt._cdp_media(cdp)
+    if not m or m.get("paused") is not False:
+        return None
+    t0 = m.get("t") or 0.0
+    deadline = time.time() + seconds + 8
+    while time.time() < deadline:
+        time.sleep(0.6)
+        m2 = mt._cdp_media(cdp) or m
+        t1 = m2.get("t") or 0.0
+        if (t1 - t0) >= seconds:
+            return m2
+    return None
+
+
+def play_iqiyi(device, cdp, seconds):
+    for _ in range(2):
+        mt.iqiyi_open_nonvip(cdp, device)
+        for _ in range(6):
+            force_play(cdp)
+            st = playing_for(cdp, seconds)
+            if st:
+                log("iqiyi playing: t=%.1f/%.1f paused=%s"
+                    % (st.get("t") or -1, st.get("d") or -1, st.get("paused")))
+                return True
+            time.sleep(1)
+    return False
+
+
+CARD_SEL = ".bili-video-horizontal"
+
+
+def bili_enter_music(device, cdp):
+    """Left nav '视频' -> category subnav '音乐'. True if the 音乐 pane is up."""
+    mt.js_click_selector(device, cdp, ".bili-nav__tab", 2, "视频 nav", visible_only=False)
+    time.sleep(2.5)
+    r = cdp.eval(
+        '(function(){var a=document.querySelectorAll(".bili-pane__subnav__list__item");'
+        'for(var i=0;i<a.length;i++){if((a[i].innerText||"").trim().indexOf("音乐")>=0){'
+        'a[i].scrollIntoView({block:"center"});a[i].click();return i;}}return -1;})()')
+    time.sleep(3)
+    return r is not None and r != -1
+
+
+def bili_click_random_card(cdp):
+    """Randomly click one visible '.bili-video-horizontal' card; return its index."""
+    return cdp.eval(
+        '(function(){var a=document.querySelectorAll("%s");var vis=[];var vw=innerWidth,vh=innerHeight;'
+        'for(var i=0;i<a.length;i++){var r=a[i].getBoundingClientRect();'
+        'var w=Math.min(r.right,vw)-Math.max(r.left,0);var h=Math.min(r.bottom,vh)-Math.max(r.top,0);'
+        'if(w>40&&h>40)vis.push(i);}'
+        'if(!vis.length)return -1;var pick=vis[Math.floor(Math.random()*vis.length)];'
+        'a[pick].scrollIntoView({block:"center"});a[pick].click();return pick;})()' % CARD_SEL)
+
+
+def play_bilibili(device, cdp, seconds, count):
+    # 视频 tab -> 音乐 category -> play `count` randomly chosen video cards.
+    played = 0
+    for _ in range(20):
+        if played >= count:
+            break
+        if "#/play" not in (mt._href(cdp) or "") and not bili_enter_music(device, cdp):
+            break
+        pick = bili_click_random_card(cdp)
+        if pick is None or pick == -1:
+            log("bilibili: no visible card in the 音乐 pane")
+            break
+        for _ in range(8):
+            force_play(cdp)
+            st = playing_for(cdp, seconds)
+            if st:
+                played += 1
+                log("bilibili video %d playing (card#%s): t=%.1f/%.1f"
+                    % (played, pick, st.get("t") or -1, st.get("d") or -1))
+                break
+            time.sleep(1)
+        cdp.eval("history.back()")
+        time.sleep(2.5)
+    return played
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--device", required=True)
+    ap.add_argument("--site", choices=["iqiyi", "bilibili"], required=True)
+    ap.add_argument("--ua")
+    ap.add_argument("--seconds", type=float, default=2.0)
+    ap.add_argument("--count", type=int, default=1)
+    args = ap.parse_args()
+
+    cdp = mt.CDP(args.device)
+    if not cdp.connect():
+        log("CDP connect failed (WebView debugging not enabled?)")
+        return 2
+    try:
+        if args.site == "iqiyi":
+            ok = play_iqiyi(args.device, cdp, args.seconds)
+            log("RESULT iqiyi played=%s" % ok)
+            return 0 if ok else 1
+        n = play_bilibili(args.device, cdp, args.seconds, args.count)
+        log("RESULT bilibili played=%d/%d" % (n, args.count))
+        return 0 if n >= args.count else 1
+    finally:
+        cdp.close()
+
+
+if __name__ == "__main__":
+    sys.exit(main())
