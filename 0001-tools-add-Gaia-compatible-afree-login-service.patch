+#!/usr/bin/env node
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {isEmailShaped} from './email.mjs';
+import {DEFAULT_CONFIG} from './config.mjs';
+
+const CLI_USAGE = `afree login service admin CLI
+
+Usage:
+  node src/cli.mjs <command> [options]
+
+Commands:
+  add-user        --email <email> [--password <pw>|-] [--name <name>]
+                  [--avatar <url>] [--db <path>]
+  list-users      [--db <path>]
+  set-password    --email <email> [--password <pw>|-]
+  disable-user    --email <email>
+  enable-user     --email <email>
+  delete-user     --email <email>
+  list-sessions   --email <email>
+  revoke-sessions --email <email>
+  prune                  Delete expired codes/tokens/sessions
+  gen-gaia-config [--url <origin>] [--client-id <id>]
+                  [--client-secret <secret>] [--output <path>]
+
+Password input:
+  Pass --password - to read one line from stdin, for example:
+    printf '%s\\n' "$PASSWORD" | node src/cli.mjs add-user --email a@b.c --password -
+`;
+
+/** @param {string[]} argv */
+function parseFlags(argv) {
+  /** @type {Record<string, string | boolean>} */
+  const flags = {};
+  /** @type {string[]} */
+  const positional = [];
+  for (let i = 0; i < argv.length; ++i) {
+    const arg = argv[i];
+    if (!arg.startsWith('--')) {
+      positional.push(arg);
+      continue;
+    }
+    const eq = arg.indexOf('=');
+    if (eq !== -1) {
+      flags[arg.slice(2, eq)] = arg.slice(eq + 1);
+      continue;
+    }
+    const name = arg.slice(2);
+    const next = argv[i + 1];
+    if (next !== undefined && !next.startsWith('--')) {
+      flags[name] = next;
+      ++i;
+    } else {
+      flags[name] = true;
+    }
+  }
+  return {flags, positional};
+}
+
+/** @param {Record<string, string | boolean>} flags @param {string} name */
+function requireFlag(flags, name) {
+  const value = flags[name];
+  if (typeof value !== 'string' || value.length === 0) {
+    throw new Error(`--${name} is required`);
+  }
+  return value;
+}
+
+/** @param {Record<string, string | boolean>} flags @param {string} name */
+function optionalFlag(flags, name) {
+  const value = flags[name];
+  return typeof value === 'string' ? value : undefined;
+}
+
+async function readStdinLine() {
+  /** @type {Buffer[]} */
+  const chunks = [];
+  for await (const chunk of process.stdin) {
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8').split('\n')[0].trim();
+}
+
+/** @param {Record<string, string | boolean>} flags */
+async function resolvePassword(flags) {
+  const provided = flags['password'];
+  if (typeof provided === 'string' && provided.length > 0) {
+    return provided === '-' ? await readStdinLine() : provided;
+  }
+  if (provided === true) {
+    throw new Error('--password requires a value (use --password - for stdin)');
+  }
+  throw new Error('--password is required (use --password - to read stdin)');
+}
+
+/** @param {Record<string, string | boolean>} flags */
+async function openStore(flags) {
+  const dbPath = optionalFlag(flags, 'db') ?? DEFAULT_CONFIG.dbPath;
+  const {Store} = await import('./db.mjs');
+  return Store.open(dbPath);
+}
+
+/**
+ * @param {string} url
+ * @param {string} clientId
+ * @param {string} clientSecret
+ */
+function buildGaiaConfig(url, clientId, clientSecret) {
+  const origin = new URL(url).origin;
+  return {
+    urls: {
+      google_url: {url: origin},
+      secure_google_url: {url: origin},
+      gaia_url: {url: origin},
+      lso_origin_url: {url: origin},
+      google_apis_origin_url: {url: origin},
+      oauth_account_manager_origin_url: {url: origin},
+      oauth_account_manager_mtls_origin_url: {url: origin},
+      oauth2_mtls_origin_url: {url: origin},
+      account_capabilities_origin_url: {url: origin},
+      people_api_origin_url: {url: origin},
+      classroom_api_origin_url: {url: origin},
+      tasks_api_origin_url: {url: origin},
+    },
+    api_keys: {
+      GOOGLE_DEFAULT_CLIENT_ID: clientId,
+      GOOGLE_DEFAULT_CLIENT_SECRET: clientSecret,
+      GOOGLE_CLIENT_ID_MAIN: clientId,
+      GOOGLE_CLIENT_SECRET_MAIN: clientSecret,
+    },
+  };
+}
+
+async function main() {
+  const argv = process.argv.slice(2);
+  if (argv.length === 0 || argv[0] === 'help' || argv[0] === '--help') {
+    process.stdout.write(CLI_USAGE);
+    return;
+  }
+  const command = argv[0];
+  const {flags} = parseFlags(argv.slice(1));
+
+  if (command === 'gen-gaia-config') {
+    const config = buildGaiaConfig(
+        optionalFlag(flags, 'url') ?? 'http://127.0.0.1:8080',
+        optionalFlag(flags, 'client-id') ?? 'afree-client-id',
+        optionalFlag(flags, 'client-secret') ?? 'afree-client-secret',
+    );
+    const json = `${JSON.stringify(config, null, 2)}\n`;
+    const output = optionalFlag(flags, 'output');
+    if (output) {
+      const {writeFileSync} = await import('node:fs');
+      writeFileSync(output, json);
+      process.stderr.write(`wrote ${output}\n`);
+    } else {
+      process.stdout.write(json);
+    }
+    return;
+  }
+
+  const store = await openStore(flags);
+  try {
+    switch (command) {
+      case 'add-user': {
+        const email = requireFlag(flags, 'email');
+        if (!isEmailShaped(email)) {
+          throw new Error(`invalid email: ${email}`);
+        }
+        const password = await resolvePassword(flags);
+        if (password.length < 8) {
+          throw new Error('password must be at least 8 characters');
+        }
+        if (store.getUserByEmail(email)) {
+          throw new Error(`user already exists: ${email}`);
+        }
+        const user = store.createUser({
+          email,
+          password,
+          displayName: optionalFlag(flags, 'name') ?? '',
+          avatarUrl: optionalFlag(flags, 'avatar') ?? '',
+        });
+        process.stdout.write(
+            `created ${user.display_email}\n  id:       ${user.id}\n  gaia_id:  ${
+                user.gaia_id}\n`);
+        break;
+      }
+      case 'list-users': {
+        const users = store.listUsers();
+        if (users.length === 0) {
+          process.stdout.write('no users\n');
+          break;
+        }
+        for (const user of users) {
+          process.stdout.write(
+              `${user.disabled ? '[disabled] ' : ''}${user.display_email}\t${
+                  user.gaia_id}\t${user.display_name || '-'}\n`);
+        }
+        break;
+      }
+      case 'set-password': {
+        const email = requireFlag(flags, 'email');
+        const user = store.getUserByEmail(email);
+        if (!user) {
+          throw new Error(`no such user: ${email}`);
+        }
+        const password = await resolvePassword(flags);
+        if (password.length < 8) {
+          throw new Error('password must be at least 8 characters');
+        }
+        store.setPassword(user.id, password);
+        process.stdout.write(`updated password for ${user.display_email}\n`);
+        break;
+      }
+      case 'disable-user':
+      case 'enable-user': {
+        const email = requireFlag(flags, 'email');
+        const user = store.getUserByEmail(email);
+        if (!user) {
+          throw new Error(`no such user: ${email}`);
+        }
+        const disabled = command === 'disable-user';
+        store.setDisabled(user.id, disabled);
+        if (disabled) {
+          store.revokeSessionByUser(user.id);
+        }
+        process.stdout.write(
+            `${disabled ? 'disabled' : 'enabled'} ${user.display_email}\n`);
+        break;
+      }
+      case 'list-sessions': {
+        const email = requireFlag(flags, 'email');
+        const user = store.getUserByEmail(email);
+        if (!user) {
+          throw new Error(`no such user: ${email}`);
+        }
+        const sessions = store.listSessionsByUser(user.id);
+        if (sessions.length === 0) {
+          process.stdout.write('no sessions\n');
+          break;
+        }
+        const formatTime = (seconds) =>
+          seconds ? new Date(seconds * 1000).toISOString() : '-';
+        for (const session of sessions) {
+          const state = session.revoked_at ?
+              'revoked' :
+              (session.expires_at * 1000 < Date.now() ? 'expired' : 'active');
+          process.stdout.write(
+              `${state}\tcreated=${formatTime(session.created_at)}\t` +
+              `last_seen=${formatTime(session.last_seen_at)}\t` +
+              `ip=${session.ip || '-'}\tdevice=${session.device_name || '-'}\n`);
+        }
+        break;
+      }
+      case 'revoke-sessions': {
+        const email = requireFlag(flags, 'email');
+        const user = store.getUserByEmail(email);
+        if (!user) {
+          throw new Error(`no such user: ${email}`);
+        }
+        store.revokeSessionByUser(user.id);
+        process.stdout.write(`revoked all sessions for ${user.display_email}\n`);
+        break;
+      }
+      case 'delete-user': {
+        const email = requireFlag(flags, 'email');
+        const user = store.getUserByEmail(email);
+        if (!user) {
+          throw new Error(`no such user: ${email}`);
+        }
+        store.deleteUser(user.id);
+        process.stdout.write(`deleted ${user.display_email}\n`);
+        break;
+      }
+      case 'prune': {
+        store.pruneExpired();
+        process.stdout.write('pruned expired rows\n');
+        break;
+      }
+      default:
+        process.stderr.write(`unknown command: ${command}\n\n${CLI_USAGE}`);
+        process.exitCode = 2;
+    }
+  } finally {
+    store.close();
+  }
+}
+
+main().catch((error) => {
+  process.stderr.write(`error: ${error?.message ?? error}\n`);
+  process.exit(1);
+});
