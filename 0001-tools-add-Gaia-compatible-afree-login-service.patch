+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// End-to-end protocol tests. These exercise the same wire formats Chromium
+// uses:
+//   * the DICE sign-in response header (components/signin/core/browser)
+//   * base64 binary gaia.ListAccountsResponse
+//   * the OAuth2 token endpoint
+//   * MultiBearer /oauth/multilogin with the XSSI prefix
+
+import assert from 'node:assert/strict';
+import {after, before, test} from 'node:test';
+import {mkdtempSync, rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+
+import {createLogger} from '../src/config.mjs';
+import {Store} from '../src/db.mjs';
+import {createHttpServer} from '../src/server.mjs';
+import {decodeListAccountsResponseBase64} from '../src/proto.mjs';
+
+const EMAIL = 'tester@example.com';
+const PASSWORD = 'correct horse battery staple';
+
+/** @type {Store} */
+let store;
+/** @type {import('node:http').Server} */
+let server;
+/** @type {string} */
+let base;
+/** @type {string} */
+let tempDir;
+/** @type {Map<string, string>} */
+const cookies = new Map();
+
+/** @param {string} pathname @param {object} [options] */
+async function request(pathname, options = {}) {
+  const {method = 'GET', headers = {}, body} = options;
+  const response = await fetch(`${base}${pathname}`, {
+    method,
+    headers,
+    body,
+    redirect: 'manual',
+  });
+  const text = await response.text();
+  return {
+    status: response.status,
+    headers: response.headers,
+    setCookies: response.headers.getSetCookie(),
+    text,
+  };
+}
+
+/** @param {string[]} setCookies */
+function storeCookies(setCookies) {
+  for (const raw of setCookies) {
+    const [pair] = raw.split(';');
+    const index = pair.indexOf('=');
+    const name = pair.slice(0, index);
+    const value = pair.slice(index + 1);
+    if (/Max-Age=0(;|$)/i.test(raw)) {
+      cookies.delete(name);
+    } else {
+      cookies.set(name, value);
+    }
+  }
+}
+
+function cookieHeader() {
+  return [...cookies].map(([name, value]) => `${name}=${value}`).join('; ');
+}
+
+/** @param {string} diceHeader */
+function parseDiceHeader(diceHeader) {
+  /** @type {Record<string, string>} */
+  const result = {};
+  for (const part of diceHeader.split(',')) {
+    const index = part.indexOf('=');
+    result[part.slice(0, index)] = decodeURIComponent(part.slice(index + 1));
+  }
+  return result;
+}
+
+before(async () => {
+  tempDir = mkdtempSync(path.join(tmpdir(), 'afree-login-test-'));
+  store = Store.open(path.join(tempDir, 'test.sqlite3'));
+  store.createUser({email: EMAIL, password: PASSWORD, displayName: 'Tester'});
+
+  /** @type {import('../src/config.mjs').Config} */
+  const config = {
+    host: '127.0.0.1',
+    port: 0,
+    dbPath: path.join(tempDir, 'test.sqlite3'),
+    publicUrl: 'http://127.0.0.1',
+    cookieHost: '127.0.0.1',
+    secureCookies: false,
+    accessTokenTtlSeconds: 3600,
+    refreshTokenTtlDays: 0,
+    authCodeTtlSeconds: 300,
+    sessionTtlDays: 30,
+    logLevel: 'silent',
+    allowRegistration: false,
+    allowedContinueHosts: [],
+    emitOAuthCodeCookie: true,
+    redirectContinue: false,
+  };
+
+  const {server: created} =
+      createHttpServer({store, config, logger: createLogger('silent')});
+  server = created;
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  const address = server.address();
+  base = `http://127.0.0.1:${address.port}`;
+  config.port = address.port;
+  config.publicUrl = base;
+});
+
+after(async () => {
+  await new Promise((resolve) => server.close(resolve));
+  store.close();
+  rmSync(tempDir, {recursive: true, force: true});
+});
+
+test('sign-in page renders a form', async () => {
+  const response = await request('/signin/chrome/sync?ssp=1&continue=https%3A%2F%2Fexample.com%2F');
+  assert.equal(response.status, 200);
+  assert.match(response.text, /<form method="post" action="" autocomplete="on">/);
+});
+
+test('wrong password does not set cookies', async () => {
+  const response = await request('/signin/chrome/sync', {
+    method: 'POST',
+    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+    body: new URLSearchParams({email: EMAIL, password: 'wrong'}).toString(),
+  });
+  assert.equal(response.status, 401);
+  assert.equal(response.setCookies.length, 0);
+  assert.match(response.text, /Wrong email or password/);
+});
+
+let authCode = '';
+let gaiaId = '';
+
+test('sign-in returns the DICE header and GAIA cookies', async () => {
+  const response = await request('/signin/chrome/sync?ssp=1', {
+    method: 'POST',
+    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+    body: new URLSearchParams({email: EMAIL, password: PASSWORD}).toString(),
+  });
+
+  assert.equal(response.status, 200);
+  storeCookies(response.setCookies);
+
+  for (const name of ['SID', 'LSID', 'HSID', 'SSID', 'APISID', 'SAPISID']) {
+    assert.ok(cookies.has(name), `missing ${name} cookie`);
+  }
+
+  const dice = response.headers.get('x-chrome-id-consistency-response');
+  assert.ok(dice, 'missing X-Chrome-ID-Consistency-Response');
+  const parsed = parseDiceHeader(dice);
+  assert.equal(parsed.action, 'SIGNIN');
+  assert.equal(parsed.email, EMAIL);
+  assert.equal(parsed.authuser, '0');
+  assert.ok(parsed.authorization_code.length > 20);
+  assert.ok(parsed.id.length > 10);
+
+  authCode = parsed.authorization_code;
+  gaiaId = parsed.id;
+
+  // The legacy inline flow reads this cookie.
+  assert.ok(response.text.includes('已登录 / Signed in'));
+});
+
+test('ListAccounts returns base64 binary protobuf', async () => {
+  // Chromium POSTs with a single space body.
+  const response = await request('/ListAccounts?gpsia=1&source=chrome&json=standard&laf=b64bin', {
+    method: 'POST',
+    headers: {Cookie: cookieHeader(), Origin: 'https://www.google.com'},
+    body: ' ',
+  });
+  assert.equal(response.status, 200);
+
+  const accounts = decodeListAccountsResponseBase64(response.text);
+  assert.equal(accounts.length, 1);
+  assert.equal(accounts[0].displayEmail, EMAIL);
+  assert.equal(accounts[0].obfuscatedId, gaiaId);
+  assert.equal(accounts[0].validSession, true);
+  assert.equal(accounts[0].signedOut, false);
+  assert.equal(accounts[0].isVerified, true);
+});
+
+test('ListAccounts without cookies returns an empty list', async () => {
+  const response = await request('/ListAccounts', {method: 'POST', body: ' '});
+  assert.equal(response.status, 200);
+  assert.deepEqual(decodeListAccountsResponseBase64(response.text), []);
+});
+
+let accessToken = '';
+let refreshToken = '';
+let idToken = '';
+
+test('authorization_code exchange issues tokens', async () => {
+  const response = await request('/oauth2/v4/token', {
+    method: 'POST',
+    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+    body: new URLSearchParams({
+      scope: 'https://www.googleapis.com/auth/oauth2login',
+      grant_type: 'authorization_code',
+      client_id: 'afree-client-id',
+      client_secret: 'afree-client-secret',
+      code: authCode,
+    }).toString(),
+  });
+  assert.equal(response.status, 200);
+  const payload = JSON.parse(response.text);
+  assert.equal(payload.token_type, 'Bearer');
+  assert.equal(payload.expires_in, 3600);
+  assert.ok(payload.access_token);
+  assert.ok(payload.refresh_token);
+  assert.ok(payload.id_token);
+
+  const claims = JSON.parse(
+      Buffer.from(payload.id_token.split('.')[1], 'base64url').toString('utf8'));
+  assert.equal(claims.sub, gaiaId);
+  assert.equal(claims.email, EMAIL);
+
+  accessToken = payload.access_token;
+  refreshToken = payload.refresh_token;
+  idToken = payload.id_token;
+});
+
+test('authorization codes are single use', async () => {
+  const response = await request('/oauth2/v4/token', {
+    method: 'POST',
+    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+    body: new URLSearchParams({
+      grant_type: 'authorization_code',
+      client_id: 'afree-client-id',
+      client_secret: 'afree-client-secret',
+      code: authCode,
+    }).toString(),
+  });
+  assert.equal(response.status, 400);
+  assert.equal(JSON.parse(response.text).error, 'invalid_grant');
+});
