@@ -0,0 +1,343 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Server-rendered pages for the Gaia-compatible sign-in service. These are
+// intentionally dependency-free and small; Chromium only needs a form that
+// eventually redirects back with the X-Chrome-ID-Consistency-Response header.
+
+/** @param {unknown} value */
+function escapeHtml(value) {
+  return String(value ?? '')
+      .replaceAll('&', '&amp;')
+      .replaceAll('<', '&lt;')
+      .replaceAll('>', '&gt;')
+      .replaceAll('"', '&quot;')
+      .replaceAll("'", '&#39;');
+}
+
+const STYLE = `
+  :root {
+    color-scheme: light dark;
+    --bg: #f6f7f9;
+    --card: #ffffff;
+    --text: #202124;
+    --muted: #5f6368;
+    --line: #dadce0;
+    --accent: #1a73e8;
+    --error-bg: #fce8e6;
+    --error-text: #b3261e;
+  }
+  @media (prefers-color-scheme: dark) {
+    :root {
+      --bg: #202124;
+      --card: #2d2e31;
+      --text: #e8eaed;
+      --muted: #9aa0a6;
+      --line: #5f6368;
+      --accent: #8ab4f8;
+      --error-bg: #4a1f1c;
+      --error-text: #f6aea9;
+    }
+  }
+  * { box-sizing: border-box; }
+  body {
+    margin: 0;
+    min-height: 100vh;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 24px;
+    background: var(--bg);
+    color: var(--text);
+    font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto,
+          "Noto Sans SC", sans-serif;
+  }
+  main {
+    width: 100%;
+    max-width: 400px;
+    background: var(--card);
+    border: 1px solid var(--line);
+    border-radius: 16px;
+    padding: 32px 28px 24px;
+    box-shadow: 0 1px 2px rgba(0, 0, 0, .08);
+  }
+  h1 { margin: 0 0 4px; font-size: 22px; font-weight: 500; }
+  .subtitle { margin: 0 0 24px; color: var(--muted); font-size: 13px; }
+  label { display: block; margin-bottom: 16px; }
+  label span { display: block; margin-bottom: 6px; font-size: 13px; color: var(--muted); }
+  input[type=email], input[type=password], input[type=text] {
+    width: 100%;
+    padding: 11px 12px;
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    background: transparent;
+    color: var(--text);
+    font-size: 15px;
+  }
+  input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
+  button {
+    width: 100%;
+    margin-top: 8px;
+    padding: 11px 16px;
+    border: 0;
+    border-radius: 999px;
+    background: var(--accent);
+    color: #fff;
+    font-size: 15px;
+    font-weight: 500;
+    cursor: pointer;
+  }
+  button:hover { filter: brightness(1.06); }
+  .error {
+    margin: 0 0 18px;
+    padding: 10px 12px;
+    border-radius: 8px;
+    background: var(--error-bg);
+    color: var(--error-text);
+    font-size: 13px;
+  }
+  .notice {
+    margin: 0 0 18px;
+    padding: 10px 12px;
+    border-radius: 8px;
+    background: rgba(26, 115, 232, .1);
+    color: var(--text);
+    font-size: 13px;
+  }
+  .hint { margin: 18px 0 0; color: var(--muted); font-size: 12px; word-break: break-all; }
+  .actions { margin-top: 20px; display: flex; gap: 12px; }
+  .actions a {
+    flex: 1;
+    text-align: center;
+    padding: 10px 14px;
+    border-radius: 999px;
+    border: 1px solid var(--line);
+    color: var(--text);
+    text-decoration: none;
+  }
+  .actions a.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
+  dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; font-size: 13px; }
+  dt { color: var(--muted); }
+  dd { margin: 0; word-break: break-all; }
+  ul.endpoints { padding-left: 18px; font-size: 13px; color: var(--muted); }
+  ul.endpoints code { color: var(--text); }
+`;
+
+/**
+ * @param {object} options
+ * @param {string} options.title
+ * @param {string} options.body
+ * @param {string} [options.lang]
+ */
+function layout({title, body, lang = 'zh-CN'}) {
+  return `<!doctype html>
+<html lang="${escapeHtml(lang)}">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="referrer" content="no-referrer">
+<title>${escapeHtml(title)}</title>
+<style>${STYLE}</style>
+</head>
+<body>
+<main>
+${body}
+</main>
+</body>
+</html>
+`;
+}
+
+/**
+ * @param {object} options
+ * @param {string} options.email
+ * @param {string} [options.error]
+ * @param {string} [options.continueUrl]
+ * @param {boolean} [options.addAccount]
+ * @param {string} [options.signedInEmail]
+ * @param {boolean} [options.allowRegistration]
+ * @param {string} [options.flow]
+ * @param {string} [options.serviceName]
+ */
+export function renderLoginPage({
+  email = '',
+  error = '',
+  continueUrl = '',
+  addAccount = false,
+  signedInEmail = '',
+  allowRegistration = false,
+  flow = '',
+  serviceName = 'afree',
+}) {
+  const notice = signedInEmail ?
+      `<p class="notice">此浏览器已登录 ${escapeHtml(signedInEmail)}，继续登录会切换主账号。<br>
+       Signed in as ${escapeHtml(signedInEmail)}; signing in again switches the
+       primary account.</p>` :
+      '';
+  const errorBlock = error ?
+      `<p class="error">${escapeHtml(error)}</p>` :
+      '';
+  const registerLink = allowRegistration ?
+      `<p class="hint">还没有账号？<a href="/signup">注册 afree 账号</a></p>` :
+      '';
+  return layout({
+    title: `登录 ${serviceName}`,
+    body: `<h1>登录 ${escapeHtml(serviceName)}</h1>
+<p class="subtitle">Sign in with your ${escapeHtml(serviceName)} account</p>
+${errorBlock}
+${notice}
+<form method="post" action="" autocomplete="on">
+  <input type="hidden" name="continue" value="${escapeHtml(continueUrl)}">
+  <input type="hidden" name="flow" value="${escapeHtml(flow)}">
+  <input type="hidden" name="add" value="${addAccount ? '1' : '0'}">
+  <label>
+    <span>邮箱 / Email</span>
+    <input type="email" name="email" value="${escapeHtml(email)}"
+           autocomplete="username" required autofocus>
+  </label>
+  <label>
+    <span>密码 / Password</span>
+    <input type="password" name="password" autocomplete="current-password"
+           required>
+  </label>
+  <button type="submit">登录 / Sign in</button>
+</form>
+${registerLink}
+<p class="hint">这是自建的 ${escapeHtml(serviceName)} 登录服务，不是 Google。
+This is a self-hosted ${escapeHtml(serviceName)} sign-in service, not Google.</p>`,
+  });
+}
+
+/**
+ * @param {object} options
+ * @param {string} options.email
+ * @param {string} options.gaiaId
+ * @param {string} [options.continueUrl]
+ * @param {string} [options.serviceName]
+ */
+export function renderSignedInPage({
+  email,
+  gaiaId,
+  continueUrl = '',
+  serviceName = 'afree',
+}) {
+  const continueLink = continueUrl ?
+      `<div class="actions">
+         <a class="primary" href="${escapeHtml(continueUrl)}">继续 / Continue</a>
+       </div>` :
+      '';
+  return layout({
+    title: `已登录 ${serviceName}`,
+    body: `<h1>已登录 / Signed in</h1>
+<p class="subtitle">Chromium 已经拿到登录凭据，可以关闭此页面。<br>
+Chromium already received the credentials; you can close this tab.</p>
+<dl>
+  <dt>账号 / Account</dt><dd>${escapeHtml(email)}</dd>
+  <dt>Gaia ID</dt><dd>${escapeHtml(gaiaId)}</dd>
+</dl>
+${continueLink}`,
+  });
+}
+
+/**
+ * @param {object} options
+ * @param {number} options.status
+ * @param {string} options.title
+ * @param {string} options.message
+ */
+export function renderErrorPage({status, title, message}) {
+  return layout({
+    title,
+    body: `<h1>${escapeHtml(title)}</h1>
+<p class="subtitle">HTTP ${status}</p>
+<p class="error">${escapeHtml(message)}</p>`,
+  });
+}
+
+/**
+ * @param {object} options
+ * @param {string} [options.email]
+ * @param {string} [options.error]
+ * @param {string} [options.continueUrl]
+ * @param {string} [options.serviceName]
+ */
+export function renderSignupPage({
+  email = '',
+  error = '',
+  continueUrl = '',
+  serviceName = 'afree',
+}) {
+  const errorBlock = error ?
+      `<p class="error">${escapeHtml(error)}</p>` :
+      '';
+  return layout({
+    title: `注册 ${serviceName}`,
+    body: `<h1>注册 ${escapeHtml(serviceName)}</h1>
+<p class="subtitle">Create a ${escapeHtml(serviceName)} account</p>
+${errorBlock}
+<form method="post" action="/signup" autocomplete="on">
+  <input type="hidden" name="continue" value="${escapeHtml(continueUrl)}">
+  <label>
+    <span>邮箱 / Email</span>
+    <input type="email" name="email" value="${escapeHtml(email)}"
+           autocomplete="username" required autofocus>
+  </label>
+  <label>
+    <span>密码 / Password (至少 8 位)</span>
+    <input type="password" name="password" autocomplete="new-password"
+           minlength="8" required>
+  </label>
+  <button type="submit">注册 / Create account</button>
+</form>
+<p class="hint">已有账号？<a href="/signin/chrome/sync">返回登录</a></p>`,
+  });
+}
+
+/**
+ * @param {object} options
+ * @param {string} [options.continueUrl]
+ * @param {string} [options.serviceName]
+ */
+export function renderSignedOutPage({continueUrl = '', serviceName = 'afree'}) {
+  const continueLink = continueUrl ?
+      `<div class="actions">
+         <a class="primary" href="${escapeHtml(continueUrl)}">继续 / Continue</a>
+       </div>` :
+      '';
+  return layout({
+    title: `已退出 ${serviceName}`,
+    body: `<h1>已退出 / Signed out</h1>
+<p class="subtitle">本机的 ${escapeHtml(serviceName)} 登录 cookie 已清除。<br>
+The ${escapeHtml(serviceName)} sign-in cookies have been cleared.</p>
+${continueLink}`,
+  });
+}
+
+/**
+ * @param {object} options
+ * @param {string} options.publicUrl
+ * @param {string} options.serviceName
+ */
+export function renderIndexPage({publicUrl, serviceName}) {
+  return layout({
+    title: `${serviceName} login service`,
+    body: `<h1>${escapeHtml(serviceName)} 登录服务</h1>
+<p class="subtitle">Gaia-compatible sign-in endpoint for Chromium/afree.</p>
+<dl>
+  <dt>Origin</dt><dd>${escapeHtml(publicUrl)}</dd>
+  <dt>Status</dt><dd>running</dd>
+</dl>
+<ul class="endpoints">
+  <li><code>GET/POST /signin/chrome/sync</code> — sign-in page</li>
+  <li><code>POST /ListAccounts</code> — base64 binary <code>ListAccountsResponse</code></li>
+  <li><code>POST /oauth2/v4/token</code> — OAuth2 token exchange</li>
+  <li><code>GET /oauth2/v1/userinfo</code> — user profile</li>
+  <li><code>POST /oauth/multilogin</code> — cookie propagation</li>
+  <li><code>GET /GetCheckConnectionInfo</code> — connection info</li>
+  <li><code>GET /Logout</code> — sign-out</li>
+</ul>
+<p class="hint">使用 <code>--gaia-config</code> 让 Chromium 指向此服务。
+Point Chromium at this service with <code>--gaia-config</code>.</p>`,
+  });
+}
