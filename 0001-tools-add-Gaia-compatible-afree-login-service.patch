@@ -0,0 +1,221 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {fileURLToPath} from 'node:url';
+import path from 'node:path';
+
+export const projectRoot =
+    path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+const LOOPBACK_HOSTS = new Set(['127.0.0.1', '::1', 'localhost']);
+
+/** @param {string} host */
+export function isLoopbackHost(host) {
+  return LOOPBACK_HOSTS.has(host);
+}
+
+/**
+ * @typedef {object} Config
+ * @property {string} host
+ * @property {number} port
+ * @property {string} dbPath
+ * @property {string} publicUrl
+ * @property {string} cookieHost
+ * @property {boolean} secureCookies
+ * @property {number} accessTokenTtlSeconds
+ * @property {number} refreshTokenTtlDays
+ * @property {number} authCodeTtlSeconds
+ * @property {number} sessionTtlDays
+ * @property {string} logLevel
+ * @property {boolean} allowRegistration
+ * @property {string[]} allowedContinueHosts
+ * @property {boolean} emitOAuthCodeCookie
+ * @property {boolean} redirectContinue
+ */
+
+/** @type {Config} */
+export const DEFAULT_CONFIG = {
+  host: '127.0.0.1',
+  port: 8080,
+  dbPath: path.join(projectRoot, 'data', 'afree-login.sqlite3'),
+  publicUrl: '',
+  cookieHost: '',
+  secureCookies: false,
+  accessTokenTtlSeconds: 3600,
+  refreshTokenTtlDays: 0,
+  authCodeTtlSeconds: 300,
+  sessionTtlDays: 30,
+  logLevel: 'info',
+  allowRegistration: false,
+  allowedContinueHosts: [],
+  emitOAuthCodeCookie: true,
+  // Real Gaia redirects to the ?continue= URL after sign-in. Chromium sets it
+  // to the Google base URL, which is often unreachable on a self-hosted
+  // deployment, so the default here renders the local "signed in" page
+  // instead. The DICE header is sent either way.
+  redirectContinue: false,
+};
+
+const NUMBER_FLAGS = new Map([
+  ['port', 'port'],
+  ['access-token-ttl', 'accessTokenTtlSeconds'],
+  ['refresh-token-ttl-days', 'refreshTokenTtlDays'],
+  ['auth-code-ttl', 'authCodeTtlSeconds'],
+  ['session-ttl-days', 'sessionTtlDays'],
+]);
+
+const STRING_FLAGS = new Map([
+  ['host', 'host'],
+  ['db', 'dbPath'],
+  ['public-url', 'publicUrl'],
+  ['log-level', 'logLevel'],
+]);
+
+const ENV_PREFIX = 'AFREE_LOGIN_';
+
+/**
+ * @param {string[]} argv
+ * @returns {Config}
+ */
+export function loadConfig(argv = process.argv.slice(2)) {
+  /** @type {Record<string, unknown>} */
+  const config = {...DEFAULT_CONFIG};
+
+  for (const [flag, key] of STRING_FLAGS) {
+    const env = process.env[ENV_PREFIX + flag.toUpperCase().replaceAll('-', '_')];
+    if (env) {
+      config[key] = env;
+    }
+  }
+  for (const [flag, key] of NUMBER_FLAGS) {
+    const env = process.env[ENV_PREFIX + flag.toUpperCase().replaceAll('-', '_')];
+    if (env) {
+      config[key] = Number(env);
+    }
+  }
+
+  for (let i = 0; i < argv.length; ++i) {
+    const arg = argv[i];
+    if (!arg.startsWith('--')) {
+      throw new Error(`unexpected argument: ${arg}`);
+    }
+    const eq = arg.indexOf('=');
+    const name = eq === -1 ? arg.slice(2) : arg.slice(2, eq);
+    const inlineValue = eq === -1 ? null : arg.slice(eq + 1);
+    /** @returns {string} */
+    const nextValue = () => {
+      if (inlineValue !== null) {
+        return inlineValue;
+      }
+      if (i + 1 >= argv.length) {
+        throw new Error(`--${name} requires a value`);
+      }
+      return argv[++i];
+    };
+
+    if (NUMBER_FLAGS.has(name)) {
+      const value = Number(nextValue());
+      if (!Number.isFinite(value) || value < 0) {
+        throw new Error(`--${name} must be a non-negative number`);
+      }
+      config[NUMBER_FLAGS.get(name)] = value;
+    } else if (STRING_FLAGS.has(name)) {
+      config[STRING_FLAGS.get(name)] = nextValue();
+    } else if (name === 'allow-registration') {
+      config.allowRegistration = true;
+    } else if (name === 'redirect-continue') {
+      config.redirectContinue = true;
+    } else if (name === 'no-oauth-code-cookie') {
+      config.emitOAuthCodeCookie = false;
+    } else if (name === 'allowed-continue-hosts') {
+      config.allowedContinueHosts = nextValue()
+                                        .split(',')
+                                        .map((value) => value.trim())
+                                        .filter(Boolean);
+    } else {
+      throw new Error(`unknown option: --${name}`);
+    }
+  }
+
+  const publicUrl = /** @type {string} */ (config.publicUrl) ||
+      `http://${displayHost(/** @type {string} */ (config.host))}:${
+          /** @type {number} */ (config.port)}/`;
+  const parsedPublicUrl = new URL(publicUrl);
+  if (!['http:', 'https:'].includes(parsedPublicUrl.protocol)) {
+    throw new Error('--public-url must be an http:// or https:// URL');
+  }
+  config.publicUrl = parsedPublicUrl.origin;
+  config.cookieHost = parsedPublicUrl.hostname;
+  config.secureCookies = parsedPublicUrl.protocol === 'https:';
+
+  return /** @type {Config} */ (config);
+}
+
+/**
+ * `0.0.0.0`/`::` are bind addresses, not something a client can dial.
+ * @param {string} host
+ */
+function displayHost(host) {
+  if (host === '0.0.0.0' || host === '::' || host === '') {
+    return '127.0.0.1';
+  }
+  return host.includes(':') ? `[${host}]` : host;
+}
+
+export const USAGE = `afree login service (Gaia-compatible)
+
+Usage:
+  node src/server.mjs [options]
+  node src/cli.mjs <command> [options]
+
+Options:
+  --host <addr>                  Bind address (default 127.0.0.1)
+  --port <port>                  TCP port (default 8080)
+  --db <path>                    SQLite database file
+  --public-url <url>             Origin Chromium uses to reach this service
+                                 (default http://<host>:<port>)
+  --access-token-ttl <seconds>   Access token lifetime (default 3600)
+  --refresh-token-ttl-days <n>   Refresh token lifetime, 0 = no expiry
+  --auth-code-ttl <seconds>      Authorization code lifetime (default 300)
+  --session-ttl-days <n>         Browser session lifetime (default 30)
+  --log-level <level>            debug|info|warn|error|silent (default info)
+  --allow-registration           Enable the optional /signup page
+  --redirect-continue            Redirect to ?continue= after sign-in like
+                                 Google Gaia does (default: show a local page)
+  --allowed-continue-hosts <h>   Comma separated allowlist for ?continue=
+                                 (default: allow any http(s) URL)
+  --no-oauth-code-cookie         Do not emit the legacy oauth_code cookie
+
+Environment variables use the AFREE_LOGIN_ prefix, for example
+AFREE_LOGIN_PORT=9000 or AFREE_LOGIN_PUBLIC_URL=https://login.example.com.
+`;
+
+/** @param {string} level */
+export function createLogger(level = 'info') {
+  const priorities = {debug: 10, info: 20, warn: 30, error: 40, silent: 100};
+  const threshold = priorities[level] ?? priorities.info;
+  /**
+   * @param {keyof priorities} severity
+   * @param {string} message
+   * @param {object} [fields]
+   */
+  const emit = (severity, message, fields) => {
+    if (priorities[severity] < threshold) {
+      return;
+    }
+    const line = {
+      level: severity,
+      time: new Date().toISOString(),
+      message,
+      ...(fields ?? {}),
+    };
+    process.stderr.write(`${JSON.stringify(line)}\n`);
+  };
+  return {
+    debug: (message, fields) => emit('debug', message, fields),
+    info: (message, fields) => emit('info', message, fields),
+    warn: (message, fields) => emit('warn', message, fields),
+    error: (message, fields) => emit('error', message, fields),
+  };
+}
diff --git a/tools/afree-login-service/src/db.mjs b/tools/afree-login-service/src/db.mjs
new file mode 100644
index 0000000000..95b4be6cae
--- /dev/null
+++ b/tools/afree-login-service/src/db.mjs
@@ -0,0 +1,510 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {randomBytes, createHash, randomInt, scryptSync, timingSafeEqual} from 'node:crypto';
+import {mkdirSync, readFileSync} from 'node:fs';
+import {dirname} from 'node:path';
+import {DatabaseSync} from 'node:sqlite';
+import {canonicalizeEmail} from './email.mjs';
+
+/** @param {string} value */
+export function sha256(value) {
+  return createHash('sha256').update(value).digest('base64url');
+}
+
+/** Returns a 256-bit URL-safe random token. */
+export function randomToken() {
+  return randomBytes(32).toString('base64url');
+}
+
+/** Returns a Gaia-style opaque account id: a 21 digit decimal string. */
+export function randomGaiaId() {
+  // First digit is 1-9 so the value never has a leading zero.
+  let id = String(randomInt(1, 10));
+  while (id.length < 21) {
+    id += String(randomInt(0, 10));
+  }
+  return id;
+}
+
+const SCRYPT_N = 16384;
+const SCRYPT_R = 8;
+const SCRYPT_P = 1;
+const SCRYPT_KEYLEN = 64;
+
+/**
+ * Hashes a password with scrypt. The format is
+ * `scrypt$<N>$<r>$<p>$<salt-b64>$<hash-b64>`.
+ * @param {string} password
+ * @returns {string}
+ */
+export function hashPassword(password) {
+  const salt = randomBytes(16);
+  const derived = scryptSync(password, salt, SCRYPT_KEYLEN, {
+    N: SCRYPT_N,
+    r: SCRYPT_R,
+    p: SCRYPT_P,
+    maxmem: 128 * SCRYPT_N * SCRYPT_R * 2,
+  });
+  return [
+    'scrypt',
+    SCRYPT_N,
+    SCRYPT_R,
+    SCRYPT_P,
+    salt.toString('base64'),
+    derived.toString('base64'),
+  ].join('$');
+}
+
+/**
+ * @param {string} password
+ * @param {string} encoded
+ * @returns {boolean}
+ */
+export function verifyPassword(password, encoded) {
+  const parts = encoded.split('$');
+  if (parts.length !== 6 || parts[0] !== 'scrypt') {
+    return false;
+  }
+  const [, n, r, p, saltB64, hashB64] = parts;
+  const salt = Buffer.from(saltB64, 'base64');
+  const expected = Buffer.from(hashB64, 'base64');
+  let derived;
+  try {
+    derived = scryptSync(password, salt, expected.length, {
+      N: Number(n),
+      r: Number(r),
+      p: Number(p),
+      maxmem: 128 * Number(n) * Number(r) * 2,
+    });
+  } catch {
+    return false;
+  }
+  return derived.length === expected.length &&
+      timingSafeEqual(derived, expected);
+}
+
+/**
+ * Thin wrapper around node:sqlite with the queries the service needs.
+ */export class Store {
+  /**
+   * @param {import('node:sqlite').DatabaseSync} db
+   */
+  constructor(db) {
+    this.db = db;
+  }
+
+  /**
+   * Opens (and migrates) the database.
+   * @param {string} path
+   * @returns {Store}
+   */
+  static open(path) {
+    if (path !== ':memory:') {
+      mkdirSync(dirname(path), {recursive: true});
+    }
+    const db = new DatabaseSync(path);
+    db.exec('PRAGMA journal_mode = WAL;');
+    db.exec('PRAGMA synchronous = NORMAL;');
+    db.exec('PRAGMA foreign_keys = ON;');
+    db.exec('PRAGMA busy_timeout = 5000;');
+    const schema = readFileSync(new URL('./schema.sql', import.meta.url), 'utf8');
+    db.exec(schema);
+    return new Store(db);
+  }
+
+  close() {
+    this.db.close();
+  }
+
+  // ---------------------------------------------------------------- meta
+
+  getMeta(key) {
+    const row = this.db.prepare('SELECT value FROM meta WHERE key = ?').get(key);
+    return row ? row.value : null;
+  }
+
+  setMeta(key, value) {
+    this.db
+        .prepare(
+            'INSERT INTO meta(key, value) VALUES(?, ?) ' +
+            'ON CONFLICT(key) DO UPDATE SET value = excluded.value')
+        .run(key, value);
+  }
+
+  /** Returns the persistent HMAC secret, creating it on first start. */
+  getOrCreateSecret() {
+    const existing = this.getMeta('cookie_secret');
+    if (existing) {
+      return existing;
+    }
+    const secret = randomBytes(32).toString('base64url');
+    this.setMeta('cookie_secret', secret);
+    return secret;
+  }
+
+  // --------------------------------------------------------------- users
+
+  createUser({
+    email,
+    password,
+    displayName = '',
+    avatarUrl = '',
+    emailVerified = true,
+  }) {
+    const canonical = canonicalizeEmail(email);
+    const now = Math.floor(Date.now() / 1000);
+    const id = randomToken();
+    const gaiaId = randomGaiaId();
+    this.db
+        .prepare(
+            'INSERT INTO users(' +
+            'id, email, display_email, password_hash, gaia_id, display_name,' +
+            ' avatar_url, email_verified, created_at, updated_at' +
+            ') VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?)')
+        .run(
+            id,
+            canonical,
+            String(email).trim(),
+            hashPassword(password),
+            gaiaId,
+            displayName,
+            avatarUrl,
+            emailVerified ? 1 : 0,
+            now,
+            now,
+        );
+    return this.getUserById(id);
+  }
+
+  getUserById(id) {
+    return this.db.prepare('SELECT * FROM users WHERE id = ?').get(id) ??
+        null;
+  }
+
+  getUserByEmail(email) {
+    return this.db
+               .prepare('SELECT * FROM users WHERE email = ?')
+               .get(canonicalizeEmail(email)) ??
+        null;
+  }
+
+  listUsers() {
+    return this.db
+        .prepare(
+            'SELECT id, email, display_email, gaia_id, display_name, disabled,' +
+            ' created_at FROM users ORDER BY created_at')
+        .all();
+  }
+
+  setPassword(userId, password) {
+    this.db
+        .prepare('UPDATE users SET password_hash = ?, updated_at = ? WHERE id = ?')
+        .run(
+            hashPassword(password),
+            Math.floor(Date.now() / 1000),
+            userId,
+        );
+  }
+
+  setDisabled(userId, disabled) {
+    this.db
+        .prepare('UPDATE users SET disabled = ?, updated_at = ? WHERE id = ?')
+        .run(
+            disabled ? 1 : 0,
+            Math.floor(Date.now() / 1000),
+            userId,
+        );
+  }
+
+  deleteUser(userId) {
+    this.db.prepare('DELETE FROM users WHERE id = ?').run(userId);
+  }
+
+  // ------------------------------------------------------------ sessions
+
+  /**
+   * Creates a new GAIA-style session ("SID" cookie).
+   * @param {string} primaryUserId
+   * @param {{deviceId?: string, deviceName?: string, userAgent?: string,
+   *          ip?: string, ttlSeconds: number}} options
+   */
+  createSession(primaryUserId, options) {
+    const now = Math.floor(Date.now() / 1000);
+    const id = randomToken();
+    this.db
+        .prepare(
+            'INSERT INTO sessions(' +
+            'id, primary_user_id, device_id, device_name, user_agent, ip,' +
+            ' created_at, last_seen_at, expires_at' +
+            ') VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?)')
+        .run(
+            id,
+            primaryUserId,
+            options.deviceId ?? '',
+            options.deviceName ?? '',
+            options.userAgent ?? '',
+            options.ip ?? '',
+            now,
+            now,
+            now + options.ttlSeconds,
+        );
+    this.addAccountToSession(id, primaryUserId);
+    return id;
+  }
+
+  addAccountToSession(sessionId, userId) {
+    const existing = this.db
+                         .prepare(
+                             'SELECT position FROM session_accounts ' +
+                             'WHERE session_id = ? AND user_id = ?')
+                         .get(sessionId, userId);
+    if (existing) {
+      return existing.position;
+    }
+    const row = this.db
+                    .prepare(
+                        'SELECT COALESCE(MAX(position), -1) + 1 AS position ' +
+                        'FROM session_accounts WHERE session_id = ?')
+                    .get(sessionId);
+    const position = row.position;
+    this.db
+        .prepare(
+            'INSERT INTO session_accounts(session_id, user_id, position,' +
+            ' added_at) VALUES(?, ?, ?, ?)')
+        .run(sessionId, userId, position, Math.floor(Date.now() / 1000));
+    return position;
+  }
+
+  getSession(sessionId) {
+    return this.db
+               .prepare('SELECT * FROM sessions WHERE id = ?')
+               .get(sessionId) ??
+        null;
+  }
+
+  getSessionAccounts(sessionId) {
+    return this.db
+        .prepare(
+            'SELECT sa.position, u.* FROM session_accounts sa ' +
+            'JOIN users u ON u.id = sa.user_id ' +
+            'WHERE sa.session_id = ? ORDER BY sa.position')
+        .all(sessionId);
+  }
+
+  /** Returns the account position for `userId` in `sessionId`, or -1. */
+  getAccountPosition(sessionId, userId) {
+    const row = this.db
+                    .prepare(
+                        'SELECT position FROM session_accounts ' +
+                        'WHERE session_id = ? AND user_id = ?')
+                    .get(sessionId, userId);
+    return row ? row.position : -1;
+  }
+
+  touchSession(sessionId) {
+    this.db
+        .prepare('UPDATE sessions SET last_seen_at = ? WHERE id = ?')
+        .run(Math.floor(Date.now() / 1000), sessionId);
+  }
+
+  revokeSession(sessionId) {
+    this.db
+        .prepare('UPDATE sessions SET revoked_at = ? WHERE id = ?')
+        .run(Math.floor(Date.now() / 1000), sessionId);
+  }
+
+  revokeSessionByUser(userId) {
+    this.db
+        .prepare(
+            'UPDATE sessions SET revoked_at = ? WHERE primary_user_id = ?')
+        .run(Math.floor(Date.now() / 1000), userId);
+  }
+
+  /** @param {string} userId */
+  listSessionsByUser(userId) {
+    return this.db
+        .prepare(
+            'SELECT id, device_id, device_name, ip, user_agent, created_at,' +
+            ' last_seen_at, expires_at, revoked_at FROM sessions ' +
+            'WHERE primary_user_id = ? ORDER BY last_seen_at DESC')
+        .all(userId);
+  }
+
+  // ----------------------------------------------------------- auth codes
+
+  createAuthCode({
+    userId,
+    clientId = '',
+    redirectUri = '',
+    scope = '',
+    deviceId = '',
+    ttlSeconds,
+  }) {
+    const code = randomToken();
+    const now = Math.floor(Date.now() / 1000);
+    this.db
+        .prepare(
+            'INSERT INTO auth_codes(' +
+            'code_hash, user_id, client_id, redirect_uri, scope, device_id,' +
+            ' created_at, expires_at) VALUES(?, ?, ?, ?, ?, ?, ?, ?)')
+        .run(
+            sha256(code),
+            userId,
+            clientId,
+            redirectUri,
+            scope,
+            deviceId,
+            now,
+            now + ttlSeconds,
+        );
+    return code;
+  }
+
+  /**
+   * Consumes a single-use authorization code. Returns the row on success.
+   * The UPDATE ... WHERE used_at IS NULL makes this atomic.
+   */
+  consumeAuthCode(code) {
+    const now = Math.floor(Date.now() / 1000);
+    const hash = sha256(code);
+    const result = this.db
+                       .prepare(
+                           'UPDATE auth_codes SET used_at = ? ' +
+                           'WHERE code_hash = ? AND used_at IS NULL ' +
+                           'AND expires_at > ?')
+                       .run(now, hash, now);
+    if (result.changes !== 1) {
+      return null;
+    }
+    return this.db.prepare('SELECT * FROM auth_codes WHERE code_hash = ?').get(hash) ??
+        null;
+  }
+
+  // -------------------------------------------------------- refresh token
+
+  createRefreshToken({
+    userId,
+    clientId = '',
+    scope = '',
+    deviceId = '',
+    deviceName = '',
+    ttlDays = 0,
+  }) {
+    const token = randomToken();
+    const now = Math.floor(Date.now() / 1000);
+    this.db
+        .prepare(
+            'INSERT INTO refresh_tokens(' +
+            'token_hash, user_id, client_id, scope, device_id, device_name,' +
+            ' created_at, expires_at) VALUES(?, ?, ?, ?, ?, ?, ?, ?)')
+        .run(
+            sha256(token),
+            userId,
+            clientId,
+            scope,
+            deviceId,
+            deviceName,
+            now,
+            ttlDays > 0 ? now + ttlDays * 86400 : null,
+        );
+    return token;
+  }
+
+  getRefreshToken(token) {
+    const row = this.db
+                    .prepare('SELECT * FROM refresh_tokens WHERE token_hash = ?')
+                    .get(sha256(token));
+    if (!row || row.revoked_at) {
+      return null;
+    }
+    const now = Math.floor(Date.now() / 1000);
+    if (row.expires_at && row.expires_at <= now) {
+      return null;
+    }
+    this.db
+        .prepare('UPDATE refresh_tokens SET last_used_at = ? WHERE token_hash = ?')
+        .run(now, row.token_hash);
+    return row;
+  }
+
+  revokeRefreshToken(token) {
+    const result = this.db
+                       .prepare(
+                           'UPDATE refresh_tokens SET revoked_at = ? ' +
+                           'WHERE token_hash = ? AND revoked_at IS NULL')
+                       .run(Math.floor(Date.now() / 1000), sha256(token));
+    return result.changes === 1;
+  }
+
+  // --------------------------------------------------------- access token
+
+  createAccessToken({
+    userId,
+    refreshTokenHash = null,
+    clientId = '',
+    scope = '',
+    ttlSeconds,
+  }) {
+    const token = randomToken();
+    const now = Math.floor(Date.now() / 1000);
+    this.db
+        .prepare(
+            'INSERT INTO access_tokens(' +
+            'token_hash, user_id, refresh_token_hash, client_id, scope,' +
+            ' created_at, expires_at) VALUES(?, ?, ?, ?, ?, ?, ?)')
+        .run(
+            sha256(token),
+            userId,
+            refreshTokenHash,
+            clientId,
+            scope,
+            now,
+            now + ttlSeconds,
+        );
+    return token;
+  }
+
+  getAccessToken(token) {
+    const row = this.db
+                    .prepare('SELECT * FROM access_tokens WHERE token_hash = ?')
+                    .get(sha256(token));
+    if (!row || row.revoked_at) {
+      return null;
+    }
+    if (row.expires_at <= Math.floor(Date.now() / 1000)) {
+      return null;
+    }
+    return row;
+  }
+
+  // -------------------------------------------------------------- audit
+
+  audit({userId = null, event, detail = '', ip = '', userAgent = ''}) {
+    this.db
+        .prepare(
+            'INSERT INTO audit_log(user_id, event, detail, ip, user_agent,' +
+            ' created_at) VALUES(?, ?, ?, ?, ?, ?)')
+        .run(
+            userId,
+            event,
+            detail,
+            ip,
+            userAgent,
+            Math.floor(Date.now() / 1000),
+        );
+  }
+
+  pruneExpired(now = Math.floor(Date.now() / 1000)) {
+    this.db.prepare('DELETE FROM auth_codes WHERE expires_at < ?').run(now);
+    this.db
+        .prepare(
+            'DELETE FROM access_tokens WHERE expires_at < ? OR revoked_at IS NOT NULL')
+        .run(now);
+    this.db
+        .prepare('DELETE FROM sessions WHERE expires_at < ? OR revoked_at IS NOT NULL')
+        .run(now);
+  }
+}
+
