+// found in the LICENSE file.
+
+/** Canonicalizes an email address the way Gaia does for lookups. */
+export function canonicalizeEmail(email) {
+  return String(email).trim().toLowerCase();
+}
+
+export function isEmailShaped(email) {
+  const value = String(email);
+  return value.length > 2 && value.length <= 254 &&
+      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
+}
diff --git a/tools/afree-login-service/src/gaia.mjs b/tools/afree-login-service/src/gaia.mjs
new file mode 100644
index 0000000000..5981f94269
--- /dev/null
+++ b/tools/afree-login-service/src/gaia.mjs
@@ -0,0 +1,1278 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Gaia-compatible HTTP surface for Chromium sign-in.
+//
+// The endpoints and wire formats below are derived from Chromium's own
+// FakeGaia implementation and from the real request/response shapes:
+//
+//   google_apis/gaia/fake_gaia.cc
+//   google_apis/gaia/gaia_auth_fetcher.cc
+//   google_apis/gaia/gaia_auth_util.cc
+//   google_apis/gaia/list_accounts_response.proto
+//   components/signin/core/browser/dice_header_helper.cc
+//   components/signin/internal/identity_manager/gaia_cookie_manager_service.cc
+//
+// In particular:
+//   * /ListAccounts is a POST with cookies and returns
+//     base64(binary gaia.ListAccountsResponse), not JSON.
+//   * The sign-in result is signalled to Chromium with the
+//     X-Chrome-ID-Consistency-Response header, not with a cookie.
+//   * /oauth/multilogin returns JSON with the XSSI prefix ")]}'\n".
+
+import {createHmac} from 'node:crypto';
+import {hashPassword, sha256, verifyPassword} from './db.mjs';
+import {canonicalizeEmail} from './email.mjs';
+import {encodeListAccountsResponseBase64} from './proto.mjs';
+import {
+  renderErrorPage,
+  renderIndexPage,
+  renderLoginPage,
+  renderSignedInPage,
+  renderSignedOutPage,
+  renderSignupPage,
+} from './views.mjs';
+
+// Cookie names Chromium expects to find for a signed-in GAIA session.
+// SAPISID is the name the cookie listener in GaiaCookieManagerService watches
+// (gaia_constants.h: kGaiaSigninCookieName).
+const GAIA_COOKIE_NAMES = ['SID', 'LSID', 'HSID', 'SSID', 'APISID', 'SAPISID'];
+
+const DICE_HEADER = 'X-Chrome-ID-Consistency-Response';
+const SIGNOUT_HEADER = 'Google-Accounts-SignOut';
+const XSSI_PREFIX = ")]}'\n";
+
+// Used to keep the response time of "unknown user" and "wrong password"
+// roughly equal. Contains no secret.
+const DUMMY_PASSWORD_HASH = hashPassword('afree-dummy-password');
+
+const MAX_BODY_BYTES = 256 * 1024;
+const MAX_PASSWORD_LENGTH = 4096;
+
+// All of these load the sign-in form. Chromium normally uses
+// /signin/chrome/sync, the others exist for the older/edge sign-in flows.
+const SIGNIN_PATHS = new Set([
+  '/signin/chrome/sync',
+  '/ServiceLogin',
+  '/ServiceLoginAuth',
+  '/AccountChooser',
+  '/AddSession',
+  '/embedded/setup/chrome/usermenu',
+  '/embedded/xreauth/chrome',
+]);
+
+// The scope Chromium uses when it exchanges the sign-in authorization code.
+// Mirrors GaiaConstants::kOAuth1LoginScope.
+const OAUTH1_LOGIN_SCOPE = 'https://www.googleapis.com/auth/oauth2login';
+
+/** @param {string} headerValue */
+function parseCookieHeader(headerValue) {
+  /** @type {Map<string, string>} */
+  const cookies = new Map();
+  if (!headerValue) {
+    return cookies;
+  }
+  for (const part of headerValue.split(';')) {
+    const index = part.indexOf('=');
+    if (index === -1) {
+      continue;
+    }
+    const name = part.slice(0, index).trim();
+    if (!name || cookies.has(name)) {
+      continue;
+    }
+    cookies.set(name, part.slice(index + 1).trim());
+  }
+  return cookies;
+}
+
+/** @param {import('node:http').IncomingMessage} req */
+async function readBody(req) {
+  /** @type {Buffer[]} */
+  const chunks = [];
+  let total = 0;
+  for await (const chunk of req) {
+    total += chunk.length;
+    if (total > MAX_BODY_BYTES) {
+      const error = new Error('request body too large');
+      // @ts-ignore
+      error.statusCode = 413;
+      throw error;
+    }
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+/** @param {import('node:http').ServerResponse} res */
+function send(res, status, headers, body) {
+  res.writeHead(status, {
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'no-referrer',
+    ...headers,
+  });
+  res.end(body);
+}
+
+function sendText(res, status, body, headers = {}) {
+  send(
+      res,
+      status,
+      {'Content-Type': 'text/plain; charset=utf-8', ...headers},
+      body,
+  );
+}
+
+function sendHtml(res, status, body, headers = {}) {
+  send(
+      res,
+      status,
+      {'Content-Type': 'text/html; charset=utf-8', ...headers},
+      body,
+  );
+}
+
+function sendJson(res, status, value, headers = {}) {
+  send(
+      res,
+      status,
+      {'Content-Type': 'application/json; charset=utf-8', ...headers},
+      JSON.stringify(value),
+  );
+}
+
+function sendXssiJson(res, status, value, headers = {}) {
+  send(
+      res,
+      status,
+      {'Content-Type': 'application/json; charset=utf-8', ...headers},
+      XSSI_PREFIX + JSON.stringify(value),
+  );
+}
+
+function redirect(res, location, headers = {}) {
+  send(
+      res,
+      302,
+      {'Content-Type': 'text/plain; charset=utf-8', Location: location, ...headers},
+      '',
+  );
+}
+
+function base64urlJson(value) {
+  return Buffer.from(JSON.stringify(value)).toString('base64url');
+}
+
+/**
+ * Signs a compact JWT with HS256. Chromium does not verify the signature of
+ * the id_token it receives directly from the token endpoint, but emitting a
+ * well-formed token keeps the payload usable by other tooling.
+ */
+function signJwt(secret, payload) {
+  const header = {alg: 'HS256', typ: 'JWT', kid: 'afree-signin-1'};
+  const signingInput = `${base64urlJson(header)}.${base64urlJson(payload)}`;
+  const signature = createHmac('sha256', secret)
+                        .update(signingInput)
+                        .digest('base64url');
+  return `${signingInput}.${signature}`;
+}
+
+/**
+ * Simple in-memory brute-force throttle. Enough for a single-process service;
+ * a multi-node deployment should move this to SQLite/Redis.
+ */
+class LoginThrottle {
+  constructor() {
+    /** @type {Map<string, {failures: number, blockedUntil: number}>} */
+    this.entries = new Map();
+  }
+
+  /** @param {string} key */
+  isBlocked(key) {
+    const entry = this.entries.get(key);
+    if (!entry) {
+      return 0;
+    }
+    const now = Date.now();
+    if (entry.blockedUntil > now) {
+      return Math.ceil((entry.blockedUntil - now) / 1000);
+    }
+    return 0;
+  }
+
+  /** @param {string} key */
+  recordFailure(key) {
+    const now = Date.now();
+    const entry = this.entries.get(key) ?? {failures: 0, blockedUntil: 0};
+    entry.failures += 1;
+    if (entry.failures >= 5) {
+      entry.blockedUntil = now + 30_000;
+      entry.failures = 0;
+    }
+    this.entries.set(key, entry);
+    if (this.entries.size > 10_000) {
+      for (const [candidate, value] of this.entries) {
+        if (value.blockedUntil <= now) {
+          this.entries.delete(candidate);
+        }
+      }
+    }
+  }
+
+  /** @param {string} key */
+  reset(key) {
+    this.entries.delete(key);
+  }
+}
+
+export class GaiaService {
+  /**
+   * @param {object} options
+   * @param {import('./db.mjs').Store} options.store
+   * @param {import('./config.mjs').Config} options.config
+   * @param {ReturnType<import('./config.mjs').createLogger>} options.logger
+   */
+  constructor({store, config, logger}) {
+    this.store = store;
+    this.config = config;
+    this.logger = logger;
+    this.secret = store.getOrCreateSecret();
+    this.throttle = new LoginThrottle();
+  }
+
+  // ------------------------------------------------------------- helpers
+
+  /** @param {string} sid @param {string} name */
+  cookieValue(sid, name) {
+    return createHmac('sha256', this.secret)
+        .update(`gaia-cookie:${sid}:${name}`)
+        .digest('base64url')
+        .slice(0, 32);
+  }
+
+  /**
+   * @param {string} name
+   * @param {string} value
+   * @param {number} [maxAgeSeconds]
+   */
+  serializeCookie(name, value, maxAgeSeconds) {
+    const parts = [`${name}=${value}`, 'Path=/', 'HttpOnly', 'SameSite=Lax'];
+    if (maxAgeSeconds !== undefined) {
+      parts.push(`Max-Age=${Math.max(0, Math.floor(maxAgeSeconds))}`);
+    }
+    if (this.config.secureCookies) {
+      parts.push('Secure');
+    }
+    return parts.join('; ');
+  }
+
+  /** @param {string} sid */
+  buildAuthCookies(sid) {
+    const maxAge = this.config.sessionTtlDays * 86400;
+    return GAIA_COOKIE_NAMES.map((name) => {
+      const value = name === 'SID' ? sid : this.cookieValue(sid, name);
+      return this.serializeCookie(name, value, maxAge);
+    });
+  }
+
+  buildClearCookies() {
+    return GAIA_COOKIE_NAMES.map(
+        (name) => this.serializeCookie(name, '', 0),
+    );
+  }
+
+  /** @param {import('node:http').IncomingMessage} req */
+  sessionIdFromRequest(req) {
+    return parseCookieHeader(req.headers.cookie).get('SID') ?? null;
+  }
+
+  /**
+   * Returns the live session for the request, or null.
+   * @param {import('node:http').IncomingMessage} req
+   */
+  getSession(req) {
+    const sid = this.sessionIdFromRequest(req);
+    if (!sid) {
+      return null;
+    }
+    const session = this.store.getSession(sid);
+    if (!session) {
+      return null;
+    }
+    const now = Math.floor(Date.now() / 1000);
+    if (session.revoked_at || session.expires_at <= now) {
+      return null;
+    }
+    return session;
+  }
+
+  /**
+   * Returns `url` if it is a safe http(s) redirect target, else null.
+   * Gaia itself refuses chrome:// continue URLs, and Chromium stops using a
+   * non-Google continue URL in some flows, so anything that is not http(s) is
+   * dropped and the caller falls back to a local page.
+   * @param {string | null} raw
+   */
+  resolveContinue(raw) {
+    if (!raw) {
+      return null;
+    }
+    let url;
+    try {
+      url = new URL(raw);
+    } catch {
+      return null;
+    }
+    if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+      return null;
+    }
+    if (this.config.allowedContinueHosts.length > 0 &&
+        !this.config.allowedContinueHosts.includes(url.hostname)) {
+      return null;
+    }
+    return url.toString();
+  }
+
+  /** @param {import('node:http').IncomingMessage} req */
+  clientInfo(req) {
+    return {
+      ip: req.socket.remoteAddress ?? '',
+      userAgent: String(req.headers['user-agent'] ?? ''),
+    };
+  }
+
+  /**
+   * @param {object} options
+   * @param {import('./db.mjs').Store extends never ? never : any} options.user
+   * @param {string} options.authCode
+   * @param {number} options.position
+   */
+  buildDiceSigninHeader({user, authCode, position}) {
+    // Legacy (comma separated) format; Chromium also supports the grouped
+    // format for multiple accounts. Attributes are URL-escaped because
+    // DiceHeaderHelper::ParseGroup() unescapes them.
+    return [
+      'action=SIGNIN',
+      `authuser=${position}`,
+      `id=${encodeURIComponent(user.gaia_id)}`,
+      `email=${encodeURIComponent(user.display_email)}`,
+      `authorization_code=${encodeURIComponent(authCode)}`,
+    ].join(',');
+  }
+
+  /**
+   * @param {any} user
+   * @param {string} audience
+   */
+  buildIdToken(user, audience) {
+    const now = Math.floor(Date.now() / 1000);
+    return signJwt(this.secret, {
+      iss: this.config.publicUrl,
+      aud: audience || 'afree-login',
+      sub: user.gaia_id,
+      email: user.display_email,
+      email_verified: Boolean(user.email_verified),
+      name: user.display_name || user.display_email,
+      picture: user.avatar_url || undefined,
+      iat: now,
+      exp: now + this.config.accessTokenTtlSeconds,
+    });
+  }
+
+  /** @param {any} user */
+  userInfo(user) {
+    return {
+      id: user.gaia_id,
+      sub: user.gaia_id,
+      email: user.display_email,
+      verified_email: user.display_email,
+      email_verified: Boolean(user.email_verified),
+      name: user.display_name || user.display_email,
+      given_name: user.display_name || user.display_email,
+      picture: user.avatar_url || '',
+      locale: 'en',
+    };
+  }
+
+  /**
+   * Extracts the bearer token from an Authorization header.
+   * @param {import('node:http').IncomingMessage} req
+   */
+  bearerToken(req) {
+    const header = String(req.headers.authorization ?? '');
+    const match = /^(?:Bearer|OAuth)\s+(.+)$/i.exec(header);
+    return match ? match[1].trim() : null;
+  }
+
+  // -------------------------------------------------------------- routing
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   */
+  async handle(req, res) {
+    const url = new URL(req.url ?? '/', 'http://localhost');
+    let path = url.pathname;
+    if (path.length > 1 && path.endsWith('/')) {
+      path = path.slice(0, -1);
+    }
+    const method = (req.method ?? 'GET').toUpperCase();
+
+    try {
+      // Sign-in pages.
+      if (method === 'GET' && SIGNIN_PATHS.has(path)) {
+        await this.handleSigninPage(req, res, url, path);
+        return;
+      }
+
+      if (method === 'POST' && SIGNIN_PATHS.has(path)) {
+        await this.handleSigninSubmit(req, res, url, path);
+        return;
+      }
+
+      if (path === '/enable_sync' && (method === 'GET' || method === 'POST')) {
+        await this.handleEnableSync(req, res);
+        return;
+      }
+
+      if (path === '/ListAccounts' && (method === 'GET' || method === 'POST')) {
+        await this.handleListAccounts(req, res);
+        return;
+      }
+
+      if (path === '/oauth2/v4/token' && (method === 'POST' || method === 'GET')) {
+        await this.handleTokenRequest(req, res, url);
+        return;
+      }
+
+      if (
+        (path === '/oauth2/v1/userinfo' || path === '/oauth2/v2/userinfo') &&
+        (method === 'GET' || method === 'POST')
+      ) {
+        await this.handleUserInfo(req, res, url);
+        return;
+      }
+
+      if (path === '/oauth2/v2/tokeninfo' && (method === 'GET' || method === 'POST')) {
+        await this.handleTokenInfo(req, res, url);
+        return;
+      }
+
+      if (path === '/oauth/multilogin' && method === 'POST') {
+        await this.handleMultilogin(req, res, url);
+        return;
+      }
+
+      if (path === '/GetCheckConnectionInfo') {
+        await readBody(req);
+        sendJson(res, 200, [], {'Cache-Control': 'no-store'});
+        return;
+      }
+
+      if (path === '/Logout' && (method === 'GET' || method === 'POST')) {
+        await this.handleLogout(req, res, url);
+        return;
+      }
+
+      if (path === '/o/oauth2/revoke' && (method === 'POST' || method === 'GET')) {
+        await this.handleRevoke(req, res, url);
+        return;
+      }
+
+      if (path === '/RotateBoundCookies') {
+        await readBody(req);
+        // DBSC (device bound session credentials) is not implemented.
+        sendJson(res, 400, {status: 'INVALID_INPUT'});
+        return;
+      }
+
+      if (path.startsWith('/reauth/v1beta/users/')) {
+        await readBody(req);
+        sendJson(res, 400, {error: {message: 'INVALID_GRANT'}});
+        return;
+      }
+
+      if (path === '/chrome/blank.html') {
+        await readBody(req);
+        sendText(res, 200, '', {'Cache-Control': 'no-store'});
+        return;
+      }
+
+      if (path === '/signup' && method === 'GET') {
+        await this.handleSignupPage(req, res, url);
+        return;
+      }
+
+      if (path === '/signup' && method === 'POST') {
+        await this.handleSignupSubmit(req, res, url);
+        return;
+      }
+
+      if (path === '/healthz') {
+        sendJson(res, 200, {status: 'ok'});
+        return;
+      }
+
+      if (path === '/favicon.ico') {
+        res.writeHead(204);
+        res.end();
+        return;
+      }
+
+      if (path === '/' && method === 'GET') {
+        sendHtml(
+            res,
+            200,
+            renderIndexPage({
+              publicUrl: this.config.publicUrl,
+              serviceName: 'afree',
+            }),
+        );
+        return;
+      }
+
+      await readBody(req);
+      sendHtml(
+          res,
+          404,
+          renderErrorPage({
+            status: 404,
+            title: 'Not found',
+            message: `${method} ${path} is not implemented by this service.`,
+          }),
+      );
+    } catch (error) {
+      const status = /** @type {any} */ (error)?.statusCode ?? 500;
+      this.logger.error('request failed', {
+        method,
+        path,
+        error: String(/** @type {any} */ (error)?.stack ?? error),
+      });
+      if (!res.headersSent) {
+        sendText(res, status, status === 413 ? 'payload too large' : 'internal error');
+      } else {
+        res.end();
+      }
+    }
+  }
+
+  // --------------------------------------------------------- sign-in flow
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   * @param {string} path
+   */
+  async handleSigninPage(req, res, url, path) {
+    const session = this.getSession(req);
+    let signedInEmail = '';
+    if (session) {
+      const primary = this.store.getUserById(session.primary_user_id);
+      signedInEmail = primary?.display_email ?? '';
+    }
+    sendHtml(
+        res,
+        200,
+        renderLoginPage({
+          email: url.searchParams.get('email_hint') ??
+              url.searchParams.get('email') ?? '',
+          continueUrl: url.searchParams.get('continue') ?? '',
+          flow: url.searchParams.get('flow') ?? '',
+          addAccount: path === '/AddSession' ||
+              url.searchParams.get('add') === '1',
+          signedInEmail,
+          allowRegistration: this.config.allowRegistration,
+          serviceName: 'afree',
+        }),
+        {'Cache-Control': 'no-store'},
+    );
+  }
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   * @param {string} path
+   */
+  async handleSigninSubmit(req, res, url, path) {
+    const form = new URLSearchParams(await readBody(req));
+    const email = String(form.get('email') ?? '').trim().slice(0, 254);
+    const password = String(form.get('password') ?? '').slice(0, MAX_PASSWORD_LENGTH);
+    const continueUrl =
+        form.get('continue') ?? url.searchParams.get('continue') ?? '';
+    const flow = form.get('flow') ?? url.searchParams.get('flow') ?? '';
+    const addAccount = form.get('add') === '1' || path === '/AddSession';
+    const {ip, userAgent} = this.clientInfo(req);
+
+    /** @type {(message: string, status: number) => void} */
+    const fail = (message, status) => {
+      sendHtml(
+          res,
+          status,
+          renderLoginPage({
+            email,
+            error: message,
+            continueUrl,
+            flow,
+            addAccount,
+            allowRegistration: this.config.allowRegistration,
+          }),
+          {'Cache-Control': 'no-store'},
+      );
+    };
+
+    const throttleKey = `${ip}|${canonicalizeEmail(email)}`;
+    const blockedFor = this.throttle.isBlocked(throttleKey);
+    if (blockedFor > 0) {
+      fail(
+          `尝试次数过多，请 ${blockedFor} 秒后重试 / Too many attempts, retry in ${blockedFor}s`,
+          429,
+      );
+      return;
+    }
+
+    if (!email || !password) {
+      fail('请输入邮箱和密码 / Email and password are required', 400);
+      return;
+    }
+
+    const user = this.store.getUserByEmail(email);
+    const passwordOk = verifyPassword(
+        password,
+        user ? user.password_hash : DUMMY_PASSWORD_HASH,
+    );
+
+    if (!user || !passwordOk) {
+      this.throttle.recordFailure(throttleKey);
+      this.store.audit({
+        userId: user?.id ?? null,
+        event: 'login_failed',
+        detail: user ? 'bad_password' : 'unknown_user',
+        ip,
+        userAgent,
+      });
+      fail('邮箱或密码不正确 / Wrong email or password', 401);
+      return;
+    }
+
+    if (user.disabled) {
+      this.store.audit({
+        userId: user.id,
+        event: 'login_failed',
+        detail: 'account_disabled',
+        ip,
+        userAgent,
+      });
+      fail('账号已被禁用 / This account is disabled', 403);
+      return;
+    }
+
+    this.throttle.reset(throttleKey);
+
+    const existingSession = this.getSession(req);
+    let sid;
+    let position = 0;
+    if (existingSession && addAccount) {
+      sid = existingSession.id;
+      position = this.store.addAccountToSession(existingSession.id, user.id);
+      this.store.touchSession(existingSession.id);
+    } else {
+      if (existingSession) {
+        this.store.revokeSession(existingSession.id);
+      }
+      sid = this.store.createSession(user.id, {
+        deviceId: String(form.get('device_id') ?? ''),
+        deviceName: String(form.get('device_name') ?? ''),
+        userAgent,
+        ip,
+        ttlSeconds: this.config.sessionTtlDays * 86400,
+      });
+    }
+
+    const authCode = this.store.createAuthCode({
+      userId: user.id,
+      clientId: String(form.get('client_id') ?? ''),
+      scope: OAUTH1_LOGIN_SCOPE,
+      ttlSeconds: this.config.authCodeTtlSeconds,
+    });
+
+    this.store.audit({
+      userId: user.id,
+      event: 'login_success',
+      detail: addAccount ? 'add_account' : 'signin',
+      ip,
+      userAgent,
+    });
+    this.logger.info('sign-in succeeded', {
+      email: user.display_email,
+      gaiaId: user.gaia_id,
+      position,
+      ip,
+    });
+
+    /** @type {string[]} */
+    const setCookies = this.buildAuthCookies(sid);
+    if (this.config.emitOAuthCodeCookie) {
+      // Legacy inline sign-in flow reads this cookie; the DICE flow uses the
+      // authorization_code attribute in the response header instead.
+      setCookies.push(this.serializeCookie('oauth_code', authCode, 60));
+    }
+
+    /** @type {Record<string, string | string[]>} */
+    const headers = {
+      'Cache-Control': 'no-store',
+      Pragma: 'no-cache',
+      'Set-Cookie': setCookies,
+      [DICE_HEADER]: this.buildDiceSigninHeader({user, authCode, position}),
+    };
+
+    const target = this.resolveContinue(continueUrl);
+    if (target && this.config.redirectContinue) {
+      redirect(res, target, headers);
+      return;
+    }
+
+    sendHtml(
+        res,
+        200,
+        renderSignedInPage({
+          email: user.display_email,
+          gaiaId: user.gaia_id,
+          continueUrl: target ?? '',
+        }),
+        headers,
+    );
+  }
+
+  // ----------------------------------------------------------- endpoints
+
+  /**
+   * Mirrors the /enable_sync endpoint used by Chromium's dice browsertest:
+   * it answers with action=ENABLE_SYNC so the client can finish the sync
+   * opt-in step.
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   */
+  async handleEnableSync(req, res) {
+    await readBody(req);
+    const session = this.getSession(req);
+    const user = session ? this.store.getUserById(session.primary_user_id) : null;
+    /** @type {Record<string, string>} */
+    const headers = {'Cache-Control': 'no-store'};
+    if (user) {
+      headers[DICE_HEADER] =
+          `action=ENABLE_SYNC,authuser=0,id=${encodeURIComponent(user.gaia_id)},` +
+          `email=${encodeURIComponent(user.display_email)}`;
+    }
+    sendText(res, 200, user ? 'sync enabled' : 'not signed in', headers);
+  }
+
+  /**
+   * Chromium POSTs to /ListAccounts with cookies and a single space body.
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   */
+  async handleListAccounts(req, res) {
+    await readBody(req);
+    const session = this.getSession(req);
+    /** @type {import('./proto.mjs').ListedAccount[]} */
+    const accounts = [];
+    if (session) {
+      for (const account of this.store.getSessionAccounts(session.id)) {
+        if (account.disabled) {
+          continue;
+        }
+        accounts.push({
+          displayEmail: account.display_email,
+          obfuscatedId: account.gaia_id,
+          validSession: true,
+          signedOut: false,
+          isVerified: Boolean(account.email_verified),
+        });
+      }
+      this.store.touchSession(session.id);
+    }
+    sendText(
+        res,
+        200,
+        encodeListAccountsResponseBase64(accounts),
+        {'Cache-Control': 'no-store'},
+    );
+  }
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   */
+  async handleTokenRequest(req, res, url) {
+    const body = await readBody(req);
+    const params = new URLSearchParams(body);
+    const grantType = params.get('grant_type') ??
+        url.searchParams.get('grant_type') ?? '';
+
+    const tokenError = (/** @type {string} */ error, description) => {
+      sendJson(
+          res,
+          400,
+          {error, ...(description ? {error_description: description} : {})},
+          {'Cache-Control': 'no-store'},
+      );
+    };
+
+    if (grantType === 'authorization_code') {
+      const code = params.get('code') ?? '';
+      if (!code) {
+        tokenError('invalid_request', 'missing code');
+        return;
+      }
+      const row = this.store.consumeAuthCode(code);
+      if (!row) {
+        tokenError('invalid_grant', 'authorization code is invalid or expired');
+        return;
+      }
+      const user = this.store.getUserById(row.user_id);
+      if (!user || user.disabled) {
+        tokenError('invalid_grant', 'account is not usable');
+        return;
+      }
+      const deviceId = params.get('device_id') ?? row.device_id ?? '';
+      const deviceType = params.get('device_type') ?? '';
+      if (deviceId && deviceType && deviceType !== 'chrome') {
+        tokenError('invalid_request', 'device_type must be chrome');
+        return;
+      }
+      const clientId = params.get('client_id') ?? row.client_id ?? '';
+      const scope = params.get('scope') ?? row.scope ?? '';
+      const refreshToken = this.store.createRefreshToken({
+        userId: user.id,
+        clientId,
+        scope,
+        deviceId,
+        ttlDays: this.config.refreshTokenTtlDays,
+      });
+      const accessToken = this.store.createAccessToken({
+        userId: user.id,
+        refreshTokenHash: sha256(refreshToken),
+        clientId,
+        scope,
+        ttlSeconds: this.config.accessTokenTtlSeconds,
+      });
+      this.store.audit({
+        userId: user.id,
+        event: 'token_issued',
+        detail: 'authorization_code',
+        ip: this.clientInfo(req).ip,
+        userAgent: this.clientInfo(req).userAgent,
+      });
+      sendJson(
+          res,
+          200,
+          {
+            access_token: accessToken,
+            refresh_token: refreshToken,
+            expires_in: this.config.accessTokenTtlSeconds,
+            token_type: 'Bearer',
+            id_token: this.buildIdToken(user, clientId),
+            scope,
+          },
+          {'Cache-Control': 'no-store'},
+      );
+      return;
+    }
+
+    if (grantType === 'refresh_token') {
+      const refreshToken = params.get('refresh_token') ?? '';
+      if (!refreshToken) {
+        tokenError('invalid_request', 'missing refresh_token');
+        return;
+      }
+      const row = this.store.getRefreshToken(refreshToken);
+      if (!row) {
+        tokenError('invalid_grant', 'refresh token is invalid or expired');
+        return;
+      }
+      const user = this.store.getUserById(row.user_id);
+      if (!user || user.disabled) {
+        tokenError('invalid_grant', 'account is not usable');
+        return;
+      }
+      // Chromium asks for one scope per service; the service does not restrict
+      // scopes, so the requested value is recorded on the issued token.
+      const scope = params.get('scope') ?? '';
+      const clientId = params.get('client_id') ?? row.client_id ?? '';
+      const accessToken = this.store.createAccessToken({
+        userId: user.id,
+        refreshTokenHash: row.token_hash,
+        clientId,
+        scope,
+        ttlSeconds: this.config.accessTokenTtlSeconds,
+      });
+      sendJson(
+          res,
+          200,
+          {
+            access_token: accessToken,
+            expires_in: this.config.accessTokenTtlSeconds,
+            token_type: 'Bearer',
+            id_token: this.buildIdToken(user, clientId),
+            scope,
+          },
+          {'Cache-Control': 'no-store'},
+      );
+      return;
+    }
+
+    tokenError(
+        'unsupported_grant_type',
+        `grant_type must be authorization_code or refresh_token, got "${
+            grantType}"`,
+    );
+  }
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   */
+  async handleUserInfo(req, res, url) {
+    const body = await readBody(req);
+    const params = new URLSearchParams(body);
+    const token = this.bearerToken(req) || params.get('access_token') ||
+        url.searchParams.get('access_token');
+    const row = token ? this.store.getAccessToken(token) : null;
+    const user = row ? this.store.getUserById(row.user_id) : null;
+    if (!user || user.disabled) {
+      sendJson(
+          res,
+          401,
+          {error: 'invalid_token'},
+          {'Cache-Control': 'no-store', 'WWW-Authenticate': 'Bearer'},
+      );
+      return;
+    }
+    sendJson(res, 200, this.userInfo(user), {'Cache-Control': 'no-store'});
+  }
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   */
+  async handleTokenInfo(req, res, url) {
+    const body = await readBody(req);
+    const params = new URLSearchParams(body);
+    const token = params.get('access_token') ??
+        url.searchParams.get('access_token') ?? this.bearerToken(req);
+    const row = token ? this.store.getAccessToken(token) : null;
+    const user = row ? this.store.getUserById(row.user_id) : null;
+    if (!user) {
+      sendJson(res, 400, {error: 'invalid_token'}, {'Cache-Control': 'no-store'});
+      return;
+    }
+    sendJson(
+        res,
+        200,
+        {
+          issued_to: row.client_id || 'afree',
+          audience: row.client_id || 'afree',
+          user_id: user.gaia_id,
+          scope: row.scope,
+          expires_in: Math.max(0, row.expires_at - Math.floor(Date.now() / 1000)),
+          email: user.display_email,
+          verified_email: user.display_email,
+          id_token: this.buildIdToken(user, row.client_id),
+        },
+        {'Cache-Control': 'no-store'},
+    );
+  }
+
+  /**
+   * Sets the GAIA cookies for the accounts Chromium just signed in.
+   * Chromium sends `Authorization: MultiBearer <token>:<gaia id>,...` and
+   * `?source=chrome&reuseCookies=...`.
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   */
+  async handleMultilogin(req, res, url) {
+    await readBody(req);
+    const header = String(req.headers.authorization ?? '');
+    const multiBearer = /^MultiBearer\s+(.+)$/i.exec(header);
+    if (!multiBearer) {
+      sendXssiJson(
+          res,
+          400,
+          {
+            status: 'INVALID_INPUT',
+            message: 'Authorization must be MultiBearer <token>:<gaia_id>',
+          },
+          {'Cache-Control': 'no-store'},
+      );
+      return;
+    }
+
+    /** @type {{token: string, gaiaId: string}[]} */
+    const credentials = [];
+    for (const part of multiBearer[1].split(',')) {
+      const trimmed = part.trim();
+      if (!trimmed) {
+        continue;
+      }
+      // Access tokens are base64url, so the last ':' separates the gaia id.
+      const index = trimmed.lastIndexOf(':');
+      if (index <= 0) {
+        sendXssiJson(
+            res,
+            400,
+            {status: 'INVALID_INPUT', message: 'malformed credentials'},
+            {'Cache-Control': 'no-store'},
+        );
+        return;
+      }
+      credentials.push({
+        token: trimmed.slice(0, index),
+        gaiaId: trimmed.slice(index + 1),
+      });
+    }
+
+    if (credentials.length === 0) {
+      sendXssiJson(
+          res,
+          400,
+          {status: 'INVALID_INPUT', message: 'no credentials'},
+          {'Cache-Control': 'no-store'},
+      );
+      return;
+    }
+
+    /** @type {{status: string, gaia_id: string}[]} */
+    const failedAccounts = [];
+    /** @type {Set<string>} */
+    const userIds = new Set();
+    for (const credential of credentials) {
+      const row = this.store.getAccessToken(credential.token);
+      const user = row ? this.store.getUserById(row.user_id) : null;
+      if (!user || user.disabled || user.gaia_id !== credential.gaiaId) {
+        failedAccounts.push({status: 'RECOVERABLE', gaia_id: credential.gaiaId});
+        continue;
+      }
+      userIds.add(user.id);
+    }
+
+    if (failedAccounts.length > 0) {
+      sendXssiJson(
+          res,
+          400,
+          {status: 'INVALID_TOKENS', failed_accounts: failedAccounts},
+          {'Cache-Control': 'no-store'},
+      );
+      return;
+    }
+
+    // Prefer the account whose session is attached to this request, so the
+    // cookie values stay consistent with /ListAccounts.
+    const session = this.getSession(req);
+    /** @type {any} */
+    let primaryUser = null;
+    if (session) {
+      const primary = this.store.getUserById(session.primary_user_id);
+      if (primary && userIds.has(primary.id)) {
+        primaryUser = primary;
+      }
+    }
+    if (!primaryUser) {
+      primaryUser = this.store.getUserById([...userIds][0]);
+    }
+    if (!primaryUser) {
+      sendXssiJson(
+          res,
+          400,
+          {status: 'INVALID_TOKENS', failed_accounts: failedAccounts},
+          {'Cache-Control': 'no-store'},
+      );
+      return;
+    }
+
+    const sid = session?.id ?? this.store.createSession(primaryUser.id, {
+      userAgent: this.clientInfo(req).userAgent,
+      ip: this.clientInfo(req).ip,
+      ttlSeconds: this.config.sessionTtlDays * 86400,
+    });
+
+    const maxAge = 2 * 365 * 86400;
+    const cookies = GAIA_COOKIE_NAMES.map((name) => ({
+      name,
+      value: name === 'SID' ? sid : this.cookieValue(sid, name),
+      // `host` (instead of `domain`) yields a host-only cookie, which is what
+      // an IP or single-label test host needs.
+      host: this.config.cookieHost,
+      path: '/',
+      isSecure: this.config.secureCookies,
+      isHttpOnly: true,
+      maxAge,
+      priority: 'HIGH',
+    }));
+
+    sendXssiJson(
+        res,
+        200,
+        {status: 'OK', cookies},
+        {'Cache-Control': 'no-store'},
+    );
+
+    this.logger.debug('multilogin', {
+      source: url.searchParams.get('source') ?? '',
+      accounts: userIds.size,
+    });
+  }
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   */
+  async handleLogout(req, res, url) {
+    await readBody(req);
+    const session = this.getSession(req);
+    /** @type {Record<string, string | string[]>} */
+    const headers = {
+      'Cache-Control': 'no-store',
+      'Set-Cookie': this.buildClearCookies(),
+    };
+
+    if (session) {
+      const primary = this.store.getUserById(session.primary_user_id);
+      if (primary) {
+        headers[SIGNOUT_HEADER] = `email="${
+            primary.display_email}", obfuscatedid="${primary.gaia_id}", sessionindex=0`;
+      }
+      this.store.revokeSession(session.id);
+      this.store.audit({
+        userId: session.primary_user_id,
+        event: 'logout',
+        ip: this.clientInfo(req).ip,
+        userAgent: this.clientInfo(req).userAgent,
+      });
+    }
+
+    const target = this.resolveContinue(url.searchParams.get('continue'));
+    if (target && this.config.redirectContinue) {
+      redirect(res, target, headers);
+      return;
+    }
+    sendHtml(res, 200, renderSignedOutPage({continueUrl: target ?? ''}), headers);
+  }
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   */
+  async handleRevoke(req, res, url) {
+    const body = await readBody(req);
+    const params = new URLSearchParams(body);
+    const token = params.get('token') ?? url.searchParams.get('token') ?? '';
+    if (!token) {
+      sendJson(res, 400, {error: 'invalid_request'}, {'Cache-Control': 'no-store'});
+      return;
+    }
+    this.store.revokeRefreshToken(token);
+    sendText(res, 200, '', {'Cache-Control': 'no-store'});
+  }
+
+  // ------------------------------------------------------------- signup
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   */
+  async handleSignupPage(req, res, url) {
+    if (!this.config.allowRegistration) {
+      sendHtml(
+          res,
+          404,
+          renderErrorPage({
+            status: 404,
+            title: 'Registration disabled',
+            message: 'Start the service with --allow-registration to enable it.',
+          }),
+      );
+      return;
+    }
+    sendHtml(
+        res,
+        200,
+        renderSignupPage({
+          continueUrl: url.searchParams.get('continue') ?? '',
+        }),
+        {'Cache-Control': 'no-store'},
+    );
+  }
+
+  /**
+   * @param {import('node:http').IncomingMessage} req
+   * @param {import('node:http').ServerResponse} res
+   * @param {URL} url
+   */
+  async handleSignupSubmit(req, res, url) {
+    if (!this.config.allowRegistration) {
+      sendText(res, 404, 'registration disabled');
+      return;
+    }
+    const form = new URLSearchParams(await readBody(req));
+    const email = String(form.get('email') ?? '').trim().slice(0, 254);
+    const password = String(form.get('password') ?? '');
+    if (!email || password.length < 8) {
+      sendHtml(
+          res,
+          400,
+          renderErrorPage({
+            status: 400,
+            title: 'Invalid input',
+            message: 'A valid email and a password of at least 8 characters are required.',
+          }),
+      );
+      return;
+    }
+    if (this.store.getUserByEmail(email)) {
+      sendHtml(
+          res,
+          409,
+          renderErrorPage({
+            status: 409,
+            title: 'Account exists',
+            message: 'An account with this email already exists.',
+          }),
+      );
+      return;
+    }
+    const user = this.store.createUser({email, password});
+    this.store.audit({
+      userId: user.id,
+      event: 'user_created',
+      detail: 'signup',
+      ip: this.clientInfo(req).ip,
+      userAgent: this.clientInfo(req).userAgent,
+    });
+    redirect(res, '/signin/chrome/sync', {'Cache-Control': 'no-store'});
+  }
+}
+
+/**
+ * @param {object} options
+ * @param {import('./db.mjs').Store} options.store
+ * @param {import('./config.mjs').Config} options.config
+ * @param {ReturnType<import('./config.mjs').createLogger>} options.logger
+ */
+export function createGaiaService({store, config, logger}) {
+  const service = new GaiaService({store, config, logger});
+  return {
+    /** @param {import('node:http').IncomingMessage} req @param {import('node:http').ServerResponse} res */
+    handle: (req, res) => service.handle(req, res),
+    service,
+  };
+}
diff --git a/tools/afree-login-service/src/proto.mjs b/tools/afree-login-service/src/proto.mjs
new file mode 100644
index 0000000000..2b64582aaf
--- /dev/null
+++ b/tools/afree-login-service/src/proto.mjs
@@ -0,0 +1,223 @@
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Minimal protobuf wire-format support for the GAIA endpoints that use
+// protobuf.
+//
+// Chromium only speaks protobuf over the wire on this call path for two
+// endpoints:
+//
+//   /ListAccounts  -> gaia.ListAccountsResponse
+//                     (google_apis/gaia/list_accounts_response.proto)
+//   /oauth2/v2/tokeninfo and the rest are JSON.
+//
+// Chromium base64-decodes the /ListAccounts body and parses it with
+// `ListAccountsResponse::ParseFromString()`, see
+// `ParseBinaryListAccountsData()` in google_apis/gaia/gaia_auth_util.cc.
+//
+// Implementing the 30 lines of wire format needed here is simpler and more
+// robust than depending on a protobuf runtime plus a codegen step. The
+// encoder below mirrors `CreateListAccountsResponseInBinaryFormat()` in
+// google_apis/gaia/gaia_auth_test_util.cc, which is what Chromium's own
+// FakeGaia returns.
+
+const WIRE_VARINT = 0;
+const WIRE_LENGTH_DELIMITED = 2;
+
+// Field numbers from google_apis/gaia/list_accounts_response.proto.
+const LIST_ACCOUNTS_ACCOUNT = 1;
+const ACCOUNT_DISPLAY_EMAIL = 3;
+const ACCOUNT_VALID_SESSION = 9;
+const ACCOUNT_OBFUSCATED_ID = 10;
+const ACCOUNT_SIGNED_OUT = 14;
+const ACCOUNT_IS_VERIFIED = 15;
+
+/**
+ * Encodes a non-negative safe integer as a protobuf varint.
+ * @param {number} value
+ * @returns {Buffer}
+ */
+function encodeVarint(value) {
+  if (!Number.isSafeInteger(value) || value < 0) {
+    throw new RangeError(`invalid varint value: ${value}`);
+  }
+  const bytes = [];
+  let remaining = value;
+  while (remaining >= 0x80) {
+    bytes.push((remaining & 0x7f) | 0x80);
+    remaining = Math.floor(remaining / 0x80);
+  }
+  bytes.push(remaining);
+  return Buffer.from(bytes);
+}
+
+function makeTag(fieldNumber, wireType) {
+  return encodeVarint((fieldNumber << 3) | wireType);
+}
+
+function encodeStringField(fieldNumber, value) {
+  const data = Buffer.from(value, 'utf8');
+  return Buffer.concat([
+    makeTag(fieldNumber, WIRE_LENGTH_DELIMITED),
+    encodeVarint(data.length),
+    data,
+  ]);
+}
+
+function encodeBoolField(fieldNumber, value) {
+  return Buffer.concat([
+    makeTag(fieldNumber, WIRE_VARINT),
+    encodeVarint(value ? 1 : 0),
+  ]);
+}
+
+/**
+ * @typedef {object} ListedAccount
+ * @property {string} displayEmail
+ * @property {string} obfuscatedId
+ * @property {boolean} [validSession]
+ * @property {boolean} [signedOut]
+ * @property {boolean} [isVerified]
+ */
+
+/**
+ * Serializes a `gaia.ListAccountsResponse` message.
+ * @param {ListedAccount[]} accounts
+ * @returns {Buffer}
+ */
+export function encodeListAccountsResponse(accounts) {
+  const parts = [];
+  for (const account of accounts) {
+    const message = Buffer.concat([
+      encodeStringField(ACCOUNT_DISPLAY_EMAIL, account.displayEmail),
+      encodeBoolField(
+        ACCOUNT_VALID_SESSION,
+        account.validSession !== false,
+      ),
+      encodeStringField(ACCOUNT_OBFUSCATED_ID, account.obfuscatedId),
+      encodeBoolField(ACCOUNT_SIGNED_OUT, account.signedOut === true),
+      encodeBoolField(ACCOUNT_IS_VERIFIED, account.isVerified !== false),
+    ]);
+    parts.push(
+      makeTag(LIST_ACCOUNTS_ACCOUNT, WIRE_LENGTH_DELIMITED),
+      encodeVarint(message.length),
+      message,
+    );
+  }
+  return Buffer.concat(parts);
+}
+
+/**
+ * Serializes and base64-encodes a `gaia.ListAccountsResponse`, exactly the
+ * format `base::Base64Encode()` produces on the Chromium side.
+ * @param {ListedAccount[]} accounts
+ * @returns {string}
+ */
+export function encodeListAccountsResponseBase64(accounts) {
+  return encodeListAccountsResponse(accounts).toString('base64');
+}
+
+function readVarint(buffer, offset) {
+  let result = 0;
+  let shift = 0;
+  let index = offset;
+  for (;;) {
+    if (index >= buffer.length) {
+      throw new RangeError('truncated varint');
+    }
+    const byte = buffer[index++];
+    result += (byte & 0x7f) * 2 ** shift;
+    if ((byte & 0x80) === 0) {
+      return [result, index];
+    }
+    shift += 7;
+    if (shift > 63) {
+      throw new RangeError('varint too long');
+    }
+  }
+}
+
+function* iterFields(buffer) {
+  let offset = 0;
+  while (offset < buffer.length) {
+    let tag;
+    [tag, offset] = readVarint(buffer, offset);
+    const fieldNumber = Math.floor(tag / 8);
+    const wireType = tag & 0x7;
+    if (wireType === WIRE_VARINT) {
+      let value;
+      [value, offset] = readVarint(buffer, offset);
+      yield {fieldNumber, wireType, value};
+    } else if (wireType === WIRE_LENGTH_DELIMITED) {
+      let length;
+      [length, offset] = readVarint(buffer, offset);
+      if (offset + length > buffer.length) {
+        throw new RangeError('truncated length-delimited field');
+      }
+      yield {
+        fieldNumber,
+        wireType,
+        value: buffer.subarray(offset, offset + length),
+      };
+      offset += length;
+    } else if (wireType === 5) {
+      offset += 4;
+    } else if (wireType === 1) {
+      offset += 8;
+    } else {
+      throw new RangeError(`unsupported wire type ${wireType}`);
+    }
+  }
+}
+
+/**
+ * Decodes a `gaia.ListAccountsResponse`. Only used by tests and the CLI.
+ * @param {Buffer} buffer
+ * @returns {ListedAccount[]}
+ */
+export function decodeListAccountsResponse(buffer) {
+  const accounts = [];
+  for (const field of iterFields(buffer)) {
+    if (
+      field.fieldNumber !== LIST_ACCOUNTS_ACCOUNT ||
+      field.wireType !== WIRE_LENGTH_DELIMITED
+    ) {
+      continue;
+    }
+    /** @type {ListedAccount} */
+    const account = {displayEmail: '', obfuscatedId: ''};
+    for (const sub of iterFields(field.value)) {
+      switch (sub.fieldNumber) {
+        case ACCOUNT_DISPLAY_EMAIL:
+          account.displayEmail = sub.value.toString('utf8');
+          break;
+        case ACCOUNT_OBFUSCATED_ID:
+          account.obfuscatedId = sub.value.toString('utf8');
+          break;
+        case ACCOUNT_VALID_SESSION:
+          account.validSession = sub.value !== 0;
+          break;
+        case ACCOUNT_SIGNED_OUT:
+          account.signedOut = sub.value !== 0;
+          break;
+        case ACCOUNT_IS_VERIFIED:
+          account.isVerified = sub.value !== 0;
+          break;
+        default:
+          break;
+      }
+    }
+    accounts.push(account);
+  }
+  return accounts;
+}
+
+/**
+ * Decodes the base64 payload Chromium returns/expects on /ListAccounts.
+ * @param {string} base64
+ * @returns {ListedAccount[]}
+ */
+export function decodeListAccountsResponseBase64(base64) {
+  return decodeListAccountsResponse(Buffer.from(base64, 'base64'));
+}
diff --git a/tools/afree-login-service/src/schema.sql b/tools/afree-login-service/src/schema.sql
new file mode 100644
index 0000000000..a1173367c5
--- /dev/null
+++ b/tools/afree-login-service/src/schema.sql
@@ -0,0 +1,114 @@
+-- Copyright 2026 The afree Authors
+-- Use of this source code is governed by a BSD-style license that can be
+-- found in the LICENSE file.
+--
+-- SQLite schema for the afree sign-in service.
+--
+-- Design notes:
+--  * Every credential is stored as a SHA-256 hash. The plaintext token only
+--    ever exists in the HTTP response that hands it to the client.
+--  * Sessions model the GAIA "SID" cookie. A session can hold several
+--    accounts, mirroring the GAIA multi-account cookie jar.
+--  * All timestamps are Unix epoch seconds.
+
+CREATE TABLE IF NOT EXISTS meta (
+  key   TEXT PRIMARY KEY,
+  value TEXT NOT NULL
+) STRICT;
+
+CREATE TABLE IF NOT EXISTS users (
+  id             TEXT PRIMARY KEY,
+  -- Canonical (lowercased) email. Unique login identifier.
+  email          TEXT NOT NULL UNIQUE,
+  -- Email as typed by the user, returned by /ListAccounts and /userinfo.
+  display_email  TEXT NOT NULL,
+  password_hash  TEXT NOT NULL,
+  -- Opaque Gaia-style account id. Must never contain '@'.
+  gaia_id        TEXT NOT NULL UNIQUE,
+  display_name   TEXT NOT NULL DEFAULT '',
+  avatar_url     TEXT NOT NULL DEFAULT '',
+  email_verified INTEGER NOT NULL DEFAULT 1,
+  disabled       INTEGER NOT NULL DEFAULT 0,
+  created_at     INTEGER NOT NULL,
+  updated_at     INTEGER NOT NULL
+) STRICT;
+
+CREATE TABLE IF NOT EXISTS sessions (
+  id             TEXT PRIMARY KEY,
+  primary_user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  device_id      TEXT NOT NULL DEFAULT '',
+  device_name    TEXT NOT NULL DEFAULT '',
+  user_agent     TEXT NOT NULL DEFAULT '',
+  ip             TEXT NOT NULL DEFAULT '',
+  created_at     INTEGER NOT NULL,
+  last_seen_at   INTEGER NOT NULL,
+  expires_at     INTEGER NOT NULL,
+  revoked_at     INTEGER
+) STRICT;
+
+CREATE TABLE IF NOT EXISTS session_accounts (
+  session_id TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
+  user_id    TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  -- 0 is the primary account; also reported as `authuser` in the DICE header.
+  position   INTEGER NOT NULL,
+  added_at   INTEGER NOT NULL,
+  PRIMARY KEY (session_id, user_id)
+) STRICT;
+
+CREATE INDEX IF NOT EXISTS session_accounts_by_position
+  ON session_accounts(session_id, position);
+
+CREATE TABLE IF NOT EXISTS auth_codes (
+  code_hash    TEXT PRIMARY KEY,
+  user_id      TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  client_id    TEXT NOT NULL DEFAULT '',
+  redirect_uri TEXT NOT NULL DEFAULT '',
+  scope        TEXT NOT NULL DEFAULT '',
+  device_id    TEXT NOT NULL DEFAULT '',
+  created_at   INTEGER NOT NULL,
+  expires_at   INTEGER NOT NULL,
+  used_at      INTEGER
+) STRICT;
+
+CREATE TABLE IF NOT EXISTS refresh_tokens (
+  token_hash    TEXT PRIMARY KEY,
+  user_id       TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  client_id     TEXT NOT NULL DEFAULT '',
+  scope         TEXT NOT NULL DEFAULT '',
+  device_id     TEXT NOT NULL DEFAULT '',
+  device_name   TEXT NOT NULL DEFAULT '',
+  created_at    INTEGER NOT NULL,
+  last_used_at  INTEGER,
+  -- NULL means "no expiry".
+  expires_at    INTEGER,
+  revoked_at    INTEGER
+) STRICT;
+
+CREATE INDEX IF NOT EXISTS refresh_tokens_by_user
+  ON refresh_tokens(user_id);
+
+CREATE TABLE IF NOT EXISTS access_tokens (
+  token_hash         TEXT PRIMARY KEY,
+  user_id            TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  refresh_token_hash TEXT,
+  client_id          TEXT NOT NULL DEFAULT '',
+  scope              TEXT NOT NULL DEFAULT '',
+  created_at         INTEGER NOT NULL,
+  expires_at         INTEGER NOT NULL,
+  revoked_at         INTEGER
+) STRICT;
+
+CREATE INDEX IF NOT EXISTS access_tokens_by_user
+  ON access_tokens(user_id);
+
+CREATE TABLE IF NOT EXISTS audit_log (
+  id         INTEGER PRIMARY KEY AUTOINCREMENT,
+  user_id    TEXT,
+  event      TEXT NOT NULL,
+  detail     TEXT NOT NULL DEFAULT '',
+  ip         TEXT NOT NULL DEFAULT '',
+  user_agent TEXT NOT NULL DEFAULT '',
+  created_at INTEGER NOT NULL
+) STRICT;
+
+CREATE INDEX IF NOT EXISTS audit_log_by_time ON audit_log(created_at);
diff --git a/tools/afree-login-service/src/server.mjs b/tools/afree-login-service/src/server.mjs
new file mode 100644
index 0000000000..6b918f440d
--- /dev/null
+++ b/tools/afree-login-service/src/server.mjs
@@ -0,0 +1,109 @@
+#!/usr/bin/env node
+// Copyright 2026 The afree Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import http from 'node:http';
+import {pathToFileURL} from 'node:url';
+import {createLogger, isLoopbackHost, loadConfig, USAGE} from './config.mjs';
+import {Store} from './db.mjs';
+import {createGaiaService} from './gaia.mjs';
+
+/**
+ * Builds the HTTP server without starting it. Used by tests and by the CLI.
+ * @param {object} options
+ * @param {Store} options.store
+ * @param {import('./config.mjs').Config} options.config
+ * @param {ReturnType<createLogger>} options.logger
+ */
+export function createHttpServer({store, config, logger}) {
+  const {handle, service} = createGaiaService({store, config, logger});
+  const server = http.createServer((req, res) => {
+    handle(req, res).catch((error) => {
+      logger.error('unhandled request error', {
+        error: String(error?.stack ?? error),
+      });
+      if (!res.headersSent) {
+        res.writeHead(500, {'Content-Type': 'text/plain; charset=utf-8'});
+      }
+      res.end('internal error');
+    });
+  });
+  return {server, service};
+}
+
+export async function startServer(config, logger) {
+  const store = Store.open(config.dbPath);
+  const {server} = createHttpServer({store, config, logger});
+
+  await new Promise((resolve, reject) => {
+    server.once('error', reject);
+    server.listen(config.port, config.host, resolve);
+  });
+
+  return {server, store};
+}
+
+async function main() {
+  const argv = process.argv.slice(2);
+  if (argv.includes('--help') || argv.includes('-h')) {
+    process.stdout.write(USAGE);
+    return;
+  }
+
+  const config = loadConfig(argv);
+  const logger = createLogger(config.logLevel);
+
+  if (!config.secureCookies) {
+    const loopback =
+        isLoopbackHost(new URL(config.publicUrl).hostname);
+    if (!loopback) {
+      logger.warn(
+          'serving over plain HTTP on a non-loopback host; cookies will not ' +
+          'be marked Secure. Use --public-url with an https:// origin and a ' +
+          'TLS terminator in production.');
+    }
+  }
+
+  const {server, store} = await startServer(config, logger);
+  const address = server.address();
+  const actualPort =
+      typeof address === 'object' && address ? address.port : config.port;
+
+  logger.info('afree login service listening', {
+    url: config.publicUrl,
+    address: `${config.host}:${actualPort}`,
+    database: config.dbPath,
+  });
+
+  process.stdout.write(`afree login service listening on ${config.publicUrl}
+database: ${config.dbPath}
+
+Next steps:
+  1) create a user:
+       node src/cli.mjs add-user --email you@example.com
+  2) write a Chromium gaia config:
+       node src/cli.mjs gen-gaia-config --url ${config.publicUrl} > gaia-config.json
+  3) start the client with:
+       --gaia-config=$PWD/gaia-config.json
+       --oauth2-client-id=afree-client-id --oauth2-client-secret=afree-client-secret
+`);
+
+  const shutdown = async (signal) => {
+    logger.info('shutting down', {signal});
+    await new Promise((resolve) => server.close(resolve));
+    store.close();
+    process.exit(0);
+  };
+  process.once('SIGINT', () => void shutdown('SIGINT'));
+  process.once('SIGTERM', () => void shutdown('SIGTERM'));
+}
+
+const invokedDirectly = process.argv[1] &&
+    import.meta.url === pathToFileURL(process.argv[1]).href;
+if (invokedDirectly) {
+  main().catch((error) => {
+    process.stderr.write(`afree login service failed: ${error?.message ?? error}\n`);
+    process.exit(1);
+  });
+}
